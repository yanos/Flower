<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- 23 (not 21) because Avalonia 12's transitive Xamarin.AndroidX.Lifecycle.*
         dependencies now require API 23+ - a manifest merge error otherwise
         (uses-sdk:minSdkVersion 21 cannot be smaller than version 23 declared
         in androidx.lifecycle.lifecycle-runtime-android.aar). -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.yanos.flower</ApplicationId>
    <!-- ApplicationVersion (versionCode) is a plain, strictly-increasing
         integer that a store release overrides via /p:ApplicationVersion=<n>
         at build time - see VERSIONING-PLAN.md Phase 3. ApplicationDisplayVersion
         (versionName) is set dynamically from MinVer's $(Version) by the
         target in Directory.Build.targets, not here - a plain property
         assignment here would freeze at the SDK's static default instead of
         MinVer's computed value. -->
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.0" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />

    <!-- Xamarin.AndroidX.Core.SplashScreen and Avalonia.Android pull skewed
         transitive versions of Xamarin.AndroidX.Core (1.19.0.1) vs
         Xamarin.AndroidX.Core.Core.Ktx (1.17.0.2) - D8 then sees the same
         generated Kotlin-extension class (androidx.core.animation.
         AnimatorKt$addListener$2) defined in both AARs and fails dexing.
         These two bindings track the same underlying androidx-core release
         in lockstep, so pin both to the same version explicitly. -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower\Flower.csproj" />
  </ItemGroup>

  <!-- Self-built (native/miniaudio/android/build.sh), not from a NuGet
       package - Miniaudio-CS only ships desktop native binaries (see
       MiniaudioSink.cs). Named libminiaudio.so so Miniaudio-CS's own
       DllImport("miniaudio") bindings resolve it with no custom
       DllImportResolver needed.

       .NET's RID graph treats android-* as falling back to linux-* (Android
       being Linux-kernel-based), so NuGet restore resolves Miniaudio-CS's
       own *desktop* runtimes/linux-arm64/native/libminiaudio.so - a real
       glibc/Bionic-incompatible Linux binary - as a "compatible" native
       asset for this project's android-arm64 target, landing it in the
       exact same lib/arm64-v8a/ output slot as our real Android build
       (confirmed via a genuine on-device dlopen failure: "library
       libc.so.6 not found" - not an Android binary at all). The
       PackageReference Update below excludes Miniaudio-CS's native assets
       for this project specifically, so our own explicit
       AndroidNativeLibrary items below are the only source. -->
  <!-- PackageReference Update didn't work here - there's no Miniaudio-CS
       Include item in this project to update, since it only flows in
       transitively via the Flower.csproj ProjectReference (PackageReference
       Update only merges metadata into items already Included in the same
       project's own evaluation). A direct Include, re-declaring the same
       package this project already gets transitively, does let NuGet
       override the asset flags for this project's own resolution. -->
  <ItemGroup>
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="libs\arm64-v8a\libminiaudio.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="libs\x86_64\libminiaudio.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="libs\armeabi-v7a\libminiaudio.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!-- The FFmpeg decoder's facade, self-built the same way and for the same
       reason (native/ffmpeg/android/build.sh). FFmpeg itself is linked in
       statically rather than shipped as four more libraries per ABI, which is
       also where the LGPL obligation lands for a phone build - there is no
       distro FFmpeg here to point at or replace. See native/ffmpeg/README.md.

       Without these there is no decoder at all on that ABI: App.axaml.cs logs
       one critical line at startup and the app browses, edits and syncs
       without being able to play anything. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="libs\arm64-v8a\libflower_ffmpeg.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="libs\x86_64\libflower_ffmpeg.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="libs\armeabi-v7a\libflower_ffmpeg.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>
</Project>
