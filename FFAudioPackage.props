<Project>
  <!-- The FFAudio.NET package switch: it builds Flower against the packaged
       façade instead of the copy that lives in Flower/Audio/Ffmpeg/. Tracked,
       because the switch is a fact about how this repo is built and is worth
       reviewing; what is not tracked is which package a given machine is
       pointed at, which is the other file.

       Nothing here does anything until FFAudioPackageVersion is set, so a
       fresh clone and CI build exactly as they did before this file existed -
       against the in-tree façade and the checked-in mobile binaries. Setting
       it is what scripts/use-ffaudio-package.sh does, by writing the
       gitignored FFAudioPackage.local.props imported just below.

       Once a version is published to nuget.org, giving FFAudioPackageVersion a
       default here is what flips the whole repo over to the package - and is
       the step that lets Flower.iOS/Frameworks/ and Flower.Android/libs/ be
       deleted. Until then the default is empty on purpose: a version that only
       exists in one developer's local feed would fail to restore for everyone
       else, CI included. -->
  <Import Project="$(MSBuildThisFileDirectory)FFAudioPackage.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)FFAudioPackage.local.props')" />

  <!-- The three projects whose own sources name the façade's types. Everything
       else reaches the decoder through ITrackDecoder and never says FFmpeg. -->
  <ItemGroup Condition="'$(FFAudioPackageVersion)' != '' And ('$(MSBuildProjectName)' == 'Flower' Or '$(MSBuildProjectName)' == 'Flower.Tests' Or '$(MSBuildProjectName)' == 'Flower.DeviceChecks')">
    <PackageReference Include="FFAudio.NET" Version="$(FFAudioPackageVersion)" />
    <!-- The façade itself, as runtimes/<rid>/native/. The SDK copies it beside
         every binary downstream of here and the macOS head bundles it into
         Contents/MonoBundle, so nothing has to name a path. It reaches the
         phone heads too, through Flower, and lands nowhere: an ios-arm64 or
         android-arm64 build matches no RID folder this package has, which is
         why the mobile payloads are separate packages with a targets file
         rather than more runtimes/ entries. -->
    <PackageReference Include="FFAudio.NET.macOS" Version="$(FFAudioPackageVersion)" />
    <!-- The renames, and nothing else - see the script's header. The SDK turns
         these into global usings, so every existing call site compiles as it
         stands and the switch leaves no diff behind. -->
    <Using Include="FFAudio.Decoder" Alias="FfmpegDecoder" />
    <Using Include="FFAudio.SampleFormat" Alias="FfmpegSampleFormat" />
    <Using Include="FFAudio.AudioFormat" Alias="FfmpegAudioFormat" />
    <Using Include="FFAudio.DecodeException" Alias="FfmpegDecodeException" />
  </ItemGroup>

  <!-- DefaultItemExcludes rather than <Compile Remove>: Directory.Build.props is
       imported before the SDK globs the source tree, so a Remove here would run
       against an empty list and quietly do nothing. FfmpegTrackDecoder stays -
       it is Flower's ITrackDecoder adapter, not part of the façade. -->
  <PropertyGroup Condition="'$(FFAudioPackageVersion)' != '' And '$(MSBuildProjectName)' == 'Flower'">
    <DefaultItemExcludes>$(DefaultItemExcludes);Audio/Ffmpeg/FfmpegDecoder.cs;Audio/Ffmpeg/FfmpegNative.cs</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Named by the local file rather than hardcoded, and absent when no iOS
       payload was built: referencing a package that was never packed fails the
       restore, where falling back to the checked-in framework merely tests
       less. The package's own targets file picks the device or simulator slice
       off the RuntimeIdentifier. -->
  <ItemGroup Condition="'$(FFAudioIosPackage)' != '' And ('$(MSBuildProjectName)' == 'Flower.iOS' Or '$(MSBuildProjectName)' == 'Flower.DeviceChecks.iOS')">
    <PackageReference Include="$(FFAudioIosPackage)" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

</Project>
