<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The whole point of this head. Flower.Desktop is plain net10.0 -
         Avalonia's desktop backend targets it - which puts every Apple
         framework out of reach from the process that runs Flower on macOS.
         net10.0-macos is a superset for package resolution, so Avalonia.Desktop
         and the rest resolve their net10.0 assets unchanged, and AVKit/AppKit
         become reachable on top. See docs/AIRPLAY-BLUETOOTH-PLAN.md Phase 2. -->
    <TargetFramework>net10.0-macos</TargetFramework>
    <!-- AVRoutePickerView is macOS 10.15; 12.0 is the floor Flower already
         needs elsewhere and keeps the analyzer from demanding version guards
         around ordinary modern API. -->
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>Flower.MacOS.Program</StartupObject>

    <!-- Xcode 27 is ahead of the newest .NET for macOS workload (26.5), which
         refuses to build against anything but Xcode 26.6. Nothing in the
         build actually needs 26.6 - with the check off, 27.0 builds this head
         cleanly - so the check is off, rather than every machine keeping an
         old Xcode beside the current one. Delete this once a workload that
         names Xcode 27 is published (`dotnet workload update`). -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <ApplicationTitle>Flower</ApplicationTitle>

    <!-- The bundle is Flower.MacOS.app, named after the assembly rather than
         after ApplicationTitle, so that an IDE can find it.

         .NET 10 changed the rule: the macOS SDK used to name every bundle
         $(AssemblyName), and now names a desktop head's $(ApplicationTitle)
         instead (Xamarin.Shared.props, _AppBundleName). Rider and Visual
         Studio still implement the old one, so they build this head correctly
         and then look for the app under the name it no longer has - "file
         .../Flower.MacOS.app/Contents/MacOS/Flower.MacOS doesn't exist",
         reported as a launch failure on a build that was fine. Pinning the
         property is what makes a fresh clone runnable from the IDE's Run
         button with nothing to configure first.

         It costs nothing user-visible: CFBundleName and CFBundleDisplayName
         are set outright in Info.plist, so the menu bar, the Dock and the
         about box all still say Flower. Only the folder on disk carries the
         head's name - and a distributable build is a packaging step that gets
         to choose its own, rather than whatever bin/ happens to hold. -->
    <_AppBundleName>$(AssemblyName)</_AppBundleName>
    <ApplicationId>com.yanos.flower</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- The managed HTTP stack rather than NSUrlSessionHandler, for the same
         reason Flower.iOS sets it: NSUrlSessionHandler does not support
         ServerCertificateCustomValidationCallback and throws
         PlatformNotSupportedException when one is set, and that callback is
         how PeerHttpClient accepts a self-hosted server's certificate at all. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>

    <!-- IL2104: trim-analysis warnings from third-party dependencies that
         aren't annotated for trimming themselves - same set, and same
         non-fix, as Flower.iOS. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower\Flower.csproj" />
  </ItemGroup>
</Project>
