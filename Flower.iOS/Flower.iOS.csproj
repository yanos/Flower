<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
    <ProvisioningType>automatic</ProvisioningType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>

    <!-- Switch back to these two to run on the Simulator instead of a real iDevice -->
    <!--<ProvisioningType>manual</ProvisioningType>-->
    <!--<RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>-->

    <!-- ApplicationVersion (CFBundleVersion) is a plain, strictly-increasing
         integer that a store release overrides via /p:ApplicationVersion=<n>
         at build time - see VERSIONING-PLAN.md Phase 3. ApplicationDisplayVersion
         (CFBundleShortVersionString) is set dynamically from MinVer's
         $(Version) by the target in Directory.Build.targets, not here - a
         plain property assignment here would freeze at the SDK's static
         default instead of MinVer's computed value. -->
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Names the AppIcon.appiconset in Resources/Assets.xcassets - without this,
         actool silently compiles the asset catalog with no app icon output and no
         build error at all (confirmed by hand: omitting the app icon argument from
         the actool invocation produces no Assets.car). -->
    <AppIcon>AppIcon</AppIcon>

    <!-- IL2104: trim-analysis warnings from third-party dependencies
         (Avalonia.Controls.DataGrid, Avalonia.Diagnostics,
         Avalonia.DesignerSupport, Common.Logging, Serilog, TagLibSharp) that
         aren't annotated for trimming themselves - nothing to fix on our
         side short of dropping the dependency. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.0" />
    <PackageReference Include="VideoLAN.LibVLC.iOS" Version="3.6.1" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower\Flower.csproj" />
  </ItemGroup>

  <!-- Self-built dynamic frameworks (native/miniaudio/ios/build.sh), not
       from a NuGet package - Miniaudio-CS only ships desktop native
       binaries (see MiniaudioSink.cs). Named miniaudio so Miniaudio-CS's
       own DllImport("miniaudio") bindings resolve it with no custom
       DllImportResolver needed.

       Two plain per-platform framework folders, not a combined
       .xcframework: confirmed via a real build that <NativeReference>
       pointing at a .xcframework silently resolves the MSBuild item but
       never actually embeds anything in the app bundle (no error, no
       warning - just missing at runtime). Mirrors VideoLAN.LibVLC.iOS's
       own proven ios-device/ios-simulator NativeReference pattern
       (~/.nuget/packages/videolan.libvlc.ios/*/build/VideoLAN.LibVLC.iOS.targets)
       instead, conditioned the same way. -->
  <ItemGroup Condition="('$(Platform)' == 'iPhoneSimulator') OR $(RuntimeIdentifier.StartsWith('iossimulator'))">
    <NativeReference Include="Frameworks\ios-simulator\miniaudio.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="('$(Platform)' == 'iPhone') OR ('$(RuntimeIdentifier)' == 'ios') OR $(RuntimeIdentifier.StartsWith('ios-')) OR $(RuntimeIdentifier.StartsWith('ios.'))">
    <NativeReference Include="Frameworks\ios-device\miniaudio.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
</Project>
