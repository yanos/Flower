<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Avalonia's Skia renderer needs libSkiaSharp/libHarfBuzzSharp statically
         linked into the WASM bundle - without this, SkiaSharp's native P/Invokes
         just throw DllNotFoundException at first use (SKImageInfo's static
         constructor), which is exactly what an unset WasmBuildNative produces
         (see the "@(NativeFileReference) is not empty... won't be linked in"
         build warning). Requires the wasm-tools SDK workload's native toolchain
         (Emscripten) to actually build, not just restore. -->
    <WasmBuildNative>true</WasmBuildNative>

    <!-- WASM0001: the native build lists every P/Invoke in every assembly,
         called or not, and warns about the ones WASM cannot make: SQLite's
         varargs sqlite3_config/sqlite3_db_config, and miniaudio's job_init.
         Neither is called here. Microsoft.Data.Sqlite calls
         sqlite3_db_config only to load an extension, which Flower never does,
         and nothing calls job_init. -->
    <NoWarn>$(NoWarn);WASM0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower\Flower.csproj" />
  </ItemGroup>

  <!-- The symbols the app's own chrome uses and Inter does not carry (the ♫ on
       the album art placeholder), bundled so they draw from the first frame.
       The larger CJK and emoji fonts are not bundled: they are served from
       wwwroot/fonts and fetched by script - see BrowserFonts. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\NotoSansSymbols-Regular.ttf" />
  </ItemGroup>
</Project>
