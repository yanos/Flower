<Project Sdk="Microsoft.NET.Sdk">

  <!-- A test runner, not an app. It launches, runs Flower.Tests.Decoding.Scenarios
       against the real iOS runtime, prints one line per check and a final
       tally, and stays on screen with the same text so a run on a physical
       device is readable without a cable. scripts/ios-decoding-tests.sh drives
       it on a simulator and turns the tally into an exit code.

       No Avalonia, no audio output, no UI framework beyond a UILabel: what is
       under test is decoding and the HTTP path beneath it, and every
       dependency this does not have is one that cannot explain a failure. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios27.0</TargetFramework>
    <!-- Flower.iOS's floor, which the workload sets - and past iOS 13, where
         the scene lifecycle this runner adopts starts. -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Simulator by default, unlike Flower.iOS: this is run far more often
         from a script on this machine than from a device, and a simulator
         build needs no signing. A device run is `-r ios-arm64`. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
    <ProvisioningType Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">automatic</ProvisioningType>
    <ProvisioningType Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">manual</ProvisioningType>

    <!-- The same choice Flower.iOS makes, and it has to be the same one:
         NSUrlSessionHandler cannot do the certificate pinning PeerHttpClient
         relies on. Checking the streaming path against a different HTTP stack
         than the app ships would make a passing run mean nothing. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>

    <ApplicationVersion>1</ApplicationVersion>
    <NoWarn>$(NoWarn);IL2104</NoWarn>

    <!-- NativeAOT, as Flower.iOS ships it - see FlowerNativeAot there, and
         scripts/ios-decoding-tests.sh, which builds this way by default. -->
    <PublishAot Condition="'$(FlowerNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <!-- The façade's P/Invokes compiled as direct calls, as Flower.iOS's are:
       under NativeAOT the lookup by name that would otherwise find it does
       not look inside Frameworks/. -->
  <ItemGroup Condition="'$(FlowerNativeAot)' == 'true'">
    <DirectPInvoke Include="ffaudio" />
  </ItemGroup>

  <!-- The shell shared with Flower.Tests.iOS: the transcript contract, and
       the scene delegate iOS 27 requires. -->
  <ItemGroup>
    <Compile Include="..\iOSRunner\*.cs" Link="iOSRunner\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower.Tests.Decoding.Scenarios\Flower.Tests.Decoding.Scenarios.csproj" />
  </ItemGroup>

  <!-- The same FFAudio.NET.iOS payload Flower.iOS ships: a runner checking a
       different binary would be checking the wrong thing. Without it
       AvailableDecoders finds nothing loadable and every check is skipped.

       No miniaudio here: this runner decodes and never plays. -->
  <ItemGroup>
    <PackageReference Include="FFAudio.NET.iOS" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

</Project>
