<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Flower Tests</string>
	<key>CFBundleIdentifier</key>
	<string>com.yanos.flower.tests</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- The tests talk to loopback servers this app starts itself. That is
	     still the local network as far as iOS is concerned. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>The tests talk to servers running inside this app.</string>
	<!-- Plain http, to loopback only: the fake servers the streaming tests
	     start have no certificate. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The scene lifecycle, which iOS 27 enforces - see RunnerSceneDelegate. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>RunnerSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
