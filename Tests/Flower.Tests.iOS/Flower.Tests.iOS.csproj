<Project Sdk="Microsoft.NET.Sdk">

  <!-- The existing Mono runner, with the same settings and native libraries.
       Flower.Tests.iOS.Suite combines the shared/UI/decoding test sources into
       one assembly so the process keeps one headless dispatcher and one set
       of assembly-wide safety guards. No tests are copied or forked.
       scripts/ios-tests.sh drives it on a simulator. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios27.0</TargetFramework>
    <!-- Flower.iOS's floor, which the workload sets - and past iOS 13, where
         the scene lifecycle this runner adopts starts. -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Simulator by default, like Flower.Tests.Decoding.iOS: run far more often
         from a script than from a device, and a simulator build needs no
         signing. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
    <ProvisioningType Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">automatic</ProvisioningType>
    <ProvisioningType Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">manual</ProvisioningType>

    <!-- The HTTP stack Flower.iOS ships, and it has to be: the streaming tests
         would otherwise check a handler the app never uses. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>

    <ApplicationVersion>1</ApplicationVersion>
    <NoWarn>$(NoWarn);IL2104</NoWarn>

    <!-- Flower.Tests is an executable (xunit v3 test projects are) that is not
         self-contained, and the SDK refuses to let a self-contained app
         reference one. Only its assembly is wanted, never its app host. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>

    <!-- The framework trimmed, everything else kept whole. xunit finds tests
         by reflection the linker cannot see, and SdkOnly never touches
         Flower.Tests, xunit, Flower or Avalonia - only the BCL and the iOS
         bindings, trimmed to what those reference. It is the difference
         between an optimized build that takes six minutes and one that takes
         half an hour on an Apple Silicon Mac and over two hours on a CI
         runner: with nothing linked away, LLVM compiled the whole BCL. The
         suite passes either way; the app ships trimmed too. -->
    <MtouchLink>SdkOnly</MtouchLink>

    <!-- Compiled ahead of time by Mono's own code generator rather than
         LLVM's, which a Release build otherwise uses. Still every method
         compiled ahead of time, with no JIT, on the same Mono runtime - what
         is given up is LLVM's optimizer, and this app is not what ships: the
         app ships on NativeAOT, and the suite runs on Mono only because it
         cannot run there yet. LLVM was nine tenths of the build: six and a
         half minutes on an Apple Silicon Mac against one, and 23 to 57 on a
         CI runner's three cores, mostly spent on the one object that holds
         every assembly's generic instances (aot-instances.dll). -->
    <MtouchUseLlvm>false</MtouchUseLlvm>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\iOSRunner\*.cs" Link="iOSRunner\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower.Tests.iOS.Suite\Flower.Tests.iOS.Suite.csproj" />

    <!-- Flows in from Flower.Tests with buildTransitive targets that demand an
         app host and generate a Main of their own, which collides with this
         one. The assemblies are wanted; the targets are not. -->
    <PackageReference Include="xunit.v3.core.mtp-off" Version="3.2.2" ExcludeAssets="buildTransitive" />

    <!-- The VSTest host and adapter `dotnet test` drives Flower.Tests through.
         This app runs xunit in-process and never loads them, and
         Microsoft.VisualStudio.TestPlatform.Common does not AOT-compile - it
         references a DoesNotReturnAttribute in an assembly that has none. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="18.8.1" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="18.8.1" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.CodeCoverage" Version="18.8.1" ExcludeAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" ExcludeAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" ExcludeAssets="all" />

    <!-- The iOS builds of the native libraries Flower.iOS ships, which the
         desktop suite reaches through host packages: the ffaudio façade, and
         Skia for the Avalonia.Headless tests. -->
    <PackageReference Include="FFAudio.NET.iOS" Version="$(FFAudioPackageVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" Version="3.119.4" />
  </ItemGroup>

  <!-- And miniaudio, from where Flower.iOS ships it - see that project for why
       these are two framework folders rather than one .xcframework. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">
    <NativeReference Include="..\..\Flower.iOS\Frameworks\ios-simulator\miniaudio.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('ios-'))">
    <NativeReference Include="..\..\Flower.iOS\Frameworks\ios-device\miniaudio.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

</Project>
