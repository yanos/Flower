<Project Sdk="Microsoft.NET.Sdk">

  <!-- A test runner, not an app. It launches, runs Flower.Tests.Decoding.Scenarios
       against the real Android runtime, writes one line per check and a final
       tally, and leaves the same text on screen so a run on a physical phone
       is readable without a cable. scripts/android-decoding-tests.sh drives it
       on an emulator and turns the tally into an exit code.

       The counterpart of Flower.Tests.Decoding.iOS, and deliberately its twin:
       the two runs are only worth comparing if the only difference between
       them is the platform. No Avalonia, no audio output, no UI beyond a
       TextView - what is under test is decoding and the HTTP path beneath it,
       plus the native output stage (NativeOutputStageChecks), and every
       dependency this does not have is one that cannot explain a failure. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ApplicationId>com.yanos.flower.decodingtests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>

    <!-- Fast Deployment off, in every configuration. It keeps the managed
         assemblies out of the APK and pushes them over adb as a separate
         step, which `dotnet build -t:Run` does and `adb install` does not -
         so a hand-installed Debug APK aborts at startup with "No assemblies
         found ... Assuming this is part of Fast Deployment". The driver
         script installs the APK itself, deliberately, so that what runs is
         the artifact rather than a developer's working tree. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower.Tests.Decoding.Scenarios\Flower.Tests.Decoding.Scenarios.csproj" />
  </ItemGroup>

  <!-- The libminiaudio.so and libflowerbridge.so Flower.Android ships: this
       runner never opens a device, but NativeOutputStageChecks calls the
       bridge's render callback directly to hold it to OutputStage. The ABI
       is read off each file's directory.

       And not the package's own: Flower.Tests.Decoding.Scenarios reaches
       Miniaudio-CS transitively, and .NET's RID graph treats android-* as
       falling back to linux-*, so restore is happy to drop its desktop
       libminiaudio.so into the APK's arm64-v8a slot - a glibc binary in a
       Bionic process, and a clash with the real one. Flower.Android carries
       the same exclusion for the same reason, with the fuller story. -->
  <ItemGroup>
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" ExcludeAssets="native" />
    <AndroidNativeLibrary Include="..\..\Flower.Android\libs\*\libminiaudio.so" />
    <AndroidNativeLibrary Include="..\..\Flower.Android\libs\*\libflowerbridge.so" />
  </ItemGroup>

  <!-- The same FFAudio.NET.Android payload Flower.Android ships: a runner
       checking a different binary would be checking the wrong thing. Without
       it AvailableDecoders finds nothing loadable, and FLOWER_REQUIRE_DECODERS
       is what turns that into a failure rather than a green run of no checks.
       The package carries all three ABIs, because which one is exercised is a
       property of the hardware: arm64-v8a on Apple silicon, x86_64 on a CI
       runner. -->
  <ItemGroup>
    <PackageReference Include="FFAudio.NET.Android" Version="$(FFAudioPackageVersion)" />
  </ItemGroup>

  <!-- And not the host's desktop payload, which arrives through Flower.csproj
       and on a Linux runner would take lib/x86_64/ from the one above (XA4301).
       Flower.Android carries the same exclusion, with the fuller story. -->
  <ItemGroup>
    <PackageReference Include="FFAudio.NET.macOS" Version="$(FFAudioPackageVersion)" ExcludeAssets="native" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="FFAudio.NET.Linux" Version="$(FFAudioPackageVersion)" ExcludeAssets="native" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="FFAudio.NET.Windows" Version="$(FFAudioPackageVersion)" ExcludeAssets="native" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
