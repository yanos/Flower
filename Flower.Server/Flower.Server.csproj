<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Deliberately NOT InvariantGlobalization. Invariant mode removes Unicode
         normalization, and it removes it silently: string.Normalize becomes a
         no-op that returns its input while IsNormalized reports success. That
         quietly killed ITunesLocations.NormalizePath, whose whole job is
         matching a decomposed path from the Music.app XML against the
         precomposed one read off disk - see its comment for the real file that
         proved it necessary. ICU is present by default on macOS, Windows and
         glibc Linux; a musl container needs icu-libs. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- No EF Core, and no SQLite package reference of its own: Microsoft.Data.Sqlite
         comes through Flower.Core, which owns the schema and the connection. See
         Flower.Core/Persistence/Sql/FlowerDb.cs for why EF Core was dropped. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flower.Core\Flower.Core.csproj" />
    <!-- Vibe Playlists' encoders (docs/VIBE-PLAYLIST-PLAN.md): the server runs
         the engine for every device paired to it. -->
    <ProjectReference Include="..\Flower.SemanticAudio.Onnx\Flower.SemanticAudio.Onnx.csproj" />
  </ItemGroup>

  <!-- The licences as plain files beside Flower.Server.dll, where someone
       looking inside a Docker image or a copied publish folder will find
       them: the server ships FFmpeg (inside libffaudio.so) and TagLib#, both
       LGPL. The same texts are embedded in Flower.Core.dll, which the server
       serves at /licences (WebUiHosting). -->
  <ItemGroup>
    <None Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\licenses\LGPL-2.1.txt" Link="licenses\LGPL-2.1.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- ONNX Runtime's package carries its phone builds too (an iOS
       xcframework and an Android aar, 110 MB between them), which a
       framework-dependent publish would copy into runtimes/ and so into
       every Docker image. No server runs on a phone. -->
  <Target Name="DropPhoneOnnxRuntime" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime' And ('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'ios' Or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'android')" />
    </ItemGroup>
  </Target>

  <!-- FFAudio's native library, which the server never needed before Vibe
       Playlists: it streams files as they are and decodes nothing, but
       analysing a song means hearing it. Chosen by build host as in
       Flower.csproj, and the publish is framework-dependent, so a Docker
       image carries whatever the build stage's OS ships: FFAudio.NET.Linux is
       linux-x64 only for now, and an arm64 image has no decoder (the engine
       says so on the settings page rather than failing every song). -->
  <ItemGroup>
    <PackageReference Include="FFAudio.NET.macOS" Version="$(FFAudioPackageVersion)" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="FFAudio.NET.Linux" Version="$(FFAudioPackageVersion)" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="FFAudio.NET.Windows" Version="$(FFAudioPackageVersion)" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <!-- Skia, to shrink cover art for a song list's rows (CoverArtThumbnail) -
       the same version Avalonia gives every client. Its own package carries
       the macOS and Windows natives; Linux's comes separately, and as the
       NoDependencies build, because the regular one links fontconfig, which
       the aspnet runtime image does not have and a server drawing no text
       does not need. -->
  <ItemGroup>
    <PackageReference Include="Sentry.AspNetCore" Version="6.13.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <!-- Those packages carry a libSkiaSharp for every flavour of Linux there is
       (musl, bionic, riscv, loongarch...) plus Windows and macOS, about 200 MB,
       which a framework-dependent publish copies into every Docker image. Only
       the build host's OS is kept, as FFAudio is chosen above: the image is
       built on Linux, and keeps linux-x64 and linux-arm64 for its two
       architectures. -->
  <PropertyGroup>
    <KeptSkiaRuntimes Condition="$([MSBuild]::IsOSPlatform('OSX'))">;osx;</KeptSkiaRuntimes>
    <KeptSkiaRuntimes Condition="$([MSBuild]::IsOSPlatform('Linux'))">;linux-x64;linux-arm64;</KeptSkiaRuntimes>
    <KeptSkiaRuntimes Condition="$([MSBuild]::IsOSPlatform('Windows'))">;win-x64;win-arm64;</KeptSkiaRuntimes>
  </PropertyGroup>
  <Target Name="KeepHostSkiaRuntimes" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('SkiaSharp.NativeAssets')) And !$(KeptSkiaRuntimes.Contains(';%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier);'))" />
    </ItemGroup>
  </Target>

  <!-- ── The browser UI ──────────────────────────────────────────────────────

       Flower.Web (an Avalonia WebAssembly build of the same Views and
       ViewModels the desktop app runs) is built and dropped in beside this
       server's binary, so that starting the server is all it takes to have the
       settings page served - see WebUiHosting, which finds it at
       AppContext.BaseDirectory/wwwroot with no configuration at all.

       Deliberately NOT a ProjectReference. Flower.Web cannot be *built* without
       the wasm-tools workload's Emscripten toolchain (WasmBuildNative=true;
       without it Avalonia's Skia renderer throws DllNotFoundException on first
       paint), and this server is the one head that has to compile on a headless
       box or in a minimal container image. A reference would make that
       impossible; this instead builds the bundle when the toolchain is present
       and skips it silently when it is not, in which case the server serves a
       short page explaining how to deploy one. Pass -p:IncludeWebUi=false to
       skip it even where the toolchain exists.

       It runs as a separate `dotnet publish` rather than an <MSBuild> task on
       purpose: the WASM bundle is only fully assembled by Publish (a plain
       build leaves wwwroot without index.html), and nesting a publish inside a
       build in the same MSBuild node is a well-known way to get very confusing
       failures. Incremental, it costs about four seconds. -->
  <PropertyGroup>
    <FlowerWebUiDir>$(MSBuildThisFileDirectory)../Flower.Web/bin/$(Configuration)/net10.0-browser/publish/wwwroot/</FlowerWebUiDir>
  </PropertyGroup>

  <!-- The toolchain probe has to happen at execution time, not evaluation time:
       NetCoreTargetingPackRoot is set by the SDK targets imported *after* this
       file's body, so a PropertyGroup condition up here would always see it
       empty and decide the workload is missing.

       None of these three targets carries a Condition of its own, because
       MSBuild evaluates a target's Condition *before* running its
       DependsOnTargets - so a condition on _BuildFlowerWebUi out here would
       skip the very target that computes it. The conditions go on the tasks. -->
  <Target Name="ResolveFlowerWebUi">
    <ItemGroup>
      <!-- Emscripten, not the WebAssembly SDK: the SDK alone would let
           Flower.Web restore and then fail in the native link step, which is
           the failure this probe exists to avoid. Globbed rather than tested
           with Exists() because the pack path carries the Emscripten version,
           the RID and the SDK band, none of which are known here. -->
      <_EmscriptenPack Include="$(NetCoreTargetingPackRoot)/Microsoft.NET.Runtime.Emscripten.*.Sdk.*/*/*.nuspec" />
    </ItemGroup>
    <PropertyGroup>
      <_BuildFlowerWebUi Condition="'$(IncludeWebUi)' != 'false' And '@(_EmscriptenPack)' != ''">true</_BuildFlowerWebUi>
    </PropertyGroup>
    <Message Importance="normal" Condition="'$(_BuildFlowerWebUi)' != 'true'"
             Text="Skipping the browser UI. The server will serve its not-deployed page instead." />
    <Exec Condition="'$(_BuildFlowerWebUi)' == 'true'"
          Command="dotnet publish &quot;$(MSBuildThisFileDirectory)../Flower.Web/Flower.Web.csproj&quot; -c $(Configuration) --nologo -v quiet" />
  </Target>

  <Target Name="CopyFlowerWebUiToOutput" AfterTargets="Build" DependsOnTargets="ResolveFlowerWebUi">
    <ItemGroup>
      <!-- The .br/.gz siblings are dead weight here: nothing in the pipeline
           negotiates content encoding, so UseStaticFiles would only ever serve
           the plain file. Dropping them takes the bundle from ~49 MB to ~17. -->
      <FlowerWebUiFile Include="$(FlowerWebUiDir)**/*" Exclude="$(FlowerWebUiDir)**/*.br;$(FlowerWebUiDir)**/*.gz" />
    </ItemGroup>
    <Copy Condition="'$(_BuildFlowerWebUi)' == 'true'" SourceFiles="@(FlowerWebUiFile)" SkipUnchangedFiles="true"
          DestinationFiles="@(FlowerWebUiFile->'$(OutDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- So that `dotnet publish Flower.Server` alone produces a deployable server
       with its web UI already in it, rather than needing the copy step by hand. -->
  <Target Name="CopyFlowerWebUiToPublishDir" AfterTargets="Publish" DependsOnTargets="ResolveFlowerWebUi">
    <ItemGroup>
      <!-- The .br/.gz siblings are dead weight here: nothing in the pipeline
           negotiates content encoding, so UseStaticFiles would only ever serve
           the plain file. Dropping them takes the bundle from ~49 MB to ~17. -->
      <FlowerWebUiFile Include="$(FlowerWebUiDir)**/*" Exclude="$(FlowerWebUiDir)**/*.br;$(FlowerWebUiDir)**/*.gz" />
    </ItemGroup>
    <Copy Condition="'$(_BuildFlowerWebUi)' == 'true'" SourceFiles="@(FlowerWebUiFile)" SkipUnchangedFiles="true"
          DestinationFiles="@(FlowerWebUiFile->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
