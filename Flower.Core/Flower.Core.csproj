<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same arrangement as Flower.csproj: a handful of tuning constants are
         internal rather than const so a test can shorten them (see
         SmartPlaylistRefresher.Cooldown). -->
    <InternalsVisibleTo Include="Flower.Tests" />
    <InternalsVisibleTo Include="Flower.Tests.UI" />
    <InternalsVisibleTo Include="Flower.Tests.Decoding" />
    <InternalsVisibleTo Include="Flower.Tests.macOS" />
    <InternalsVisibleTo Include="Flower.Tests.Windows" />
    <InternalsVisibleTo Include="Flower.Tests.iOS.Suite" />
    <InternalsVisibleTo Include="Flower.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="plist-cil" Version="2.3.1" />
    <PackageReference Include="Sentry" Version="6.13.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- Vibe Playlists' engine (SemanticAudio/, docs/VIBE-PLAYLIST-PLAN.md).
       FFAudio.NET's managed decoder API only: Flower.csproj picks its native
       payload by host, and a head that hosts the engine without Flower brings
       its own. ONNX Runtime is deliberately not here but in
       Flower.SemanticAudio.Onnx - see that project file for why. -->
  <ItemGroup>
    <PackageReference Include="FFAudio.NET" Version="$(FFAudioPackageVersion)" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.14" />
  </ItemGroup>

  <!-- The licences, inside every build of every head and the server - a
       phone app has no folder beside it to carry them in, and FFmpeg's LGPL
       asks for its text to go with each copy. Read by OpenSourceNotices;
       shown by OpenSourceLicencesWindow, the phone's Settings and the
       server's /licences. -->
  <ItemGroup>
    <EmbeddedResource Include="..\NOTICE" LogicalName="Flower.Licences.NOTICE" Visible="false" />
    <EmbeddedResource Include="..\licenses\LGPL-2.1.txt" LogicalName="Flower.Licences.LGPL-2.1" Visible="false" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="Flower.Licences.Apache-2.0" Visible="false" />
  </ItemGroup>
</Project>
