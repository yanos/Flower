<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaPackageVersion>12.1.5</AvaloniaPackageVersion>
    <SkiaSharpPackageVersion>3.119.4</SkiaSharpPackageVersion>
    <DotNetPackageVersion>10.0.14</DotNetPackageVersion>
    <TestPlatformPackageVersion>18.11.0</TestPlatformPackageVersion>
    <XunitPackageVersion>3.2.2</XunitPackageVersion>
  </PropertyGroup>
