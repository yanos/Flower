    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(TestPlatformPackageVersion)" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="$(TestPlatformPackageVersion)" />
