    <PackageVersion Include="System.Diagnostics.EventLog" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="System.Numerics.Tensors" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />
