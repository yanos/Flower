<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:controls="clr-namespace:Flower.Controls"
        x:Class="Flower.Views.TrackInfoWindow"
        Title="Track Info"
        Width="659"
        Height="691"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.45"/>
      <Setter Property="Margin" Value="0,4,0,7"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <!-- The label beside a read-only value, as opposed to one beside an
         editable box. Same as .lbl but without its 4px top margin: that margin
         exists to push a label down past a TextBox's border and padding so the
         two baselines line up, and against a plain TextBlock value - which has
         neither - it pushed the label 4px *below* the text it names instead.
         Every row in the Technical tab, and the two in Listening, is that
         second kind. -->
    <Style Selector="TextBlock.roLbl">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.45"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="MinWidth" Value="120"/>
    </Style>
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
      <Setter Property="Opacity" Value="0.4"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBox.val">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MinWidth" Value="150"/>
    </Style>
    <Style Selector="TextBox.numVal">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Width" Value="50"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Parallel to TextBox.val above - AutoCompleteBox doesn't inherit from
         TextBox, so that selector doesn't match it, and its own template has
         no TextWrapping to set (single-line entry is fine for the three
         fields this backs: Artist/Album/Album Artist - see
         TrackInfoWindow.axaml.cs's PopulateSuggestions). Padding/MinHeight
         are set on the templated PART_TextBox inside it, not on the outer
         AutoCompleteBox itself - the outer control has its own default
         Padding too, so setting it there as well stacked both paddings and
         rendered visibly taller than the plain TextBox.val fields beside it. -->
    <Style Selector="AutoCompleteBox.val">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="MinWidth" Value="150"/>
      <Setter Property="FilterMode" Value="Contains"/>
      <Setter Property="MinimumPrefixLength" Value="1"/>
    </Style>
    <Style Selector="AutoCompleteBox.val /template/ TextBox#PART_TextBox">
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <!-- Suggestion dropdown rows - same "Fluent's default list-item chrome is
         roomier than this compact form needs" issue as PART_TextBox above,
         just for the popup's ListBoxItem containers instead. Avalonia resolves
         style scope for AutoCompleteBox's popup content against its logical
         parent, so this reaches in despite the popup rendering on a separate
         surface. -->
    <Style Selector="AutoCompleteBox.val ListBoxItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ── Button bar (always visible at bottom) ── -->
    <Border DockPanel.Dock="Bottom" Padding="24,10,24,16">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Button x:Name="PrevButton" Width="36" Height="32" Padding="4" Click="PrevButton_Click" ToolTip.Tip="Previous track">
            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="20" Height="20"/>
          </Button>
          <Button x:Name="NextButton" Width="36" Height="32" Padding="4" Click="NextButton_Click" ToolTip.Tip="Next track">
            <materialIcons:MaterialIcon Kind="ChevronRight" Width="20" Height="20"/>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="32" IsCancel="True" Click="CancelButton_Click"/>
          <Button x:Name="OkButton"     Content="OK"     Width="80" Height="32" IsDefault="True" Click="OkButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Persistent header: art + read-only title/artist/album display,
         shown above the tabs so it stays visible regardless of which tab is
         selected. This is display-only - the actual editable Title/Artist/
         Album fields live in the Info tab below, alongside everything else. ── -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="24,16,24,0">
      <!-- Fixed 112×112 box; Stretch="Uniform" letterboxes non-square art
           inside it rather than cropping it (AlbumArtView's default
           UniformToFill would crop). MinWidth is a floor for when there's no
           image yet (still loading, or the track has no art at all) so the
           box doesn't collapse to zero width before art loads. Deliberately
           smaller than the header thumbnail it started as: this is a glance-
           level "which track am I editing" cue, and the room it was taking is
           worth more to the field rows below it. The Artwork tab is where the
           art is actually looked at (and replaced) at size. -->
      <controls:AlbumArtView x:Name="AlbumArtView"
              Grid.Column="0"
              Height="112" MinWidth="112" Margin="0,0,16,0"
              Stretch="Uniform"
              DoubleTapped="Artwork_DoubleTapped"/>

      <StackPanel x:Name="TitleStack" Grid.Column="1" VerticalAlignment="Top" Spacing="4">
        <SelectableTextBlock x:Name="TitleDisplay"  FontSize="18" TextWrapping="Wrap"/>
        <SelectableTextBlock x:Name="ArtistDisplay" FontSize="14" Opacity="0.7" TextWrapping="Wrap"/>
        <SelectableTextBlock x:Name="AlbumDisplay"  FontSize="14" Opacity="0.7" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <TabControl Margin="0,8,0,0">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>

      <!-- ── Info (default) ── -->
      <TabItem Header="Info">
        <ScrollViewer>
          <StackPanel Margin="24,16,24,8" Spacing="0">

            <TextBlock Text="GENERAL" Classes="sectionHeader"/>
            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,14">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Title"  Classes="lbl"/>
              <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TitleBox"  Classes="val"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist" Classes="lbl"/>
              <AutoCompleteBox Grid.Row="1" Grid.Column="1" x:Name="ArtistBox" Classes="val"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Album Artist" Classes="lbl"/>
              <AutoCompleteBox Grid.Row="2" Grid.Column="1" x:Name="AlbumArtistBox" Classes="val"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Album"  Classes="lbl"/>
              <AutoCompleteBox Grid.Row="3" Grid.Column="1" x:Name="AlbumBox"  Classes="val"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Composer" Classes="lbl"/>
              <TextBox   Grid.Row="4" Grid.Column="1" x:Name="ComposerBox" Classes="val"/>

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Conductor" Classes="lbl"/>
              <TextBox   Grid.Row="5" Grid.Column="1" x:Name="ConductorBox" Classes="val"/>

              <TextBlock Grid.Row="6" Grid.Column="0" Text="Remixed By" Classes="lbl"/>
              <TextBox   Grid.Row="6" Grid.Column="1" x:Name="RemixedByBox" Classes="val"/>
            </Grid>

            <TextBlock Text="ALBUM" Classes="sectionHeader"/>
            <Grid ColumnDefinitions="*,24,*" Margin="0,0,0,14">
              <Grid Grid.Column="0" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Track" Classes="lbl"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,4">
                  <TextBox x:Name="TrackNumBox"   Classes="numVal"/>
                  <TextBlock Text=" / " VerticalAlignment="Center" Opacity="0.45" FontSize="12" Margin="4,0"/>
                  <TextBox x:Name="TrackTotalBox" Classes="numVal"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Disc" Classes="lbl"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,4">
                  <TextBox x:Name="DiscNumBox"    Classes="numVal"/>
                  <TextBlock Text=" / " VerticalAlignment="Center" Opacity="0.45" FontSize="12" Margin="4,0"/>
                  <TextBox x:Name="DiscTotalBox"  Classes="numVal"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Year"  Classes="lbl"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="YearBox"  Classes="val"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Genre" Classes="lbl"/>
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="GenreBox" Classes="val"/>
              </Grid>

              <Grid Grid.Column="2" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="BPM"      Classes="lbl"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BpmBox"      Classes="val"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Key"      Classes="lbl"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="KeyBox"      Classes="val"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Grouping" Classes="lbl"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="GroupingBox" Classes="val"/>
              </Grid>
            </Grid>

            <!-- ── Listening ──
                 The only two fields in this window that are not tags: they are
                 Flower's own record of what has been listened to, kept per
                 track in the library rather than in the file (see Track's
                 "Stats" region). Which is also why the star writes immediately
                 instead of waiting for OK, like the artwork and unlike every
                 field above it - there is no tag write to batch it with. -->
            <TextBlock Text="LISTENING" Classes="sectionHeader"/>
            <Grid ColumnDefinitions="*,24,*" Margin="0,0,0,14">
              <Grid Grid.Column="0" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Play Count" Classes="roLbl"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PlayCountValue" Classes="val"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Last played" Classes="roLbl"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastPlayedValue" Classes="val"/>
              </Grid>

              <Grid Grid.Column="2" ColumnDefinitions="90,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rating" Classes="lbl"/>
                <Button Grid.Row="0" Grid.Column="1" x:Name="StarButton"
                        Background="Transparent" BorderThickness="0"
                        Padding="0,0,6,0" Margin="0,-2,0,4"
                        HorizontalAlignment="Left" Click="StarButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon x:Name="StarIcon" Kind="StarOutline"
                                                Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StarText" FontSize="12" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Descriptions ── -->
      <TabItem Header="Descriptions">
        <ScrollViewer>
          <StackPanel Margin="24,16,24,8" Spacing="0">
            <Grid ColumnDefinitions="*,24,*" Margin="0,0,0,10">
              <Grid Grid.Column="0" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtitle"  Classes="lbl"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="SubtitleBox"  Classes="val"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Publisher" Classes="lbl"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PublisherBox" Classes="val"/>
              </Grid>

              <Grid Grid.Column="2" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Copyright" Classes="lbl"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="CopyrightBox" Classes="val"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="ISRC"      Classes="lbl"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ISRCBox"      Classes="val"/>
              </Grid>
            </Grid>

            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Description" Classes="lbl"/>
              <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DescriptionBox" Classes="val" AcceptsReturn="True" MinHeight="48"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Comment"     Classes="lbl"/>
              <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CommentBox"     Classes="val" AcceptsReturn="True" MinHeight="48"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Lyrics ──
           Its own tab rather than a section at the bottom of Descriptions: it
           is the one field with no natural height, and sharing a scroller with
           six single-line boxes meant it got whatever was left over. Here it
           fills the tab and grows with the window instead. -->
      <TabItem Header="Lyrics">
        <TextBox x:Name="LyricsBox"
                 Margin="24,16,24,8"
                 FontSize="12"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </TabItem>

      <!-- ── Artwork ──
           The art at a size worth looking at, plus the ways to move a picture
           in and out of it: drop a file on it or pick one to replace it, drag
           it off to anywhere that takes a file to get a full-size copy,
           double-click to open it at its own size, Remove to take it out of the
           tag. Every one of those writes straight into the file's own tag -
           there is no pending state here and OK/Cancel do not apply to it,
           which is why the buttons say what they do rather than staging an edit
           like every other field in this window. -->
      <TabItem Header="Artwork">
        <!-- The art takes nine tenths of the free height rather than all of it;
             the last tenth is the empty row below the buttons, which is what
             keeps this tab's button row from sitting flush against the window's
             own OK/Cancel row underneath it. -->
        <Grid Margin="24,12,24,8" RowDefinitions="9*,Auto,Auto,1*">
          <!-- Background is what makes the whole framed area a drop target:
               a Border with no painted background doesn't hit-test, so
               without it only the art itself would accept a drop and the
               surrounding letterbox margins would silently reject one. -->
          <Border Grid.Row="0"
                  x:Name="ArtDropTarget"
                  Background="Transparent"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10"
                  DoubleTapped="Artwork_DoubleTapped"
                  PointerPressed="ArtDropTarget_PointerPressed"
                  PointerMoved="ArtDropTarget_PointerMoved"
                  PointerReleased="ArtDropTarget_PointerReleased">
            <Panel>
              <controls:AlbumArtView x:Name="ArtworkLargeView" Stretch="Uniform"/>
              <TextBlock x:Name="ArtDropHint"
                         Text="Drop an image here"
                         FontSize="12"
                         Opacity="0.6"
                         IsVisible="False"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Panel>
          </Border>

          <TextBlock Grid.Row="1"
                     x:Name="ArtworkInfoText"
                     FontSize="11"
                     Opacity="0.55"
                     Margin="0,8,0,0"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"/>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Center">
            <Button x:Name="ChangeArtButton"  Content="Change…"        Height="30" Padding="12,0" VerticalContentAlignment="Center" Click="ChangeArtButton_Click"/>
            <Button x:Name="RemoveArtButton"  Content="Remove"         Height="30" Padding="12,0" VerticalContentAlignment="Center" Click="RemoveArtButton_Click"/>
            <Button x:Name="OpenArtButton"    Content="Open Full Size" Height="30" Padding="12,0" VerticalContentAlignment="Center" Click="OpenArtButton_Click"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ── Options ──
           Everything about a track that is not a description of it: how it
           should be filed, and how it should behave when it plays.

           Split down the middle by who owns the value, which is also why the
           tab is not uniformly staged-until-OK like Info and Descriptions are.
           Compilation and the four "sort as" fields are tags, written into the
           file when OK is pressed, alongside every other tag edit. Playback
           below them is Flower's own state, kept in the library and not in the
           file - so, exactly like the star on the Info tab, it is written the
           moment it is changed and Cancel does not undo it. -->
      <TabItem Header="Options">
        <ScrollViewer>
          <StackPanel Margin="24,16,24,8" Spacing="0">

            <TextBlock Text="FILING" Classes="sectionHeader"/>

            <!-- The sort tags. Each box overrides what the field beside it in
                 the Info tab sorts under, and nothing else - the track lists
                 still display the real value. Watermarked with that real value
                 so an empty box reads as "sorts as itself" rather than as an
                 empty field. -->
            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,14">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Sort title"    Classes="lbl"/>
              <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TitleSortBox"     Classes="val"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Sort artist"   Classes="lbl"/>
              <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ArtistSortBox"    Classes="val"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Sort album"    Classes="lbl"/>
              <TextBox   Grid.Row="2" Grid.Column="1" x:Name="AlbumSortBox"     Classes="val"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Sort composer" Classes="lbl"/>
              <TextBox   Grid.Row="3" Grid.Column="1" x:Name="ComposerSortBox"  Classes="val"/>
            </Grid>

            <CheckBox x:Name="CompilationBox"
                      Content="Part of a compilation"
                      FontSize="12"
                      MinHeight="0"
                      Margin="0,0,0,10"
                      ToolTip.Tip="Groups this album as one, under Various Artists, even when every track has a different artist."/>

            <TextBlock Text="PLAYBACK" Classes="sectionHeader"/>

            <CheckBox x:Name="RememberPositionBox"
                      FontSize="12"
                      MinHeight="0"
                      Margin="0,0,0,2"
                      IsCheckedChanged="RememberPositionBox_Changed"
                      ToolTip.Tip="Start this track where it was last left off instead of at the beginning - for podcasts, audiobooks and long mixes.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Remember playback position" VerticalAlignment="Center"/>
                <TextBlock x:Name="ResumePositionText" Opacity="0.45" VerticalAlignment="Center"/>
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="IgnoreInShuffleBox"
                      Content="Skip when shuffling"
                      FontSize="12"
                      MinHeight="0"
                      Margin="0,0,0,10"
                      IsCheckedChanged="IgnoreInShuffleBox_Changed"
                      ToolTip.Tip="Shuffle never picks this track. It still plays when the queue reaches it in order."/>

            <Grid ColumnDefinitions="90,*,56" RowDefinitions="Auto">
              <TextBlock Grid.Column="0" Text="Volume" Classes="lbl" Margin="0,6,0,0"/>
              <Slider Grid.Column="1" x:Name="VolumeAdjustmentSlider"
                      Minimum="-100" Maximum="100"
                      TickFrequency="25" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center"
                      ValueChanged="VolumeAdjustmentSlider_Changed"
                      ToolTip.Tip="Shifts the volume while this track plays, and puts it back afterwards - for the one track mastered far quieter or louder than the rest."/>
              <TextBlock Grid.Column="2" x:Name="VolumeAdjustmentText"
                         FontSize="12" Margin="8,0,0,0"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Says why the controls above are greyed out, when they are:
                 a server-only track has no local file to write a tag into. -->
            <TextBlock x:Name="OptionsUnavailableText"
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                       Margin="0,12,0,0" IsVisible="False"/>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Technical ── -->
      <TabItem Header="Technical">
        <StackPanel Margin="24,16,24,4" Spacing="0">
          <Grid ColumnDefinitions="*,24,*" Margin="0,0,0,10">
            <Grid Grid.Column="0" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Duration"    Classes="roLbl"/>
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DurationValue"   Classes="val"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Codec"       Classes="roLbl"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CodecValue"      Classes="val"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Bit Rate"    Classes="roLbl"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BitrateValue"    Classes="val"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Sample Rate" Classes="roLbl"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SampleRateValue" Classes="val"/>
            </Grid>

            <Grid Grid.Column="2" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Channels"  Classes="roLbl"/>
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ChannelsValue" Classes="val"/>

              <!-- "—" for a lossy stream (mp3/aac - most of a typical
                   library), which has no bit depth to report; lossless files
                   (FLAC/WAV/ALAC) fill it in - see
                   AudioTechnicalProperties.BitsPerSampleOf. The row stays put
                   either way: a field that disappears when it has nothing to
                   say cannot be told apart from one that does not exist. -->
              <TextBlock Grid.Row="1" Grid.Column="0" x:Name="BitDepthLabel" Text="Bit Depth" Classes="roLbl"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BitDepthValue" Classes="val"/>

              <!-- The encoder's own record of how it was told to encode -
                   "LAME 3.100, VBR (V0)". Only an MP3 carries this, so
                   everything else reads "—", same as Bit Depth above. See
                   EncodingProfile. -->
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Encoding" Classes="roLbl"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EncodingValue" Classes="val"/>
            </Grid>
          </Grid>

          <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="FileLabel" Text="File" Classes="roLbl"/>
            <SelectableTextBlock Grid.Row="0" Grid.Column="1" x:Name="PathValue" Classes="val" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
            <!-- Shown in PathValue's place for a track that only exists on the
                 paired server (Path == null): there is no local file to name,
                 and the honest answer to "where is this" is the server's own
                 sidebar identity - same Server glyph and alias the sidebar row
                 uses - rather than the "—" that stood here. -->
            <StackPanel Grid.Row="0" Grid.Column="1" x:Name="ServerSourcePanel"
                        Orientation="Horizontal" Spacing="6" IsVisible="False"
                        VerticalAlignment="Top" Margin="0,0,0,7">
              <materialIcons:MaterialIcon Kind="Server" Width="14" Height="14" Opacity="0.6" VerticalAlignment="Center"/>
              <TextBlock x:Name="ServerSourceName" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date Added" Classes="roLbl"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DateAddedValue" Classes="val"/>
          </Grid>
        </StackPanel>
      </TabItem>

    </TabControl>

  </DockPanel>
</Window>
