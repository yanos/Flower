<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Flower.ViewModels"
        xmlns:views="using:Flower.Views"
        x:Class="Flower.Views.LogWindow"
        x:DataType="vm:LogViewModel"
        Title="Log"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">
  <!-- This device's own log and nothing else. The same viewer, pointed at
       every device instead, is on the server's settings screen - see
       SettingsPanel's Logs tab. -->
  <views:LogViewer/>
</Window>
