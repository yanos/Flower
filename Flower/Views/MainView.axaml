<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:usercontrols="clr-namespace:Flower.UserControls"
             xmlns:views="clr-namespace:Flower.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:services="clr-namespace:Flower.Services;assembly=Flower.Core"
             xmlns:conv="clr-namespace:Flower.Converters"
             mc:Ignorable="d"
             x:Class="Flower.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid>

    <!-- The window: the player bar across its whole width - at the top, or at
         the bottom with the playback controls there (AppSettings.
         PlaybackControlsPlacement) - and between, the sidebar and beside it
         the page, with the status bar coming up over its foot when there is
         something to say. Which row the player bar takes is set by the styles
         below rather than on the element, because a value set on an element
         outranks any style. -->
    <Grid x:Name="ContentGrid"
          RowDefinitions="Auto,*,Auto"
          Classes.controlsAtBottom="{Binding PlaybackControlsAtBottom}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="170" MaxWidth="320"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.Styles>
        <Style Selector="Grid#ContentGrid > Border#PlayerBar">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Grid#ContentGrid.controlsAtBottom > Border#PlayerBar">
          <Setter Property="Grid.Row" Value="2"/>
          <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
      </Grid.Styles>

      <!-- Player bar, across the whole window over or under the sidebar and
           the page: what is playing at the left, the transport in the middle
           - the middle of the window, since the halves either side are equal
           - and the volume and output at the right. -->
      <Border x:Name="PlayerBar"
              Grid.ColumnSpan="3"
              Padding="16,8,16,8"
              BorderBrush="{DynamicResource AppDividerBrush}">
        <Grid ColumnDefinitions="*,Auto,*">
          <usercontrols:CurrentlyPlayingControl
            Grid.Column="0"
            DataContext="{Binding NowPlaying}"
            Margin="0,0,128,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"/>

          <usercontrols:PlaylistControls
            x:Name="PlaybackControls"
            Grid.Column="1"
            DataContext="{Binding PlaybackControls}"
            VerticalAlignment="Center"/>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="6"
                      Margin="24,0,0,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <usercontrols:VolumeControl
              DataContext="{Binding Volume}"
              VerticalAlignment="Center"
              Height="24"
              Width="240" />
            <usercontrols:OutputDeviceControl
              DataContext="{Binding OutputDevice}"
              Margin="12,0,0,0"
              VerticalAlignment="Center" />
            <!-- Apple's own AirPlay route button, hosted natively, and nothing
                 at all on platforms with no such control (see RoutePickerControl)
                 - which today is everything but the Flower.MacOS head. It sits
                 beside OutputDeviceControl rather than replacing it: that one
                 lists the CoreAudio devices miniaudio can render to, this one
                 reaches AirPlay receivers that are not devices at all. Sized
                 here because a NativeControlHost has no intrinsic size of its
                 own to measure. -->
            <usercontrols:RoutePickerControl
              Width="28" Height="28"
              VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar: the library, playlists and server under small capital
           headings. Its own tint (AppSidebarBrush) sets it apart from the
           page instead of a rule down its edge. -->
      <Border x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Background="{DynamicResource AppSidebarBrush}">
        <DockPanel>
        <Panel>
          <ListBox x:Name="SidebarList"
                   Classes="sidebar"
                   ItemsSource="{Binding SidebarItems}"
                   SelectedItem="{Binding SelectedSidebarItem, Mode=TwoWay}"
                   SelectionMode="Multiple"
                   Background="Transparent"
                   Padding="0,12,0,8"
                   SelectionChanged="SidebarList_SelectionChanged">
            <ListBox.Styles>
              <!-- Each row a rounded pill inset from the column's edges: the
                   selected one in the accent's faint wash with its icon and
                   name in the accent, the others' icons in the secondary text
                   colour, so the one red thing in the column is where you
                   are. Headings are not pills and never light up. -->
              <Style Selector="ListBox.sidebar ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Margin" Value="12,1"/>
                <Setter Property="CornerRadius" Value="10"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem materialIcons|MaterialIcon.rowIcon">
                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem Path.rowIcon">
                <Setter Property="Fill" Value="{DynamicResource AppTextSecondaryBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected materialIcons|MaterialIcon.rowIcon">
                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected Path.rowIcon">
                <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected TextBlock#SidebarRowName">
                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SidebarItem">
                <Panel>
                  <!-- Highlighted while a dragged track hovers this playlist row -->
                  <Border IsVisible="{Binding IsDropTarget}"
                          Background="{DynamicResource AppAccentBrush}"
                          Opacity="0.25"
                          CornerRadius="10"
                          IsHitTestVisible="False"/>
                  <TextBlock Text="{Binding Name, Converter={x:Static conv:UpperCaseConverter.Instance}}"
                             IsVisible="{Binding IsHeader}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextSecondaryBrush}"
                             Margin="10,18,8,6"
                             LetterSpacing="1.2"/>
                  <StackPanel IsVisible="{Binding IsSelectable}"
                              Orientation="Horizontal"
                              Margin="12,8,8,8">
                    <Panel Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                      <materialIcons:MaterialIcon Classes="rowIcon"
                                                 Kind="{Binding Icon}"
                                                 IsVisible="{Binding UsesMaterialIcon}"
                                                 Width="20" Height="20"/>
                      <!-- At Material's scale for a 20px icon (App.axaml's
                           SongNoteGeometry), so the note is no larger than the
                           glyphs around it, only taller-stemmed. Coloured as
                           the icons beside it are, by the rowIcon styles. -->
                      <Path Classes="rowIcon"
                            Data="{StaticResource SongNoteGeometry}"
                            IsVisible="{Binding UsesSongNote}"
                            Stretch="Uniform"
                            Width="15.8" Height="17.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                        <TextBlock x:Name="SidebarRowName" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"/>
                        <!-- Paired-server standing - see SidebarItem.
                             ShowReachableIcon/ShowUnreachableIcon. Only ever
                             set on the one Device row for MainViewModel's
                             paired Server, which (unlike an ordinary
                             Devices/Server row) stays in the sidebar even
                             while unreachable. IsSyncing used to be a spinner
                             of its own, sitting beside the check rather than
                             instead of it; see ConnectionStatusIcon. -->
                        <controls:ConnectionStatusIcon
                            IsConnected="{Binding ShowReachableIcon}"
                            IsUnreachable="{Binding ShowUnreachableIcon}"
                            IsBusy="{Binding IsSyncing}"
                            VerticalAlignment="Center"/>
                      </StackPanel>
                      <!-- The one field in the app that is a plain TextBox
                           rather than controls:TextInput: the row it replaces
                           is 20px tall, and the clear button inside a
                           TextInput is taller than that on its own, so it
                           would push every sidebar row apart to hold a button
                           for something Escape already does. It still draws
                           the primary outline, which is a theme brush rather
                           than anything that control owns. -->
                      <TextBox Text="{Binding Name, Mode=TwoWay}"
                               IsVisible="{Binding IsEditing}"
                               VerticalContentAlignment="Center"
                               Height="22"
                               MinHeight="0"
                               Padding="4,0"
                               MinWidth="80"
                               SelectionBrush="{DynamicResource AppAccentSoftBrush}"
                               SelectionForegroundBrush="{DynamicResource AppTextPrimaryBrush}"
                               Loaded="RenameBox_Loaded"
                               KeyDown="RenameBox_KeyDown"
                               LostFocus="RenameBox_LostFocus"/>
                      <!-- Only ever set (see MainViewModel.RefreshDeviceDisplayNames)
                           when this device's name collides with another
                           currently-listed device - shows its IP so they can
                           be told apart. -->
                      <TextBlock Text="{Binding Subtitle}"
                                 IsVisible="{Binding Subtitle, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                                 FontSize="11"
                                 Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Drop-onto-empty-space cue for the drag-a-track-onto-the-sidebar
               gesture (see MainView.axaml.cs's GetPlaylistsDropBand /
               HitTestSidebarDrop). Shown while a track is dragged over the
               Playlists section but not over one specific playlist row -
               including the section's empty tail below the last playlist, or
               the whole section when there are no playlists yet - meaning the
               drop will create a new playlist rather than add to one. -->
          <Border x:Name="NewPlaylistDropZone"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  ClipToBounds="True"
                  Background="{DynamicResource AppAccentSoftBrush}"
                  BorderBrush="{DynamicResource AppAccentBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  VerticalAlignment="Top"
                  Margin="12,1">
            <TextBlock Text="New Playlist"
                       FontSize="11"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="1" Grid.Column="1"
                    Width="4"
                    Background="Transparent"
                    ResizeDirection="Columns"/>

      <!-- Beside the sidebar: a banner when there is something to say, the
           page's header and the page. -->
      <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">

    <!-- The server cannot write to its music folders (see
         LibraryWriteWarning): in an administrator's browser tab, as the server
         reports it; on a desktop, as edits and files from here that it could
         not write (MainViewModel.OnUnwrittenChanged). Across the page rather than
         on the settings screen, because what it warns about happens elsewhere
         - on the owner's phone, as a refused upload or tag edit. The close
         button is for a server that is read-only on purpose; it lasts until
         the page is next loaded, or the desktop's count next changes. -->
    <Border x:Name="LibraryWriteWarningBanner"
            Grid.Row="0"
            IsVisible="{Binding HasServerLibraryWriteWarning}"
            Padding="12,8,8,8"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource AppWarningBrush}">
      <Border.Background>
        <SolidColorBrush Color="{DynamicResource PaletteWarning}" Opacity="0.14"/>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <materialIcons:MaterialIcon Grid.Column="0"
                                    Kind="AlertOutline"
                                    Width="16" Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AppWarningBrush}"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding ServerLibraryWriteWarning}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="2"
                Command="{Binding DismissServerLibraryWriteWarningCommand}"
                ToolTip.Tip="Dismiss"
                Background="Transparent"
                BorderThickness="0"
                Padding="4"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
        </Button>
      </Grid>
    </Border>

    <!-- A list's header: its name in the display serif, how much is in it,
         and the filter box, which used to sit in the top bar and now heads
         what it acts on. Not over Home, Artists (whose column of
         names carries the filter instead) or a server's page - see
         MainViewModel.ShowsPageHeader. -->
    <Grid Grid.Row="1"
          IsVisible="{Binding ShowsPageHeader}"
          ColumnDefinitions="*,Auto"
          Margin="28,18,24,14">
      <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
        <TextBlock Classes="screenTitle"
                   Text="{Binding PageTitle}"
                   FontSize="44"/>
        <TextBlock Text="{Binding PageSubtitle}"
                   FontSize="14"
                   Margin="2,2,0,0"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <usercontrols:FilterControl
          Width="260"
          IsVisible="{Binding ShowsPageFilter}"
          FilterText="{Binding FilterText}"/>
      </StackPanel>
    </Grid>

      <!-- The page: the Artists column of names beside a track area, or one
           of the views that take the whole width. -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Artist sub-list. Albums used to share this (plain album-name text
             list) but was replaced by the art-tile grid below, matching
             mobile's own Albums/Recently Added tabs - see MainViewModel's
             IsSubListVisible/IsShowingAlbumGrid doc comments. -->
        <!-- Artists: the names, narrowed by the page header's filter
             (VisibleSubListItems), beside the picked artist's page. -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                IsVisible="{Binding IsSubListVisible}"
                Width="250"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource AppDividerBrush}">
          <!-- Each name built once and handed name after name as the list
               scrolls (RecyclingListBox, UniformRowPanel), as on the phone. -->
          <controls:RecyclingListBox x:Name="SubList"
                   Classes="names"
                   ItemsSource="{Binding VisibleSubListItems}"
                   SelectionMode="Multiple"
                   Background="Transparent"
                   Padding="0,4,0,8"
                   SelectionChanged="SubList_SelectionChanged">
            <ListBox.Styles>
              <!-- The sidebar's pills: inset, rounded, the accent's wash
                   and the accent on the name when picked. -->
              <Style Selector="ListBox.names ListBoxItem">
                <Setter Property="Margin" Value="10,1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
              </Style>
              <Style Selector="ListBox.names ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
              </Style>
              <Style Selector="ListBox.names ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:UniformRowPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <controls:RowText Text="{Binding}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </controls:RecyclingListBox>
        </Border>

        <!-- The picked artist's page: who they are - their covers as a round
             collage, the name in the display serif, how much there is, and the
             phone's album-header circles to play it all or shuffle it - then
             each of their albums as a card: its cover, its name and a line
             about it, play and the album menu, and its songs under it
             (AlbumTrackList, the Albums grid's expanded-album list, here
             under a band naming its columns). Oldest album first. -->
        <ScrollViewer Grid.Column="1" Grid.RowSpan="2"
                      IsVisible="{Binding IsShowingArtistPage}"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,4,24,24" Spacing="16">
            <!-- Bound through ArtistHeader rather than switching the data
                 context to it: a DataContext binding on the element that also
                 declares the new x:DataType is resolved by Avalonia against
                 the parent's type, but by Rider's inspection against the new
                 one, which then reports ArtistHeader as missing. -->
            <Grid IsVisible="{Binding ArtistHeader, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ColumnDefinitions="Auto,*,Auto">
              <controls:AlbumArtView Grid.Column="0"
                                     Covers="{Binding ArtistHeader.Cover.CoverArt}"
                                     Width="96" Height="96"
                                     ArtCornerRadius="48"
                                     Margin="0,0,20,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="screenTitle" Text="{Binding ArtistHeader.Name}" FontSize="40"/>
                <TextBlock Text="{Binding ArtistHeader.Summary}"
                           FontSize="14"
                           Margin="2,2,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Classes="floating" Width="48" Height="48" CornerRadius="24">
                  <Button Classes="pill" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                          ToolTip.Tip="Play all"
                          Command="{Binding PlayViewCommand}">
                    <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24"/>
                  </Button>
                </Border>
                <Border Classes="floating" Width="48" Height="48" CornerRadius="24">
                  <Button Classes="pill" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                          ToolTip.Tip="Shuffle"
                          Command="{Binding ShuffleViewCommand}">
                    <materialIcons:MaterialIcon Kind="Shuffle" Width="24" Height="24"/>
                  </Button>
                </Border>
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding ArtistAlbums}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtistAlbumSectionViewModel">
                  <Border Background="{DynamicResource AppSidebarBrush}"
                          CornerRadius="14"
                          Padding="16"
                          Margin="0,0,0,16">
                    <Grid ColumnDefinitions="Auto,*">
                      <controls:AlbumArtView Grid.Column="0"
                                             AlbumArt="{Binding Tile.AlbumArt}"
                                             Width="140" Height="140"
                                             ArtCornerRadius="10"
                                             Margin="0,0,20,0"
                                             VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="1">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Classes="screenTitle" Text="{Binding Tile.Name}" FontSize="28"/>
                            <TextBlock Text="{Binding Meta}"
                                       FontSize="13"
                                       Margin="2,2,0,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Classes="floating" Width="40" Height="40">
                              <Button Classes="pill" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip.Tip="Play album"
                                      Click="ArtistAlbumPlay_Click">
                                <materialIcons:MaterialIcon Kind="Play" Width="22" Height="22"/>
                              </Button>
                            </Border>
                            <Button Classes="pill" Padding="8"
                                    ToolTip.Tip="More"
                                    Click="ArtistAlbumMenu_Click">
                              <materialIcons:MaterialIcon Classes="chrome" Kind="DotsVertical" Width="20" Height="20" Opacity="0.6"/>
                            </Button>
                          </StackPanel>
                        </Grid>
                        <!-- The songs' column names, in the track list's
                             header band; the widths are AlbumTrackList's
                             row template's - the number, the download well,
                             the title, the time, the "...". -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="8"
                                Margin="0,12,0,2"
                                Padding="12,6,32,6">
                          <Grid ColumnDefinitions="Auto,20,*,Auto">
                            <TextBlock Grid.Column="0" Text="#" MinWidth="26" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Title" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Duration" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                          </Grid>
                        </Border>
                        <controls:AlbumTrackList ShowsNumbers="True"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Album art tile grid for Albums, alphabetical (see
             MainViewModel.AlbumGridTiles). Spans both columns - unlike the
             track list, this view never has a sub-list pane alongside it.
             Clicking a tile expands that album's songs in place (ExpandedKey/
             ExpandedTracks - see AlbumGridRowControl for the actual
             expand/collapse animation) rather than navigating to a separate
             track-list view, so the grid stays visible the whole time. It also
             gets the full multi-select + drag-to-playlist gesture (the old
             SubList's own gesture, restored here) - see MainView.axaml.cs's
             AlbumGrid_Pointer* handlers. -->
        <controls:AlbumGridView x:Name="AlbumGrid"
                                Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                                IsVisible="{Binding IsShowingAlbumGrid}"
                                ItemsSource="{Binding AlbumGridTiles}"
                                SelectedNames="{Binding SelectedSubItems}"
                                ExpandedKey="{Binding ExpandedAlbumKey}"
                                ExpandedTracks="{Binding ExpandedAlbumTracks}"
                                Availability="{Binding Availability}"
                                CurrentlyPlayingTrackId="{Binding CurrentlyPlayingTrack.Id}"/>

        <!-- Home: Continue Playing, Recently Played, Recently Added - see
             HomeViewModel. -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsShowingHome}">
          <views:HomeView DataContext="{Binding Home}"/>
        </Panel>

        <!-- Custom track list - Songs/Artists/Playlists only now; Albums
             shows its songs inline via the grid above instead. Hidden (not just covered) when showing device detail -
             MusicListView draws its own column-header row internally, and
             the panels that replace it only inset by their own Margin,
             leaving that header row visible peeking above it otherwise. -->
        <controls:MusicListView Grid.Column="1" Grid.Row="1"
                                x:Name="MusicList"
                                IsVisible="{Binding IsShowingTrackList}"
                                SelectedTrack="{Binding SelectedTrack, Mode=TwoWay}"/>

        <!-- The Queue page with nothing playing - the phone's Queue tab says
             the same (QueueViewModel.EmptyTitle/EmptyMessage). -->
        <StackPanel Grid.Column="1" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" Opacity="0.6" MaxWidth="360">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsShowingQueue"/>
              <Binding Path="Queue.IsEmpty"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <materialIcons:MaterialIcon Kind="PlaylistMusic" Width="40" Height="40"/>
          <TextBlock Text="{x:Static vm:QueueViewModel.EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{x:Static vm:QueueViewModel.EmptyMessage}"
                     FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <!-- The browser's Server Settings page: the same SettingsPanel the
             device-detail pane above hosts, shown here because a tab's sidebar
             has a row for it (see MainViewModel.IsShowingServerSettings).

             A page in the content area rather than the full-view overlay this
             replaced, so the top bar stays on screen - what is being
             administered is the server a track is streaming from, and taking
             away pause and the seek bar to configure it was the wrong trade.
             Scrolls, because the panel is taller than a short window and the
             OK/Cancel row lives at its bottom.

             Filled in from code-behind (UpdateServerSettingsPage) for the same
             reason ServerSettingsHost is: SettingsPanel takes its ViewModel
             through a constructor. -->
        <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                      IsVisible="{Binding IsShowingServerSettings}"
                      HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="ServerSettingsPageHost"
                          Margin="24"
                          MaxWidth="620"
                          HorizontalAlignment="Left"/>
        </ScrollViewer>

        <!-- Device detail: shown instead of the track list when a Devices/Server
             sidebar row is selected. The server itself - who it is, pairing, the
             codes it hands out - and then its own settings, administered in
             place (see MainViewModel.SelectedServerSettings). Its music is
             deliberately not here: a paired server's tracks are merged into the
             library by LibrarySyncService and play from the ordinary track list,
             so browsing them again under the sidebar row was the same catalog
             twice. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
              IsVisible="{Binding IsShowingDeviceDetail}"
              Margin="24" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- SelectedSidebarItem.Name, not SelectedDevice.Alias - the sidebar
                     row already resolves a local nickname override (DeviceNicknameStore)
                     over the peer's raw self-reported alias and keeps it live-updated
                     on rename; SelectedDevice.Alias is that raw, unresolved value. -->
                <TextBlock Text="{Binding SelectedSidebarItem.Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <!-- Reachable/unreachable come from the selected sidebar row
                     itself (SidebarItem.ShowReachableIcon/ShowUnreachableIcon),
                     the same two properties the row's own glyph binds, so the
                     header and the sidebar cannot disagree. This used to bind
                     IsSelectedDeviceTrustConfirmed, which is about the pairing
                     rather than the server being there, and so showed a green
                     check beside a sidebar warning for a server that had gone
                     away. Busy is the one addition: a pairing still awaiting
                     approval spins here as well as a sync, which is why the
                     pairing row further down no longer carries a spinner of
                     its own. After the name, the way the sidebar row puts it. -->
                <controls:ConnectionStatusIcon
                    IsConnected="{Binding SelectedSidebarItem.ShowReachableIcon}"
                    IsUnreachable="{Binding SelectedSidebarItem.ShowUnreachableIcon}"
                    IsBusy="{Binding IsSelectedDeviceBusy}"
                    IconSize="18"
                    VerticalAlignment="Center"/>
              </StackPanel>
              <!-- Collapsed rather than blank with no live endpoint (the
                   pinned row of a paired server that has dropped off the
                   network): an empty line still takes its height. -->
              <TextBlock Text="{Binding SelectedDevice.Origin}" Opacity="0.5" FontSize="13"
                         IsVisible="{Binding SelectedDevice, Converter={x:Static avc:ObjectConverters.IsNotNull}}"/>
              <!-- The key this device actually pinned, so it can be compared
                   against what the server says about itself. Only useful for a
                   pairing made with a bare code - one made from a flower://
                   invite checked it before pinning anything - but it is shown
                   either way rather than conditionally, since the app does not
                   record which was used and a check offered only sometimes is
                   one nobody learns to make. See
                   PeerSyncCoordinator.PairedServerPinnedFingerprint. -->
              <StackPanel Orientation="Horizontal" Spacing="5"
                          IsVisible="{Binding HasSelectedDevicePinnedFingerprint}">
                <TextBlock Text="Verified as" Opacity="0.4" FontSize="11" VerticalAlignment="Center"/>
                <SelectableTextBlock Text="{Binding SelectedDevicePinnedFingerprint}"
                                     Opacity="0.55" FontSize="11" FontFamily="monospace"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="The server identity this device pinned when it paired. Every later connection is checked against it. Compare it with the fingerprint the server shows in its own settings."/>
              </StackPanel>
            </StackPanel>
            <!-- Only shown for a peer advertising Server mode, while this device
                 is a Client (see MainViewModel.CanPairWithSelectedDevice) - mirrors
                 ServerPickerView's Pair/Unpair button (Settings' Devices tab) so
                 pairing doesn't require a trip to Settings. -->
            <!-- Pairing code (see MainViewModel.IsPairingCodeRequired): there
                 is nobody in front of a server to tap Allow, so an admin issues
                 a one-time code out of band and this redeems it. Hidden once
                 paired, when there is nothing left to redeem. -->
            <!-- Wide enough for a whole flower:// invite, not just the five
                 characters of a code. The cap used to be 20, which silently
                 truncated a pasted link into something that could only fail as
                 a bad code - see PairingEntry, which is what reads either. -->
            <controls:TextInput Text="{Binding PairingCode}"
                                PlaceholderText="Pairing code or link"
                                IsVisible="{Binding IsPairingCodeRequired}"
                                Width="180" MaxLength="400"
                                KeyDown="PairingCodeBox_KeyDown"
                                Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="{Binding PairActionLabel}"
                    IsVisible="{Binding CanPairWithSelectedDevice}"
                    IsEnabled="{Binding IsPairActionEnabled}"
                    Click="PairActionButton_Click"
                    Margin="8,0,0,0" VerticalAlignment="Center"/>
            <!-- A wrong or expired code is an ordinary outcome, so it is said
                 plainly next to the box rather than raised as a dialog. -->
            <SelectableTextBlock Text="{Binding PairingCodeError}"
                       IsVisible="{Binding PairingCodeError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource AppErrorBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding PairActionHint}"
                       IsVisible="{Binding PairActionHint, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <!-- Only for a server this device has already paired with (see
                 MainViewModel.CanOpenSelectedServerSettings). Now that the
                 settings themselves are on this page, what it still does that
                 the panel below cannot is pair a *browser tab* as an
                 administrator, which is the only way into this server from a
                 machine that is not running Flower. It issues a one-time
                 admin pairing code and opens the server's own page in the OS
                 browser, where the tab spends that code on a keypair of its
                 own. -->
            <Button Content="Open in Browser…"
                    ToolTip.Tip="Pairs a browser tab with this server as an administrator and opens its settings page there."
                    IsVisible="{Binding CanOpenSelectedServerSettings}"
                    IsEnabled="{Binding IsOpenSelectedServerSettingsEnabled}"
                    Click="ServerSettingsButton_Click"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
            <!-- "Paired, but not an administrator of that server" is the common
                 case here, and it is an ordinary outcome rather than a fault -
                 said plainly next to the button, same as PairingCodeError. -->
            <SelectableTextBlock Text="{Binding ServerSettingsError}"
                       IsVisible="{Binding ServerSettingsError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource AppErrorBrush}" FontSize="12" TextWrapping="Wrap"
                       MaxWidth="260"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <!-- The server's own settings: the same SettingsPanel its browser UI
               serves, over a RemoteServerSettingsBackend. Filled in from
               code-behind (UpdateServerSettingsPane) rather than declared here,
               since SettingsPanel takes its ViewModel through a constructor. -->
          <ContentControl Grid.Row="1" x:Name="ServerSettingsHost"/>

          <!-- Why there is no panel, when there is none: a server that has not
               approved this device yet has nothing it will let us read, and one
               that has approved us but not as an administrator says so itself. -->
          <SelectableTextBlock Grid.Row="1" x:Name="ServerSettingsMessage"
                     Opacity="0.6" FontSize="13" TextWrapping="Wrap"
                     VerticalAlignment="Top"/>

        </Grid>
      </Grid>

      </Grid>

      <!-- Status bar: what the app is busy with - a rescan, a sync, an import -
           as a tab at the bottom right of the page, only as wide as what it
           says. It slides up when a message arrives, stays while the work
           goes on, and slides back down a second after it ends
           (ShowStatusMessage in the code-behind), so it is never a strip of
           empty chrome. Over the page rather than in a row of its own, and
           clipped by this panel so the slide happens below the page's edge,
           not across the player bar when that sits at the bottom. -->
      <Panel Grid.Row="1" Grid.Column="2"
             ClipToBounds="True"
             IsHitTestVisible="False">
        <Border x:Name="StatusBar"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Padding="12,5,16,5"
                CornerRadius="6,0,0,0"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource AppDividerBrush}"
                Background="{DynamicResource AppSurfaceBrush}"
                RenderTransform="translateY(40px)">
          <Border.Transitions>
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform"
                                             Duration="0:0:0.2"
                                             Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <Border.Styles>
            <Style Selector="Border#StatusBar.shown">
              <Setter Property="RenderTransform" Value="translateY(0px)"/>
            </Style>
          </Border.Styles>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <materialIcons:MaterialIcon x:Name="SpinnerIcon"
                                        Kind="Sync"
                                        Width="13" Height="13"
                                        Opacity="0.55"/>
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Opacity="0.55"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Floating "what you're dragging" ghost for the drag-onto-playlist gesture
           (see MusicListView's TrackDragFormat / MainView.axaml.cs's
           ContentGrid_DragOver). Spans all 3 columns of ContentGrid so it can
           follow the cursor from the track list all the way to the sidebar. -->
      <Border x:Name="DragGhost"
              Grid.ColumnSpan="3"
              Grid.RowSpan="3"
              IsVisible="False"
              IsHitTestVisible="False"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,6"
              BoxShadow="{DynamicResource AppDropdownShadow}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="MusicNote" Width="14" Height="14" VerticalAlignment="Center"/>
          <TextBlock x:Name="DragGhostText"
                     FontSize="12"
                     VerticalAlignment="Center"
                     MaxWidth="220"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Browser only: the whole page, for a tab the server does not know (see
         MainViewModel's browser pairing section). Over every row and opaque,
         because everything underneath could only be empty or refused - the
         library, the transport, the settings. What remains is the one thing
         such a tab can do: take a pairing code. Or, when the page cannot hold
         a key at all, say so instead of offering a box no code would help.
         Blank until the server has said which (IsCheckingBrowserPairing). -->
    <Border
            IsVisible="{Binding CoversBrowserPage}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <ScrollViewer IsVisible="{Binding ShowsBrowserPairingScreen}">
        <StackPanel MaxWidth="520" Margin="24,48" Spacing="16" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <materialIcons:MaterialIcon Kind="LinkVariant" Width="28" Height="28"/>
            <TextBlock Text="Pair this browser" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding CanEnterBrowserPairingCode}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="BrowserPairingCodeBox"
                       Text="{Binding BrowserPairingCode}"
                       Watermark="Pairing code"
                       FontSize="18"
                       IsEnabled="{Binding !IsPairingBrowser}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding PairBrowserCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Content="Pair" Margin="8,0,0,0" Padding="20,8"
                      VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                      Command="{Binding PairBrowserCommand}"
                      IsEnabled="{Binding !IsPairingBrowser}"/>
            </Grid>
            <SelectableTextBlock Text="{Binding BrowserPairingError}"
                                 IsVisible="{Binding BrowserPairingError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                                 Foreground="{DynamicResource AppErrorBrush}" TextWrapping="Wrap"/>
            <SelectableTextBlock Text="{x:Static vm:MainViewModel.BrowserPairingHelp}"
                                 TextWrapping="Wrap" Opacity="0.8"/>
          </StackPanel>

          <SelectableTextBlock Text="{Binding BrowserCannotPairReason}"
                               IsVisible="{Binding BrowserCannotPairReason, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                               TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

  </Grid>

</UserControl>
