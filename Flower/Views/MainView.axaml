<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:usercontrols="clr-namespace:Flower.UserControls"
             xmlns:views="clr-namespace:Flower.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:services="clr-namespace:Flower.Services;assembly=Flower.Core"
             xmlns:conv="clr-namespace:Flower.Converters"
             mc:Ignorable="d"
             x:Class="Flower.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid>

    <!-- The window: the player bar across its whole width - at the top, or at
         the bottom with the playback controls there (AppSettings.
         PlaybackControlsPlacement) - and between, the sidebar and beside it
         the page, with the status bar coming up over its foot when there is
         something to say. Which row the player bar takes is set by the styles
         below rather than on the element, because a value set on an element
         outranks any style. -->
    <Grid x:Name="ContentGrid"
          RowDefinitions="Auto,*,Auto"
          Classes.controlsAtBottom="{Binding PlaybackControlsAtBottom}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="170" MaxWidth="320"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.Styles>
        <Style Selector="Grid#ContentGrid > Border#PlayerBar">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="BorderThickness" Value="0,0,0,1"/>
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        </Style>
        <Style Selector="Grid#ContentGrid.controlsAtBottom > Border#PlayerBar">
          <Setter Property="Grid.Row" Value="2"/>
          <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
      </Grid.Styles>

      <!-- Player bar, across the whole window over or under the sidebar and
           the page: what is playing at the left, its cover flush with the
           bar's edge; the transport in the middle, over the seek bar - the
           middle of the window, since the halves either side are equal; and
           the output and the volume at the right. On the surface colour,
           whatever the cover. -->
      <Border x:Name="PlayerBar"
              Grid.ColumnSpan="3"
              Padding="6,6,24,6"
              BorderBrush="{DynamicResource AppDividerBrush}"
              TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}">
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="32">
          <!-- A right-click on what is playing opens its menu - see
               NowPlaying_ContextRequested. -->
          <usercontrols:CurrentlyPlayingControl
            x:Name="NowPlayingInfo"
            Grid.Column="0"
            DataContext="{Binding NowPlaying}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <usercontrols:PlaylistControls
              x:Name="PlaybackControls"
              DataContext="{Binding PlaybackControls}"
              HorizontalAlignment="Center"/>
            <usercontrols:SeekBar DataContext="{Binding NowPlaying}" Width="560"/>
          </StackPanel>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="4"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <usercontrols:OutputDeviceControl
              DataContext="{Binding OutputDevice}"
              VerticalAlignment="Center" />
            <!-- Apple's own AirPlay route button, hosted natively, and nothing
                 at all on platforms with no such control (see RoutePickerControl)
                 - which today is everything but the Flower.MacOS head. It sits
                 beside OutputDeviceControl rather than replacing it: that one
                 lists the CoreAudio devices miniaudio can render to, this one
                 reaches AirPlay receivers that are not devices at all. Sized
                 here because a NativeControlHost has no intrinsic size of its
                 own to measure. -->
            <usercontrols:RoutePickerControl
              x:Name="RoutePicker"
              Width="28" Height="28"
              Margin="8,0"
              VerticalAlignment="Center" />
            <usercontrols:VolumeControl
              DataContext="{Binding Volume}"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Height="24"
              Width="150" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar: the library, playlists and server under small capital
           headings, the server at the foot. Its own tint (AppSidebarBrush)
           sets it apart from the page instead of a rule down its edge. -->
      <Border x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Background="{DynamicResource AppSidebarBrush}">
        <DockPanel>
        <!-- Back and Forward through the pages visited, above Library
             (MainViewModel.GoBackAsync/GoForwardAsync). Greyed while there is
             nowhere to go. -->
        <!-- Over the list, which the margin's -4 tucks the Library heading's
             own top margin under, so the buttons keep their full height to
             click. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="20,14,16,-4" ZIndex="1">
          <!-- As the October 2026 redesign draws them: rounded squares, a thin
               chevron in the sidebar rows' icon colour, the selected tint
               behind it and the ink in it when pointed at, and no fill at all
               while greyed - Fluent's own disabled fill included. -->
          <StackPanel.Styles>
            <Style Selector="Button.history">
              <Setter Property="Width" Value="36"/>
              <Setter Property="Height" Value="36"/>
              <Setter Property="Padding" Value="9"/>
              <Setter Property="CornerRadius" Value="10"/>
            </Style>
            <Style Selector="Button.history:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
            </Style>
            <Style Selector="Button.history:disabled /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="Button.history Path">
              <Setter Property="Stroke" Value="{DynamicResource AppIconBrush}"/>
              <Setter Property="StrokeThickness" Value="1.8"/>
              <Setter Property="StrokeLineCap" Value="Round"/>
              <Setter Property="StrokeJoin" Value="Round"/>
            </Style>
            <Style Selector="Button.history:pointerover Path">
              <Setter Property="Stroke" Value="{DynamicResource AppTextPrimaryBrush}"/>
            </Style>
            <Style Selector="Button.history:disabled Path">
              <Setter Property="Stroke" Value="{DynamicResource AppTextDisabledBrush}"/>
            </Style>
          </StackPanel.Styles>
          <!-- Drawn on a 24px grid and scaled to 18, stroke and all, as the
               redesign's own icons are. -->
          <Button Classes="pill history"
                  ToolTip.Tip="Back"
                  AutomationProperties.Name="Back"
                  Command="{Binding GoBackCommand}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Data="M15,5 L8,12 L15,19"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Button Classes="pill history"
                  ToolTip.Tip="Forward"
                  AutomationProperties.Name="Forward"
                  Command="{Binding GoForwardCommand}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Data="M9,5 L16,12 L9,19"/>
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
        <Panel>
          <ListBox x:Name="SidebarList"
                   Classes="sidebar"
                   ItemsSource="{Binding SidebarItems}"
                   SelectedItem="{Binding SelectedSidebarItem, Mode=TwoWay}"
                   SelectionMode="Multiple"
                   Background="Transparent"
                   Padding="0,0,0,24"
                   SelectionChanged="SidebarList_SelectionChanged">
            <ListBox.Styles>
              <!-- Each row a rounded pill inset from the column's edges: the
                   selected one on the selected tint, its icon and name in ink
                   and its name in bold, the others' icons and names a shade
                   softer until pointed at. Headings are not pills and never
                   light up. -->
              <Style Selector="ListBox.sidebar ListBoxItem" x:DataType="vm:SidebarItem">
                <Setter Property="controls:BottomPinnedStackPanel.PinsFromHere" Value="{Binding PinsToBottom}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Margin" Value="16,1"/>
                <Setter Property="CornerRadius" Value="10"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
              </Style>
              <!-- Headings, whatever the pointer does (the "header" class -
                   see SidebarList_ContainerPrepared). -->
              <Style Selector="ListBox.sidebar ListBoxItem.header /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem.header">
                <Setter Property="Cursor" Value="Arrow"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem materialIcons|MaterialIcon.rowIcon">
                <Setter Property="Foreground" Value="{DynamicResource AppIconBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem Path.rowIcon">
                <Setter Property="Fill" Value="{DynamicResource AppIconBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem TextBlock#SidebarRowName">
                <Setter Property="Foreground" Value="{DynamicResource AppIconBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:pointerover materialIcons|MaterialIcon.rowIcon, ListBox.sidebar ListBoxItem:selected materialIcons|MaterialIcon.rowIcon">
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:pointerover Path.rowIcon, ListBox.sidebar ListBoxItem:selected Path.rowIcon">
                <Setter Property="Fill" Value="{DynamicResource AppTextPrimaryBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:pointerover TextBlock#SidebarRowName, ListBox.sidebar ListBoxItem:selected TextBlock#SidebarRowName">
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected TextBlock#SidebarRowName">
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Style>
              <!-- A server's row is a card of its own under its heading: the
                   page's colour inside a hairline, its name in bold. Picked,
                   it takes the selected tint like any other row. -->
              <Style Selector="ListBox.sidebar ListBoxItem Border.serverCard">
                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:pointerover Border.serverCard">
                <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem:selected Border.serverCard">
                <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
              </Style>
              <Style Selector="ListBox.sidebar ListBoxItem TextBlock#SidebarRowName.card">
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Style>
            </ListBox.Styles>
            <!-- The server's section at the foot of the column, as long as
                 there is room below the playlists for it. -->
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:BottomPinnedStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SidebarItem">
                <Panel>
                  <!-- Highlighted while a dragged track hovers this playlist row -->
                  <Border Classes="serverCard"
                          IsVisible="{Binding IsServerCard}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          CornerRadius="12"/>
                  <Border IsVisible="{Binding IsDropTarget}"
                          Background="{DynamicResource AppInkBrush}"
                          Opacity="0.12"
                          CornerRadius="10"
                          IsHitTestVisible="False"/>
                  <TextBlock Text="{Binding Name, Converter={x:Static conv:UpperCaseConverter.Instance}}"
                             IsVisible="{Binding IsHeader}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextSecondaryBrush}"
                             Margin="12,20,8,6"
                             LetterSpacing="0.9"
                             VerticalAlignment="Bottom"/>
                  <!-- The Playlists heading's own way to start one, File >
                       New Playlist's command. -->
                  <Button Classes="pill"
                          IsVisible="{Binding IsPlaylistsHeader}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).NewPlaylistCommand}"
                          ToolTip.Tip="New Playlist"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,0"
                          Width="32" Height="32"
                          Padding="8">
                    <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"
                                                Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </Button>
                  <StackPanel IsVisible="{Binding IsSelectable}"
                              Orientation="Horizontal"
                              Margin="{Binding Indent}">
                    <Panel Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                      <materialIcons:MaterialIcon Classes="rowIcon"
                                                 Kind="{Binding Icon}"
                                                 IsVisible="{Binding UsesMaterialIcon}"
                                                 Width="19" Height="19"/>
                      <!-- A server's own icon in place of the glyph (ServerIcon):
                           the emoji it chose, or its picture, rounded like a
                           cover. -->
                      <TextBlock Text="{Binding IconEmoji}"
                                 IsVisible="{Binding UsesServerEmoji}"
                                 FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border IsVisible="{Binding UsesServerImage}" CornerRadius="5" ClipToBounds="True">
                        <Image Source="{Binding IconImage}" Stretch="UniformToFill"/>
                      </Border>
                      <!-- At Material's scale for a 20px icon (App.axaml's
                           SongNoteGeometry), so the note is no larger than the
                           glyphs around it, only taller-stemmed. Coloured as
                           the icons beside it are, by the rowIcon styles. -->
                      <Path Classes="rowIcon"
                            Data="{StaticResource SongNoteGeometry}"
                            IsVisible="{Binding UsesSongNote}"
                            Stretch="Uniform"
                            Width="15.8" Height="17.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                        <TextBlock x:Name="SidebarRowName"
                                   Classes.card="{Binding IsServerCard}"
                                   Text="{Binding Name}"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <!-- Paired-server standing - see SidebarItem.
                             ShowReachableIcon/ShowUnreachableIcon. Only ever
                             set on the one Device row for MainViewModel's
                             paired Server, which (unlike an ordinary
                             Devices/Server row) stays in the sidebar even
                             while unreachable. IsSyncing used to be a spinner
                             of its own, sitting beside the check rather than
                             instead of it; see ConnectionStatusIcon. -->
                        <controls:ConnectionStatusIcon
                            IsConnected="{Binding ShowReachableIcon}"
                            IsUnreachable="{Binding ShowUnreachableIcon}"
                            IsBusy="{Binding IsSyncing}"
                            ConnectedAsDot="True"
                            VerticalAlignment="Center"/>
                      </StackPanel>
                      <!-- The one field in the app that is a plain TextBox
                           rather than controls:TextInput: the row it replaces
                           is 20px tall, and the clear button inside a
                           TextInput is taller than that on its own, so it
                           would push every sidebar row apart to hold a button
                           for something Escape already does. It still draws
                           the primary outline, which is a theme brush rather
                           than anything that control owns. -->
                      <TextBox Text="{Binding Name, Mode=TwoWay}"
                               PlaceholderText="Name"
                               IsVisible="{Binding IsEditing}"
                               VerticalContentAlignment="Center"
                               Height="22"
                               MinHeight="0"
                               Padding="4,0"
                               MinWidth="80"
                               SelectionBrush="{DynamicResource AppSelectedBrush}"
                               SelectionForegroundBrush="{DynamicResource AppTextPrimaryBrush}"
                               Loaded="RenameBox_Loaded"
                               KeyDown="RenameBox_KeyDown"
                               LostFocus="RenameBox_LostFocus"/>
                      <!-- Only ever set (see MainViewModel.RefreshDeviceDisplayNames)
                           when this device's name collides with another
                           currently-listed device - shows its IP so they can
                           be told apart. -->
                      <TextBlock Text="{Binding Subtitle}"
                                 IsVisible="{Binding Subtitle, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                                 FontSize="11"
                                 Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                  <!-- A folder's open/closed chevron, at the row's end in the
                       room SidebarItem.Indent leaves for it, so the folder's
                       name lines up with the playlists beside it; the rows
                       inside it are indented by their Depth. Its own button,
                       so opening a folder does not also select it. -->
                  <Button Classes="pill"
                          IsVisible="{Binding IsFolder}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"
                          Padding="4"
                          Click="SidebarFolderToggle_Click">
                    <Panel>
                      <materialIcons:MaterialIcon Classes="chrome" Kind="ChevronDown" Width="16" Height="16" IsVisible="{Binding IsExpanded}"/>
                      <materialIcons:MaterialIcon Classes="chrome" Kind="ChevronRight" Width="16" Height="16" IsVisible="{Binding !IsExpanded}"/>
                    </Panel>
                  </Button>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Drop-onto-empty-space cue for the drag-a-track-onto-the-sidebar
               gesture (see MainView.axaml.cs's GetPlaylistsDropBand /
               HitTestSidebarDrop). Shown while a track is dragged over the
               Playlists section but not over one specific playlist row -
               including the section's empty tail below the last playlist, or
               the whole section when there are no playlists yet - meaning the
               drop will create a new playlist rather than add to one. -->
          <Border x:Name="NewPlaylistDropZone"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  ClipToBounds="True"
                  Background="{DynamicResource AppSelectedBrush}"
                  BorderBrush="{DynamicResource AppInkBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  VerticalAlignment="Top"
                  Margin="16,1">
            <TextBlock Text="New Playlist"
                       FontSize="11"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="1" Grid.Column="1"
                    Width="4"
                    Background="Transparent"
                    ResizeDirection="Columns"/>

      <!-- Beside the sidebar: a banner when there is something to say, the
           page's header and the page. -->
      <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">

    <!-- The server cannot write to its music folders (see
         LibraryWriteWarning): in an administrator's browser tab, as the server
         reports it; on a desktop, as edits and files from here that it could
         not write (MainViewModel.OnUnwrittenChanged). Across the page rather than
         on the settings screen, because what it warns about happens elsewhere
         - on the owner's phone, as a refused upload or tag edit. The close
         button is for a server that is read-only on purpose; it lasts until
         the page is next loaded, or the desktop's count next changes. -->
    <!-- One above the other, when both have something to say. -->
    <StackPanel Grid.Row="0">
    <Border x:Name="LibraryWriteWarningBanner"
            IsVisible="{Binding HasServerLibraryWriteWarning}"
            Padding="12,8,8,8"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource AppWarningBrush}"
            Background="{DynamicResource AppWarningBackgroundBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <materialIcons:MaterialIcon Grid.Column="0"
                                    Kind="AlertOutline"
                                    Width="16" Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AppWarningBrush}"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding ServerLibraryWriteWarning}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="2"
                Command="{Binding DismissServerLibraryWriteWarningCommand}"
                ToolTip.Tip="Dismiss"
                Background="Transparent"
                BorderThickness="0"
                Padding="4"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
        </Button>
      </Grid>
    </Border>

    <!-- A newer Flower, found by AppUpdatesViewModel: across the page, asking
         rather than acting, because nothing should restart on its own while
         someone is listening. The close button lasts until the next launch,
         and Settings > General still offers it. -->
    <Panel IsVisible="{Binding Updates, Converter={x:Static avc:ObjectConverters.IsNotNull}}">
      <Border x:Name="AppUpdateBanner"
              DataContext="{Binding Updates}"
              x:DataType="vm:AppUpdatesViewModel"
              IsVisible="{Binding ShowsBanner}"
              Padding="12,8,8,8"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource AppDividerBrush}"
              Background="{DynamicResource AppPlaceholderBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <materialIcons:MaterialIcon Grid.Column="0"
                                      Kind="ArrowUpCircleOutline"
                                      Width="16" Height="16"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding Available.Description, FallbackValue=''}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"/>
          <Button Grid.Column="2"
                  Classes="standard primary small"
                  Content="{Binding Available.InstallLabel, FallbackValue=''}"
                  Command="{Binding InstallCommand}"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"/>
          <Button Grid.Column="3"
                  Command="{Binding DismissCommand}"
                  ToolTip.Tip="Dismiss"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
          </Button>
        </Grid>
      </Border>
    </Panel>
    </StackPanel>

    <!-- A list's header: its name in the display serif and how much is in
         it, and at the right what the page can do - Play and Shuffle over a
         list of songs, Download over a playlist, Sort where the order is a
         choice, and the filter box, which heads what it acts on. Not over
         Artists, whose column of names carries its own, or a server's page -
         see MainViewModel.ShowsPageHeader. -->
    <Grid Grid.Row="1"
          IsVisible="{Binding ShowsPageHeader}"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="20"
          Margin="40,40,40,24">
      <StackPanel Grid.Column="0" Spacing="8">
        <TextBlock Classes="pageTitle" Text="{Binding PageTitle}"/>
        <TextBlock Text="{Binding PageSubtitle}"
                   IsVisible="{Binding ShowsPageSubtitle}"
                   FontSize="14"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Top">
        <!-- Everything on the page from the top, or shuffled: the songs as
             listed, filter and all (MainViewModel.PlayView). -->
        <Button Classes="play pagePlay"
                IsVisible="{Binding ShowsPagePlay}"
                Command="{Binding PlayViewCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="Play" Width="20" Height="20"/>
            <TextBlock Text="Play" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border Classes="outlined" Width="44" Height="44"
                IsVisible="{Binding ShowsPagePlay}">
          <Button Classes="pill" Padding="12"
                  HorizontalAlignment="Center"
                  ToolTip.Tip="Shuffle"
                  Command="{Binding ShuffleViewCommand}">
            <materialIcons:MaterialIcon Classes="chrome" Kind="Shuffle" Width="18" Height="18"/>
          </Button>
        </Border>
        <!-- Every song in the playlist not yet here (MainViewModel.
             PageDownload), shown only while there is one. Its own IsVisible
             is the indicator's answer, so the page gate goes on a wrapper -
             the two are different questions. The Artists page has its own,
             beside its play and shuffle. -->
        <Panel IsVisible="{Binding IsShowingPlaylist}" VerticalAlignment="Center">
          <Border Classes="outlined" Width="44" Height="44"
                  IsVisible="{Binding #PlaylistDownloadButton.IsVisible}">
            <controls:TrackDownloadButton x:Name="PlaylistDownloadButton"
                                          DataContext="{Binding PageDownload}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IconSize="18"
                                          IconPadding="12"
                                          Label="Download all"
                                          DownloadRequested="PageDownload_Requested"/>
          </Border>
        </Panel>
        <!-- Everything queued but the song playing, as the phone's Queue
             menu offers it. -->
        <Button Content="Clear Queue"
                Classes="standard secondary"
                IsVisible="{Binding IsShowingQueue}"
                IsEnabled="{Binding Queue.CanClear}"
                Click="ClearQueue_Click"
                VerticalAlignment="Center"/>
        <!-- The orders the page can be in, as the phone's screen menus
             offer them - see SortButton_Click. -->
        <Border Classes="outlined" Width="40" Height="40"
                IsVisible="{Binding ShowsSortButton}">
          <Button Classes="pill"
                  Padding="11"
                  HorizontalAlignment="Center"
                  ToolTip.Tip="Sort"
                  Click="SortButton_Click">
            <materialIcons:MaterialIcon Classes="chrome" Kind="Sort" Width="16" Height="16"/>
          </Button>
        </Border>
        <usercontrols:FilterControl
          Width="240"
          VerticalAlignment="Center"
          IsVisible="{Binding ShowsPageFilter}"
          FilterText="{Binding FilterText}"/>
      </StackPanel>
    </Grid>

      <!-- The page: the Artists column of names beside a track area, or one
           of the views that take the whole width. -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Artist sub-list. Albums used to share this (plain album-name text
             list) but was replaced by the art-tile grid below, matching
             mobile's own Albums/Recently Added tabs - see MainViewModel's
             IsSubListVisible/IsShowingAlbumGrid doc comments. -->
        <!-- Artists: the column of names under its own heading - the page's
             name, how many artists its filter leaves, and that filter, which
             finds names alone (ArtistFilterText, VisibleSubListItems) - beside
             the picked artist's page, with an A-Z strip down its right edge
             (ScrollIndexBar, as on the phone). -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                IsVisible="{Binding IsSubListVisible}"
                Width="280"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource AppDividerBrush}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="16,32,16,12" Spacing="14">
              <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                <TextBlock Grid.Column="0"
                           Classes="pageTitle"
                           Text="{Binding PageTitle}"
                           FontSize="32"
                           LineHeight="32"
                           LetterSpacing="0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding VisibleSubListItems.Count, StringFormat={}{0:N0}}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,3"/>
              </Grid>
              <usercontrols:FilterControl FilterText="{Binding ArtistFilterText}"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <!-- Each name built once and handed name after name as the list
                   scrolls (RecyclingListBox, UniformRowPanel), as on the phone. -->
              <controls:RecyclingListBox x:Name="SubList"
                       Grid.Column="0"
                       Classes="names"
                       ItemsSource="{Binding VisibleSubListItems}"
                       SelectionMode="Multiple"
                       Background="Transparent"
                       Padding="0,0,0,16"
                       SelectionChanged="SubList_SelectionChanged">
                <ListBox.Styles>
                  <!-- The sidebar's pills: inset, rounded, the selected tint
                       and the name in bold when picked. -->
                  <Style Selector="ListBox.names ListBoxItem">
                    <Setter Property="Margin" Value="12,1,4,0"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="FontSize" Value="14"/>
                  </Style>
                  <Style Selector="ListBox.names ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                  </Style>
                  <Style Selector="ListBox.names ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                  </Style>
                  <Style Selector="ListBox.names ListBoxItem:selected controls|RowText">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:UniformRowPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <!-- The line's height pinned, not the font's own: a name the
                       UI font has no glyphs for (２８１４, 竹内まりや) falls
                       back to a taller system face, and UniformRowPanel takes
                       every row's height from the top one - so scrolling one
                       such name to the top of the window resized the whole
                       list under the pointer. The initials' circle beside it
                       is the row's height. -->
                  <DataTemplate x:DataType="sys:String">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Grid.Column="0"
                              Width="26" Height="26"
                              CornerRadius="13"
                              Background="{DynamicResource AppSelectedBrush}">
                        <TextBlock Text="{Binding Converter={x:Static conv:InitialsConverter.Instance}}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextValueBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                      <controls:RowText Grid.Column="1"
                                        Text="{Binding}"
                                        LineHeight="24"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </controls:RecyclingListBox>
              <controls:ScrollIndexBar x:Name="SubListIndexBar"
                                       Grid.Column="1"
                                       Classes="desktop"
                                       Target="{Binding #SubList}"
                                       ShowsLetters="{Binding ArtistsAreAlphabetical}"
                                       LettersDescending="{Binding ArtistsRunZToA}"
                                       Margin="0,0,4,16"/>
            </Grid>
          </DockPanel>
        </Border>

        <!-- The picked artist's page: who they are - their covers as a round
             collage, the name in the display serif, the red Play and the
             circles to shuffle it all, fetch it and put it in order, then how
             much there is - and then each of their albums as a card: its
             cover, its name and a line about it and its own Play, Shuffle,
             Download and "..." down the left, its songs at the right under a
             band naming their columns (AlbumTrackList, the Albums grid's
             expanded-album list). In the order the Sort button picks. -->
        <ScrollViewer Grid.Column="1" Grid.RowSpan="2"
                      IsVisible="{Binding IsShowingArtistPage}"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="40,40,40,40" Spacing="28">
            <!-- Bound through ArtistPage.Header rather than switching the data
                 context to it: a DataContext binding on the element that also
                 declares the new x:DataType is resolved by Avalonia against
                 the parent's type, but by Rider's inspection against the new
                 one, which then reports ArtistPage.Header as missing. -->
            <Grid IsVisible="{Binding ArtistPage.Header, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ColumnDefinitions="Auto,*">
              <controls:AlbumArtView Grid.Column="0"
                                     Covers="{Binding ArtistPage.Header.Cover.CoverArt}"
                                     Width="132" Height="132"
                                     ArtCornerRadius="66"
                                     Margin="0,0,24,0"/>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <!-- The buttons go under the name when it would not fit
                     beside them. -->
                <controls:TitleToolbarPanel Spacing="16">
                <TextBlock Classes="pageTitle"
                           Text="{Binding ArtistPage.Header.Name}"
                           VerticalAlignment="Center"/>
                <!-- Play, Shuffle and Download by the name, Sort and the
                     filter at the right edge, under the name or beside it. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                  <Button Classes="play pagePlay"
                          Command="{Binding PlayViewCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <materialIcons:MaterialIcon Kind="Play" Width="20" Height="20"/>
                      <TextBlock Text="Play" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Border Classes="outlined" Width="44" Height="44">
                    <Button Classes="pill" Padding="12" HorizontalAlignment="Center"
                            ToolTip.Tip="Shuffle"
                            Command="{Binding ShuffleViewCommand}">
                      <materialIcons:MaterialIcon Classes="chrome" Kind="Shuffle" Width="18" Height="18"/>
                    </Button>
                  </Border>
                  <!-- Everything by them not yet here (MainViewModel.
                       PageDownload), shown only while there is some. -->
                  <Border Classes="outlined" Width="44" Height="44"
                          IsVisible="{Binding #ArtistDownloadButton.IsVisible}">
                    <controls:TrackDownloadButton x:Name="ArtistDownloadButton"
                                                  DataContext="{Binding PageDownload}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IconSize="18"
                                                  IconPadding="12"
                                                  Label="Download all"
                                                  DownloadRequested="PageDownload_Requested"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <!-- The artists' order and their albums' - see
                       SortButton_Click. -->
                  <Border Classes="outlined" Width="40" Height="40">
                    <Button Classes="pill" Padding="11" HorizontalAlignment="Center"
                            ToolTip.Tip="Sort"
                            Click="SortButton_Click">
                      <materialIcons:MaterialIcon Classes="chrome" Kind="Sort" Width="16" Height="16"/>
                    </Button>
                  </Border>
                  <!-- Their songs, by title or album (ArtistPageViewModel
                       .Show); the column's box finds the artists. -->
                  <usercontrols:FilterControl Width="240"
                                              VerticalAlignment="Center"
                                              FilterText="{Binding FilterText}"/>
                </StackPanel>
                </Grid>
                </controls:TitleToolbarPanel>
                <TextBlock Text="{Binding ArtistPage.Header.Summary}"
                           FontSize="14"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Nothing by them matches the filter."
                       IsVisible="{Binding ArtistPage.ShowsNoMatches}"
                       FontSize="14"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>

            <ItemsControl ItemsSource="{Binding ArtistPage.Albums}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtistAlbumSectionViewModel">
                  <Border Background="{DynamicResource AppSidebarBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="18"
                          Padding="28"
                          Margin="0,0,0,28">
                    <Grid ColumnDefinitions="220,*" ColumnSpacing="32">
                      <StackPanel Grid.Column="0" Spacing="14" VerticalAlignment="Top">
                        <controls:AlbumArtView AlbumArt="{Binding Tile.AlbumArt}"
                                               Width="220" Height="220"
                                               ArtCornerRadius="12"/>
                        <StackPanel Spacing="4">
                          <TextBlock Classes="sectionTitle"
                                     Text="{Binding Tile.Name}"
                                     FontSize="22"
                                     ToolTip.Tip="{Binding Tile.Name}"/>
                          <TextBlock Text="{Binding Meta}"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                          <Button Classes="play pagePlay"
                                  Click="ArtistAlbumPlay_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <materialIcons:MaterialIcon Kind="Play" Width="20" Height="20"/>
                              <TextBlock Text="Play" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Border Classes="outlined" Width="44" Height="44">
                            <Button Classes="pill" Padding="12" HorizontalAlignment="Center"
                                    ToolTip.Tip="Shuffle album"
                                    Click="ArtistAlbumShuffle_Click">
                              <materialIcons:MaterialIcon Classes="chrome" Kind="Shuffle" Width="18" Height="18"/>
                            </Button>
                          </Border>
                          <!-- The album's own indicator, shown while it has
                               songs to fetch (TrackDownloadButton). -->
                          <Border Classes="outlined" Width="44" Height="44"
                                  IsVisible="{Binding #AlbumCardDownload.IsVisible}">
                            <controls:TrackDownloadButton x:Name="AlbumCardDownload"
                                                          DataContext="{Binding Tile}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IconSize="18"
                                                          IconPadding="12"
                                                          Label="Download album"
                                                          DownloadRequested="ArtistAlbumDownload_Requested"/>
                          </Border>
                          <Border Classes="outlined" Width="44" Height="44">
                            <Button Classes="pill" Padding="12" HorizontalAlignment="Center"
                                    ToolTip.Tip="More"
                                    Click="ArtistAlbumMenu_Click">
                              <materialIcons:MaterialIcon Classes="chrome" Kind="DotsVertical" Width="18" Height="18"/>
                            </Button>
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <!-- The songs' column names over a hairline; the
                             widths are AlbumTrackList's row template's - the
                             number, the download well, the title, the time,
                             the "...". -->
                        <Border BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                Height="36"
                                Margin="0,0,0,6"
                                Padding="8,0,36,0">
                          <Grid ColumnDefinitions="Auto,20,*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="#" MinWidth="26" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Title" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Duration" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                          </Grid>
                        </Border>
                        <controls:AlbumTrackList ShowsNumbers="True"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Album art tile grid for Albums, alphabetical (see
             MainViewModel.AlbumGridTiles). Spans both columns - unlike the
             track list, this view never has a sub-list pane alongside it.
             Clicking a tile expands that album's songs in place (ExpandedKey/
             ExpandedTracks - see AlbumGridRowControl for the actual
             expand/collapse animation) rather than navigating to a separate
             track-list view, so the grid stays visible the whole time. It also
             gets the full multi-select + drag-to-playlist gesture (the old
             SubList's own gesture, restored here) - see MainView.axaml.cs's
             AlbumGrid_Pointer* handlers. -->
        <controls:AlbumGridView x:Name="AlbumGrid"
                                Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                                IsVisible="{Binding IsShowingAlbumGrid}"
                                ItemsSource="{Binding AlbumGridTiles}"
                                SelectedNames="{Binding SelectedSubItems}"
                                ExpandedKey="{Binding ExpandedAlbumKey}"
                                ExpandedTracks="{Binding ExpandedAlbumTracks}"
                                Availability="{Binding Availability}"
                                CurrentlyPlayingTrackId="{Binding CurrentlyPlayingTrack.Id}"
                                Margin="0,0,36,0"/>
        <!-- Its A-Z strip, down the right of the page beside the grid rather
             than over it, so it never scrolls (ScrollIndexBar). Pointed at
             the grid's rows, and told where a letter is, in the code-behind. -->
        <controls:ScrollIndexBar x:Name="AlbumGridIndexBar"
                                 Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                                 Classes="desktop"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding IsShowingAlbumGrid}"
                                 ShowsLetters="{Binding AlbumGridIsAlphabetical}"
                                 LettersDescending="{Binding AlbumGridRunsZToA}"
                                 Margin="0,0,12,16"/>

        <!-- Search: the whole library's albums, artists and songs for what is
             typed - see SearchView. -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsShowingSearch}">
          <views:SearchView x:Name="SearchPage"/>
        </Panel>

        <!-- Home: Continue Playing, Recently Played, Recently Added - see
             HomeViewModel. -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsShowingHome}">
          <views:HomeView DataContext="{Binding Home}"/>
        </Panel>

        <!-- Custom track list - Songs/Artists/Playlists only now; Albums
             shows its songs inline via the grid above instead. Hidden (not just covered) when showing device detail -
             MusicListView draws its own column-header row internally, and
             the panels that replace it only inset by their own Margin,
             leaving that header row visible peeking above it otherwise. -->
        <controls:MusicListView Grid.Column="1" Grid.Row="1"
                                x:Name="MusicList"
                                Margin="38,0,16,0"
                                IsVisible="{Binding IsShowingTrackList}"
                                SelectedTrack="{Binding SelectedTrack, Mode=TwoWay}"/>

        <!-- The Queue page with nothing playing - the phone's Queue tab says
             the same (QueueViewModel.EmptyTitle/EmptyMessage). -->
        <StackPanel Grid.Column="1" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" Opacity="0.6" MaxWidth="360">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsShowingQueue"/>
              <Binding Path="Queue.IsEmpty"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <materialIcons:MaterialIcon Kind="PlaylistMusicOutline" Width="40" Height="40"/>
          <TextBlock Text="{x:Static vm:QueueViewModel.EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{x:Static vm:QueueViewModel.EmptyMessage}"
                     FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <!-- The browser's Server Settings page: the same SettingsPanel the
             device-detail pane above hosts, shown here because a tab's sidebar
             has a row for it (see MainViewModel.IsShowingServerSettings).

             A page in the content area rather than the full-view overlay this
             replaced, so the top bar stays on screen - what is being
             administered is the server a track is streaming from, and taking
             away pause and the seek bar to configure it was the wrong trade.
             Scrolls, because the panel is taller than a short window and the
             OK/Cancel row lives at its bottom.

             Filled in from code-behind (UpdateServerSettingsPage) for the same
             reason ServerSettingsHost is: SettingsPanel takes its ViewModel
             through a constructor. -->
        <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                      IsVisible="{Binding IsShowingServerSettings}"
                      HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="ServerSettingsPageHost"
                          Margin="24"
                          MaxWidth="620"
                          HorizontalAlignment="Left"/>
        </ScrollViewer>

        <!-- Device detail: shown instead of the track list when a Devices/Server
             sidebar row is selected. The server itself - who it is, pairing, the
             codes it hands out - and then its own settings, administered in
             place (see MainViewModel.SelectedServerSettings). Its music is
             deliberately not here: a paired server's tracks are merged into the
             library by LibrarySyncService and play from the ordinary track list,
             so browsing them again under the sidebar row was the same catalog
             twice. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
              IsVisible="{Binding IsShowingDeviceDetail}"
              Margin="28,24,28,16" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- SelectedSidebarItem.Name, not SelectedDevice.Alias - the sidebar
                     row already resolves a local nickname override (DeviceNicknameStore)
                     over the peer's raw self-reported alias and keeps it live-updated
                     on rename; SelectedDevice.Alias is that raw, unresolved value. -->
                <TextBlock Classes="sectionTitle" Text="{Binding SelectedSidebarItem.Name}" FontSize="26" VerticalAlignment="Center"/>
                <!-- Reachable/unreachable come from the selected sidebar row
                     itself (SidebarItem.ShowReachableIcon/ShowUnreachableIcon),
                     the same two properties the row's own glyph binds, so the
                     header and the sidebar cannot disagree. This used to bind
                     IsSelectedDeviceTrustConfirmed, which is about the pairing
                     rather than the server being there, and so showed a green
                     check beside a sidebar warning for a server that had gone
                     away. Busy is the one addition: a pairing still awaiting
                     approval spins here as well as a sync, which is why the
                     pairing row further down no longer carries a spinner of
                     its own. After the name, the way the sidebar row puts it. -->
                <controls:ConnectionStatusIcon
                    IsConnected="{Binding SelectedSidebarItem.ShowReachableIcon}"
                    IsUnreachable="{Binding SelectedSidebarItem.ShowUnreachableIcon}"
                    IsBusy="{Binding IsSelectedDeviceBusy}"
                    IconSize="18"
                    VerticalAlignment="Center"/>
              </StackPanel>
              <!-- Collapsed rather than blank with no live endpoint (the
                   pinned row of a paired server that has dropped off the
                   network): an empty line still takes its height. -->
              <TextBlock Text="{Binding SelectedDevice.Origin}" FontSize="12"
                         FontFamily="{DynamicResource AppMonospaceFontFamily}"
                         Foreground="{DynamicResource AppTextValueBrush}"
                         IsVisible="{Binding SelectedDevice, Converter={x:Static avc:ObjectConverters.IsNotNull}}"/>
              <!-- The key this device actually pinned, so it can be compared
                   against what the server says about itself. Only useful for a
                   pairing made with a bare code - one made from a flower://
                   invite checked it before pinning anything - but it is shown
                   either way rather than conditionally, since the app does not
                   record which was used and a check offered only sometimes is
                   one nobody learns to make. See
                   PeerSyncCoordinator.PairedServerPinnedFingerprint. -->
              <StackPanel Orientation="Horizontal" Spacing="5"
                          IsVisible="{Binding HasSelectedDevicePinnedFingerprint}">
                <TextBlock Text="Verified as" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <SelectableTextBlock Text="{Binding SelectedDevicePinnedFingerprint}"
                                     FontSize="12" FontFamily="{DynamicResource AppMonospaceFontFamily}"
                                     Foreground="{DynamicResource AppTextValueBrush}"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="The server identity this device pinned when it paired. Every later connection is checked against it. Compare it with the fingerprint the server shows in its own settings."/>
              </StackPanel>
            </StackPanel>
            <!-- Only shown for a peer advertising Server mode, while this device
                 is a Client (see MainViewModel.CanPairWithSelectedDevice) - mirrors
                 ServerPickerView's Pair/Unpair button (Settings' Devices tab) so
                 pairing doesn't require a trip to Settings. -->
            <!-- Pairing code (see MainViewModel.IsPairingCodeRequired): there
                 is nobody in front of a server to tap Allow, so an admin issues
                 a one-time code out of band and this redeems it. Hidden once
                 paired, when there is nothing left to redeem. -->
            <!-- Wide enough for a whole flower:// invite, not just the five
                 characters of a code. The cap used to be 20, which silently
                 truncated a pasted link into something that could only fail as
                 a bad code - see PairingEntry, which is what reads either. -->
            <controls:TextInput Text="{Binding PairingCode}"
                                PlaceholderText="Pairing code or link"
                                IsVisible="{Binding IsPairingCodeRequired}"
                                Width="180" MaxLength="400"
                                KeyDown="PairingCodeBox_KeyDown"
                                Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="{Binding PairActionLabel}"
                    Classes="standard secondary"
                    IsVisible="{Binding CanPairWithSelectedDevice}"
                    IsEnabled="{Binding IsPairActionEnabled}"
                    Click="PairActionButton_Click"
                    Margin="8,0,0,0" VerticalAlignment="Center"/>
            <!-- A wrong or expired code is an ordinary outcome, so it is said
                 plainly next to the box rather than raised as a dialog. -->
            <SelectableTextBlock Text="{Binding PairingCodeError}"
                       IsVisible="{Binding PairingCodeError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource AppErrorBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding PairActionHint}"
                       IsVisible="{Binding PairActionHint, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <!-- Only for a server this device has already paired with (see
                 MainViewModel.CanOpenSelectedServerSettings). Now that the
                 settings themselves are on this page, what it still does that
                 the panel below cannot is pair a *browser tab* as an
                 administrator, which is the only way into this server from a
                 machine that is not running Flower. It issues a one-time
                 admin pairing code and opens the server's own page in the OS
                 browser, where the tab spends that code on a keypair of its
                 own. -->
            <Button Content="Open in Browser…"
                    Classes="standard secondary"
                    ToolTip.Tip="Pairs a browser tab with this server as an administrator and opens its settings page there."
                    IsVisible="{Binding CanOpenSelectedServerSettings}"
                    IsEnabled="{Binding IsOpenSelectedServerSettingsEnabled}"
                    Click="ServerSettingsButton_Click"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
            <!-- "Paired, but not an administrator of that server" is the common
                 case here, and it is an ordinary outcome rather than a fault -
                 said plainly next to the button, same as PairingCodeError. -->
            <SelectableTextBlock Text="{Binding ServerSettingsError}"
                       IsVisible="{Binding ServerSettingsError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource AppErrorBrush}" FontSize="12" TextWrapping="Wrap"
                       MaxWidth="260"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <!-- The server's own settings: the same SettingsPanel its browser UI
               serves, over a RemoteServerSettingsBackend. Filled in from
               code-behind (UpdateServerSettingsPane) rather than declared here,
               since SettingsPanel takes its ViewModel through a constructor. -->
          <ContentControl Grid.Row="1" x:Name="ServerSettingsHost"/>

          <!-- Why there is no panel, when there is none: a server that has not
               approved this device yet has nothing it will let us read, and one
               that has approved us but not as an administrator says so itself. -->
          <SelectableTextBlock Grid.Row="1" x:Name="ServerSettingsMessage"
                     Opacity="0.6" FontSize="13" TextWrapping="Wrap"
                     VerticalAlignment="Top"/>

        </Grid>
      </Grid>

      </Grid>

      <!-- Status bar: what the app is busy with - a rescan, a sync, an import -
           as a tab at the bottom right of the page, only as wide as what it
           says. It slides up when a message arrives, stays while the work
           goes on, and slides back down a second after it ends
           (ShowStatusMessage in the code-behind), so it is never a strip of
           empty chrome. Over the page rather than in a row of its own, and
           clipped by this panel so the slide happens below the page's edge,
           not across the player bar when that sits at the bottom. -->
      <Panel Grid.Row="1" Grid.Column="2"
             ClipToBounds="True"
             IsHitTestVisible="False">
        <Border x:Name="StatusBar"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Padding="12,5,16,5"
                CornerRadius="6,0,0,0"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource AppDividerBrush}"
                Background="{DynamicResource AppSurfaceBrush}"
                RenderTransform="translateY(40px)">
          <Border.Transitions>
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform"
                                             Duration="0:0:0.2"
                                             Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <Border.Styles>
            <Style Selector="Border#StatusBar.shown">
              <Setter Property="RenderTransform" Value="translateY(0px)"/>
            </Style>
          </Border.Styles>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <materialIcons:MaterialIcon x:Name="SpinnerIcon"
                                        Kind="Sync"
                                        Width="13" Height="13"
                                        Opacity="0.55"/>
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Opacity="0.55"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Panel>

      <!-- The frame-rate readout Settings can turn on (MainViewModel.
           ShowsFrameMeter), over the page's top edge, centred - the phone's,
           under its status bar. -->
      <controls:FrameMeter Grid.Row="1" Grid.Column="2"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           IsHitTestVisible="False"
                           IsVisible="{Binding ShowsFrameMeter}"/>

      <!-- Floating "what you're dragging" ghost for the drag-onto-playlist gesture
           (see MusicListView's TrackDragFormat / MainView.axaml.cs's
           ContentGrid_DragOver). Spans all 3 columns of ContentGrid so it can
           follow the cursor from the track list all the way to the sidebar. -->
      <Border x:Name="DragGhost"
              Grid.ColumnSpan="3"
              Grid.RowSpan="3"
              IsVisible="False"
              IsHitTestVisible="False"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,6"
              BoxShadow="{DynamicResource AppDropdownShadow}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="MusicNote" Width="14" Height="14" VerticalAlignment="Center"/>
          <TextBlock x:Name="DragGhostText"
                     FontSize="12"
                     VerticalAlignment="Center"
                     MaxWidth="220"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Browser only: the whole page, for a tab the server does not know (see
         MainViewModel's browser pairing section). Over every row and opaque,
         because everything underneath could only be empty or refused - the
         library, the transport, the settings. What remains is the one thing
         such a tab can do: take a pairing code. Or, when the page cannot hold
         a key at all, say so instead of offering a box no code would help.
         Blank until the server has said which (BrowserPairingViewModel.IsChecking). -->
    <Border DataContext="{Binding BrowserPairing}"
            x:DataType="vm:BrowserPairingViewModel"
            IsVisible="{Binding CoversPage}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <ScrollViewer IsVisible="{Binding ShowsScreen}">
        <StackPanel MaxWidth="520" Margin="24,48" Spacing="16" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <materialIcons:MaterialIcon Kind="LinkVariant" Width="28" Height="28"/>
            <TextBlock Text="Pair this browser" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding CanEnterCode}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="BrowserPairingCodeBox"
                       Text="{Binding Code}"
                       Watermark="Pairing code"
                       FontSize="18"
                       IsEnabled="{Binding !IsPairing}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding PairCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Content="Pair" Margin="8,0,0,0"
                      Classes="standard primary"
                      Command="{Binding PairCommand}"
                      IsEnabled="{Binding !IsPairing}"/>
            </Grid>
            <SelectableTextBlock Text="{Binding Error}"
                                 IsVisible="{Binding Error, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                                 Foreground="{DynamicResource AppErrorBrush}" TextWrapping="Wrap"/>
            <SelectableTextBlock Text="{x:Static vm:BrowserPairingViewModel.Help}"
                                 TextWrapping="Wrap" Opacity="0.8"/>
          </StackPanel>

          <SelectableTextBlock Text="{Binding CannotPairReason}"
                               IsVisible="{Binding CannotPairReason, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                               TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

  </Grid>

</UserControl>
