<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:usercontrols="clr-namespace:Flower.UserControls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:services="clr-namespace:Flower.Services;assembly=Flower.Core"
             mc:Ignorable="d"
             x:Class="Flower.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <!-- Continuous rotation while a sidebar Device row's IsSyncing is true -
         see SidebarItem.IsSyncing. Same "MaterialIcon Kind=Sync, spinning"
         visual as the status-bar busy spinner and ServerPickerView/mobile
         SettingsView's own sync spinners, done declaratively here since
         sidebar rows are ordinary bound ItemTemplate instances, not stable
         named elements a DispatcherTimer could target. -->
    <Style Selector="materialIcons|MaterialIcon.spinning">
      <Setter Property="RenderTransform" Value="rotate(0deg)"/>
    </Style>
    <Style Selector="materialIcons|MaterialIcon.spinning">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Grid.Row="0"
            Padding="4,10,4,10"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <usercontrols:PlaylistControls
            x:Name="PlaybackControls"
            DataContext="{Binding PlaybackControls}"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Margin="8,0,4,0"/>
        </StackPanel>

        <usercontrols:CurrentlyPlayingControl
          DataContext="{Binding NowPlaying}"
          Grid.Column="1"
          Margin="12,0,12,0"
          VerticalAlignment="Center"
          HorizontalAlignment="Stretch" />

        <usercontrols:FilterControl
          Grid.Column="2"
          Margin="8,0,8,0"
          VerticalAlignment="Center"
          HorizontalAlignment="Right"
          MinWidth="180"
          FilterText="{Binding FilterText}"/>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="2"
            Padding="8,4,8,4"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Grid>
        <StackPanel Orientation="Horizontal"
                    IsVisible="{Binding IsBusy}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Spacing="5">
          <materialIcons:MaterialIcon x:Name="SpinnerIcon"
                                      Kind="Sync"
                                      Width="13" Height="13"
                                      Opacity="0.55"/>
          <TextBlock Text="{Binding BusyMessage}"
                     FontSize="11"
                     Opacity="0.55"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusBarText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Opacity="0.6"/>
        <usercontrols:VolumeControl
          DataContext="{Binding Volume}"
          VerticalAlignment="Center"
          HorizontalAlignment="Right"
          Height="16"
          Width="140" />
      </Grid>
    </Border>

    <!-- Content row: sidebar + main area -->
    <Grid Grid.Row="1" x:Name="ContentGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" MinWidth="120" MaxWidth="280"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0"
              BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <Panel>
          <ListBox x:Name="SidebarList"
                   ItemsSource="{Binding SidebarItems}"
                   SelectedItem="{Binding SelectedSidebarItem, Mode=TwoWay}"
                   Background="Transparent"
                   Padding="0,4,0,4"
                   SelectionChanged="SidebarList_SelectionChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SidebarItem">
                <Panel>
                  <!-- Highlighted while a dragged track hovers this playlist row -->
                  <Border IsVisible="{Binding IsDropTarget}"
                          Background="{DynamicResource AppAccentBrush}"
                          Opacity="0.25"
                          CornerRadius="4"
                          Margin="4,1"
                          IsHitTestVisible="False"/>
                  <TextBlock Text="{Binding Name}"
                             IsVisible="{Binding IsHeader}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Opacity="0.55"
                             Margin="12,14,8,4"
                             LetterSpacing="0.8"/>
                  <StackPanel IsVisible="{Binding IsSelectable}"
                              Orientation="Horizontal"
                              Margin="12,5,8,5">
                    <materialIcons:MaterialIcon Kind="{Binding Icon}"
                                               Width="16" Height="16"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                        <TextBlock Text="{Binding Name}"/>
                        <materialIcons:MaterialIcon Kind="Sync"
                                                     Classes="spinning"
                                                     Width="11" Height="11"
                                                     Opacity="0.55"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsSyncing}"/>
                        <!-- Paired-server reachability - see SidebarItem.
                             ShowReachableIcon/ShowUnreachableIcon. Only ever
                             set on the one Device row for MainViewModel's
                             paired Server, which (unlike an ordinary
                             Devices/Server row) stays in the sidebar even
                             while unreachable. -->
                        <materialIcons:MaterialIcon Kind="CheckCircle"
                                                     Width="11" Height="11"
                                                     Foreground="{DynamicResource AppSuccessBrush}"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding ShowReachableIcon}"/>
                        <materialIcons:MaterialIcon Kind="AlertCircle"
                                                     Width="11" Height="11"
                                                     Foreground="{DynamicResource AppWarningBrush}"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding ShowUnreachableIcon}"/>
                      </StackPanel>
                      <TextBox Text="{Binding Name, Mode=TwoWay}"
                               IsVisible="{Binding IsEditing}"
                               VerticalContentAlignment="Center"
                               Height="20"
                               MinHeight="0"
                               Padding="4,0"
                               MinWidth="80"
                               SelectionBrush="{DynamicResource AppAccentMutedBrush}"
                               SelectionForegroundBrush="{DynamicResource AppTextPrimaryBrush}"
                               Loaded="RenameBox_Loaded"
                               KeyDown="RenameBox_KeyDown"
                               LostFocus="RenameBox_LostFocus"/>
                      <!-- Only ever set (see MainViewModel.RefreshDeviceDisplayNames)
                           when this device's name collides with another
                           currently-listed device - shows its IP so they can
                           be told apart. -->
                      <TextBlock Text="{Binding Subtitle}"
                                 IsVisible="{Binding Subtitle, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                                 FontSize="10"
                                 Opacity="0.55"/>
                    </StackPanel>
                  </StackPanel>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Drop-onto-empty-space cue for the drag-a-track-onto-the-sidebar
               gesture (see MainView.axaml.cs's GetPlaylistsDropBand /
               HitTestSidebarDrop). Shown while a track is dragged over the
               Playlists section but not over one specific playlist row -
               including the section's empty tail below the last playlist, or
               the whole section when there are no playlists yet - meaning the
               drop will create a new playlist rather than add to one. -->
          <Border x:Name="NewPlaylistDropZone"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  ClipToBounds="True"
                  Background="{DynamicResource AppAccentSoftBrush}"
                  BorderBrush="{DynamicResource AppAccentBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  VerticalAlignment="Top"
                  Margin="4,1">
            <TextBlock Text="New Playlist"
                       FontSize="11"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </Panel>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="4"
                    Background="Transparent"
                    ResizeDirection="Columns"/>

      <!-- Main content: optional sub-list + track area -->
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Artist sub-list. Albums used to share this (plain album-name text
             list) but was replaced by the art-tile grid below, matching
             mobile's own Albums/Recently Added tabs - see MainViewModel's
             IsSubListVisible/IsShowingAlbumGrid doc comments. -->
        <Border Grid.Column="0"
                IsVisible="{Binding IsSubListVisible}"
                Width="200"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
          <ListBox x:Name="SubList"
                   ItemsSource="{Binding SubListItems}"
                   SelectionMode="Multiple"
                   Background="Transparent"
                   SelectionChanged="SubList_SelectionChanged"/>
        </Border>

        <!-- Album art tile grid - Albums and Recently Added both use this,
             alphabetical vs. by-recency (see MainViewModel.AlbumGridTiles/
             RecentlyAddedGridTiles). Spans both columns - unlike the track
             list, this view never has a sub-list pane alongside it. Clicking
             a tile expands that album's songs in place (ExpandedName/
             ExpandedTracks - see AlbumGridRowControl for the actual
             expand/collapse animation) rather than navigating to a separate
             track-list view, so both grids stay visible the whole time; only
             one album across either grid can be expanded at once
             (MainViewModel.ExpandedAlbumName is shared by both). Both
             instances also get the full multi-select + drag-to-playlist
             gesture (the old SubList's own gesture, restored here) - see
             MainView.axaml.cs's AlbumGrid_Pointer* handlers, shared by both
             rather than being an Albums-only feature. -->
        <controls:AlbumGridView x:Name="AlbumGrid"
                                Grid.Column="0" Grid.ColumnSpan="2"
                                IsVisible="{Binding IsShowingAlbumGrid}"
                                ItemsSource="{Binding AlbumGridTiles}"
                                SelectedNames="{Binding SelectedSubItems}"
                                ExpandedName="{Binding ExpandedAlbumName}"
                                ExpandedTracks="{Binding ExpandedAlbumTracks}"
                                Availability="{Binding Availability}"
                                CurrentlyPlayingTrackId="{Binding CurrentlyPlayingTrack.Id}"/>
        <controls:AlbumGridView x:Name="RecentlyAddedGrid"
                                Grid.Column="0" Grid.ColumnSpan="2"
                                IsVisible="{Binding IsShowingRecentlyAddedGrid}"
                                ItemsSource="{Binding RecentlyAddedGridTiles}"
                                SelectedNames="{Binding SelectedSubItems}"
                                ExpandedName="{Binding ExpandedAlbumName}"
                                ExpandedTracks="{Binding ExpandedAlbumTracks}"
                                Availability="{Binding Availability}"
                                CurrentlyPlayingTrackId="{Binding CurrentlyPlayingTrack.Id}"/>

        <!-- Custom track list - Songs/Artists/Playlists only now; Albums/
             Recently Added show their songs inline via the grids above
             instead. Hidden (not just covered) when showing device detail -
             MusicListView draws its own column-header row internally, and
             the panels that replace it only inset by their own Margin,
             leaving that header row visible peeking above it otherwise. -->
        <controls:MusicListView Grid.Column="1"
                                x:Name="MusicList"
                                IsVisible="{Binding IsShowingTrackList}"
                                SelectedTrack="{Binding SelectedTrack, Mode=TwoWay}"/>

        <!-- Device detail: shown instead of the track list when a Devices/Server
             sidebar row is selected. Live browse/stream of that peer's catalog (see
             PeerLibraryViewModel) - unrestricted by Client/Server role/pairing,
             deliberately separate from the bulk LibrarySyncService merge (see
             SyncRolePolicy). -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              IsVisible="{Binding IsShowingDeviceDetail}"
              Margin="24" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
            <!-- Server vs. plain-device icon - see MainViewModel.DeviceSidebarIcon;
                 SelectedSidebarItem.Icon is the same one shown in the sidebar row. -->
            <materialIcons:MaterialIcon Kind="{Binding SelectedSidebarItem.Icon}" Width="28" Height="28" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Only once the paired server has actually approved this
                     device (see MainViewModel.IsSelectedDeviceTrustConfirmed)
                     - not just requested, which is IsSelectedDevicePaired
                     alone (see PairActionLabel's "Waiting for server..."
                     state below). -->
                <materialIcons:MaterialIcon Kind="CheckCircle"
                                             Width="16" Height="16"
                                             Foreground="#4CAF50"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsSelectedDeviceTrustConfirmed}"/>
                <!-- SelectedSidebarItem.Name, not SelectedDevice.Alias - the sidebar
                     row already resolves a local nickname override (DeviceNicknameStore)
                     over the peer's raw self-reported alias and keeps it live-updated
                     on rename; SelectedDevice.Alias is that raw, unresolved value. -->
                <TextBlock Text="{Binding SelectedSidebarItem.Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{Binding SelectedDevice.Origin}" Opacity="0.5" FontSize="13"/>
            </StackPanel>
            <!-- Only shown for a peer advertising Server mode, while this device
                 is a Client (see MainViewModel.CanPairWithSelectedDevice) - mirrors
                 ServerPickerView's Pair/Unpair button (Settings' Devices tab) so
                 pairing doesn't require a trip to Settings. -->
            <!-- Pairing code, for a headless Flower.Server only (see
                 MainViewModel.IsPairingCodeRequired): there is nobody in front
                 of a server to tap Allow, so an admin issues a one-time code
                 out of band and this redeems it. An app peer keeps the live
                 approval prompt and shows no box at all. -->
            <TextBox Text="{Binding PairingCode}"
                     PlaceholderText="Pairing code"
                     IsVisible="{Binding IsPairingCodeRequired}"
                     Width="140" MaxLength="20"
                     KeyDown="PairingCodeBox_KeyDown"
                     Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="{Binding PairActionLabel}"
                    IsVisible="{Binding CanPairWithSelectedDevice}"
                    IsEnabled="{Binding IsPairActionEnabled}"
                    Click="PairActionButton_Click"
                    Margin="8,0,0,0" VerticalAlignment="Center"/>
            <!-- A wrong or expired code is an ordinary outcome, so it is said
                 plainly next to the box rather than raised as a dialog. -->
            <TextBlock Text="{Binding PairingCodeError}"
                       IsVisible="{Binding PairingCodeError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Foreground="#E57373" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <!-- Spinner while a pairing request has been sent but the server
                 hasn't approved it yet - see MainViewModel.IsPairAwaitingApproval.
                 Same "MaterialIcon Kind=Sync, spinning" visual as the sidebar's
                 own IsSyncing spinner (see this file's Styles block). -->
            <materialIcons:MaterialIcon Kind="Sync"
                                         Classes="spinning"
                                         Width="14" Height="14"
                                         Opacity="0.55"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsPairAwaitingApproval}"/>
            <TextBlock Text="{Binding PairActionHint}"
                       IsVisible="{Binding PairActionHint, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <!-- Only for a headless Flower.Server this device has already paired
                 with (see MainViewModel.CanOpenSelectedServerSettings): its
                 settings live in its own browser UI, not in this app, so this
                 issues a one-time admin pairing code against it and opens that
                 page in the OS browser, where the tab spends the code on a
                 keypair of its own. An app peer has its own Settings window on
                 its own screen and shows nothing here. -->
            <Button Content="Server Settings…"
                    IsVisible="{Binding CanOpenSelectedServerSettings}"
                    IsEnabled="{Binding !IsOpeningServerSettings}"
                    Click="ServerSettingsButton_Click"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
            <!-- "Paired, but not an administrator of that server" is the common
                 case here, and it is an ordinary outcome rather than a fault -
                 said plainly next to the button, same as PairingCodeError. -->
            <TextBlock Text="{Binding ServerSettingsError}"
                       IsVisible="{Binding ServerSettingsError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Foreground="#E57373" FontSize="12" TextWrapping="Wrap"
                       MaxWidth="260"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <!-- Adding somebody else's device to this server, from the one
                 place its administrator already is. Issues an ordinary
                 (non-admin) one-time code and shows it to be read out or
                 typed on the device being added - see
                 MainViewModel.InviteDeviceToSelectedServerAsync. Shown under
                 the same conditions as "Server Settings…" above, including
                 the deliberate absence of an is-this-device-an-admin check. -->
            <Button Content="Add Device…"
                    IsVisible="{Binding CanInviteDeviceToSelectedServer}"
                    IsEnabled="{Binding !IsIssuingPairingCode}"
                    Click="AddDeviceButton_Click"
                    Margin="8,0,0,0" VerticalAlignment="Center"/>
            <!-- Selectable: it is as often pasted into a chat message as it is
                 read aloud. Monospace at size for both - see
                 PairingCodeService's alphabet, chosen so it survives being
                 dictated over the phone. -->
            <SelectableTextBlock Text="{Binding IssuedPairingCode}"
                                 IsVisible="{Binding IssuedPairingCode, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                                 FontFamily="monospace" FontSize="16" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding IssuedPairingCodeError}"
                       IsVisible="{Binding IssuedPairingCodeError, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                       Foreground="#E57373" FontSize="12" TextWrapping="Wrap"
                       MaxWidth="260"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <TextBlock Grid.Row="1" Text="{Binding PeerLibrary.ErrorMessage}"
                     IsVisible="{Binding PeerLibrary.ErrorMessage, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                     Opacity="0.6" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>

          <Grid Grid.Row="1" ColumnDefinitions="220,*"
                IsVisible="{Binding PeerLibrary.ErrorMessage, Converter={x:Static avc:ObjectConverters.IsNull}}">
            <ListBox Grid.Column="0" x:Name="PeerAlbumList"
                     ItemsSource="{Binding PeerLibrary.Albums}"
                     SelectedItem="{Binding PeerLibrary.SelectedAlbum}"
                     SelectionChanged="PeerAlbumList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="services:AlbumID3">
                  <StackPanel Spacing="2" Margin="0,4">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox Grid.Column="1" x:Name="PeerSongList" Margin="16,0,0,0"
                     ItemsSource="{Binding PeerLibrary.AlbumSongs}"
                     DoubleTapped="PeerSongList_DoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="services:Child">
                  <Grid ColumnDefinitions="32,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Track}" Opacity="0.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Opacity="0.5"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Grid>

      <!-- Floating "what you're dragging" ghost for the drag-onto-playlist gesture
           (see MusicListView's TrackDragFormat / MainView.axaml.cs's
           ContentGrid_DragOver). Spans all 3 columns of ContentGrid so it can
           follow the cursor from the track list all the way to the sidebar. -->
      <Border x:Name="DragGhost"
              Grid.ColumnSpan="3"
              IsVisible="False"
              IsHitTestVisible="False"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,6"
              BoxShadow="0 2 8 0 #40000000">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="MusicNote" Width="14" Height="14" VerticalAlignment="Center"/>
          <TextBlock x:Name="DragGhostText"
                     FontSize="12"
                     VerticalAlignment="Center"
                     MaxWidth="220"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Full-page settings, for a single-view host. On desktop Settings is a
         SettingsWindow; Avalonia.Browser has no second Window to open at all, so
         the same SettingsPanel is laid over the whole view instead. Opaque, not a
         scrim - it is a screen, not a dialog. See MainView.axaml.cs's
         ShowSettingsOverlay, which is also how the server's own settings page is
         shown when the client's "Server Settings..." button opens this app with
         page=settings in the URL fragment. -->
    <Border x:Name="SettingsOverlay"
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="False"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <ContentControl x:Name="SettingsOverlayHost" MaxWidth="620"/>
    </Border>
  </Grid>

</UserControl>
