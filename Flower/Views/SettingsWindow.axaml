<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Flower.Views"
        x:Class="Flower.Views.SettingsWindow"
        Title="Settings"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <!-- Nothing but a frame. The screen itself is SettingsPanel, which is shared
       with the browser UI, where Avalonia is single-view and this Window cannot
       exist at all - see SettingsPanel.axaml. -->
  <views:SettingsPanel x:Name="Panel"/>
</Window>
