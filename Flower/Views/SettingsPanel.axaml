<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:Flower.Views"
             x:Class="Flower.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

  <!-- The settings screen itself, hosted twice: by SettingsWindow on desktop, and
       full-page by MainView in the browser, where Avalonia is single-view and
       there is no second Window to open. Which tabs and controls appear is decided
       entirely by SettingsViewModel.Capabilities, so administering a headless
       Flower.Server from a browser runs this exact XAML rather than a second,
       drifting copy of it. -->
  <Grid RowDefinitions="*,Auto,Auto" Margin="16">

    <TabControl Grid.Row="0" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

      <TabItem Header="General" x:Name="GeneralTab">
        <!-- Scrolls like every other tab here: a server's General tab carries the
             address list as well, which is as tall as the server has origins. -->
        <ScrollViewer>
        <StackPanel Margin="0,12,0,0" Spacing="0">
          <!-- Label above its control, like Theme below and every other field on
               this screen - the one place that put them side by side needed a
               caption underneath to say what the field was for. -->
          <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox Text="{Binding Alias, Mode=TwoWay}"/>

          <TextBlock Text="Theme"
                     FontWeight="SemiBold"
                     Margin="0,20,0,8"
                     IsVisible="{Binding Capabilities.ThemePicker}"/>
          <ComboBox HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                    IsVisible="{Binding Capabilities.ThemePicker}">
            <ComboBoxItem Content="Follow System"/>
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="Dark"/>
          </ComboBox>

          <!-- On by default: whoever runs the server is the one who ends up
               diagnosing a listener's phone, and a listener cannot be asked to
               find a log file. Still a switch, because the snapshot carries
               exception text and absolute file paths (see
               AppSettings.ShareLogsWithPairedServer). -->
          <CheckBox Content="Send logs to paired server"
                    Margin="0,20,0,0"
                    IsChecked="{Binding ShareLogsWithPairedServer, Mode=TwoWay}"
                    IsVisible="{Binding Capabilities.PairedServerPicker}"/>
          <TextBlock Text="Lets whoever runs the server read this device's error log when something breaks. It contains file names from this device."
                     Margin="0,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                     IsVisible="{Binding Capabilities.PairedServerPicker}"/>

          <!-- "Where does my data live" is a general, not library-specific,
               question. Shown as a button on the machine you are sitting at, and
               as plain text for a server you are not - a file manager on this
               machine cannot open a path on that one. -->
          <Button Content="Open App Data Location"
                  Margin="0,20,0,0"
                  HorizontalAlignment="Left"
                  Click="OpenAppDataLocationButton_Click"
                  IsVisible="{Binding Capabilities.RevealAppDataLocation}"/>

          <TextBlock Text="Data directory"
                     FontWeight="SemiBold" Margin="0,20,0,4"
                     IsVisible="{Binding !Capabilities.RevealAppDataLocation}"/>
          <SelectableTextBlock Text="{Binding DataDirectory}"
                               FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding !Capabilities.RevealAppDataLocation}"/>

          <!-- "Where is this server?" is the first thing anyone asks of it, and
               the answer is the same one whether they came to set a network
               option or not - so it lives here rather than buried on the Network
               tab among the switches that decide who may use these addresses.
               Read-only: each row is something to click, copy or read off to
               somebody, never something to edit. -->
          <TextBlock Text="This server is reachable at"
                     FontWeight="SemiBold" Margin="0,20,0,6"
                     IsVisible="{Binding HasAddresses}"/>
          <Border BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                  CornerRadius="4"
                  Padding="8,6"
                  IsVisible="{Binding HasAddresses}">
            <!-- Two levels: a heading per ServerAddressKind, then that kind's
                 origins under it. Grouped because the same server usually appears
                 several times over - once per scheme, once per interface - and a
                 flat list of near-identical strings has to be read character by
                 character to tell an IPv6 literal from the IPv4 one beside it. -->
            <ItemsControl ItemsSource="{Binding AddressGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerAddressGroup">
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}"
                               FontSize="11" FontWeight="SemiBold"
                               Opacity="0.5"
                               Margin="2,0,0,3"/>
                    <ItemsControl ItemsSource="{Binding Addresses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerAddressRow">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                            <!-- Alongside the scheme in the text, not instead of
                                 it: the glyph is what makes a plain-http row
                                 findable in a list at a glance, the text is what
                                 gets read out or typed in. -->
                            <Panel Grid.Column="0" VerticalAlignment="Center">
                              <materialIcons:MaterialIcon Kind="Lock"
                                                           Width="15" Height="15" Opacity="0.55"
                                                           IsVisible="{Binding IsSecure}"/>
                              <materialIcons:MaterialIcon Kind="LockOpenVariantOutline"
                                                           Width="15" Height="15" Opacity="0.4"
                                                           IsVisible="{Binding !IsSecure}"/>
                            </Panel>
                            <HyperlinkButton Grid.Column="1"
                                             Content="{Binding Address}"
                                             NavigateUri="{Binding NavigateUri}"
                                             FontFamily="monospace" FontSize="13"
                                             Padding="8,2"
                                             HorizontalAlignment="Left"/>
                            <Button Grid.Column="2"
                                    Click="CopyAddressButton_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Copy address">
                              <materialIcons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" Opacity="0.7"/>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Text="{Binding VersionDisplay}"
                     Margin="0,16,0,0" FontSize="11" Opacity="0.5"/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- The tab itself always stays selectable - only its content is disabled
           (see SettingsViewModel.CanManageLibrary) while this device is a Client
           paired to a Server: a Client's library is meant to be synced in from
           that server, not locally curated, so importing its own folders or
           rebuilding its own database doesn't make sense here. -->
      <TabItem Header="Library" x:Name="LibraryTab">
        <ScrollViewer>
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                Margin="0,12,0,0"
                IsEnabled="{Binding CanManageLibrary}">

            <!-- Master switch for the whole Music.app integration (see
                 AppSettings.IntegrateWithITunes / FlowerServerOptions.IntegrateWithITunes):
                 with it off, Music.app's media folder is no longer auto-added to
                 the library paths below and neither per-track import runs. A
                 folder already in that list stays there, though - unchecking this
                 stops Flower re-adding it, and the Remove button below is what
                 takes it out. The two sub-checkboxes stay visible but disabled,
                 keeping their own remembered values for when it is switched back
                 on.

                 All three are disabled outright, with the note in row 4 in place of
                 the source description, when the machine being configured has no
                 Music.app library folder at all - see
                 SettingsViewModel.HasAppleMusicFolder. -->
            <CheckBox Grid.Row="0"
                      Content="Use iTunes/Music.app library"
                      IsChecked="{Binding IntegrateWithITunes, Mode=TwoWay}"
                      IsEnabled="{Binding CanIntegrateWithITunes}"
                      IsVisible="{Binding Capabilities.ITunesIntegration}"/>

            <CheckBox Grid.Row="1"
                      Content="Sync play count from iTunes/Music.app"
                      Margin="20,4,0,0"
                      IsChecked="{Binding SyncPlayCountFromITunes, Mode=TwoWay}"
                      IsEnabled="{Binding CanSyncFromITunes}"
                      IsVisible="{Binding Capabilities.ITunesIntegration}"/>

            <CheckBox Grid.Row="2"
                      Content="Sync date added from iTunes/Music.app"
                      Margin="20,4,0,0"
                      IsChecked="{Binding SyncDateAddedFromITunes, Mode=TwoWay}"
                      IsEnabled="{Binding CanSyncFromITunes}"
                      IsVisible="{Binding Capabilities.ITunesIntegration}"/>

            <TextBlock Grid.Row="3"
                       Text="{Binding ITunesLibraryDescription}"
                       Margin="40,2,0,0" FontSize="11" Opacity="0.6"
                       TextTrimming="CharacterEllipsis"
                       IsEnabled="{Binding CanSyncFromITunes}"
                       IsVisible="{Binding CanIntegrateWithITunes}"/>

            <!-- Why the three switches above are greyed out. Deliberately in the
                 same place the source description would have been, rather than
                 beside them: it answers the same question ("where would this read
                 from?") in the case where the answer is "nowhere". -->
            <TextBlock Grid.Row="4"
                       Text="{Binding ITunesUnavailableMessage}"
                       Margin="20,4,0,0" FontSize="11" Opacity="0.6"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ShowsITunesUnavailable}"/>

            <TextBlock Grid.Row="5" Text="Library Folders" FontWeight="SemiBold" Margin="0,16,0,8"/>

            <Border Grid.Row="6" MinHeight="140"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
              <ListBox x:Name="PathsList" ItemsSource="{Binding LibraryPaths}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryPathRow">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Path}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="4,0"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SongCountDisplay}"
                                 IsVisible="{Binding HasSongCount}"
                                 VerticalAlignment="Center"
                                 Opacity="0.6" FontSize="11" Margin="8,0"/>
                      <Button Grid.Column="2"
                              Width="26" Height="26" Padding="4"
                              Click="RevealFolderButton_Click"
                              ToolTip.Tip="Reveal in File Manager">
                        <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <!-- The three things you can do to the folder list above, on its own
                 row: the two that change what is in it on the left, and the one
                 that acts on all of it pushed to the right, away from them. -->
            <Grid Grid.Row="7" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                <Button Content="Add Folder…" Click="AddFolderButton_Click"/>
                <Button Content="Remove Selected"
                        Command="{Binding RemoveLibraryPathCommand}"
                        CommandParameter="{Binding #PathsList.SelectedItem}"/>
              </StackPanel>
              <Button Content="Rescan Files"
                      HorizontalAlignment="Right"
                      Command="{Binding RescanCommand}"
                      IsVisible="{Binding !Capabilities.RebuildDatabase}"/>
            </Grid>

            <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Spacing="8"
                        IsVisible="{Binding Capabilities.RebuildDatabase}">
              <Button Content="Rebuild Database"
                      Command="{Binding RebuildDatabaseCommand}"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding DevicesTabHeader}" x:Name="DevicesTab">
        <Panel Margin="0,12,0,0">

          <!-- A Client picks which one Server it bulk-syncs with; there is no
               trusted-device list to show it, because a Client approves nobody.
               Built in code-behind (ServerPickerView takes MainViewModel), which is
               also why it is a host rather than a declared element. Exactly one of
               these two is visible at a time - see RefreshDevicesTab. -->
          <ContentControl x:Name="ServerPickerHost"/>

          <Grid x:Name="TrustedDevicesSection" RowDefinitions="Auto,Auto,*,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="0">
              <TextBlock Text="Phones and computers allowed to use this server."
                         TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,12"/>

              <!-- One button, with the far rarer and far more dangerous
                   variant behind a checkbox rather than behind a second button
                   sitting flush against it - see
                   SettingsViewModel.PairingCodeGrantsAdmin. More than one
                   device may be an administrator; an owner's own desktop and
                   their own phone both being one is the expected shape. -->
              <StackPanel Spacing="6" Margin="0,0,0,12"
                          IsVisible="{Binding Capabilities.PairingCodes}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Generate Pairing Code" Command="{Binding IssuePairingCodeCommand}"/>
                  <CheckBox Content="Administrator"
                            IsChecked="{Binding PairingCodeGrantsAdmin}"
                            VerticalAlignment="Center"/>
                  <SelectableTextBlock Text="{Binding PairingCode}"
                                       FontFamily="monospace"
                                       FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Type this code on the new device. It works once, and only for a few minutes."
                           Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="Administrators can also change these settings and add devices themselves."
                           IsVisible="{Binding PairingCodeGrantsAdmin}"
                           Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>

          <Border Grid.Row="2"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Grid>
              <TextBlock Text="No devices allowed yet."
                         Opacity="0.6"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding !HasDevices}"/>
              <ListBox ItemsSource="{Binding Devices}">
                <!-- Zeroes FluentTheme's own default ListBoxItem padding/MinHeight
                     cushion, same as MainView.axaml's sidebar list - otherwise it
                     pads on top of this DataTemplate's own (already-tight) margins
                     regardless of how compact the row content is made. -->
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrustedPeerRow">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="4,2">
                      <!-- Read-only. A server records the name each device
                           reported for itself at pairing time and has no override
                           to write, so there is nothing here to edit - see
                           RemoteServerSettingsBackend and DeviceNicknameStore,
                           which is where a local nickname lives instead. -->
                      <TextBlock Grid.Row="0" Grid.Column="0"
                                 Text="{Binding Alias}"
                                 FontWeight="SemiBold" FontSize="13"
                                 VerticalAlignment="Center" Margin="4,0"/>
                      <TextBlock Grid.Row="1" Grid.Column="0"
                                 Text="{Binding ApprovedAtDisplay}"
                                 Opacity="0.6" FontSize="11" Margin="4,1,0,0"/>

                      <!-- Confirmed inline rather than in a modal: this list also
                           renders in the browser, where Avalonia is single-view
                           and there is no Window to own a dialog - which used to
                           make Forget silently do nothing there. -->
                      <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                              Content="Forget"
                              Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"
                              IsVisible="{Binding IsNotConfirmingForget}"
                              Click="ForgetButton_Click"/>
                      <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                  Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  IsVisible="{Binding IsConfirmingForget}">
                        <TextBlock Text="Forget?" VerticalAlignment="Center" FontSize="12" Opacity="0.75"/>
                        <Button Content="Yes" Padding="10,4" Click="ConfirmForgetButton_Click"/>
                        <Button Content="No" Padding="10,4" Click="CancelForgetButton_Click"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <TextBlock Grid.Row="3"
                     Text="Devices you turned down."
                     TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,16,0,8"
                     IsVisible="{Binding ShowsDeniedDevices}"/>

          <Border Grid.Row="4"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                  IsVisible="{Binding ShowsDeniedDevices}">
            <ListBox ItemsSource="{Binding DeniedDevices}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="MinHeight" Value="0"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeniedPeerRow">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="4,2">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Alias}"
                               FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Margin="4,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding DeniedAtDisplay}"
                               Opacity="0.6" FontSize="11" Margin="4,1,0,0"/>
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Content="Forget refusal"
                            Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"
                            Click="ForgetRefusalButton_Click"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          </Grid>
        </Panel>
      </TabItem>

      <!-- Server-only: how this server is reached and who is allowed to reach it.
           See FlowerServerOptions for what each of these actually does. -->
      <TabItem Header="Network" x:Name="NetworkTab" IsVisible="{Binding Capabilities.ServerNetwork}">
        <ScrollViewer>
          <StackPanel Margin="0,12,0,0" Spacing="0">
            <CheckBox Content="Announce this server on the local network"
                      IsChecked="{Binding AdvertiseOnLan, Mode=TwoWay}"/>
            <TextBlock Text="Flower apps on the same network find this server by themselves, with nothing to type in. Turn it off if everyone reaches it through a tunnel or proxy instead."
                       Margin="0,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

            <!-- The switch that retires LanGuard. Worded as what it does rather
                 than as a setting name, because it is the most consequential one
                 here by a distance - see FlowerServerOptions.AllowPublicAccess. -->
            <CheckBox Content="Accept connections from outside this network"
                      Margin="0,20,0,0"
                      IsChecked="{Binding AllowPublicAccess, Mode=TwoWay}"/>
            <TextBlock Text="Off: only devices on your own network (plus anything allowed below) get an answer - everything else is ignored. On: anyone can reach it, and a paired device's key is the only thing keeping strangers out. Turn it on if you reach this server through a tunnel, a proxy or a forwarded port."
                       Margin="0,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

            <!-- The address this server answers on from outside, which none of
                 the ones on the General tab is - see PublicAddressProbe.
                 Selectable because it exists to be copied into a router's
                 forwarding rule or into a client that cannot discover it, and
                 hidden entirely when nothing could be found out. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0"
                        IsVisible="{Binding HasPublicAddress}">
              <TextBlock Text="Seen from the internet as" FontSize="11" Opacity="0.6"
                         VerticalAlignment="Center"/>
              <SelectableTextBlock Text="{Binding PublicAddressDisplay}"
                                   FontSize="11" FontFamily="monospace"
                                   VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Advertised address" FontWeight="SemiBold" Margin="0,20,0,4"/>
            <TextBox Text="{Binding AdvertisedHost, Mode=TwoWay}" Watermark="host:port"/>
            <TextBlock Text="The address to put in pairing invites, when it isn't the one this server sees requests arrive on - behind a proxy, or in a container that changes the port. Leave empty otherwise."
                       Margin="0,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

            <CheckBox Content="Trust the Tailscale range (100.64.0.0/10)"
                      Margin="0,20,0,0"
                      IsChecked="{Binding TrustTailscaleRange, Mode=TwoWay}"/>
            <TextBlock Text="Leave this on if you use Tailscale to reach this server from outside. Turn it off if you don't."
                       Margin="0,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

            <TextBlock Text="Additional allowed networks" FontWeight="SemiBold" Margin="0,20,0,4"/>
            <TextBox Text="{Binding AllowedCidrsText, Mode=TwoWay}"
                     AcceptsReturn="True" Height="80"
                     Watermark="One CIDR per line, e.g. 10.8.0.0/24"/>
            <TextBlock Text="Your own network is always allowed, and Tailscale too if it's ticked above. Add a range here for a tunnel or proxy that sits on its own network."
                       Margin="0,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

            <TextBlock Text="Subsonic clients" FontWeight="SemiBold" Margin="0,24,0,4"
                       IsVisible="{Binding Capabilities.SubsonicCredentials}"/>
            <TextBlock Text="Other music apps can't pair the way Flower does, so give each one its own username and password. The password is shown once, right after you create it."
                       Margin="0,0,0,8" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       IsVisible="{Binding Capabilities.SubsonicCredentials}"/>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding Capabilities.SubsonicCredentials}">
              <TextBox Text="{Binding NewCredentialLabel, Mode=TwoWay}" Width="180" Watermark="Label"/>
              <Button Content="Create Credential" Command="{Binding IssueSubsonicCredentialCommand}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding SubsonicCredentials}" Margin="0,8,0,0"
                          IsVisible="{Binding Capabilities.SubsonicCredentials}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SubsonicCredentialRow">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Detail}" Opacity="0.6" FontSize="11"/>
                    <SelectableTextBlock Grid.Row="2" Grid.Column="0"
                                         Text="{Binding Password}"
                                         IsVisible="{Binding HasPassword}"
                                         FontFamily="monospace"
                                         FontSize="12" Margin="0,2,0,0"/>
                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                            Content="Revoke" Padding="10,4" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RevokeSubsonicCredentialCommand}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Logs" x:Name="LogsTab" IsVisible="{Binding Capabilities.Log}">
        <!-- Whose log: this server's own, or the last snapshot one of its
             paired devices pushed (see AppSettings.ShareLogsWithPairedServer,
             and ISettingsBackend.LoadDeviceLogAsync). The whole point is that
             the owner of the server is the one who ends up diagnosing a
             listener's phone - which is also why this is the one screen that
             lists everyone. A client's own Log window shows only itself. -->
        <Grid RowDefinitions="*" ColumnDefinitions="200,Auto,*" Margin="0,12,0,0">
          <Grid Grid.Column="0" RowDefinitions="*,Auto">
            <ListBox Grid.Row="0"
                     ItemsSource="{Binding LogSources}"
                     SelectedItem="{Binding SelectedLogSource, Mode=TwoWay}"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogSourceRow">
                  <TextBlock Text="{Binding Name}" Margin="8,6" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- Polled while this tab is on screen rather than pushed: the
                 server's log arrives as a delta every couple of seconds (see
                 SettingsViewModel.SetLogTabActive), and a device's snapshot
                 only changes when it next syncs. Refresh stays for re-reading
                 one from scratch. -->
            <Button Grid.Row="1" Content="Refresh" Margin="0,8,8,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding RefreshLogCommand}"/>
          </Grid>

          <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns"/>

          <!-- The app's own log viewer, unchanged - filtering, minimum level,
               font size, word wrap and an AvaloniaEdit document that handles a
               real log's worth of lines. -->
          <views:LogViewer Grid.Column="2" DataContext="{Binding LogViewer}"/>
        </Grid>
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="2">
      <TextBlock Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                 Foreground="#E57373" FontSize="12" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StatusMessage}"
                 IsVisible="{Binding StatusMessage, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                 Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Spacing="8">
      <materialIcons:MaterialIcon Kind="Sync" Width="14" Height="14" Opacity="0.55"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsBusy}"/>
      <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" IsCancel="True"/>
      <Button x:Name="SaveButton" Content="OK" Click="SaveButton_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</UserControl>
