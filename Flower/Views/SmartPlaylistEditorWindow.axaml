<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Flower.Views"
        xmlns:vm="using:Flower.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="480"
        x:Class="Flower.Views.SmartPlaylistEditorWindow"
        x:DataType="vm:SmartPlaylistEditorViewModel"
        Title="Smart Playlist"
        Width="860" MinWidth="720"
        Height="460" MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <!-- The controls are SmartPlaylistEditorView, shared with the phone's
       sheet; the window only adds the two buttons that end the edit. -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Click="Cancel_Click" MinWidth="90"/>
      <Button Content="OK" Click="Ok_Click" MinWidth="90" IsDefault="True"/>
    </StackPanel>

    <views:SmartPlaylistEditorView/>
  </DockPanel>
</Window>
