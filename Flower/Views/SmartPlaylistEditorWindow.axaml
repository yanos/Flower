<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Flower.Views"
        xmlns:controls="clr-namespace:Flower.Controls"
        xmlns:vm="using:Flower.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="680"
        x:Class="Flower.Views.SmartPlaylistEditorWindow"
        x:DataType="vm:SmartPlaylistEditorViewModel"
        Title="Smart Playlist"
        Width="980" MinWidth="720"
        Height="700" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <!-- The controls are SmartPlaylistEditorView, shared with the phone's
       sheet; the window adds what the rules as typed would pick, under them
       as the phone's sheet lists it (SmartPlaylistEditorViewModel.
       PreviewTracks), and the two buttons that end the edit.

       The rules take the height they need, up to a point where they scroll,
       and the songs take the rest: a playlist of one rule should not be a
       window of empty rule space. The songs are the track list itself -
       MusicListView, with the columns as they are set everywhere else. -->
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
    <views:SmartPlaylistEditorView Grid.Row="0" MaxHeight="380"/>

    <TextBlock Grid.Row="1"
               Text="{Binding PreviewSummary}"
               FontWeight="SemiBold" Opacity="0.6"
               Margin="0,16,0,6"/>

    <controls:MusicListView Grid.Row="2" x:Name="PreviewList" MinHeight="120"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Classes="standard secondary" Content="Cancel" Click="Cancel_Click"/>
      <Button Classes="standard primary" Content="OK" Click="Ok_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
