<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Flower.ViewModels"
        xmlns:controls="clr-namespace:Flower.Controls"
        x:Class="Flower.Views.ColumnSelectorWindow"
        x:DataType="vm:MainViewModel"
        Title="Select Columns"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource AppBackgroundBrush}">

  <!-- Laid out from the October 2026 redesign's Columns board: the name in
       the display serif over a line saying what it is for, the columns on the
       surface colour between hairlines, and Close at the bottom. -->
  <Window.Styles>
    <Style Selector="CheckBox.column">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="8,0,0,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <StackPanel>
    <StackPanel Margin="24,22,24,16" Spacing="4">
      <TextBlock Classes="sectionTitle" Text="Columns" FontSize="24"/>
      <TextBlock Text="Choose what song lists show. Drag a column's heading in the list to move it."
                 FontSize="13"
                 Foreground="{DynamicResource AppTextSecondaryBrush}"/>
    </StackPanel>

    <Border BorderThickness="0,1"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource AppSurfaceBrush}"
            Padding="20,12,20,16">
      <StackPanel Spacing="12">
        <!-- A UniformGrid, not a WrapPanel: wrapping packs each row to
             whatever fits, so the second and third checkbox of one row
             started at a different x than the row above it however carefully
             the items were given a MinWidth. Fixed columns are what actually
             lines them up, and with the full Track Info field set here there
             are enough of them for that to matter. Four columns keeps the
             window about as tall as the screen allows. -->
        <ItemsControl x:Name="ColumnsList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="controls:MusicColumnDefinition">
              <CheckBox Classes="column"
                        Content="{Binding Header}"
                        IsChecked="{Binding IsVisible}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="0,10,0,0">
          <StackPanel>
            <!-- Its own DataContext (the ColumnManager, set in the
                 constructor): the art well is track-list layout like every
                 checkbox above it, and ColumnManager is what owns and persists
                 that - see ColumnManager.ShowAlbumArt. The window's own
                 DataContext, and so the checkbox below, is still the
                 MainViewModel. -->
            <CheckBox x:Name="AlbumArtCheck"
                      x:DataType="controls:ColumnManager"
                      Classes="column"
                      Content="Show album art"
                      IsChecked="{Binding ShowAlbumArt}"/>
            <CheckBox Classes="column"
                      Content="Sort artist's albums by year"
                      IsChecked="{Binding SortArtistAlbumsByYear}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Button x:Name="CloseButton"
            Content="Close"
            Classes="primary"
            Height="36"
            Padding="20,0"
            CornerRadius="10"
            FontSize="13"
            FontWeight="SemiBold"
            VerticalContentAlignment="Center"
            Margin="24,14,24,18"
            HorizontalAlignment="Right"
            IsDefault="True"
            IsCancel="True"
            Click="CloseButton_Click"/>
  </StackPanel>
</Window>
