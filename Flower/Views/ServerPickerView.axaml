<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Flower.Views"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Flower.Views.ServerPickerView">
  <UserControl.Styles>
    <!-- Continuous rotation while a row's IsSyncing is true - see
         ServerRow.IsSyncing. Same "MaterialIcon Kind=Sync, spinning" visual
         MainView.axaml.cs uses for the status-bar busy spinner, just done
         declaratively since these rows are rebuilt wholesale on every
         Refresh() rather than being stable named elements a DispatcherTimer
         could target. -->
    <Style Selector="materialIcons|MaterialIcon.spinning">
      <Setter Property="RenderTransform" Value="rotate(0deg)"/>
    </Style>
    <Style Selector="materialIcons|MaterialIcon.spinning">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
    <Grid Grid.Row="0">
      <TextBlock x:Name="EmptyStateText"
                 Text="No servers found on this network yet."
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
      <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ListBox x:Name="ServersList">
          <!-- See TrustedDevicesView's identical style for why. -->
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="MinHeight" Value="0"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="views:ServerRow">
              <!-- One row, two columns: everything about the server on the left
                   as a vertically-centred stack, its buttons on the right. The
                   name used to sit in its own grid row while the buttons spanned
                   both, which left the name riding above the middle of the
                   buttons beside it whenever the second line had anything in it. -->
              <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Only once the paired server has actually approved this
                         device (see ServerRow.IsTrustConfirmed) - not just
                         requested, which is IsPaired alone (see ActionLabel's
                         "Waiting for server..." state). -->
                    <materialIcons:MaterialIcon Kind="CheckCircle"
                                                 Width="14" Height="14"
                                                 Foreground="#4CAF50"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding IsTrustConfirmed}"/>
                    <TextBlock Text="{Binding Alias}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <materialIcons:MaterialIcon Kind="Sync"
                                                 Classes="spinning"
                                                 Width="12" Height="12"
                                                 Opacity="0.6"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding IsSyncing}"/>
                  </StackPanel>
                  <!-- Detail only appears when two servers share a name - see
                       ServerRow.Detail. All three live on one line so a row
                       showing any combination of them keeps its height. -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Detail}"
                               IsVisible="{Binding Detail, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                               Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding LastSyncedDisplay}"
                               IsVisible="{Binding LastSyncedDisplay, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                               Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding HintText}"
                               IsVisible="{Binding HintText, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                               Opacity="0.6" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Content="Sync Now"
                          IsVisible="{Binding IsPaired}"
                          IsEnabled="{Binding CanForceSync}"
                          Padding="10,4"
                          Click="ForceSyncButton_Click"/>
                  <!-- Hidden once paired (ServerRow.IsPairingCodeRequired) -
                       there is nothing left to redeem. -->
                  <TextBox Text="{Binding PairingCode}"
                           PlaceholderText="Pairing code"
                           IsVisible="{Binding IsPairingCodeRequired}"
                           Width="130" MaxLength="20"
                           VerticalAlignment="Center"/>
                  <Button Content="{Binding ActionLabel}"
                          IsEnabled="{Binding IsActionEnabled}"
                          Padding="10,4"
                          Click="ActionButton_Click"/>
                  <!-- Pairing requested but not yet approved - see
                       ServerRow.IsAwaitingApproval. -->
                  <materialIcons:MaterialIcon Kind="Sync"
                                               Classes="spinning"
                                               Width="12" Height="12"
                                               Opacity="0.6"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsAwaitingApproval}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <TextBlock Grid.Row="1"
               x:Name="SyncResultText"
               IsVisible="False"
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11"
               Margin="0,10,0,0"/>

    <!-- Bootstrap only: a server this device has never shared a network with,
         and so could never discover, so it cannot appear in the list above and
         be paired with there. Typing its address and its code here does both
         steps at once - see AddManualServerButton_Click. A server paired with
         on the LAN reports its own addresses and keeps working away from home
         with nothing typed - see docs/REMOTE-ACCESS-PLAN.md. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
      <TextBox Grid.Column="0" x:Name="ManualAddressBox"
               PlaceholderText="my-server.tail1234.ts.net:4533"
               Margin="0,0,8,0"/>
      <TextBox Grid.Column="1" x:Name="ManualPairingCodeBox"
               PlaceholderText="Pairing code"
               Width="130" MaxLength="20"
               Margin="0,0,8,0"/>
      <!-- No padding override: this one stands on its own next to two text
           boxes, so it should read as an ordinary button like Add Folder or
           Generate Pairing Code. The compact 10,4 the list rows use is theirs
           because a row is tight, not because Pair is a smaller action. -->
      <Button Grid.Column="2" x:Name="AddManualServerButton" Content="Pair"
              Click="AddManualServerButton_Click"/>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="ManualAddressStatus"
               IsVisible="False"
               TextWrapping="Wrap" FontSize="11" Opacity="0.65"
               Margin="0,6,0,0"/>

  </Grid>
</UserControl>
