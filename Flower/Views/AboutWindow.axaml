<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Flower.ViewModels"
        xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        x:Class="Flower.Views.AboutWindow"
        Title="About Flower"
        Width="320"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height">
  <!-- No Height: SizeToContent sets it, as in the other dialogs. A fixed one
       alongside it cut the window short on Linux, hiding the rows below. -->
  <StackPanel Margin="24" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Image Source="/Assets/flower-glyph.png"
           Width="48" Height="48"
           HorizontalAlignment="Center"/>
    <TextBlock Text="Flower"
               FontSize="22"
               FontWeight="Bold"
               HorizontalAlignment="Center"/>
    <TextBlock Text="A cross-platform music player"
               Opacity="0.7"
               HorizontalAlignment="Center"/>
    <HyperlinkButton Content="github.com/yanos/Flower"
                     NavigateUri="https://github.com/yanos/Flower"
                     Padding="0"
                     HorizontalAlignment="Center"/>
    <TextBlock x:Name="VersionTextBlock"
               TextAlignment="Center"
               FontSize="11"
               Opacity="0.5"
               HorizontalAlignment="Center"/>
    <!-- The same check as Settings > General's Check now (AppUpdatesViewModel),
         and its install button once there is something to install. Hidden
         where there is no updater: a phone, the browser, a build not
         installed from a release. -->
    <StackPanel x:Name="UpdatesPanel"
                x:DataType="vm:AppUpdatesViewModel"
                IsVisible="False"
                Spacing="4"
                Margin="0,6,0,6"
                HorizontalAlignment="Center">
      <Button Classes="standard secondary"
              Content="Check for Updates"
              Command="{Binding CheckNowCommand}"
              IsVisible="{Binding Available, Converter={x:Static avc:ObjectConverters.IsNull}}"
              HorizontalAlignment="Center"/>
      <Button Classes="standard primary"
              Content="{Binding Available.InstallLabel, FallbackValue=''}"
              Command="{Binding InstallCommand}"
              IsVisible="{Binding Available, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
              HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Status}"
                 MaxWidth="272"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 FontSize="11"
                 Opacity="0.6"
                 HorizontalAlignment="Center"/>
    </StackPanel>
    <!-- A new GitHub issue with the version already in it (IssueLink). -->
    <HyperlinkButton x:Name="ReportIssueLink"
                     Content="Report an Issue"
                     Padding="0"
                     FontSize="11"
                     HorizontalAlignment="Center"/>
    <HyperlinkButton Content="Open-Source Licences"
                     Click="LicencesButton_OnClick"
                     Padding="0"
                     FontSize="11"
                     HorizontalAlignment="Center"/>
  </StackPanel>
</Window>
