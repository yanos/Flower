<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Flower.Views.PlaylistConflictWindow"
        Title="Playlist sync conflict"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="HeadlineText"
               FontWeight="SemiBold"
               FontSize="14"
               TextWrapping="Wrap"/>
    <TextBlock x:Name="ExplanationText"
               TextWrapping="Wrap"
               Opacity="0.75"
               FontSize="12"/>

    <Border Classes="listFrame" Padding="10">
      <StackPanel Spacing="4">
        <TextBlock Text="This device" FontWeight="SemiBold" FontSize="12"/>
        <TextBlock x:Name="LocalSummaryText" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Classes="listFrame" Padding="10">
      <StackPanel Spacing="4">
        <TextBlock x:Name="RemoteHeaderText" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="RemoteSummaryText" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Stacked, because the second names a server and can be any length. No
         default button: Enter must not overwrite either side's edits. -->
    <StackPanel Spacing="8">
      <Button x:Name="KeepLocalButton" Classes="standard primary" Content="Keep This Device's Version"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="KeepLocalButton_Click"/>
      <Button x:Name="KeepRemoteButton" Classes="standard secondary"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="KeepRemoteButton_Click">
        <TextBlock x:Name="KeepRemoteText" TextTrimming="CharacterEllipsis"/>
      </Button>
      <Button x:Name="DecideLaterButton" Classes="standard secondary" Content="Decide Later"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsCancel="True" Click="DecideLaterButton_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
