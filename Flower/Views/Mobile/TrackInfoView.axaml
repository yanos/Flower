<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:info="clr-namespace:Flower.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.TrackInfoView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
             Padding="{DynamicResource SheetBottomInset}"
             controls:SoftKeyboard.DismissOnTapOutside="True">

  <UserControl.Styles>
    <Style Selector="Border.step:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- A secondary action, as on Settings: a grey fill rather than Fluent's
         outlined box. -->
    <Style Selector="Button.soft">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Stacked full width beside the cover, so the glyphs line up. -->
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.soft materialIcons|MaterialIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <!-- Cards as on Settings: lighter than the page, and rounded. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="{DynamicResource AppButtonShadow}" />
      <Setter Property="Padding" Value="14,14,14,16" />
      <Setter Property="Margin" Value="16,0,16,14" />
    </Style>

    <!-- A field's name, to the left of its box. -->
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The name beside a box several lines tall sits on its first line. -->
    <Style Selector="TextBlock.lbl.top">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="TextBox.val">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <!-- The clear button only on the field being typed in: on a form this
         dense, one beside every filled field is a column of crosses, and in
         the narrow number boxes it takes half the room. -->
    <!-- TextBox rather than TextInput in the selector, because TextInput
         styles as a TextBox (its StyleKeyOverride) and a TextInput selector
         would match nothing; every .val box on this sheet is a TextInput. -->
    <Style Selector="TextBox.val">
      <Setter Property="controls:TextInput.ShowsClearButton" Value="False" />
    </Style>
    <Style Selector="TextBox.val:focus">
      <Setter Property="controls:TextInput.ShowsClearButton" Value="True" />
    </Style>
    <!-- The keyboard starts each box with a capital - a title, a name - and
         lets it be overridden, rather than the box rewriting what is typed:
         "jinsang", "yes/and" and "waykup." are names as they are spelled.
         The number boxes get the number pad instead. -->
    <Style Selector="TextBox.val">
      <Setter Property="TextInputOptions.AutoCapitalization" Value="True" />
    </Style>
    <Style Selector="TextBox.val.num">
      <Setter Property="TextInputOptions.AutoCapitalization" Value="False" />
      <Setter Property="TextInputOptions.ContentType" Value="Digits" />
    </Style>
    <!-- The library's own spellings, under the box being typed in, a tap
         from going into it - see TrackInfoView's TagSuggestions. Not
         focusable, so the tap leaves the keyboard where it is. -->
    <Style Selector="WrapPanel.suggestions > Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="{DynamicResource AppAccentTintBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9999" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBox.val.multi">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="76" />
    </Style>

    <!-- The read-only figures in the two cards at the foot of the sheet. -->
    <Style Selector="TextBlock.figureLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.figure">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A count is a number at display size; the words for there being
         several are not, and at that size they do not fit the card. -->
    <Style Selector="TextBlock.playCount">
      <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="TextBlock.playCount.mixed">
      <Setter Property="FontSize" Value="15" />
    </Style>
  </UserControl.Styles>

  <!-- Below the status bar: the sheet itself runs up under it (MobileMainView
       pulls it up by ScreenStackBleed) so it covers the whole screen. -->
  <Grid RowDefinitions="Auto,*" Margin="{DynamicResource StatusBarInset}">

    <!-- A round chevron and a round check facing it, as on the smart
         playlist editor: 40px circles 12 in from either edge. The check is
         Save; the chevron leaves without saving. The title is centred on the
         sheet between them. Opened for one song from a list - an album, a
         playlist, Songs - it has an arrow either side, stepping along that
         list a song at a time and saving what was typed on the way (see
         MobileMainViewModel.StepTrackInfo); dimmed at either end. -->
    <Panel Grid.Row="0" Height="60" Margin="12,4,12,4">
      <StackPanel Orientation="Horizontal" Spacing="10"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Classes="floating step" Width="40"
                IsVisible="{Binding CanStepTrackInfo}"
                IsEnabled="{Binding HasPreviousTrackInfo}">
          <Button x:Name="PreviousSongButton"
                  Classes="pill"
                  Click="Previous_Click"
                  HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="22" Height="22" />
          </Button>
        </Border>
        <TextBlock Text="Track Info"
                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppChromeBrush}"
                   VerticalAlignment="Center" />
        <Border Classes="floating step" Width="40"
                IsVisible="{Binding CanStepTrackInfo}"
                IsEnabled="{Binding HasNextTrackInfo}">
          <Button x:Name="NextSongButton"
                  Classes="pill"
                  Click="Next_Click"
                  HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="ChevronRight" Width="22" Height="22" />
          </Button>
        </Border>
      </StackPanel>
      <Border Classes="floating" Width="40" HorizontalAlignment="Left">
        <Button Classes="pill"
                Click="Cancel_Click"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="ChevronDown" Width="22" Height="22" />
        </Button>
      </Border>
      <Border Classes="floating" Width="40" HorizontalAlignment="Right">
        <Button x:Name="SaveButton"
                Classes="pill"
                Click="Save_Click"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="Check" Width="20" Height="20" />
        </Button>
      </Border>
    </Panel>

    <!-- Everything in here is the songs' Track Info (TrackInfoViewModel,
         shared with the desktop window), set as this scroller's DataContext
         by the code-behind each time the sheet shows songs. -->
    <ScrollViewer Grid.Row="1" x:Name="Body" x:DataType="info:TrackInfoViewModel"
                  VerticalScrollBarVisibility="Auto"
                  controls:SoftKeyboard.AvoidOcclusion="True">
      <StackPanel Margin="0,4,0,16">

        <!-- The cover, its size in pixels under it, and beside it the ways to
             change it: a photo from the phone, one found online for the album
             named in the boxes below, or the clipboard's image (ClipboardArt).
             Each writes at once, like the desktop Artwork tab's buttons,
             rather than waiting for Save: a picture goes into the file, not
             into a box. Tapping the cover shows it on the whole screen. -->
        <Border Classes="card">
          <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto" ColumnSpacing="14">
            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Top">
              <controls:AlbumArtView x:Name="ArtView"
                                     Width="128" Height="128" ArtCornerRadius="12"
                                     Tapped="Art_Tapped" />
              <TextBlock x:Name="ArtResolution"
                         FontSize="12"
                         Foreground="{DynamicResource AppTextMutedBrush}"
                         HorizontalAlignment="Center"
                         IsVisible="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" x:Name="ArtButtons" Spacing="8" VerticalAlignment="Top">
              <Button x:Name="ChoosePhotoButton"
                      Classes="soft"
                      HorizontalAlignment="Stretch"
                      Click="ChoosePhoto_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <materialIcons:MaterialIcon Kind="ImageMultiple" />
                  <TextBlock Text="Choose Photo" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="FindArtButton"
                      Classes="soft"
                      HorizontalAlignment="Stretch"
                      Click="FindArt_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <materialIcons:MaterialIcon Kind="ImageSearch" />
                  <TextBlock x:Name="FindArtLabel" Text="Find Online" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="PasteArtButton"
                      Classes="soft"
                      HorizontalAlignment="Stretch"
                      Click="PasteArt_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <materialIcons:MaterialIcon Kind="ContentPaste" />
                  <TextBlock Text="Paste" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                       x:Name="ArtMessage"
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       IsVisible="False" />
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Grid.Row="0" Classes="lbl" Text="Title" />
              <controls:TextInput Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Text="{Binding Title.Text, Mode=TwoWay}" PlaceholderText="{Binding Title.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
              <TextBlock Grid.Row="1" Classes="lbl" Text="Artist" VerticalAlignment="Top" Margin="0,10,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1">
                <controls:TextInput x:Name="ArtistBox" Text="{Binding Artists.Text, Mode=TwoWay}" PlaceholderText="{Binding Artists.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
                <WrapPanel x:Name="ArtistSuggestions" Classes="suggestions" Margin="0,6,0,0" IsVisible="False" />
              </StackPanel>
              <TextBlock Grid.Row="2" Classes="lbl" Text="Album" VerticalAlignment="Top" Margin="0,10,0,0" />
              <StackPanel Grid.Row="2" Grid.Column="1">
                <controls:TextInput x:Name="AlbumBox" Text="{Binding Album.Text, Mode=TwoWay}" PlaceholderText="{Binding Album.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
                <WrapPanel x:Name="AlbumSuggestions" Classes="suggestions" Margin="0,6,0,0" IsVisible="False" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="88,*,40,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Grid.Row="0" Classes="lbl" Text="Track #" />
              <controls:TextInput Grid.Row="0" Grid.Column="1" x:Name="TrackNumBox" Text="{Binding TrackNumber.Text, Mode=TwoWay}" PlaceholderText="{Binding TrackNumber.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val num" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="lbl" Text="of" HorizontalAlignment="Center" />
              <controls:TextInput Grid.Row="0" Grid.Column="3" x:Name="TrackTotalBox" Text="{Binding TrackCount.Text, Mode=TwoWay}" PlaceholderText="{Binding TrackCount.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val num" />

              <TextBlock Grid.Row="1" Classes="lbl" Text="Disc #" />
              <controls:TextInput Grid.Row="1" Grid.Column="1" x:Name="DiscNumBox" Text="{Binding DiscNumber.Text, Mode=TwoWay}" PlaceholderText="{Binding DiscNumber.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val num" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="lbl" Text="of" HorizontalAlignment="Center" />
              <controls:TextInput Grid.Row="1" Grid.Column="3" x:Name="DiscTotalBox" Text="{Binding DiscCount.Text, Mode=TwoWay}" PlaceholderText="{Binding DiscCount.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val num" />

              <TextBlock Grid.Row="2" Classes="lbl" Text="Year" />
              <controls:TextInput Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="YearBox" Text="{Binding Year.Text, Mode=TwoWay}" PlaceholderText="{Binding Year.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val num" />

              <!-- Typed like any other field, with the library's own genres a
                   tap away on the chevron - so picking one reuses its exact
                   spelling, as the desktop's suggestions do for artists. -->
              <TextBlock Grid.Row="3" Classes="lbl" Text="Genre" VerticalAlignment="Top" Margin="0,10,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
              <Panel>
                <controls:TextInput x:Name="GenreBox" Text="{Binding Genre.Text, Mode=TwoWay}" PlaceholderText="{Binding Genre.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" ShowsClearButton="False" Padding="12,9,44,9" />
                <Button x:Name="GenreMenuButton"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0" Padding="8"
                        Background="Transparent" BorderThickness="0"
                        Click="GenreMenu_Click">
                  <materialIcons:MaterialIcon Kind="ChevronDown" Width="20" Height="20"
                                              Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Button>
              </Panel>
              <WrapPanel x:Name="GenreSuggestions" Classes="suggestions" Margin="0,6,0,0" IsVisible="False" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="88,*,52,*" RowDefinitions="Auto,Auto" RowSpacing="10">
              <TextBlock Grid.Row="0" Classes="lbl" Text="BPM" />
              <controls:TextInput Grid.Row="0" Grid.Column="1" x:Name="BpmBox" Text="{Binding BeatsPerMinute.Text, Mode=TwoWay}" PlaceholderText="{Binding BeatsPerMinute.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val num" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="lbl" Text="Key" HorizontalAlignment="Center" />
              <controls:TextInput Grid.Row="0" Grid.Column="3" x:Name="KeyBox" Text="{Binding InitialKey.Text, Mode=TwoWay}" PlaceholderText="{Binding InitialKey.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />

              <TextBlock Grid.Row="1" Classes="lbl" Text="Grouping" />
              <controls:TextInput Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="GroupingBox" Text="{Binding Grouping.Text, Mode=TwoWay}" PlaceholderText="{Binding Grouping.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="108,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Grid.Row="0" Classes="lbl" Text="Album Artist" VerticalAlignment="Top" Margin="0,10,0,0" />
              <StackPanel Grid.Row="0" Grid.Column="1">
                <controls:TextInput x:Name="AlbumArtistBox" Text="{Binding AlbumArtists.Text, Mode=TwoWay}" PlaceholderText="{Binding AlbumArtists.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
                <WrapPanel x:Name="AlbumArtistSuggestions" Classes="suggestions" Margin="0,6,0,0" IsVisible="False" />
              </StackPanel>
              <TextBlock Grid.Row="1" Classes="lbl" Text="Composer" VerticalAlignment="Top" Margin="0,10,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1">
                <controls:TextInput x:Name="ComposerBox" Text="{Binding Composers.Text, Mode=TwoWay}" PlaceholderText="{Binding Composers.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
                <WrapPanel x:Name="ComposerSuggestions" Classes="suggestions" Margin="0,6,0,0" IsVisible="False" />
              </StackPanel>
              <TextBlock Grid.Row="2" Classes="lbl" Text="Conductor" />
              <controls:TextInput Grid.Row="2" Grid.Column="1" x:Name="ConductorBox" Text="{Binding Conductor.Text, Mode=TwoWay}" PlaceholderText="{Binding Conductor.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
              <TextBlock Grid.Row="3" Classes="lbl" Text="Remixed By" />
              <!-- A tag like the boxes, saved with them; three-state only while
                   the songs disagree, as on the desktop's Options tab. -->
              <CheckBox Grid.Row="4" Grid.Column="1"
                        Content="Part of a compilation"
                        FontSize="15"
                        IsChecked="{Binding IsCompilation}"
                        IsThreeState="{Binding CompilationIsThreeState}"
                        IsEnabled="{Binding IsEditable}" />
              <controls:TextInput Grid.Row="3" Grid.Column="1" x:Name="RemixedByBox" Text="{Binding RemixedBy.Text, Mode=TwoWay}" PlaceholderText="{Binding RemixedBy.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="108,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Grid.Row="0" Classes="lbl" Text="Subtitle" />
              <controls:TextInput Grid.Row="0" Grid.Column="1" x:Name="SubtitleBox" Text="{Binding Subtitle.Text, Mode=TwoWay}" PlaceholderText="{Binding Subtitle.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
              <TextBlock Grid.Row="1" Classes="lbl top" Text="Description" />
              <controls:TextInput Grid.Row="1" Grid.Column="1" x:Name="DescriptionBox" Text="{Binding Description.Text, Mode=TwoWay}" PlaceholderText="{Binding Description.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val multi" />
              <TextBlock Grid.Row="2" Classes="lbl top" Text="Comment" />
              <controls:TextInput Grid.Row="2" Grid.Column="1" x:Name="CommentBox" Text="{Binding Comment.Text, Mode=TwoWay}" PlaceholderText="{Binding Comment.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val multi" />
              <TextBlock Grid.Row="3" Classes="lbl" Text="Publisher" />
              <controls:TextInput Grid.Row="3" Grid.Column="1" x:Name="PublisherBox" Text="{Binding Publisher.Text, Mode=TwoWay}" PlaceholderText="{Binding Publisher.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
              <TextBlock Grid.Row="4" Classes="lbl" Text="Copyright" />
              <controls:TextInput Grid.Row="4" Grid.Column="1" x:Name="CopyrightBox" Text="{Binding Copyright.Text, Mode=TwoWay}" PlaceholderText="{Binding Copyright.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
              <TextBlock Grid.Row="5" Classes="lbl" Text="ISRC" />
              <controls:TextInput Grid.Row="5" Grid.Column="1" x:Name="ISRCBox" Text="{Binding ISRC.Text, Mode=TwoWay}" PlaceholderText="{Binding ISRC.Placeholder}" IsEnabled="{Binding IsEditable}" Classes="val" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <controls:TextInput x:Name="LyricsBox" Classes="val multi" MinHeight="100"
                                Text="{Binding Lyrics.Text, Mode=TwoWay}"
                                PlaceholderText="{Binding Lyrics.Placeholder, TargetNullValue=Lyrics}"
                                IsEnabled="{Binding IsEditable}" />
          </StackPanel>
        </Border>

        <!-- Read-only, side by side: Flower's own record of what has been
             listened to (as in the desktop window's Listening section), and
             what the file is. -->
        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="10" Margin="16,0,16,14">
          <Border Grid.Column="0" Classes="card" Margin="0">
            <StackPanel Spacing="4">
              <TextBlock Classes="lbl" Text="Play Count" />
              <TextBlock x:Name="PlayCountValue" Classes="playCount" Classes.mixed="{Binding IsPlayCountMixed}"
                         Text="{Binding PlayCountValue}" Margin="0,0,0,10" TextWrapping="Wrap" />
              <TextBlock Classes="lbl" Text="Last Played" />
              <TextBlock x:Name="LastPlayedValue" Text="{Binding LastPlayedValue}" FontSize="15" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="card" Margin="0">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="4"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Classes="figureLabel" Text="Duration" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DurationValue" Text="{Binding DurationValue}" Classes="figure" />
                <TextBlock Grid.Row="1" Classes="figureLabel" Text="Codec" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CodecValue" Text="{Binding CodecValue}" Classes="figure" />
                <TextBlock Grid.Row="2" Classes="figureLabel" Text="Bit Rate" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BitrateValue" Text="{Binding BitrateValue}" Classes="figure" />
                <TextBlock Grid.Row="3" Classes="figureLabel" Text="Sample Rate" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SampleRateValue" Text="{Binding SampleRateValue}" Classes="figure" />
                <TextBlock Grid.Row="4" Classes="figureLabel" Text="Channels" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ChannelsValue" Text="{Binding ChannelsValue}" Classes="figure" />
                <TextBlock Grid.Row="5" Classes="figureLabel" Text="Bit Depth" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="BitDepthValue" Text="{Binding BitDepthValue}" Classes="figure" />
                <TextBlock Grid.Row="6" Classes="figureLabel" Text="Encoding" />
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="EncodingValue" Text="{Binding EncodingValue}" Classes="figure" />
                <!-- "Source" and the server's name for a song that lives on
                     the paired server, which has no file here to name. -->
                <TextBlock Grid.Row="7" x:Name="FileLabel" Classes="figureLabel" Text="{Binding SourceLabel}" />
                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="PathValue" Text="{Binding SourceValue}" Classes="figure" FontSize="11" />
                <TextBlock Grid.Row="8" Classes="figureLabel" Text="Date Added" />
                <TextBlock Grid.Row="8" Grid.Column="1" x:Name="DateAddedValue" Text="{Binding DateAddedValue}" Classes="figure" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
