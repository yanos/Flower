<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:services="clr-namespace:Flower.Services"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.SettingsView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">

  <UserControl.Styles>
    <Style Selector="StackPanel.section">
      <Setter Property="Margin" Value="20,4,20,20" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- The same round back button MobileMainView floats over its screens,
         and at the same spot (Border.floating and Button.pill are styled
         there): a 40px circle 12 in, the title 8 past it at 60. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Height="52" Margin="12,4,16,4">
      <Border Grid.Column="0" Classes="floating" Width="40">
        <Button Classes="pill"
                Command="{Binding CloseSheetCommand}"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
        </Button>
      </Border>
      <TextBlock Grid.Column="1"
                 Text="Settings"
                 FontSize="22"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Margin="8,0,0,0" />
    </Grid>

    <!-- Scrolls because the content is now taller than a small phone. The
         diagnostics block below is the last thing on the screen and would
         otherwise simply be unreachable on a 13 mini. -->
    <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  controls:SoftKeyboard.AvoidOcclusion="True">
    <StackPanel Margin="0,8,0,0">

      <!-- Four headed sections rather than one flat run of blocks: the sheet
           grew past a phone's height, and "which of these is about the server I
           am on, and which is about adding another one" is not answerable from
           spacing alone. -->
      <StackPanel Classes="section">
        <TextBlock Classes="section-header" Text="General"/>

        <TextBlock Text="Device Name" FontSize="13" Opacity="0.6"/>
        <TextBox Text="{Binding Main.DeviceAlias, UpdateSourceTrigger=LostFocus}"
                 controls:SoftKeyboard.ReopenOnTap="True"/>
        <TextBlock Text="Shown on the server this device syncs with"
                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>

        <StackPanel IsVisible="{Binding HasMediaPermissionPrompt}" Margin="0,10,0,0" Spacing="8">
          <StackPanel IsVisible="{Binding !HasMediaPermission}" Spacing="8">
            <TextBlock Text="Music access permission was denied, so Flower cannot see your library."
                       FontSize="14"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
            <Button Command="{Binding OpenAppSettingsCommand}" HorizontalAlignment="Left">
              <TextBlock Text="Open App Settings" FontSize="14" />
            </Button>
          </StackPanel>
          <TextBlock IsVisible="{Binding HasMediaPermission}"
                     Text="Music access permission is granted."
                     FontSize="14"
                     Opacity="0.5" />
        </StackPanel>
      </StackPanel>

      <!-- The one server this device syncs with - desktop's equivalent is
           ServerPickerView, embedded in Settings' Devices tab. Everything here
           is about that server; reaching a different one is the next section
           down. -->
      <StackPanel Classes="section">
        <TextBlock Classes="section-header" Text="Paired server"/>

        <Grid IsVisible="{Binding Main.PairedServerAlias, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
              ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!-- Only once the paired server has actually accepted this
                 device (see MainViewModel.IsPairedServerTrustConfirmed) -
                 not just pointed at, which is PairedServerAlias alone (see
                 the "waiting" spinner below). -->
            <!-- Desktop's sidebar carries the same three states in the same
                 glyph; here the unreachable one keeps its explanatory line
                 below as well, since a phone off the network is the common
                 case and a bare icon would not say why. -->
            <controls:ConnectionStatusIcon
                IsConnected="{Binding Main.IsPairedServerTrustConfirmed}"
                IsBusy="{Binding Main.IsPairedServerBusy}"
                IsUnreachable="{Binding Main.ShowPairedServerUnreachableWarning}"
                IconSize="16"
                VerticalAlignment="Center"/>
            <!-- How fresh the synced library is sits directly under the name it
                 is about (see MainViewModel.LastSyncedDisplay); several lines
                 further down it read as a fact about the section rather than
                 about this server. Desktop's picker stacks the same two. -->
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Main.PairedServerAlias}" FontWeight="Medium"/>
              <TextBlock IsVisible="{Binding Main.LastSyncedDisplay, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                         Text="{Binding Main.LastSyncedDisplay}"
                         Opacity="0.6" FontSize="12" Margin="0,1,0,0"/>
            </StackPanel>
            <!-- Pairing requested but not yet approved by the server - see
                 MainViewModel.IsPairedServerAwaitingApproval. -->
            <TextBlock Text="Waiting for server..."
                       Opacity="0.6" FontSize="12"
                       VerticalAlignment="Center"
                       IsVisible="{Binding Main.IsPairedServerAwaitingApproval}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Sync Now" Command="{Binding ForceSyncCommand}" IsEnabled="{Binding Main.CanForceSync}"/>
            <Button Content="Unpair" Command="{Binding UnpairServerCommand}"/>
          </StackPanel>
        </Grid>
        <!-- See MainViewModel.ShowPairedServerUnreachableWarning - desktop's
             equivalent is the sidebar's own check/exclamation glyph next to
             the paired server's row. -->
        <TextBlock IsVisible="{Binding Main.ShowPairedServerUnreachableWarning}"
                   Text="Server not reachable"
                   Foreground="{DynamicResource AppWarningBrush}"
                   FontSize="12" Margin="0,2,0,0"/>
        <TextBlock IsVisible="{Binding Main.LastForceSyncResult, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding Main.LastForceSyncResult}"
                   Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock IsVisible="{Binding Main.PairedServerAlias, Converter={x:Static avc:StringConverters.IsNullOrEmpty}}"
                   Text="Not paired with a server" Opacity="0.5" FontSize="14"/>

        <!-- How the server is being reached, when it is not the ordinary
             at-home case - see MainViewModel.PairedServerRouteDescription. A
             silent fallback to a relayed tailnet path is otherwise
             indistinguishable from a fast local one. -->
        <TextBlock IsVisible="{Binding Main.PairedServerRouteDescription, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding Main.PairedServerRouteDescription}"
                   Opacity="0.6" FontSize="12" Margin="0,2,0,0"/>

        <!-- On by default, same as desktop: whoever runs the server is the one
             who ends up diagnosing a phone, and a phone's owner cannot be asked
             to find a log file. Directly under the server it names, since that
             is the server the logs go to. See
             AppSettings.ShareLogsWithPairedServer. -->
        <CheckBox Content="Send logs to paired server"
                  IsChecked="{Binding Main.ShareLogsWithPairedServer}"
                  Margin="0,6,0,0"/>

        <!-- Adding another phone or laptop to this server, without needing a
             desktop or a browser to do it - shown only if this device is
             paired with a Flower.Server that is reachable right now *and* that
             server counts this device as one of its administrators (see
             MainViewModel.CanInviteDeviceToPairedServer). A listener's phone
             sees nothing here rather than a button the server can only
             refuse. -->
        <StackPanel IsVisible="{Binding Main.CanInviteDeviceToPairedServer}" Spacing="6" Margin="0,12,0,0">
          <!-- The checkbox rides alongside the button rather than under it:
               it is what the button is about to issue, not a separate setting,
               and a phone's width has room for both. More than one device may
               be an administrator - an owner's own desktop and their own phone
               both being one is the expected shape. See
               MainViewModel.PairingCodeGrantsAdmin. -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Generate Pairing Code"
                    Command="{Binding InviteDeviceCommand}"
                    IsEnabled="{Binding !Main.IsIssuingPairingCode}"/>
            <CheckBox Content="Administrator"
                      IsChecked="{Binding Main.PairingCodeGrantsAdmin}"
                      VerticalAlignment="Center"/>
          </StackPanel>
          <!-- Shown whether or not the box is ticked, because what pairing
               costs is the decision being made here and a warning that only
               appears once the dangerous option is already chosen has arrived
               too late to inform it. The ordinary grant is not nothing either -
               a listener's playlists replace the server's - so both halves are
               stated rather than only the administrator one. -->
          <TextBlock Text="A paired device plays the whole library and adds its plays to the server's counts, and its playlists replace the ones there - so it can add or remove playlists for everyone."
                     FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
          <TextBlock Text="An administrator can also change the server's settings, including which folders the library is read from, so it can add or remove music. It can star tracks for everyone, and add and remove devices."
                     FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
          <!-- Copying is the actual gesture on a phone - the code goes into a
               message to whoever is holding the other device, and a selection
               drag on a 20pt monospace string is not how anyone does that. The
               button shares the code's own visibility so the two appear
               together.
               A Grid rather than a horizontal StackPanel because the two have
               to share a centre line: the code's box is taller than the
               button's and centring each within its own is what left them
               looking offset from one another. -->
          <Grid ColumnDefinitions="Auto,Auto"
                IsVisible="{Binding Main.IssuedPairingCode, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}">
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="6" Padding="10,4" Margin="0,0,12,0"
                    VerticalAlignment="Stretch">
              <SelectableTextBlock Text="{Binding Main.IssuedPairingCode}"
                                   FontFamily="monospace" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
            </Border>
            <Button Grid.Column="1" Content="Copy"
                    Click="CopyPairingCodeButton_Click"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Center"/>
          </Grid>
          <TextBlock IsVisible="{Binding Main.IssuedPairingCode, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                     Text="Enter this code on the device you are adding. It works once."
                     FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
          <!-- The link is the safer of the two renderings, so it is offered
               rather than hidden behind the code: a device given the whole
               link checks that it reached the server the link came from, and a
               device given five characters trusts whatever answers. See
               PairingEntry.
               It gets the same Copy button as the code, and needs it more: a
               flower:// link is not something anyone retypes, and on a phone a
               selection drag across a wrapped monospace string is worse still. -->
          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{Binding Main.IssuedPairingInvite, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}">
            <SelectableTextBlock Grid.Column="0" Text="{Binding Main.IssuedPairingInvite}"
                                 FontFamily="monospace" FontSize="11"
                                 Margin="0,0,12,0"
                                 Opacity="0.7" TextWrapping="Wrap"
                                 VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Copy link"
                    Click="CopyPairingInviteButton_Click"
                    VerticalAlignment="Center"/>
          </Grid>
          <TextBlock IsVisible="{Binding Main.IssuedPairingInvite, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                     Text="Send the link rather than the code. A device given the link refuses to pair with anything but this server; a device given five characters trusts whatever answers."
                     FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
          <TextBlock IsVisible="{Binding Main.IssuedPairingCodeError, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding Main.IssuedPairingCodeError}"
                     Foreground="{DynamicResource AppWarningBrush}"
                     FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Classes="section">
        <TextBlock Classes="section-header" Text="Add new server"/>

        <!-- Bootstrap only: a server this phone has never shared a network
             with, and so could never discover. A server paired with at home
             reports its own addresses and keeps working away from home without
             anything being typed - see docs/REMOTE-ACCESS-PLAN.md. -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding ManualServerAddress}"
                   PlaceholderText="my-server.tail1234.ts.net:4533"
                   controls:SoftKeyboard.ReopenOnTap="True"
                   FontSize="14" Margin="0,0,8,0"/>
          <Button Grid.Column="1" Content="Add" Command="{Binding AddManualServerCommand}"/>
        </Grid>
        <TextBlock IsVisible="{Binding ManualServerStatus, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding ManualServerStatus}"
                   Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <ItemsControl ItemsSource="{Binding Main.ManualServerAddresses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <TextBlock Grid.Column="0" Text="{Binding}" Opacity="0.7" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="Remove"
                        Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).RemoveManualServerCommand}"
                        CommandParameter="{Binding}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Flower servers seen on this network right now (mDNS), each one
             offering to pair with it - tapping Pair opens the code sheet, the
             same flow the desktop sidebar runs.
             Hidden outright once this phone is paired with something, rather
             than shown with every button greyed out: switching servers takes
             an explicit unpair first (Unpair above), so a list whose every row
             is dead only invites the question of what it was for.
             Rows reach back up to the page's own root DataContext
             (MobileMainViewModel) for the command, since each row's own
             DataContext here is a DiscoveredDevice instead. -->
        <StackPanel Margin="0,8,0,0" Spacing="4"
                    IsVisible="{Binding Main.PairedServerAlias, Converter={x:Static avc:StringConverters.IsNullOrEmpty}}">
          <TextBlock Text="Servers on this network" FontSize="13" Opacity="0.6"/>
          <TextBlock Text="No servers found yet. One has to be running and on the same Wi-Fi."
                     FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                     IsVisible="{Binding !Main.HasAvailableServers}"/>
          <ItemsControl ItemsSource="{Binding Main.AvailableServers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:DiscoveredDevice">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Grid.Column="0" Text="{Binding Alias}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Pair"
                          Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).PairWithServerCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- Which build this is, and what the process is costing: the two things
           asked of a phone that is misbehaving, and neither is a setting.
           The figures are polled once a second and only while this screen is
           open (MobileMainViewModel.ActiveSheet starts/stops it) - a hot phone
           and a stuttering track is a question about CPU and memory, and until
           this existed there was no way to ask it from the device. -->
      <StackPanel Classes="section" Margin="20,4,20,24">
        <TextBlock Classes="section-header" Text="Additional information"/>

        <TextBlock x:Name="VersionTextBlock" FontSize="12" Opacity="0.5"/>

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" FontSize="14" Opacity="0.55" Margin="0,2,14,2" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Resources.CpuText}"
                     FontSize="14" FontFamily="monospace" Margin="0,2" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory" FontSize="14" Opacity="0.55" Margin="0,2,14,2" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Resources.MemoryText}"
                     FontSize="14" FontFamily="monospace" Margin="0,2" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Heap" FontSize="14" Opacity="0.55" Margin="0,2,14,2" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Resources.HeapText}"
                     FontSize="14" FontFamily="monospace" Margin="0,2" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="GC" FontSize="14" Opacity="0.55" Margin="0,2,14,2" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Resources.GcText}"
                     FontSize="14" FontFamily="monospace" Margin="0,2" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Threads" FontSize="14" Opacity="0.55" Margin="0,2,14,2" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Resources.ThreadsText}"
                     FontSize="14" FontFamily="monospace" Margin="0,2" />
        </Grid>
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
