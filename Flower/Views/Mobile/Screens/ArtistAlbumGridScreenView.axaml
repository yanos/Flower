<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.ArtistAlbumGridScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- One artist's own albums (tapped from the artist name picker) - same
       tile-grid presentation/virtualization as Recently Added/Albums (see
       RecentlyAddedScreenView's own comment); tapping a tile drills into that
       album's tracks via SelectArtistAlbumCommand. -->
  <ScrollViewer controls:RubberBandScroll.IsEnabled="True">
    <ItemsControl ItemsSource="{Binding ArtistAlbumGridRows}"
                  Margin="12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlbumGridRow">
          <!-- Keep the outer gutter and the inter-album gutter identical. -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Classes="pickerRow" Padding="0"
                    Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectArtistAlbumCommand}"
                    CommandParameter="{Binding First.Name}">
              <StackPanel Spacing="6" Margin="0,0,0,24" HorizontalAlignment="Stretch"
                          Classes.dimmed="{Binding First.IsUnavailable}">
                <controls:SquareAlbumArtView AlbumArt="{Binding First.AlbumArt}" />
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding First.Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding First.Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="pickerRow" Padding="0"
                    IsVisible="{Binding Second, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                    Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectArtistAlbumCommand}"
                    CommandParameter="{Binding Second.Name}">
              <StackPanel Spacing="6" Margin="0,0,0,24" HorizontalAlignment="Stretch"
                          Classes.dimmed="{Binding Second.IsUnavailable}">
                <controls:SquareAlbumArtView AlbumArt="{Binding Second.AlbumArt}" />
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Second.Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Second.Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
