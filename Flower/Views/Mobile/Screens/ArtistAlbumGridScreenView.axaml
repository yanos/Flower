<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.ArtistAlbumGridScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- One artist's own albums (tapped from the artist name picker) - same
       tile-grid presentation/virtualization as Recently Added/Albums (see
       RecentlyAddedScreenView's own comment); tapping a tile drills into that
       album's tracks via SelectArtistAlbumCommand. -->
  <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
    <!-- Stacked with the screen's title, so the title scrolls away with the
         tiles (ScreenTitle). -->
    <StackPanel>
      <controls:ScreenTitle />
      <ItemsControl ItemsSource="{Binding ArtistAlbumGridRows}"
                    Padding="12,12,0,12"
                    controls:AlbumGridColumnSizing.IsEnabled="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AlbumGridRow">
            <!-- One UniformGrid per row, sized by that row's own Columns: the
                 grid fits as many ~150px tiles across as the width allows, so a
                 phone turned into landscape shows five where portrait shows two
                 (see AlbumGridRow.ColumnsFor, fed by AlbumGridColumnSizing on
                 the ItemsControl above). UniformGrid has no ColumnSpacing of its
                 own, so the 12px gutter is each tile's right margin and the
                 ItemsControl leaves its own right edge to the last tile's - that
                 is what keeps the gap identical at both screen edges and between
                 columns. The gap *below* a tile is deliberately much larger than
                 the 6 between its art and its caption, so a title reads as
                 belonging to the album above it rather than the one below. -->
            <ItemsControl ItemsSource="{Binding Tiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlbumTileViewModel">
                  <Button Classes="pickerRow" Padding="0" Margin="0,0,12,20"
                          Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectArtistAlbumCommand}"
                          CommandParameter="{Binding Name}"
                          controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                          controls:LongPress.CommandParameter="{Binding}">
                    <controls:AlbumCard Tile="{Binding}"
                                        MenuCommand="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
