<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.QueueScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/TrackRowTemplate.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- The Queue tab: the song playing, then what plays after it - see
       MobileMainViewModel.QueueRows. A ScrollViewer over an ItemsControl
       rather than the screenScroll ListBox. The rows still virtualize: the
       panel sizes itself off the effective viewport, which the StackPanel
       around it does not change, and a queue can be the whole library.

       No line under the title saying why the order is what it is (shuffle,
       repeat): the desktop's page subtitle says it, where there is room, and
       on a phone it only pushed the songs down.

       Rows are dragged by their handle like a playlist's (TrackRowDragReorder),
       all but the song playing, which heads the list.

       No pull-down filter (MobileNavigationFrame.CanFilter): the queue is in
       the order it plays in, and a filtered one would hide what is next. -->
  <Panel>
    <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
      <StackPanel>
        <controls:ScreenTitle />
        <ItemsControl x:Name="QueueList"
                      ItemsSource="{Binding QueueRows}" ItemTemplate="{StaticResource TrackRowTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Where a dragged row will land -->
    <Border x:Name="DropIndicator"
            Height="2"
            Background="{DynamicResource AppAccentBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsVisible="False" />
  </Panel>
</UserControl>
