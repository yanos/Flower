<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.RecentlyAddedScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Recently Added: album art grid, ordered by recency - the app's
       default/home view (see MobileMainViewModel._selectedTab). Tapping a
       tile drills into that album's tracks via the same underlying
       Albums-tab filtering (SelectRecentlyAddedAlbumCommand).

       Bound to rows of two tiles (AlbumGridRow), not a flat tile list, with
       a VirtualizingStackPanel rather than a UniformGrid - a flat list in a
       UniformGrid isn't virtualizable (no viewport awareness), so it had to
       realize/measure/template-expand every tile in the whole library the
       first time the grid became visible - a multi-second stall on a library
       with ~1,400 albums. Wrapped in an explicit ScrollViewer - unlike
       ListBox, plain ItemsControl has no ScrollViewer in its own default
       template, so without this there was no scroll gesture at all on
       mobile (no mouse wheel to fall back on). Safe to add back alongside
       VirtualizingStackPanel specifically because that panel cooperates with
       ScrollViewer via logical scrolling the same way ListBox's own
       virtualizing panel does - it's a non-virtualizing panel (StackPanel/
       WrapPanel) inside a ScrollViewer that would defeat virtualization by
       forcing an unconstrained measure pass. -->
  <ScrollViewer controls:RubberBandScroll.IsEnabled="True">
    <ItemsControl ItemsSource="{Binding RecentlyAddedAlbumRows}"
                  Margin="12,12,0,12"
                  controls:AlbumGridColumnSizing.IsEnabled="True">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlbumGridRow">
          <!-- One UniformGrid per row, sized by that row's own Columns: the
               grid fits as many ~150px tiles across as the width allows, so a
               phone turned into landscape shows five where portrait shows two
               (see AlbumGridRow.ColumnsFor, fed by AlbumGridColumnSizing on
               the ItemsControl above). UniformGrid has no ColumnSpacing of its
               own, so the 12px gutter is each tile's right margin and the
               ItemsControl leaves its own right edge to the last tile's - that
               is what keeps the gap identical at both screen edges and between
               columns. The gap *below* a tile is deliberately much larger than
               the 6 between its art and its caption, so a title reads as
               belonging to the album above it rather than the one below. -->
          <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Columns}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumTileViewModel">
                <Button Classes="pickerRow" Padding="0" Margin="0,0,12,24"
                        Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectRecentlyAddedAlbumCommand}"
                        CommandParameter="{Binding Name}">
                  <StackPanel Spacing="6" HorizontalAlignment="Stretch"
                              Classes.dimmed="{Binding IsUnavailable}">
                    <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}" />
                    <!-- Explicit LineHeights, not the font default: Inter has no CJK
                         glyphs, so a Japanese title falls back to a system face about
                         1.45x taller, and a row pairing one with a Latin title puts the
                         two captions at different heights. Pinning both lines makes every
                         caption 37px whatever script it is in. -->
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="13" LineHeight="20" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Artist}" FontSize="11" LineHeight="17" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
