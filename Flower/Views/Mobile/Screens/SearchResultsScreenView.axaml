<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:views="clr-namespace:Flower.Views.Mobile.Screens"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="Flower.Views.Mobile.Screens.SearchResultsScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/TrackRowTemplate.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Search tab results: Artists/Albums/Songs sections, each hidden when
       empty - see SearchViewModel. A plain
       ScrollViewer+StackPanel rather than TrackListScreenView's virtualized
       ListBox - search results are bounded by the query, not the whole
       library, so virtualization isn't worth the extra complexity here. -->
  <UserControl.Styles>
    <!-- Each section's name: Inter at the size of the rows under it,
         set apart by weight and a greyer tone rather than by being small. -->
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="16,16,16,6" />
    </Style>
    <!-- The chevron at the end of an album row: it opens a screen, where a
         song row plays. -->
    <Style Selector="materialIcons|MaterialIcon.drillIn">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </UserControl.Styles>

  <!-- Each section's rows are built once and handed the next search's
       results as the query is typed (RecyclingItemsControl); none is
       virtualized, each being capped (SearchViewModel.MaxResultsPerSection). -->
  <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
    <StackPanel>
      <StackPanel IsVisible="{Binding Search.HasArtistResults}">
        <TextBlock Classes="sectionHeader" Text="Artists" />
        <controls:RecyclingItemsControl ItemsSource="{Binding Search.ArtistResults}">
          <ItemsControl.ItemTemplate>
            <!-- The Artists tab's own row (ArtistRowView). -->
            <DataTemplate x:DataType="vm:ArtistPickerRow">
              <views:ArtistRowView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </controls:RecyclingItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding Search.HasAlbumResults}">
        <TextBlock Classes="sectionHeader" Text="Albums" />
        <controls:RecyclingItemsControl ItemsSource="{Binding Search.AlbumResults}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AlbumTileViewModel">
              <Button Classes="pickerRow"
                      Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectSearchAlbumCommand}"
                      CommandParameter="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                      Classes.dimmed="{Binding IsUnavailable}">
                  <controls:AlbumArtView Grid.Column="0" AlbumArt="{Binding AlbumArt}"
                                         ArtCornerRadius="8"
                                         Width="64" Height="64" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="14" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <materialIcons:MaterialIcon Grid.Column="2" Classes="drillIn" Kind="ChevronRight" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </controls:RecyclingItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding Search.HasSongResults}">
        <TextBlock Classes="sectionHeader" Text="Songs" />
        <controls:RecyclingItemsControl ItemsSource="{Binding Search.SongResults}" ItemTemplate="{StaticResource TrackRowTemplate}" />
      </StackPanel>

      <!-- See SearchViewModel.MaxResultsPerSection - each section
           above is capped, so a very broad query needs to say so rather
           than silently looking like the whole match set. -->
      <TextBlock IsVisible="{Binding Search.HasMoreResults}"
                 Text="Showing partial results - refine your search to see more."
                 FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                 Margin="16,14,16,20" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
