<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="Flower.Views.Mobile.Screens.SearchResultsScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/TrackRowTemplate.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Search tab results: Artists/Albums/Songs sections, each hidden when
       empty - see MobileMainViewModel.RebuildSearchResults. A plain
       ScrollViewer+StackPanel rather than TrackListScreenView's virtualized
       ListBox - search results are bounded by the query, not the whole
       library, so virtualization isn't worth the extra complexity here. -->
  <UserControl.Styles>
    <!-- Each section's name: Inter at the size of the rows under it,
         set apart by weight and a greyer tone rather than by being small. -->
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="16,16,16,6" />
    </Style>
    <!-- The chevron at the end of an artist or album row: those two open a
         screen, where a song row plays. -->
    <Style Selector="materialIcons|MaterialIcon.drillIn">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
    <StackPanel>
      <StackPanel IsVisible="{Binding HasSearchArtistResults}">
        <TextBlock Classes="sectionHeader" Text="Artists" />
        <ItemsControl ItemsSource="{Binding SearchArtistResults}">
          <ItemsControl.ItemTemplate>
            <!-- The artist's cover is the collage the Artists tab draws for
                 them, made round: a person, where an album is square. -->
            <DataTemplate x:DataType="vm:ArtistPickerRow">
              <Button Classes="pickerRow"
                      Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectSearchArtistCommand}"
                      CommandParameter="{Binding Name}"
                      controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenArtistActionsCommand}"
                      controls:LongPress.CommandParameter="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                  <controls:AlbumCollageView Grid.Column="0"
                                              Covers="{Binding Cover.CoverArt}"
                                              ArtCornerRadius="28"
                                              Width="56" Height="56" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="17"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <materialIcons:MaterialIcon Grid.Column="2" Classes="drillIn" Kind="ChevronRight" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding HasSearchAlbumResults}">
        <TextBlock Classes="sectionHeader" Text="Albums" />
        <ItemsControl ItemsSource="{Binding SearchAlbumResults}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AlbumTileViewModel">
              <Button Classes="pickerRow"
                      Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectSearchAlbumCommand}"
                      CommandParameter="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                      Classes.dimmed="{Binding IsUnavailable}">
                  <controls:AlbumArtView Grid.Column="0" AlbumArt="{Binding AlbumArt}"
                                         ArtCornerRadius="8"
                                         Width="64" Height="64" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="14" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <materialIcons:MaterialIcon Grid.Column="2" Classes="drillIn" Kind="ChevronRight" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding HasSearchSongResults}">
        <TextBlock Classes="sectionHeader" Text="Songs" />
        <ItemsControl ItemsSource="{Binding SearchSongResults}" ItemTemplate="{StaticResource TrackRowTemplate}" />
      </StackPanel>

      <!-- See MaxSearchResultsPerSection's own doc comment - each section
           above is capped, so a very broad query needs to say so rather
           than silently looking like the whole match set. -->
      <TextBlock IsVisible="{Binding HasMoreSearchResults}"
                 Text="Showing partial results - refine your search to see more."
                 FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                 Margin="16,14,16,20" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
