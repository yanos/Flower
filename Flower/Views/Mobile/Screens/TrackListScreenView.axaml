<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:screens="clr-namespace:Flower.Views.Mobile.Screens"
             x:Class="Flower.Views.Mobile.Screens.TrackListScreenView"
             x:DataType="vm:MobileMainViewModel"
             x:Name="Root"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/TrackRowTemplate.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The art and the words are two templates, not one header: the
           narrow layout stacks them (art, then title/artist/year, then the
           tracks, all in one scroll), while the wide one pins the art down the
           left and puts the words at the top of the track column, where they
           scroll away with the songs. Splitting them is what lets the wide
           layout keep the art still while the text moves.

           Neither carries a size of its own: SquareAlbumArtView takes whatever
           width it is given and stays square (see that control), so each use
           site sets a Width and the art follows. -->
      <DataTemplate x:Key="AlbumArtTemplate" x:DataType="vm:AlbumTileViewModel">
        <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}"
                                     Classes.dimmed="{Binding IsUnavailable}" />
      </DataTemplate>

      <!-- Under the name, artist and year, a pill of the album's own actions:
           play, shuffle, add to playlist, download. The download is the same
           button download-all always was - the screen-wide indicator and
           command, so it spins while the batch runs and leaves once there is
           nothing left to fetch - and the other three act on the same rows it
           does. Play comes first, ringed like Now Playing's (Button.pill.circle): it is
           what the group is for. Download goes last because it is the one that
           leaves, so nothing shifts when it does. All of them are reached through the screen's DataContext,
           since this template's own is the album tile.

           The pill is the floating one MobileMainView puts over its screens
           (Border.floating, Button.pill), which reaches here because the
           screens are hosted inside that view. Centred under the art, ranged
           left beside it (.albumText styles). Drawn a fifth larger than the
           floating pill's own 40px: 24px glyphs in 44px buttons, 48 tall. -->
      <DataTemplate x:Key="AlbumTextTemplate" x:DataType="vm:AlbumTileViewModel">
        <StackPanel Spacing="2" Classes.dimmed="{Binding IsUnavailable}">
          <TextBlock Text="{Binding Name}"
                     FontSize="20" FontWeight="Bold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding Artist}"
                     FontSize="15" Opacity="0.7"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding RepresentativeTrack.Year}"
                     FontSize="13" Opacity="0.5"
                     IsVisible="{Binding RepresentativeTrack.Year, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}" />
          <Border Classes="floating albumActions" Height="48" CornerRadius="24" Padding="2,0" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Classes="pill circle" Padding="3"
                      Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).PlayAlbumCommand}">
                <Border Classes="ring" Padding="5.5">
                  <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24" />
                </Border>
              </Button>
              <Button Classes="pill" Padding="10"
                      Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).ShuffleAlbumCommand}">
                <materialIcons:MaterialIcon Kind="Shuffle" Width="24" Height="24" />
              </Button>
              <Button Classes="pill" Padding="10"
                      Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).OpenAlbumAddToPlaylistCommand}">
                <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="24" Height="24" />
              </Button>
              <!-- Its own IsVisible is the indicator's answer, so the server
                   gate goes on a wrapper - the two are different questions. -->
              <Panel IsVisible="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).Main.CanForceSync}">
                <controls:TrackDownloadButton DataContext="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).DownloadAllIndicator}"
                                              IconSize="24"
                                              IconPadding="10"
                                              Label="Download album"
                                              Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).DownloadAllVisibleCommand}" />
              </Panel>
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The words are one ContentControl used by both layouts, so the only
         thing that varies with the layout - centred under the art when it is
         stacked, ranged left at the head of the track column when it is not -
         has to come from a class on that one use site rather than from two
         templates. -->
    <Style Selector="ContentControl.albumText TextBlock">
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <!-- Centred under the art, the words answer to the screen, so they are
         inset evenly. Ranged left beside it they answer to the song titles
         below instead, and take their left inset from the row: 8 of
         Button.trackRow's own horizontal Padding (see MobileMainView.axaml)
         plus the 14px download well every row reserves ahead of its title
         (see TrackRowTemplate.axaml). Change either number there and this one
         follows - AlbumDetailLayoutTests.The_album_name_lines_up_with_the_
         song_titles measures the two against each other. Both live here
         rather than on the use site because a local Margin would outrank
         them. -->
    <Style Selector="ContentControl.albumText">
      <Setter Property="Margin" Value="12,4,12,16" />
    </Style>
    <Style Selector="ContentControl.albumText.beside TextBlock">
      <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style Selector="ContentControl.albumText Border.albumActions">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="ContentControl.albumText.beside Border.albumActions">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="ContentControl.albumText.beside">
      <Setter Property="Margin" Value="22,4,12,16" />
    </Style>

    <!-- A row with no artist line under the title is a single line of text,
         but it kept the height of two: the trailing "..." button is a 20px
         icon in 6px of padding, 32 tall on its own, which is what the row
         measured to either way. So the tightening has to take that button
         with it, or hiding the artist reclaims nothing.

         The button's own padding is trimmed in the template itself (a local
         value there would beat any setter here anyway), so all this has left
         to do is close the gap above and below.

         Here rather than in MobileMainView.axaml's own trackRow styles
         because "dense" is set from ITrackRowHost.ShowsRowArtist, which is
         this screen's question to answer - and being the nearer StyleHost,
         these win over that file's Padding for the rows it applies to. Only
         the vertical half is this style's own business: the 8 has to stay
         equal to the horizontal padding over there, since it is what the
         album text's margin above is measured against, and a dense row is
         still a row in the same list as a tall one. -->
    <Style Selector="Button.trackRow.dense">
      <Setter Property="Padding" Value="8,3" />
    </Style>
  </UserControl.Styles>

  <!-- Track list: Songs (flat), or the drilled-into album/artist/playlist.
       Two mutually exclusive full-area children, not one Grid - the album
       case's header used to sit in a pinned Auto row above the scrolling
       ListBox; in the narrow layout it now scrolls away with the rest of the
       view instead, which needs the header to be part of the SAME scrollable
       content as the tracks below it, not a sibling of whatever scrolls them.
       (The wide layout pins the art again, deliberately, but not the
       words - see the album Grid.) -->
  <Panel>
    <Grid IsVisible="{Binding #Root.IsAlbumMode}" ColumnDefinitions="Auto,*">
      <!-- Turned sideways (or on a tablet) the art moves out of the scroll
           and pins to the left, sized to fill the height it is given
           (PinnedArtSize in the code-behind), with the album name and the
           tracks scrolling past it on the right. Stacked, the 240px art ate
           most of a landscape screen before a single song was visible.
           Column 0 is Auto and its only child is collapsed in the narrow
           layout, so it measures to nothing there and the ScrollViewer gets
           the full width without either side needing a bound Grid.Column.

           The tracks themselves are laid out once, not once per layout: this
           control can be kept alive as ScreenStackPanel's one-back screen, and
           a hidden ItemsControl still generates its containers (see DisplayRows'
           own comment in the code-behind), so a second copy would quietly
           realize every row of the layout that is not even showing. Only the
           art is written twice - one collapsed art view costs nothing
           measurable and shares the same cached bitmap - and the words are
           written once, inside the scroll, because both layouts want them to
           scroll away. -->
      <ContentControl Grid.Column="0"
                      IsVisible="{Binding #Root.IsWideAlbumLayout}"
                      Content="{Binding #Root.DisplayHeader}"
                      ContentTemplate="{StaticResource AlbumArtTemplate}"
                      Width="{Binding #Root.PinnedArtSize}"
                      Margin="16"
                      VerticalAlignment="Center" />

      <!-- Album mode: header + track list share one ScrollViewer, so the art
           and the words scroll away with everything else instead of staying
           pinned - except for the art in the wide layout, which is the one
           thing hoisted out of the scroll above.

           A plain (non-virtualizing) ItemsControl is fine here, unlike Songs'
           TrackListBox below - one album's tracks are a small, bounded list (a
           few dozen at most), nothing like the whole library, so there is no
           virtualization concern to trade away for this. TrackRowTemplate
           already hides its own drag handle outside IsShowingPlaylistTracks
           and its own art thumbnail inside IsShowingAlbumTrackList (see the
           template itself), so reusing it here needs no changes.

           Bound to #Root.DisplayRows/DisplayHeader/IsAlbumMode,
           NOT Main.Rows/AlbumDetailRows/CurrentAlbumHeader/IsShowingAlbumTrackList
           on the shared DataContext directly - this instance can be kept alive
           as ScreenStackPanel's "one back" screen (see the swipe-back
           navigation feature), and a kept-alive ItemsControl's item-container
           generation is not gated on IsVisible the way layout/rendering is, so
           binding it straight to the live, wholesale-replaced Main.Rows meant
           it kept trying to realize thousands of rows in the background even
           while hidden/frozen - confirmed as making the app feel slow to
           navigate generally, not just within an album (the same bug, in the
           same shape, that motivated AlbumDetailRows in the first place - see
           TrackListScreenView.axaml.cs's ObserveLive/Freeze). -->
      <ScrollViewer Grid.Column="1" Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
        <StackPanel>
          <ContentControl IsVisible="{Binding !#Root.IsWideAlbumLayout}"
                          Content="{Binding #Root.DisplayHeader}"
                          ContentTemplate="{StaticResource AlbumArtTemplate}"
                          Width="240" Margin="24,4,24,12"
                          HorizontalAlignment="Center" />
          <!-- Inset by the .albumText styles above, which is where the two
               layouts differ - the ranged-left one has to line its first
               character up with the song titles below it. -->
          <ContentControl Classes="albumText"
                          Classes.beside="{Binding #Root.IsWideAlbumLayout}"
                          Content="{Binding #Root.DisplayHeader}"
                          ContentTemplate="{StaticResource AlbumTextTemplate}" />
          <ItemsControl ItemsSource="{Binding #Root.DisplayRows}" ItemTemplate="{StaticResource TrackRowTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Songs (flat)/playlist mode: unchanged virtualized ListBox, still
         backing DragHandle_PointerPressed/etc.'s TrackListBox references
         for playlist drag-to-reorder. -->
    <ListBox Classes="screenScroll" IsVisible="{Binding !#Root.IsAlbumMode}"
              x:Name="TrackListBox"
              Background="Transparent"
              ItemsSource="{Binding #Root.DisplayRows}"
              ItemTemplate="{StaticResource TrackRowTemplate}"
              controls:RubberBandScroll.IsEnabled="True"
              SelectionMode="Single" />

    <!-- Drop-position indicator for the playlist drag-to-reorder gesture -->
    <Border x:Name="DropIndicator"
            Height="2"
            Background="{DynamicResource AppAccentBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsVisible="False" />
  </Panel>
</UserControl>
