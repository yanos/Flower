<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Flower.Views.Mobile.Screens.TrackListScreenView"
             x:DataType="vm:MobileMainViewModel"
             x:Name="Root"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/TrackRowTemplate.axaml" />
        <!-- The header an album's tracks and a playlist's tracks both get -
             one definition for the two of them. See that file. -->
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/AlbumHeaderTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The words are the same template wherever they are drawn (stacked
         under the art, or at the head of the track column beside it), so the
         only thing that varies - centred there, ranged left here - comes from
         a class on the ContentControl showing them rather than from a second
         copy of them. .beside is the wide album layout's; the .albumText
         without it is the stacked header's own, inside
         AlbumHeaderTemplate. -->
    <Style Selector="ContentControl.albumText TextBlock">
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <!-- Centred under the art, the words answer to the screen, so they are
         inset evenly. Ranged left beside it they answer to the song titles
         below instead, and take their left inset from the row: the 24 of
         Grid.albumTracks' row Padding (below), which is all that stands ahead
         of a title inside an album. Change one and change the other: nothing
         checks the two against each other. Both live here rather than on the
         use site because a local Margin would outrank them. -->
    <Style Selector="ContentControl.albumText">
      <Setter Property="Margin" Value="12,4,12,16" />
    </Style>
    <Style Selector="ContentControl.albumText.beside TextBlock">
      <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style Selector="ContentControl.albumText StackPanel.albumActions">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="ContentControl.albumText.beside StackPanel.albumActions">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="ContentControl.albumText.beside">
      <Setter Property="Margin" Value="24,4,12,16" />
    </Style>

    <!-- Under an album's (or a playlist's) header the songs are set in from
         the edge, in line with the header's own breathing room, rather than
         the 8 a flat list uses to buy its titles width: these rows carry no
         art, so there is width to spare. Less on the right, where the "..."
         button's own padding already stands off the edge. No vertical
         padding, like every track row - see Button.trackRow in
         MobileMainView.axaml. -->
    <Style Selector="Grid.albumTracks Button.trackRow">
      <Setter Property="Padding" Value="24,0,16,0" />
    </Style>

    <!-- An album's page is washed in its cover's colour, the way Now Playing
         is (AlbumPage's Background, from the code-behind) - dark whatever the
         theme, so the words on it are white: the name, the artist, the songs,
         and the songs' own icons, which dim rather than turn the pressed
         accent, as on that sheet. The round actions under the name are Now
         Playing's round buttons too: no fill, ringed and drawn in white. A
         playlist's page is the plain one, and its name the colour every
         page's title is (AppChromeBrush). -->
    <Style Selector="TextBlock.albumName">
      <Setter Property="Foreground" Value="{DynamicResource AppChromeBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <!-- A row is a Button, whose Fluent theme gives it a foreground of its
         own (and its presenter another, pressed), so the page's does not
         reach the songs by inheritance. -->
    <Style Selector="Grid#AlbumPage Button.trackRow">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage Button.trackRow /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage TextBlock.albumName">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage Button.trackRow:not(.placeholder) materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage Button.trackRow:not(.placeholder) :is(Button):pressed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtRingBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage StackPanel.albumActions Border.floating">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage StackPanel.albumActions materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#AlbumPage StackPanel.albumActions :is(Button):pressed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtRingBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Track list: Songs (flat), or the drilled-into album/artist/playlist.
       Two mutually exclusive full-area children, not one Grid - the album
       case's header used to sit in a pinned Auto row above the scrolling
       ListBox; in the narrow layout it now scrolls away with the rest of the
       view instead, which needs the header to be part of the SAME scrollable
       content as the tracks below it, not a sibling of whatever scrolls them.
       (The wide layout pins the art again, deliberately, but not the
       words - see the album Grid.) -->
  <Panel>
    <Grid x:Name="AlbumPage" Classes="albumTracks" IsVisible="{Binding #Root.IsAlbumMode}" ColumnDefinitions="Auto,*">
      <!-- The rule between songs, faint white on the cover's colour rather
           than the theme's divider, which is a cream line in light mode. -->
      <Grid.Resources>
        <SolidColorBrush x:Key="AppDividerBrush" Color="{DynamicResource PaletteOnArt}" Opacity="0.15" />
      </Grid.Resources>
      <!-- Turned sideways (or on a tablet) the art moves out of the scroll
           and pins to the left, sized to fill the height it is given
           (PinnedArtSize in the code-behind), with the album name and the
           tracks scrolling past it on the right. Stacked, the 240px art ate
           most of a landscape screen before a single song was visible.
           Column 0 is Auto and its only child is collapsed in the narrow
           layout, so it measures to nothing there and the ScrollViewer gets
           the full width without either side needing a bound Grid.Column.

           The tracks themselves are laid out once, not once per layout: this
           control can be kept alive as ScreenStackPanel's one-back screen, and
           a hidden ItemsControl still generates its containers (see DisplayRows'
           own comment in the code-behind), so a second copy would quietly
           realize every row of the layout that is not even showing. Only the
           art is written twice - one collapsed art view costs nothing
           measurable and shares the same cached bitmap - and the words are
           written once, inside the scroll, because both layouts want them to
           scroll away. -->
      <ContentControl Grid.Column="0"
                      IsVisible="{Binding #Root.IsWideAlbumLayout}"
                      Content="{Binding #Root.DisplayHeader}"
                      ContentTemplate="{StaticResource AlbumArtTemplate}"
                      ClipToBounds="False"
                      Width="{Binding #Root.PinnedArtSize}"
                      Margin="16,80,16,16"
                      VerticalAlignment="Center" />

      <!-- Album mode: header + track list share one ScrollViewer, so the art
           and the words scroll away with everything else instead of staying
           pinned - except for the art in the wide layout, which is the one
           thing hoisted out of the scroll above.

           A plain (non-virtualizing) ItemsControl is fine here, unlike Songs'
           TrackListBox below - one album's tracks are a small, bounded list (a
           few dozen at most), nothing like the whole library, so there is no
           virtualization concern to trade away for this. TrackRowTemplate
           already hides its own drag handle outside IsShowingPlaylistTracks
           and its own art thumbnail inside IsShowingAlbumTrackList (see the
           template itself), so reusing it here needs no changes.

           Bound to #Root.DisplayRows/DisplayHeader/IsAlbumMode,
           NOT Main.Rows/AlbumDetailRows/CurrentAlbumHeader/IsShowingAlbumTrackList
           on the shared DataContext directly - this instance can be kept alive
           as ScreenStackPanel's "one back" screen (see the swipe-back
           navigation feature), and a kept-alive ItemsControl's item-container
           generation is not gated on IsVisible the way layout/rendering is, so
           binding it straight to the live, wholesale-replaced Main.Rows meant
           it kept trying to realize thousands of rows in the background even
           while hidden/frozen - confirmed as making the app feel slow to
           navigate generally, not just within an album (the same bug, in the
           same shape, that motivated AlbumDetailRows in the first place - see
           TrackListScreenView.axaml.cs's ObserveLive/Freeze). -->
      <!-- The cover again, behind the header: stretched across the page and
           blurred, fading out below the words, from the very top of the
           screen, under the back button and the status bar, so the page
           starts in it rather than below a strip of plain background. Part
           of the page rather than of what scrolls, so it stays put: the
           header and the songs scroll up over it, and a pull down past the
           top moves them and leaves it where it is. As tall as the stacked
           header stands at rest (SizeBackdrop in the code-behind), so it
           fades out under the words wherever they wrap. Only in the stacked
           layout; the wide one pins the cover itself instead.
           The blur is a small copy of the cover drawn large (ArtBackdrop
           .Soft), not a blur effect, which the phone would redraw on every
           frame of a scroll. Low quality to match the buttons over it, whose
           brush can only sample that way (PageDrawing in the code-behind) -
           Soft is smoothed already, so the two cannot be told apart. -->
      <Border x:Name="Backdrop"
              Grid.Column="1"
              VerticalAlignment="Top"
              ClipToBounds="True"
              IsHitTestVisible="False"
              IsVisible="{Binding !#Root.IsWideAlbumLayout}"
              OpacityMask="{DynamicResource AppBackdropFadeMask}">
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"
               Opacity="0.6"
               RenderOptions.BitmapInterpolationMode="LowQuality" />
      </Border>
      <ScrollViewer x:Name="AlbumScroll" Grid.Column="1" Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
        <StackPanel x:Name="AlbumContent">
          <!-- Blank over an album, however it was reached, and this
               collapses - see MobileNavigationFrame.Title. -->
          <controls:ScreenTitle />
          <!-- Stacked, the art and the words are one thing (the same one a
               playlist shows); pinned, the art is out of this scroller
               entirely and only the words are left here, ranged left so they
               line their first character up with the song titles below. -->
          <ContentControl x:Name="StackedHeader"
                          IsVisible="{Binding !#Root.IsWideAlbumLayout}"
                          Content="{Binding #Root.DisplayHeader}"
                          ContentTemplate="{StaticResource AlbumHeaderTemplate}"
                          ClipToBounds="False" />
          <ContentControl Classes="albumText beside"
                          IsVisible="{Binding #Root.IsWideAlbumLayout}"
                          Content="{Binding #Root.DisplayHeader}"
                          ContentTemplate="{StaticResource AlbumTextTemplate}" />
          <!-- Not virtualized - an album is short - but each row is still
               built once and handed the next album's songs
               (RecyclingItemsControl). -->
          <controls:RecyclingItemsControl ItemsSource="{Binding #Root.DisplayRows}" ItemTemplate="{StaticResource TrackRowTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Songs (flat)/playlist mode: the virtualized ListBox, still backing
         DragHandle_PointerPressed/etc.'s TrackListBox references for playlist
         drag-to-reorder. A playlist's own header goes above its first row
         through the screenScroll template (ScreenScroll.Header) rather than
         into a scroller of its own like the album screen's: a playlist can be
         thousands of songs long, and hoisting it out of the ListBox would
         cost exactly the virtualization that makes that bearable. ListHeader
         is null on the flat Songs list, which stands for the whole library
         and is nobody's one thing. -->
    <!-- The A-Z bar is the flat Songs list's alone - an album or a playlist
         is in its own order, where a letter means nothing - and takes a
         column rather than floating over the rows, whose "..." button is at
         their right edge. -->
    <Grid IsVisible="{Binding !#Root.IsAlbumMode}" ColumnDefinitions="*,Auto">
      <controls:RecyclingListBox Classes="screenScroll"
               x:Name="TrackListBox"
               controls:ScreenScroll.Header="{Binding #Root.ListHeader}"
               Background="Transparent"
               ItemsSource="{Binding #Root.DisplayRows}"
               ItemTemplate="{StaticResource TrackRowTemplate}"
               controls:RubberBandScroll.IsEnabled="True"
               SelectionMode="Single">
        <!-- Every row here is one height, so a panel that keeps its rows (see
             UniformRowPanel) rather than Avalonia's, which takes each one off
             the tree and back on again as it scrolls past. -->
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:UniformRowPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </controls:RecyclingListBox>
      <controls:ScrollIndexBar x:Name="IndexBar" Grid.Column="1"
                               IsVisible="{Binding #Root.IsSongsMode}"
                               Target="{Binding #TrackListBox}" />
    </Grid>

    <!-- Drop-position indicator for the playlist drag-to-reorder gesture -->
    <Border x:Name="DropIndicator"
            Height="2"
            Background="{DynamicResource AppAccentBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsVisible="False" />
  </Panel>
</UserControl>
