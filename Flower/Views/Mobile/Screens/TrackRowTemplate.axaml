<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rowvm="clr-namespace:Flower.ViewModels"
                    xmlns:views="clr-namespace:Flower.Views.Mobile.Screens">

  <!-- Shared by the main track list (Songs/album-artist-playlist drill-in, see
       TrackListScreenView) and the Search tab's own Songs section (see
       SearchResultsScreenView) - same row for the same underlying
       TrackRowViewModel wherever it appears, rather than a second copy of
       this template drifting out of sync. Moved into its own
       ResourceDictionary (out of the old monolithic MobileMainView.axaml)
       when each screen became its own UserControl, for the same reason.

       The row itself is TrackRowView, which sets what the song decides from
       code rather than binding it - see that control for why. What it reads
       off its host, it reads through ITrackRowHost: both hosts are
       UserControls, but neither IS the other, and casting to either one by
       name would make the row only work for that one host. ITrackRowHost
       (see that file) is a small interface both TrackListScreenView and
       SearchResultsScreenView implement, purely so the row has one static
       type to bind $parent[...] against. -->
  <DataTemplate x:Key="TrackRowTemplate" x:DataType="rowvm:TrackRowViewModel">
    <views:TrackRowView />
  </DataTemplate>
</ResourceDictionary>
