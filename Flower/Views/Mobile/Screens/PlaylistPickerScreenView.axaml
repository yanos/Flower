<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:svm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Views.Mobile.Screens.PlaylistPickerScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Playlist picker. A ScrollViewer over an ItemsControl rather than the
       ListBox the other pickers use, because this one puts the screen's title
       and the New Playlist row above its items and a ListBox has nowhere to
       put anything before its first item (the screenScroll ListBox template
       stacks ScreenTitle in for exactly that reason, and stops there). Nothing
       is lost by giving up its virtualization: this list is as long as the
       user has playlists.

       The way to make a playlist is here, under the title and ranged left with
       the rows, rather than a bare plus in the header band where it read as an
       icon with no subject - see controls:NewPlaylistEntry, which is also what
       the add-to-playlist sheet shows. -->
  <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
    <StackPanel>
      <controls:ScreenTitle />

      <controls:NewPlaylistEntry IsLarge="True" />

      <!-- Under New Playlist, and drawn the same way so the two read as a
           pair - the same circled plus, since both rows make something and
           the words already say which. Only here, not in the add-to-playlist
           sheet: a smart playlist holds what its rules say, so there is
           nothing to add a song to. -->
      <Button Classes="pickerRow"
              IsVisible="{Binding CanCreateSmartPlaylist}"
              Command="{Binding NewSmartPlaylistCommand}">
        <!-- NewPlaylistEntry's large sizes (IsLarge), restated. -->
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
          <Border Classes="floating" Width="36" Height="36" CornerRadius="18">
            <materialIcons:MaterialIcon Kind="Plus" Width="20" Height="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="New Smart Playlist" FontSize="17" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <ItemsControl ItemsSource="{Binding PlaylistPickerItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svm:SidebarItem">
            <!-- Laid out like a song row on the Queue, less its drag handle
                 (see ArtistPickerScreenView, which is the same row): the
                 playlist's cover where the art goes (see
                 SidebarItem.PlaylistCover), its name above, how many songs
                 and how long they run below, and the row's own menu past
                 that. 16 in on the left, so the cover lines up under New
                 Playlist's circled plus and with the screen's title. No
                 vertical padding: the cover carries the row's room above and
                 below, so the rule under the words lies on the row's bottom
                 edge, halfway between one playlist and the next (the same
                 arrangement as a song row - see TrackRowTemplate). -->
            <Button Classes="pickerRow"
                    Padding="16,0,8,0"
                    Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectPlaylistCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="1" Grid.ColumnSpan="2"
                        BorderBrush="{DynamicResource AppDividerBrush}"
                        BorderThickness="0,0,0,1"
                        IsHitTestVisible="False" />
                <controls:AlbumCollageView Grid.Column="0"
                                           Covers="{Binding PlaylistCover.CoverArt}"
                                           ArtCornerRadius="6"
                                           Width="64" Height="64"
                                           Margin="0,12,14,12" />
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"
                            IsVisible="{Binding !IsEditing}">
                  <TextBlock Text="{Binding Name}" FontSize="17" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding PlaylistSummary}"
                             FontSize="15"
                             Opacity="0.65"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Renaming in place, raised from this row's own menu. The
                     name is bound live and committed on Enter or on losing
                     focus (see the code-behind), which is the desktop
                     sidebar's rename in the same two gestures a phone has -
                     and, underneath, literally the same SidebarRenameService. -->
                <controls:TextInput Grid.Column="1"
                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsVisible="{Binding IsEditing}"
                                    FontSize="17"
                                    VerticalAlignment="Center"
                                    Loaded="RenameBox_Loaded"
                                    KeyDown="RenameBox_KeyDown"
                                    LostFocus="RenameBox_LostFocus" />
                <!-- The same glyph, in the same corner, as a song row's own
                     menu (TrackRowTemplate) - and it opens the same sheet the
                     album menu is, over this playlist. -->
                <Button Grid.Column="2"
                        Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenPlaylistActionsCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="2,4"
                        VerticalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="DotsVertical" Width="24" Height="24" Opacity="0.6" />
                </Button>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
