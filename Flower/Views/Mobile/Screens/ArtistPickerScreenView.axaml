<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:views="clr-namespace:Flower.Views.Mobile.Screens"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.ArtistPickerScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Artist name picker, with the A-Z bar in a column of its own beside
       it rather than over it, so it never sits on top of a name. -->
  <Grid ColumnDefinitions="*,Auto">
    <controls:RecyclingListBox x:Name="Artists" Classes="screenScroll" Background="Transparent"
             ItemsSource="{Binding ArtistPickerItems}"
             controls:RubberBandScroll.IsEnabled="True"
             SelectionMode="Single">
      <!-- One height for every row: see UniformRowPanel. -->
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <controls:UniformRowPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ArtistPickerRow">
          <views:ArtistRowView />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </controls:RecyclingListBox>
    <controls:ScrollIndexBar x:Name="IndexBar" Grid.Column="1" Target="{Binding #Artists}"
                             ShowsLetters="{Binding ArtistPickerIsAlphabetical}"
                             LettersDescending="{Binding ArtistPickerRunsZToA}" />
  </Grid>
</UserControl>
