<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.ArtistPickerScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Artist name picker, with the A-Z bar in a column of its own beside
       it rather than over it, so it never sits on top of a name. -->
  <Grid ColumnDefinitions="*,Auto">
    <ListBox x:Name="Artists" Classes="screenScroll" Background="Transparent"
             ItemsSource="{Binding ArtistPickerItems}"
             controls:RubberBandScroll.IsEnabled="True"
             SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ArtistPickerRow">
          <!-- Its own padding rather than the track row's: no vertical
               padding, so the rule under each row is the row's own bottom
               edge and sits exactly halfway between two names; 16 on the
               left so the covers line up with the screen's title. -->
          <Button Classes="trackRow"
                  Padding="16,0,8,0"
                  Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectArtistCommand}"
                  CommandParameter="{Binding Name}"
                  controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenArtistActionsCommand}"
                  controls:LongPress.CommandParameter="{Binding Name}">
            <!-- The artist's cover (see AlbumCollage), their name above,
                 how much of theirs there is below, and a chevron: the row
                 opens a screen rather than playing anything. The rule runs
                 under the words and the chevron only, the way a list inset
                 behind its pictures does, so the covers read as a column. -->
            <Grid ColumnDefinitions="Auto,*" Height="60">
              <controls:AlbumCollageView Grid.Column="0"
                                          Covers="{Binding Cover.CoverArt}"
                                          ArtCornerRadius="6"
                                          Width="48" Height="48"
                                          Margin="0,0,14,0" />
              <Border Grid.Column="1"
                      BorderBrush="{DynamicResource AppDividerBrush}"
                      BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="17" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="14"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <materialIcons:MaterialIcon Grid.Column="1"
                                              Kind="ChevronRight"
                                              Width="24" Height="24"
                                              Opacity="0.7"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
          </Button>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <controls:ScrollIndexBar x:Name="IndexBar" Grid.Column="1" Target="{Binding #Artists}"
                             ShowsLetters="{Binding ArtistPickerIsAlphabetical}"
                             LettersDescending="{Binding ArtistPickerRunsZToA}" />
  </Grid>
</UserControl>
