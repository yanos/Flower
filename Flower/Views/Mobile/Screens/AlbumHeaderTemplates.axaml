<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Flower.Controls"
                    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                    xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
                    xmlns:services="clr-namespace:Flower.Services"
                    xmlns:screens="clr-namespace:Flower.Views.Mobile.Screens">

  <!-- What a track list of one thing's songs says about that thing, above the
       songs: its cover, its name, what it is by, and the handful of buttons
       that act on the whole of it. One definition for the two screens that
       have such a thing - an album's tracks and a playlist's - so the row of
       actions, the type and the spacing can only ever be changed for both.
       A playlist arrives here as an AlbumTileViewModel like any album (see
       MobileMainViewModel.CurrentPlaylistHeader), with how many songs it
       holds where the artist goes and no cover of its own yet, which draws as
       AlbumArtView's own empty one.

       The art and the words are two templates rather than one, because the
       wide album layout pins the art down the left and leaves the words in
       the scroll - splitting them is what lets it keep the art still while
       the text moves. AlbumHeaderTemplate below is the two of them stacked,
       which is what every other case wants.

       Neither carries a size of its own: SquareAlbumArtView takes whatever
       width it is given and stays square (see that control), so each use site
       sets a Width and the art follows. -->
  <!-- Lifted off the page by a shadow, which is drawn by a Border round the
       art rather than by the art itself: AlbumArtView clips its content to
       its corners, and a shadow is outside them. The same 16px radius as the
       art's own (ArtCornerRadius), and as Now Playing's cover, so the shadow
       follows the rounded corners instead of squaring them off. Every ContentControl that hosts
       this template turns ClipToBounds off: a ContentControl clips by
       default, at exactly the art's square, which left the shadow showing
       only in the four rounded corners. -->
  <DataTemplate x:Key="AlbumArtTemplate" x:DataType="vm:AlbumTileViewModel">
    <Border CornerRadius="16"
            BoxShadow="{DynamicResource AppCoverShadow}">
      <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}"
                                   ArtCornerRadius="16"
                                   Classes.dimmed="{Binding IsUnavailable}" />
    </Border>
  </DataTemplate>

  <!-- Under the name and artist, a row of the album's own actions: play,
       shuffle, add to playlist (a pencil instead, on a playlist's screen),
       download - each a round button of its own,
       the same circle play always was, rather than the last three grouped in
       a pill beside it. The download is the same button download-all always
       was - the screen-wide indicator and command, so it spins while the
       batch runs and leaves once there is nothing left to fetch - and the
       other three act on the same rows it does. Play comes first: it is what
       the actions are for. Download goes last because it is the one that
       leaves, so nothing shifts when it does - and its circle leaves with it,
       following the button's own IsVisible rather than asking the indicator
       again. All of them are reached through the screen's DataContext, since
       this template's own is the album tile - and all of them are already
       written in terms of the rows on screen, which is what lets a playlist
       use them unchanged.

       Each circle is the floating one MobileMainView puts over its screens
       (Border.floating, Button.pill), which reaches here because the screens
       are hosted inside that view. Centred under the art, ranged left beside
       it (.albumText styles, in TrackListScreenView). Drawn a fifth larger
       than the floating pill's own 40px: 24px glyphs in 44px buttons, in
       circles 48 across. -->
  <DataTemplate x:Key="AlbumTextTemplate" x:DataType="vm:AlbumTileViewModel">
    <StackPanel Spacing="2" Classes.dimmed="{Binding IsUnavailable}">
      <!-- A playlist's name turns into a box in place when its pencil is
           pressed (see controls:PlaylistNameEditor); an album's never does,
           since it has no row to be renamed through.
           Set like the song's title on Now Playing - the display serif, in
           the accent red - since this is the one place the album is the
           subject rather than a tile among many. -->
      <TextBlock Classes="albumName"
                 Text="{Binding Name}"
                 IsVisible="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).CurrentPlaylistItem.IsEditing, Converter={x:Static BoolConverters.Not}, FallbackValue=True}"
                 FontFamily="{DynamicResource AppDisplayFontFamily}"
                 FontSize="28" FontWeight="SemiBold"
                 Foreground="{DynamicResource AppAccentBrush}"
                 TextWrapping="Wrap" />
      <controls:PlaylistNameEditor DataContext="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).CurrentPlaylistItem}"
                                   IsVisible="{Binding IsEditing, FallbackValue=False}"
                                   CommitCommand="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).CommitPlaylistRenameCommand}" />
      <TextBlock Text="{Binding Artist}"
                 FontSize="16" Opacity="0.7"
                 TextWrapping="Wrap" />
      <!-- Hidden on an album when Settings says so (ShowAlbumButtons); a
           playlist keeps it, its pencil being in no menu. Read off the host
           screen's own IsPlaylistMode rather than the live ViewModel's, like
           the rows, so a kept-alive screen answers for what it shows. -->
      <StackPanel Classes="albumActions" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="$parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).ShowAlbumButtons" FallbackValue="True" />
            <Binding Path="$parent[screens:TrackListScreenView].IsPlaylistMode" FallbackValue="True" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <Border Classes="floating" Width="48" Height="48" CornerRadius="24">
          <Button Classes="pill" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).PlayAlbumCommand}">
            <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24" />
          </Button>
        </Border>
        <Border Classes="floating" Width="48" Height="48" CornerRadius="24">
          <Button Classes="pill" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).ShuffleAlbumCommand}">
            <materialIcons:MaterialIcon Kind="Shuffle" Width="24" Height="24" />
          </Button>
        </Border>
        <!-- An album's songs go into a playlist from here; a playlist's
             are already in one, so its screen offers the pencil instead:
             its rules if it is smart, its name if it is not. -->
        <Border Classes="floating" Width="48" Height="48" CornerRadius="24"
                IsVisible="{Binding !$parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).IsShowingPlaylistTracks}">
          <Button Classes="pill" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).OpenAlbumAddToPlaylistCommand}">
            <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="24" Height="24" />
          </Button>
        </Border>
        <Border Classes="floating" Width="48" Height="48" CornerRadius="24"
                IsVisible="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).CanEditCurrentPlaylist}">
          <Button Classes="pill" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).EditCurrentPlaylistCommand}">
            <materialIcons:MaterialIcon Kind="Pencil" Width="24" Height="24" />
          </Button>
        </Border>
        <!-- Its own IsVisible is the indicator's answer, so the server gate
             goes on a wrapper - the two are different questions. -->
        <Panel IsVisible="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).Main.CanForceSync}">
          <Border Classes="floating" Width="48" Height="48" CornerRadius="24"
                  IsVisible="{Binding #DownloadAllButton.IsVisible}">
            <controls:TrackDownloadButton x:Name="DownloadAllButton"
                                          DataContext="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).DownloadAllIndicator}"
                                          HorizontalAlignment="Center"
                                          IconSize="24"
                                          IconPadding="10"
                                          Label="Download all"
                                          Command="{Binding $parent[screens:TrackListScreenView].((vm:MobileMainViewModel)DataContext).DownloadAllVisibleCommand}" />
          </Border>
        </Panel>
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <!-- The two of them stacked, which is the whole header for everything but
       the wide album layout: a narrow album screen, and a playlist either way
       up (a playlist has no art to pin, so there is nothing for the wide
       layout to do differently). 240 is the art's width on a phone, wide
       enough to be the page's subject and narrow enough to leave songs
       showing under it. -->
  <DataTemplate x:Key="AlbumHeaderTemplate" x:DataType="vm:AlbumTileViewModel">
    <Panel>
      <!-- The cover again, behind all of it: stretched across the page and
           blurred, fading out below the words. It reaches up past the top of
           the header by the scroller's own inset (ScreenBackdropBleed), under
           the back button and the status bar, so the page starts in it
           rather than below a strip of plain background - and scrolls away
           with the header like the rest of it.
           The blur is a 16px copy of the cover drawn large with a smooth
           upscale (ArtBackdrop.Tiny), not a blur effect, which the phone
           would redraw on every frame of a scroll. A playlist has no cover of
           its own, so there is nothing to draw and nothing shows. -->
      <Border Margin="{DynamicResource ScreenBackdropBleed}"
              ClipToBounds="True"
              IsHitTestVisible="False"
              OpacityMask="{DynamicResource AppBackdropFadeMask}">
        <Image Source="{Binding AlbumArt, Converter={x:Static services:TinyArtConverter.Instance}}"
               Stretch="UniformToFill"
               Opacity="0.6"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
      </Border>
      <StackPanel>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource AlbumArtTemplate}"
                        ClipToBounds="False"
                        Width="240" Margin="24,4,24,12"
                        HorizontalAlignment="Center" />
        <ContentControl Classes="albumText"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource AlbumTextTemplate}" />
      </StackPanel>
    </Panel>
  </DataTemplate>
</ResourceDictionary>
