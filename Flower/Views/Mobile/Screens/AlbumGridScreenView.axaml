<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.AlbumGridScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Albums: an art-tile grid, alphabetical - AlbumGridBuilder groups by
       Album name alone to match desktop's existing Albums sidebar logic.
       Tapping a tile reuses the plain-text picker's own
       SelectAlbumOrArtistCommand.

       Bound to rows of tiles (AlbumGridRow), not a flat tile list, with a
       VirtualizingStackPanel rather than a UniformGrid - a flat list in a
       UniformGrid isn't virtualizable (no viewport awareness), so it had to
       realize/measure/template-expand every tile in the whole library the
       first time the grid became visible - a multi-second stall on a library
       with ~1,400 albums. Wrapped in an explicit ScrollViewer - unlike
       ListBox, plain ItemsControl has no ScrollViewer in its own default
       template, so without this there was no scroll gesture at all on
       mobile. Safe alongside VirtualizingStackPanel specifically because that
       panel cooperates with ScrollViewer via logical scrolling; a
       non-virtualizing panel inside a ScrollViewer would defeat
       virtualization by forcing an unconstrained measure pass. -->
  <!-- The index bar takes a column of its own rather than floating over
       the grid, which put it on top of the right-hand tiles' art. The grid
       sizes its tiles off the width it is left with (AlbumGridColumnSizing
       measures the ItemsControl, not the screen), so the tiles shrink to make
       room, and the 12px each tile keeps to its right is the gap before the
       bar - the same 12 as the screen's left edge and between tiles. -->
  <Grid ColumnDefinitions="*,Auto">
    <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
      <!-- Stacked with the screen's title, so the title scrolls away with the
           tiles (ScreenTitle). -->
      <StackPanel>
        <controls:ScreenTitle />
        <ItemsControl x:Name="Rows"
                      ItemsSource="{Binding AlbumGridRows}"
                      Padding="12,12,0,12"
                      controls:AlbumGridColumnSizing.IsEnabled="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AlbumGridRow">
              <!-- One UniformGrid per row, sized by that row's own Columns: the
                   grid fits as many ~150px tiles across as the width allows, so a
                   phone turned into landscape shows five where portrait shows two
                   (see AlbumGridRow.ColumnsFor, fed by AlbumGridColumnSizing on
                   the ItemsControl above). UniformGrid has no ColumnSpacing of its
                   own, so the 12px gutter is each tile's right margin and the
                   ItemsControl leaves its own right edge to the last tile's - that
                   is what keeps the gap identical at both screen edges and between
                   columns. The gap *below* a tile is deliberately much larger than
                   the 6 between its art and its caption, so a title reads as
                   belonging to the album above it rather than the one below. -->
              <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Columns}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlbumTileViewModel">
                    <Button Classes="pickerRow" Padding="0" Margin="0,0,12,20"
                            Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectAlbumOrArtistCommand}"
                            CommandParameter="{Binding Name}"
                            controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                            controls:LongPress.CommandParameter="{Binding}">
                      <StackPanel Spacing="6" HorizontalAlignment="Stretch"
                                  Classes.dimmed="{Binding IsUnavailable}">
                        <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}" ArtCornerRadius="10" />
                        <!-- Explicit LineHeights, not the font default: Inter has no CJK
                             glyphs, so a Japanese title falls back to a system face 1.45x to
                             1.6x taller (which face, and so which of those, depends on the
                             machine), and a row pairing one with a Latin title puts the two
                             captions at different heights. Pinning both lines makes every
                             caption 48px whatever script it is in, with a pixel or two to spare
                             over the tallest fallback measured - see AlbumTileCaptionTests. The
                             lines overlap by 5px: each pinned height leaves room above and below
                             a Latin glyph, and the gap that made between the name and the artist
                             read as two separate captions.
                             The "..." opens the same album menu a long press on the tile does,
                             for anyone who does not know to press and hold. It is a button
                             inside the tile's own, so a tap on it is its alone. -->
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="2,0,0,0">
                          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="17" LineHeight="29" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,-5,0,0" Text="{Binding Artist}" FontSize="14" LineHeight="24" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                          <!-- On the artist's line rather than the name's: an album name is
                               what gets cut short on a tile two to a row, and the artist is
                               usually the shorter of the two. The negative margins keep a
                               comfortable tap target without growing the pinned line. -->
                          <Button Grid.Row="1" Grid.Column="1" Classes="pill" Padding="4" Margin="4,-7,0,-2"
                                  Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                                  CommandParameter="{Binding}">
                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="20" Height="20" Opacity="0.6" />
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <controls:ScrollIndexBar x:Name="IndexBar" Grid.Column="1" Target="{Binding #Rows}"
                             ShowsLetters="{Binding AlbumGridIsAlphabetical}"
                             LettersDescending="{Binding AlbumGridRunsZToA}" />
  </Grid>
</UserControl>
