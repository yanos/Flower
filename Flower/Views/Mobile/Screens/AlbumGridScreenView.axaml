<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.Mobile.Screens.AlbumGridScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Albums: same art-tile grid presentation and virtualization approach as
       Recently Added (see RecentlyAddedScreenView), just alphabetical rather
       than by-recency - AlbumGridBuilder groups by Album name alone to match
       desktop's existing Albums sidebar logic. Tapping a tile reuses the
       plain-text picker's own SelectAlbumOrArtistCommand. -->
  <ScrollViewer controls:RubberBandScroll.IsEnabled="True">
    <ItemsControl ItemsSource="{Binding AlbumGridRows}"
                  Margin="12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlbumGridRow">
          <!-- The outside margin and ColumnSpacing intentionally match: each
               square tile reaches its column edge, so the grid has the same
               visual gutter at the screen edge and between its two albums.
               The gap *below* a tile is deliberately much larger than the 6
               between its art and its caption, so a title reads as belonging
               to the album above it rather than the one below. -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Classes="pickerRow" Padding="0"
                    Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectAlbumOrArtistCommand}"
                    CommandParameter="{Binding First.Name}">
              <StackPanel Spacing="6" Margin="0,0,0,24" HorizontalAlignment="Stretch"
                          Classes.dimmed="{Binding First.IsUnavailable}">
                <controls:SquareAlbumArtView AlbumArt="{Binding First.AlbumArt}" />
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding First.Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding First.Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="pickerRow" Padding="0"
                    IsVisible="{Binding Second, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                    Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectAlbumOrArtistCommand}"
                    CommandParameter="{Binding Second.Name}">
              <StackPanel Spacing="6" Margin="0,0,0,24" HorizontalAlignment="Stretch"
                          Classes.dimmed="{Binding Second.IsUnavailable}">
                <controls:SquareAlbumArtView AlbumArt="{Binding Second.AlbumArt}" />
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Second.Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Second.Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
