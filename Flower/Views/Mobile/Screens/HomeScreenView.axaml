<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:fvm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Views.Mobile.Screens.HomeScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Home: Continue Playing, Recently Played and Recently Added, each a
       short row of covers that scrolls sideways - see HomeViewModel, which
       desktop's HomeView draws too. A Continue Playing cover picks its album
       up where it was left; any other cover opens its album, the way a tile
       in the Albums grid does. A long press on any of them is the album menu,
       which is also where an album comes off Continue Playing.

       Plain StackPanels rather than virtualized lists: a shelf is a dozen
       covers at most (HomeViewModel.MaxRecentlyPlayed and friends). A
       sideways drag is the shelf's and an up-and-down one the page's - each
       ScrollViewer takes a pan only along the axis it can scroll. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.shelfTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="16,0,16,12" />
    </Style>
    <!-- Every caption on the page: the name, then the artist (and, on
         Continue Playing, where the album was left). Pinned line heights
         for the same reason as the album grids' captions (see
         AlbumGridScreenView): a CJK title falls back to a taller face, and
         the pins are what keep a row of tiles level - AlbumTileCaptionTests
         holds these numbers. -->
    <Style Selector="StackPanel.caption">
      <Setter Property="Spacing" Value="-4" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style Selector="StackPanel.caption > TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="StackPanel.caption > TextBlock.name">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="27" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
    <StackPanel>
      <controls:ScreenTitle />

      <Grid>
        <StackPanel DataContext="{Binding Main.Home}" x:DataType="fvm:HomeViewModel"
                    Spacing="28" Margin="0,8,0,24">

          <StackPanel IsVisible="{Binding HasContinuePlaying}">
            <TextBlock Classes="shelfTitle" Text="Continue Playing" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ContinuePlaying}" Padding="16,0,4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="fvm:ContinuePlayingItemViewModel">
                    <!-- Wider than the other shelves' covers: this is the one
                         thing on the page that picks up where you were. -->
                    <Button Classes="pickerRow" Padding="0" Margin="0,0,14,0" Width="152"
                            VerticalAlignment="Top"
                            Command="{Binding Home.ResumeCommand}"
                            CommandParameter="{Binding}"
                            controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                            controls:LongPress.CommandParameter="{Binding Tile}">
                      <StackPanel Spacing="8" Classes.dimmed="{Binding Tile.IsUnavailable}">
                        <Panel>
                          <controls:SquareAlbumArtView AlbumArt="{Binding Tile.AlbumArt}" ArtCornerRadius="8" />
                          <Border Width="40" Height="40" CornerRadius="20"
                                  Margin="0,0,8,8"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  BoxShadow="{DynamicResource AppButtonShadow}"
                                  Background="{DynamicResource AppAccentBrush}">
                            <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24" Foreground="{DynamicResource AppOnPrimaryBrush}" />
                          </Border>
                        </Panel>
                        <ProgressBar MinWidth="0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                     Height="4" MinHeight="4" CornerRadius="2"
                                     Foreground="{DynamicResource AppAccentBrush}" />
                        <StackPanel Classes="caption">
                          <TextBlock Classes="name" Text="{Binding Tile.Name}" />
                          <TextBlock Text="{Binding Tile.Artist}" />
                          <TextBlock Text="{Binding Detail}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <StackPanel IsVisible="{Binding HasRecentlyPlayed}">
            <TextBlock Classes="shelfTitle" Text="Recently Played" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding RecentlyPlayed}" Padding="16,0,4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlbumTileViewModel">
                    <Button Classes="pickerRow" Padding="0" Margin="0,0,14,0" Width="116"
                            VerticalAlignment="Top"
                            Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectHomeAlbumCommand}"
                            CommandParameter="{Binding}"
                            controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                            controls:LongPress.CommandParameter="{Binding}">
                      <StackPanel Spacing="6" Classes.dimmed="{Binding IsUnavailable}">
                        <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}" ArtCornerRadius="8" />
                        <StackPanel Classes="caption">
                          <TextBlock Classes="name" Text="{Binding Name}" />
                          <TextBlock Text="{Binding Artist}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <StackPanel IsVisible="{Binding HasRecentlyAdded}">
            <TextBlock Classes="shelfTitle" Text="Recently Added" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding RecentlyAdded}" Padding="16,0,4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlbumTileViewModel">
                    <Button Classes="pickerRow" Padding="0" Margin="0,0,14,0" Width="116"
                            VerticalAlignment="Top"
                            Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectHomeAlbumCommand}"
                            CommandParameter="{Binding}"
                            controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                            controls:LongPress.CommandParameter="{Binding}">
                      <StackPanel Spacing="6" Classes.dimmed="{Binding IsUnavailable}">
                        <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}" ArtCornerRadius="8" />
                        <StackPanel Classes="caption">
                          <TextBlock Classes="name" Text="{Binding Name}" />
                          <TextBlock Text="{Binding Artist}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>

        <StackPanel DataContext="{Binding Main.Home}" x:DataType="fvm:HomeViewModel"
                    IsVisible="{Binding IsEmpty}"
                    Margin="32,96,32,0" Spacing="8" Opacity="0.6"
                    HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="HomeOutline" Width="40" Height="40" />
          <TextBlock Text="Nothing here yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Albums you play and albums you add will show up here."
                     FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
