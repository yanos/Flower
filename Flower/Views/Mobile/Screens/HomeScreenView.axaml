<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:views="clr-namespace:Flower.Views.Mobile.Screens"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:fvm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Views.Mobile.Screens.HomeScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Home: Continue Playing, Recently Played and Recently Added - see
       HomeViewModel, which desktop's HomeView draws too, for what is on each
       and how many. The album shelves are laid out like the Albums grid, as
       many ~150px covers across as fit and wrapping onto rows below, in a
       virtualizing list of rows at AlbumGridRow's tile width and gutters,
       rather than a row that scrolls sideways; Recently Played is songs, a
       song list's rows. Pulling the page down opens the filter oval,
       as on Albums. A Continue Playing cover picks its album up where it was
       left; any other cover opens its album, the way a tile in the Albums
       grid does. A long press on any of them is the album menu, which is also
       where an album comes off Continue Playing. Each cover is the album tile
       the Albums grid draws (AlbumCard), its "..." the same album menu a long
       press opens. -->
  <UserControl.Styles>
    <!-- Inside the list's 12 of padding, so 4 more puts the heading at the
         page title's 16. The first sits at the top; the others leave room
         above them for the shelf before. -->
    <Style Selector="TextBlock.shelfTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="4,8,16,12" />
    </Style>
    <Style Selector="TextBlock.shelfTitle.first">
      <Setter Property="Margin" Value="4,0,16,12" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
    <StackPanel>
      <controls:ScreenTitle />

      <Grid>
        <!-- One virtualizing list of rows - each shelf's heading, then its
             covers so many to a row (HomeShelfRows, fed by HomeShelfRowsHost
             from this list's width with AlbumGridRow's arithmetic) - so only
             what is on screen is built, as in the Albums grid. The gutters
             are that grid's: 12 at the left from the padding, 12 at the right
             and between columns from each cover's right margin. -->
        <controls:RecyclingItemsControl x:Name="Rows"
                      DataContext="{Binding Main.Home}"
                      Padding="12,8,0,24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="fvm:HomeShelfHeaderRow">
              <TextBlock Classes="shelfTitle" Classes.first="{Binding IsFirst}" Text="{Binding Title}" />
            </DataTemplate>

            <!-- Each shelf's covers, so many to a row, the way the Albums
                 grid lays them out (TileRowPanel, AlbumTileView). -->
            <DataTemplate DataType="fvm:HomeContinuePlayingRow">
              <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Items}">
                <controls:TileRowPanel.ItemTemplate>
                  <DataTemplate>
                    <views:AlbumTileView />
                  </DataTemplate>
                </controls:TileRowPanel.ItemTemplate>
              </controls:TileRowPanel>
            </DataTemplate>

            <DataTemplate DataType="fvm:HomeAlbumRow">
              <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Tiles}">
                <controls:TileRowPanel.ItemTemplate>
                  <DataTemplate>
                    <views:AlbumTileView />
                  </DataTemplate>
                </controls:TileRowPanel.ItemTemplate>
              </controls:TileRowPanel>
            </DataTemplate>

            <!-- Recently Played's songs, one to a row and the whole width of
                 the screen, as a song list's are (TrackRowView). A tap plays
                 the shelf from that song down; a long press or the "..." is
                 the song menu. -->
            <DataTemplate DataType="fvm:HomeSongRow">
              <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Songs}" Margin="-12,0,0,0">
                <controls:TileRowPanel.ItemTemplate>
                  <DataTemplate>
                    <views:TrackRowView />
                  </DataTemplate>
                </controls:TileRowPanel.ItemTemplate>
              </controls:TileRowPanel>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </controls:RecyclingItemsControl>

        <StackPanel IsVisible="{Binding Main.Home.ShowsNothingYet}"
                    Margin="32,96,32,0" Spacing="8" Opacity="0.6"
                    HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="HomeOutline" Classes="chrome" Width="40" Height="40" />
          <TextBlock Text="Nothing here yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Songs you play and albums you add will show up here."
                     FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <StackPanel IsVisible="{Binding Main.Home.ShowsNoMatches}"
                    Margin="32,96,32,0" Spacing="8" Opacity="0.6"
                    HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="Magnify" Classes="chrome" Width="40" Height="40" />
          <TextBlock Text="No matches" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Nothing on Home matches the filter."
                     FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
