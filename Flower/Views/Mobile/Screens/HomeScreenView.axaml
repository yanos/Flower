<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:fvm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Views.Mobile.Screens.HomeScreenView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Home: Continue Playing, Recently Played and Recently Added, each a
       short row of covers that scrolls sideways - see HomeViewModel, which
       desktop's HomeView draws too. A Continue Playing cover picks its album
       up where it was left; any other cover opens its album, the way a tile
       in the Albums grid does. A long press on any of them is the album menu,
       which is also where an album comes off Continue Playing.

       Plain StackPanels rather than virtualized lists: a shelf is a dozen
       covers at most (HomeViewModel.MaxRecentlyPlayed and friends). A
       sideways drag is the shelf's and an up-and-down one the page's - each
       ScrollViewer takes a pan only along the axis it can scroll. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.shelfTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="16,0,16,8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="screenScroll" controls:RubberBandScroll.IsEnabled="True">
    <StackPanel>
      <controls:ScreenTitle />

      <Grid>
        <StackPanel DataContext="{Binding Main.Home}" x:DataType="fvm:HomeViewModel"
                    Spacing="24" Margin="0,8,0,24">

          <StackPanel IsVisible="{Binding HasContinuePlaying}">
            <TextBlock Classes="shelfTitle" Text="Continue Playing" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ContinuePlaying}" Padding="16,0,4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="fvm:ContinuePlayingItemViewModel">
                    <Button Classes="pickerRow" Padding="0" Margin="0,0,12,0" Width="144"
                            VerticalAlignment="Top"
                            Command="{Binding Home.ResumeCommand}"
                            CommandParameter="{Binding}"
                            controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                            controls:LongPress.CommandParameter="{Binding Tile}">
                      <StackPanel Spacing="6" Classes.dimmed="{Binding Tile.IsUnavailable}">
                        <Panel>
                          <controls:SquareAlbumArtView AlbumArt="{Binding Tile.AlbumArt}" />
                          <Border Width="38" Height="38" CornerRadius="19"
                                  Margin="0,0,6,6"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Background="{DynamicResource AppAccentBrush}">
                            <materialIcons:MaterialIcon Kind="Play" Width="22" Height="22" Foreground="White" />
                          </Border>
                        </Panel>
                        <ProgressBar MinWidth="0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                     Height="3" MinHeight="3" CornerRadius="2"
                                     Foreground="{DynamicResource AppAccentBrush}" />
                        <!-- Pinned line heights for the same reason as the album
                             grids' captions (see AlbumGridScreenView): a CJK
                             title falls back to a taller face. -->
                        <StackPanel Spacing="-3" Margin="2,0,0,0">
                          <TextBlock Text="{Binding Tile.Name}" FontSize="13" LineHeight="21" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Tile.Artist}" FontSize="11" LineHeight="18" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="11" LineHeight="18" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <StackPanel IsVisible="{Binding HasRecentlyPlayed}">
            <TextBlock Classes="shelfTitle" Text="Recently Played" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding RecentlyPlayed}" Padding="16,0,4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlbumTileViewModel">
                    <Button Classes="pickerRow" Padding="0" Margin="0,0,12,0" Width="144"
                            VerticalAlignment="Top"
                            Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectHomeAlbumCommand}"
                            CommandParameter="{Binding}"
                            controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                            controls:LongPress.CommandParameter="{Binding}">
                      <StackPanel Spacing="3" Classes.dimmed="{Binding IsUnavailable}">
                        <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}" />
                        <StackPanel Spacing="-3" Margin="2,0,0,0">
                          <TextBlock Text="{Binding Name}" FontSize="13" LineHeight="21" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Artist}" FontSize="11" LineHeight="18" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <StackPanel IsVisible="{Binding HasRecentlyAdded}">
            <TextBlock Classes="shelfTitle" Text="Recently Added" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding RecentlyAdded}" Padding="16,0,4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlbumTileViewModel">
                    <Button Classes="pickerRow" Padding="0" Margin="0,0,12,0" Width="144"
                            VerticalAlignment="Top"
                            Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).SelectHomeAlbumCommand}"
                            CommandParameter="{Binding}"
                            controls:LongPress.Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).OpenAlbumActionsCommand}"
                            controls:LongPress.CommandParameter="{Binding}">
                      <StackPanel Spacing="3" Classes.dimmed="{Binding IsUnavailable}">
                        <controls:SquareAlbumArtView AlbumArt="{Binding AlbumArt}" />
                        <StackPanel Spacing="-3" Margin="2,0,0,0">
                          <TextBlock Text="{Binding Name}" FontSize="13" LineHeight="21" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Artist}" FontSize="11" LineHeight="18" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>

        <StackPanel DataContext="{Binding Main.Home}" x:DataType="fvm:HomeViewModel"
                    IsVisible="{Binding IsEmpty}"
                    Margin="32,96,32,0" Spacing="8" Opacity="0.6"
                    HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="HomeOutline" Width="40" Height="40" />
          <TextBlock Text="Nothing here yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Albums you play and albums you add will show up here."
                     FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
