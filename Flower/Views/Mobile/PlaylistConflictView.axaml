<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.PlaylistConflictView"
             x:DataType="vm:MobileMainViewModel">

  <!-- The phone's PlaylistConflictWindow. A tap on the backdrop is Decide
       Later: it leaves both versions as they are. -->
  <UserControl.Styles>
    <Style Selector="Button.confirmAction">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Button Command="{Binding DecidePlaylistConflictLaterCommand}"
            Background="{DynamicResource AppScrimBrush}"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    <Border VerticalAlignment="Bottom"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="20,20,20,28">
      <StackPanel Spacing="14" Margin="{DynamicResource SheetBottomInset}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <materialIcons:MaterialIcon Kind="PlaylistEdit" Width="24" Height="24" />
          <TextBlock Text="{Binding PlaylistConflictHeadline}"
                     FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock Text="{Binding PlaylistConflictExplanation}"
                   FontSize="14" Opacity="0.75" TextWrapping="Wrap" />

        <StackPanel Spacing="2">
          <TextBlock Text="This device" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PlaylistConflictLocalSummary}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding PlaylistConflictRemoteName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding PlaylistConflictRemoteSummary}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <Button Classes="confirmAction primary" Content="{Binding PlaylistConflictKeepLocalText}" Command="{Binding KeepLocalPlaylistCommand}" />
        <Button Classes="confirmAction secondary" Command="{Binding KeepRemotePlaylistCommand}">
          <TextBlock Text="{Binding PlaylistConflictKeepRemoteText}" TextTrimming="CharacterEllipsis" />
        </Button>
        <Button Classes="confirmAction secondary" Content="Decide Later" Command="{Binding DecidePlaylistConflictLaterCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
