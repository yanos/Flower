<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:svm="clr-namespace:Flower.ViewModels"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Flower.Views.Mobile.VibePlaylistEditorSheetView"
             x:DataType="vm:MobileMainViewModel"
             Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
             Padding="{DynamicResource SheetBottomInset}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/TrackRowTemplate.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- A bare switch, as in Settings. -->
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- New Vibe Playlist and Edit Vibe Playlist as a pushed screen, like the
       smart playlist editor's (SmartPlaylistEditorSheetView): the sentence,
       a name, No vocals, and the songs the sentence would make, under the
       header Settings uses. The same VibePlaylistEditorViewModel the
       desktop's dialog binds. Back is Cancel, as leaving any other way is -
       see MobileMainViewModel.ActiveSheet - and the check is OK. -->
  <Grid RowDefinitions="Auto,*">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="52" Margin="12,4,12,4">
      <Border Grid.Column="0" Classes="floating" Width="40">
        <Button Classes="pill"
                Command="{Binding CloseSheetCommand}"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="ChevronLeft" Width="22" Height="22" />
        </Button>
      </Border>
      <Border Grid.Column="2" Classes="floating" Width="40">
        <Button Classes="pill"
                Command="{Binding SaveVibePlaylistCommand}"
                IsEnabled="{Binding VibePlaylistEditor.CanSave, FallbackValue=False}"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="Check" Width="20" Height="20" />
        </Button>
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  controls:SoftKeyboard.AvoidOcclusion="True">
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{Binding VibePlaylistEditor.Title, FallbackValue=''}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="20,0,20,8"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Margin="20,8,20,0" Spacing="6">
          <TextBlock Text="Describe how the songs should sound" Opacity="0.75" />
          <controls:TextInput Text="{Binding VibePlaylistEditor.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                              PlaceholderText="{x:Static svm:VibePlaylistEditorViewModel.PromptPlaceholder}"
                              TextInputOptions.AutoCapitalization="False"
                              controls:SoftKeyboard.ReopenOnTap="True" />

          <TextBlock Text="Name" Opacity="0.75" Margin="0,10,0,0" />
          <controls:TextInput Text="{Binding VibePlaylistEditor.Name, Mode=TwoWay, FallbackValue=''}"
                              PlaceholderText="{Binding VibePlaylistEditor.NamePlaceholder, FallbackValue=''}"
                              TextInputOptions.AutoCapitalization="True"
                              controls:SoftKeyboard.ReopenOnTap="True" />

          <!-- Songs CLAP hears no voice in. Turned on by a sentence that
               says "instrumental" or "without lyrics". -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="No vocals" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding VibePlaylistEditor.Instrumental, FallbackValue=False}" />
          </Grid>
        </StackPanel>

        <!-- What the sentence would make right now, in the Songs tab's own
             rows - tapping one plays it, with the preview as the queue. -->
        <TextBlock Text="{Binding VibePlaylistEditor.PreviewSummary, FallbackValue=''}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Margin="20,20,20,6" />
        <controls:RecyclingItemsControl ItemsSource="{Binding VibePlaylistPreviewRows}"
                                        ItemTemplate="{StaticResource TrackRowTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:UniformRowPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </controls:RecyclingItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
