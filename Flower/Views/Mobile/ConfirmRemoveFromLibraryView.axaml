<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.ConfirmRemoveFromLibraryView"
             x:DataType="vm:MobileMainViewModel">

  <UserControl.Styles>
    <Style Selector="Button.removeAction">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="FontSize" Value="16" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- No backdrop-tap-to-dismiss, same as ConfirmDeleteFileView: this can
         delete files, on this phone and on the server, and should not be
         answered by an unattended tap. -->
    <Border Background="#66000000" />

    <Border VerticalAlignment="Bottom"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="20,20,20,28">
      <StackPanel Spacing="14" Margin="{DynamicResource SheetBottomInset}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <materialIcons:MaterialIcon Kind="MusicNoteOff" Width="24" Height="24" />
          <TextBlock Text="{Binding RemoveFromLibraryTitle}"
                     FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="{Binding RemoveFromLibraryMessage}"
                   FontSize="14" Opacity="0.75" TextWrapping="Wrap" />

        <!-- Off every time the sheet opens - see
             MobileMainViewModel.RemoveFromLibraryDeleteFiles. -->
        <CheckBox IsVisible="{Binding OffersRemoveFromLibraryDeleteFiles}"
                  IsChecked="{Binding RemoveFromLibraryDeleteFiles}"
                  FontSize="14">
          <TextBlock Text="{Binding RemoveFromLibraryDeleteFilesLabel}" TextWrapping="Wrap" />
        </CheckBox>

        <TextBlock Text="{Binding RemoveFromLibraryError}"
                   IsVisible="{Binding HasRemoveFromLibraryError}"
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppErrorBrush}" />

        <Button Classes="removeAction" Content="Remove" Command="{Binding ConfirmRemoveFromLibraryCommand}"
                IsEnabled="{Binding !IsRemovingFromLibrary}"
                Background="{DynamicResource AppErrorBrush}" Foreground="{DynamicResource AppOnPrimaryBrush}" />
        <Button Classes="removeAction" Content="Cancel" Command="{Binding CancelRemoveFromLibraryCommand}"
                Background="Transparent" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
