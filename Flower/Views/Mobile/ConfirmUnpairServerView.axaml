<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.ConfirmUnpairServerView"
             x:DataType="vm:MobileMainViewModel">

  <!-- "Really unpair from this server?" - the phone's counterpart of the
       dialog desktop raises from its two Unpair buttons, with the same text
       (MainViewModel.UnpairConsequences). The same card as
       ConfirmDeletePlaylistView, and not dismissible by a tap on the backdrop
       for the same reason: the two buttons are the only ways out of a
       destructive choice. -->
  <UserControl.Styles>
    <!-- The desktop dialog's two buttons (ConfirmDialogWindow): the ink fill
         for what is being asked (Button.primary) - even when it takes
         something away, since red is playback's and danger is said in words -
         and the outline for Cancel (Button.secondary), with the corners every
         button with words has. -->
    <Style Selector="Button.unpairAction">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border Background="{DynamicResource AppScrimBrush}" />

    <Border VerticalAlignment="Bottom"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="20,20,20,28">
      <StackPanel Spacing="14" Margin="{DynamicResource SheetBottomInset}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <materialIcons:MaterialIcon Kind="ServerRemove" Width="24" Height="24" />
          <TextBlock Text="{Binding Pairing.ConfirmUnpairServerTitle}"
                     FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock Text="{Binding Pairing.ConfirmUnpairServerMessage}"
                   FontSize="14" Opacity="0.75" TextWrapping="Wrap" />

        <Button Classes="unpairAction primary" Content="Unpair" Command="{Binding Pairing.ConfirmUnpairServerCommand}" />
        <Button Classes="unpairAction secondary" Content="Cancel" Command="{Binding Pairing.CancelUnpairServerCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
