<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.AlbumActionsView"
             x:DataType="vm:MobileMainViewModel">

  <!-- The album menu, raised by a long press on a cover in the Albums,
       Recently Added and an artist's album grids - and on an artist's name,
       where it acts on every album of theirs at once. The same card as a song's
       menu (TrackActionsView): the art and name of what it acts on at the top,
       dismissed by the X beside them or a tap on the backdrop. Its actions are
       the album header's (TrackListScreenView), acting on the tile pressed
       rather than on the album the screen is showing.

       Also the playlist menu, from a row's "..." in the Playlists tab: play,
       shuffle, add these songs somewhere and download them are the same
       questions asked of a different pile of songs, and asking them twice in
       two sheets is how the two would start to differ. The playlist's own two
       entries appear underneath, on IsActingOnAPlaylist. -->
  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Dimmed backdrop; tapping it dismisses the sheet -->
    <Button Command="{Binding CloseSheetCommand}"
            Background="#66000000"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    <!-- Action card -->
    <Border VerticalAlignment="Bottom"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="0,8,0,16">
      <StackPanel Margin="{DynamicResource SheetBottomInset}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,8,8,8">
          <controls:AlbumArtView Grid.Column="0"
                                  AlbumArt="{Binding AlbumActionTarget.AlbumArt}"
                                  Width="52" Height="52" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding AlbumActionTarget.Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding AlbumActionTarget.Artist}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="pill"
                  VerticalAlignment="Top"
                  Command="{Binding CloseSheetCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Opacity="0.7" />
          </Button>
        </Grid>

        <Button Classes="action" Command="{Binding PlayAlbumActionTargetCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Width="26" Height="26" Margin="-2"
                    CornerRadius="9999" BorderThickness="1"
                    BorderBrush="{DynamicResource AppPrimaryBorderBrush}">
              <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" />
            </Border>
            <TextBlock Text="Play" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="action" Command="{Binding ShuffleAlbumActionTargetCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="Shuffle" Width="22" Height="22" />
            <TextBlock Text="Shuffle" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="action" Command="{Binding AddAlbumActionTargetToPlaylistCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="22" Height="22" />
            <TextBlock Text="Add to Playlist" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="action" Command="{Binding DownloadAlbumActionTargetCommand}"
                IsVisible="{Binding CanDownloadAlbumActionTarget}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="22" Height="22" />
            <TextBlock Text="Download All" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- The two entries a playlist has that an album does not: it is a
             thing the user made, so it can be called something else or thrown
             away. Both act on the row the menu was opened from, not on
             whatever the screen behind is showing - see
             MobileMainViewModel.PlaylistActionTarget. -->
        <Button Classes="action" Command="{Binding RenamePlaylistActionTargetCommand}"
                IsVisible="{Binding IsActingOnAPlaylist}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="PencilOutline" Width="22" Height="22" />
            <TextBlock Text="Rename" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Once any song in the album has a file on this device
             (CanDeleteAlbumActionTargetLocalFiles): every such file, reverted to
             a placeholder the way a song's own Delete Local File does, through
             the same confirm sheet and its warning when a file would not come
             back. -->
        <Button Classes="action" Command="{Binding DeleteAlbumActionTargetLocalFilesCommand}"
                IsVisible="{Binding CanDeleteAlbumActionTargetLocalFiles}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="22" Height="22" Foreground="{DynamicResource AppErrorBrush}" />
            <TextBlock Text="Delete Local Files" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AppErrorBrush}" />
          </StackPanel>
        </Button>

        <!-- Every song on the album (or by the artist) that this device may
             remove - see the song menu's own entry. Never shown over a
             playlist; see CanRemoveAlbumActionTargetFromLibrary. -->
        <Button Classes="action" Command="{Binding RemoveAlbumFromLibraryCommand}"
                IsVisible="{Binding CanRemoveAlbumActionTargetFromLibrary}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="MusicNoteOff" Width="22" Height="22" Foreground="{DynamicResource AppErrorBrush}" />
            <TextBlock Text="Remove from Library" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AppErrorBrush}" />
          </StackPanel>
        </Button>

        <!-- Last, and in the destructive colour, under everything that is not:
             it is the one entry here that cannot be undone. It confirms first
             (ConfirmDeletePlaylistView) - and the songs themselves are
             untouched, which is what that prompt says. -->
        <Button Classes="action" Command="{Binding DeletePlaylistActionTargetCommand}"
                IsVisible="{Binding IsActingOnAPlaylist}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="PlaylistRemove" Width="22" Height="22" Foreground="{DynamicResource AppErrorBrush}" />
            <TextBlock Text="Delete Playlist" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AppErrorBrush}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
