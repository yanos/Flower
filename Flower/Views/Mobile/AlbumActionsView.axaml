<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.AlbumActionsView"
             x:DataType="vm:MobileMainViewModel">

  <!-- The album menu, raised by a long press on a cover in the Albums,
       Recently Added and an artist's album grids - and on an artist's name,
       where it acts on every album of theirs at once. The same card as a song's
       menu (TrackActionsView): the art and name of what it acts on at the top,
       dismissed by the X beside them or a tap on the backdrop. Its actions are
       the album header's (TrackListScreenView), acting on the tile pressed
       rather than on the album the screen is showing. -->
  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Dimmed backdrop; tapping it dismisses the sheet -->
    <Button Command="{Binding CloseSheetCommand}"
            Background="#66000000"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    <!-- Action card -->
    <Border VerticalAlignment="Bottom"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="0,8,0,16">
      <StackPanel Margin="{DynamicResource SheetBottomInset}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,8,8,8">
          <controls:AlbumArtView Grid.Column="0"
                                  AlbumArt="{Binding AlbumActionTarget.AlbumArt}"
                                  Width="52" Height="52" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding AlbumActionTarget.Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding AlbumActionTarget.Artist}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="pill"
                  VerticalAlignment="Top"
                  Command="{Binding CloseSheetCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Opacity="0.7" />
          </Button>
        </Grid>

        <Button Classes="action" Command="{Binding PlayAlbumActionTargetCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Width="26" Height="26" Margin="-2"
                    CornerRadius="9999" BorderThickness="1.5"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
              <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" />
            </Border>
            <TextBlock Text="Play" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="action" Command="{Binding ShuffleAlbumActionTargetCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="Shuffle" Width="22" Height="22" />
            <TextBlock Text="Shuffle" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="action" Command="{Binding AddAlbumActionTargetToPlaylistCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="22" Height="22" />
            <TextBlock Text="Add to Playlist" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="action" Command="{Binding DownloadAlbumActionTargetCommand}"
                IsVisible="{Binding CanDownloadAlbumActionTarget}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="22" Height="22" />
            <TextBlock Text="Download" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
