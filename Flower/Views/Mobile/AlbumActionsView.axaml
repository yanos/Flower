<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:menus="clr-namespace:Flower.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.AlbumActionsView"
             x:DataType="vm:MobileMainViewModel">

  <!-- The album menu, raised by a long press on a cover in the Albums grid,
       an artist's album grid and Home's shelves - and on an artist's name,
       where it acts on every album of theirs at once. The same card as a song's
       menu (TrackActionsView): the art and name of what it acts on at the top,
       dismissed by the X beside them or a tap on the backdrop. Its actions are
       the album header's (TrackListScreenView), acting on the tile pressed
       rather than on the album the screen is showing.

       Also the playlist menu, from a row's "..." in the Playlists tab: play,
       shuffle, add these songs somewhere and download them are the same
       questions asked of a different pile of songs, and asking them twice in
       two sheets is how the two would start to differ. The playlist's own two
       entries appear underneath (ActionMenus.ForAlbum's isPlaylist).

       What is listed is ActionMenus', the same entries as the desktop's
       album menu; each runs the command MobileMainViewModel has for it. -->
  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Dimmed backdrop; tapping it dismisses the sheet -->
    <Button Command="{Binding CloseSheetCommand}"
            Background="{DynamicResource AppScrimBrush}"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    <!-- Action card -->
    <!-- .chromeIcons: every icon on the card, the X and a delete's
         included, in the frame's colour (App.axaml); a delete's words are
         AppDangerBrush. -->
    <Border VerticalAlignment="Bottom"
            Classes="chromeIcons"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="0,8,0,16">
      <StackPanel Margin="{DynamicResource SheetBottomInset}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,8,8,8">
          <controls:AlbumArtView Grid.Column="0"
                                  AlbumArt="{Binding AlbumActionTarget.AlbumArt}"
                                  Width="52" Height="52" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding AlbumActionTarget.Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding AlbumActionTarget.Artist}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="pill"
                  VerticalAlignment="Top"
                  Command="{Binding CloseSheetCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Opacity="0.7" />
          </Button>
        </Grid>

        <!-- The entries ActionMenus gives, in its order - the same as the
             desktop's context menu. A destructive entry's words are in the
             danger colour; the album menu's Play is ringed. -->
        <ItemsControl ItemsSource="{Binding AlbumActions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="menus:ActionMenuEntry">
              <Button Classes="action"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding $parent[ItemsControl].((vm:MobileMainViewModel)DataContext).RunAlbumActionCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <Border Classes="ring"
                          Width="26" Height="26" Margin="-2"
                          CornerRadius="9999" BorderThickness="1"
                          BorderBrush="{DynamicResource AppChromeBorderBrush}"
                          IsVisible="{Binding IsPrimary}">
                    <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="15" Height="15" />
                  </Border>
                  <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22"
                                              IsVisible="{Binding !IsPrimary}" />
                  <TextBlock Text="{Binding Title}" FontSize="16" VerticalAlignment="Center"
                             Classes.danger="{Binding IsDestructive}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
