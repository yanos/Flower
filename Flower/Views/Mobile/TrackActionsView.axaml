<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.TrackActionsView"
             x:DataType="vm:MobileMainViewModel">

  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Dimmed backdrop; tapping it dismisses the sheet -->
    <Button Command="{Binding CloseSheetCommand}"
            Background="#66000000"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    <!-- Action card -->
    <Border VerticalAlignment="Bottom"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="0,8,0,16">
      <StackPanel Margin="{DynamicResource SheetBottomInset}">
        <!-- What the menu acts on - the song's art, title and artist - with
             the X that closes it in the top right corner. -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,8,8,8">
          <controls:AlbumArtView Grid.Column="0"
                                  AlbumArt="{Binding ActionRow.AlbumArt}"
                                  Width="52" Height="52" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding ActionTarget.Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ActionTarget.Artists}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="pill"
                  VerticalAlignment="Top"
                  Command="{Binding CloseSheetCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Opacity="0.7" />
          </Button>
        </Grid>

        <Button Classes="action" Command="{Binding ViewTrackInfoCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="InformationOutline" Width="22" Height="22" />
            <TextBlock Text="View Info" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="action" Command="{Binding OpenAddToPlaylistCommand}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="22" Height="22" />
            <TextBlock Text="Add to Playlist" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Only while the row's own download icon would show (see
             MobileMainViewModel.CanDownloadActionTarget), and the opposite of
             the entry below: a track has either this or that, or neither when
             the server that has it is out of reach. -->
        <Button Classes="action" Command="{Binding DownloadActionTargetCommand}"
                IsVisible="{Binding CanDownloadActionTarget}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="22" Height="22" />
            <TextBlock Text="Download" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Any track with a real local file (see
             MobileMainViewModel.CanDeleteDownloadedFile) - reverts it back to
             a not-yet-downloaded placeholder and frees the local file's
             storage, rather than removing the track from the library. Opens a
             confirm sheet (ConfirmDeleteFileView) that warns first if this
             particular file wouldn't come back on its own - see
             IsRecoverableDownload. -->
        <Button Classes="action" Command="{Binding DeleteDownloadedFileCommand}"
                IsVisible="{Binding CanDeleteDownloadedFile}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="22" Height="22" Foreground="{DynamicResource AppErrorBrush}" />
            <TextBlock Text="Delete Local File" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AppErrorBrush}" />
          </StackPanel>
        </Button>

        <!-- Takes the song out of the library itself, not just its file -
             and off the server too when an admin does it. Confirmed first,
             with a choice to delete the files (ConfirmRemoveFromLibraryView).
             Hidden for a server song on a phone that is not the server's
             admin: see LibraryRemovalService. -->
        <Button Classes="action" Command="{Binding RemoveFromLibraryCommand}"
                IsVisible="{Binding CanRemoveActionTargetFromLibrary}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="MusicNoteOff" Width="22" Height="22" Foreground="{DynamicResource AppErrorBrush}" />
            <TextBlock Text="Remove from Library" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AppErrorBrush}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
