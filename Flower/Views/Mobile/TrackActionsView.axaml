<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:menus="clr-namespace:Flower.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.TrackActionsView"
             x:DataType="vm:MobileMainViewModel">

  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Dimmed backdrop; tapping it dismisses the sheet -->
    <Button Command="{Binding CloseSheetCommand}"
            Background="{DynamicResource AppScrimBrush}"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    <!-- Action card -->
    <!-- .chromeIcons: every icon on the card, the X and a delete's
         included, in the frame's colour (App.axaml); a delete's words are
         AppDangerBrush. -->
    <Border VerticalAlignment="Bottom"
            Classes="chromeIcons"
            controls:SlidingSheet.IsCard="True"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="0,8,0,16">
      <StackPanel Margin="{DynamicResource SheetBottomInset}">
        <!-- What the menu acts on - the song's art, title and artist - with
             the X that closes it in the top right corner. -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,8,8,8">
          <controls:AlbumArtView Grid.Column="0"
                                  AlbumArt="{Binding ActionRow.AlbumArt}"
                                  Width="52" Height="52" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding ActionTarget.Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ActionTarget.Artists}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="pill"
                  VerticalAlignment="Top"
                  Command="{Binding CloseSheetCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Opacity="0.7" />
          </Button>
        </Grid>

        <!-- The entries ActionMenus gives, in its order - the same as the
             desktop's context menu. A destructive entry's words are in the
             danger colour; the album menu's Play is ringed. -->
        <ItemsControl ItemsSource="{Binding SongActions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="menus:ActionMenuEntry">
              <Button Classes="action"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding $parent[ItemsControl].((vm:MobileMainViewModel)DataContext).RunSongActionCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <Border Classes="ring"
                          Width="26" Height="26" Margin="-2"
                          CornerRadius="9999" BorderThickness="1"
                          BorderBrush="{DynamicResource AppChromeBorderBrush}"
                          IsVisible="{Binding IsPrimary}">
                    <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="15" Height="15" />
                  </Border>
                  <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22"
                                              IsVisible="{Binding !IsPrimary}" />
                  <TextBlock Text="{Binding Title}" FontSize="16" VerticalAlignment="Center"
                             Classes.danger="{Binding IsDestructive}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
