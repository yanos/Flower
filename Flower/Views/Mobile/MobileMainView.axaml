<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:views="clr-namespace:Flower.Views.Mobile"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:Flower.Converters"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.MobileMainView"
             x:DataType="vm:MobileMainViewModel"
             controls:FlingStopGuard.IsEnabled="True"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- For the screenScroll ListBox template below, which shows one of
             these above a playlist's rows. -->
        <ResourceInclude Source="avares://Flower/Views/Mobile/Screens/AlbumHeaderTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:PlayOrPauseConverter x:Key="PlayOrPauseConverter" />
      <!-- Replaced from the code-behind as BottomChrome's height changes. -->
      <Thickness x:Key="ScreenScrollInset">0,64,0,100</Thickness>
      <!-- The tab oval's height and bottom margin, which the Now Playing
           sheet keeps its content clear of - replaced from the code-behind. -->
      <Thickness x:Key="NowPlayingBottomInset">0,0,0,84</Thickness>
      <conv:EqualsConverter x:Key="EqualsConverter" />
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- No scrollbars anywhere on the phone. A finger already knows how far
         down a list it is, and every scroller here is a full-width screen
         whose Fluent scrollbar drew a grey rail down the right edge - over
         the album grids' last column of art, and over the floating ovals at
         the bottom. Opacity rather than IsVisible because ScrollBar sets its
         own IsVisible from code as the extent changes, which beats a style
         setter; and rather than a width of 0 because the scrollers here
         auto-hide, so the bars overlay the content and take no layout from
         it either way. IsHitTestVisible goes with it so an invisible rail
         cannot swallow a drag meant for the list.

         Desktop keeps its own: a mouse has no other way to tell how long a
         list is, which is why this sits here and not in App.axaml. -->
    <Style Selector="ScrollBar">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- The ListBoxItem container FluentTheme generates around each row has its
         own default Padding/MinHeight independent of the row Button's - showing
         up as a second, differently-colored selection box wrapped around the
         row's own pressed-state box, and doubling the visual vertical spacing.
         Zeroing it here makes the row Button's own Padding the only source of
         row height/spacing. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- FluentTheme paints its pressed/pointerover/selected highlight on the
         ContentPresenter template PART (Background on
         ContentPresenter#PART_ContentPresenter INSIDE the control's own
         default template), NOT on the control itself - which is why a plain
         `Selector="ListBoxItem:pressed { Background }"` (and the Button
         equivalent) had zero effect: it set the wrong element's Background.
         The documented way to actually suppress it is to reach into the
         template and override that same part, so these selectors target
         `/template/ ContentPresenter#PART_ContentPresenter` for every
         highlight state. Purely cosmetic - selection/Click routing is
         untouched, a genuine tap still activates exactly as before, this
         only removes the "about to activate" grey that flashed on scroll
         and lingered on press-and-hold. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The tabs take Button.pill (Styles/IconButtons.axaml) for its round
         press highlight, which fits the oval they sit in. This style is
         nearer, so it makes each one a 52px square, well inside the oval
         (64 less its 1px border, top and bottom) so the highlight sits clear
         of the rim - a circle, then, rather than a stadium as wide as its
         column - centred in its column, with the icon and label centred in
         it and no padding pushing them off.

         52 rather than the 58 five tabs could afford: Search joined them from
         the pill at the top, and six circles have to fit the oval on the
         narrowest phone. The oval widened with them to the mini player's own
         length (TabBar below), and what sets the floor is not the circle but
         the longest label - "Playlists" has to stay on one line in a column of
         about 55px. MobileTabBarLayoutTests measures both, at 375 and at 430.
         The tab showing is marked .current rather than .selected:
         Button.pill.selected tints its icon with the accent, which suits the
         search button but not a tab, whose label and Songs note it cannot
         reach.

         The icons are sized to the Songs note rather than to one number. A
         Material icon draws its glyph inside a 24-unit box with a margin that
         varies by icon, while the note is stretched to fill its box, so drawn
         at the same size every one of them came out smaller than it: measured,
         the clock spans 21 of those units, the disc 20, the person 16, the
         playlist 19 and the magnifier 17.5. Each is enlarged until its glyph
         spans 24px at its widest or tallest - 24 x 24 / the glyph's extent in
         units - and a negative margin gives the enlargement back, so every
         icon still takes 24px of the tab's layout and the labels stay on one
         line.

         That span was 22px until the icons were asked to be a little bigger.
         Only the glyphs grew: the margins absorb the difference, so each tab
         is the same 52px square in the same oval, and nothing above or beside
         them moved. Which is the whole point of sizing them this way - the
         alternative, growing the icons by growing their boxes, would have
         pushed the labels down and the oval out. -->
    <Style Selector="Button.tab">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The tabs not showing are grey rather than dimmed: dimming left their
         icons a faded red that still read as lit. The one showing keeps the
         primary red every icon is drawn in, and its label and the Songs note
         follow it. -->
    <Style Selector="Button.tab Path">
      <Setter Property="Fill" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Button.tab.current TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Button.tab:not(.current) materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}" />
    </Style>
    <Style Selector="Button.tab:not(.current) TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}" />
    </Style>
    <Style Selector="Button.tab:not(.current) Path">
      <Setter Property="Fill" Value="{DynamicResource AppTextDisabledBrush}" />
    </Style>
    <!-- The mini player and the tab oval float over the bottom of the screens
         (BottomChrome below), so every screen's scroller keeps that much room
         past its last item - enough to bring it up clear of them, while the
         list still runs behind them on the way. ScreenScrollInset follows
         their height from the code-behind: the mini player comes and goes.
         The top is the same idea for the header band, which has no background
         and lets the list run on under the back button (ScreenSlot): the
         content - the screen's title first (ScreenTitle) - starts below it,
         and scrolls up behind it.

         Where it goes depends on the scroller, because it has to lengthen what
         scrolls rather than shrink the window onto it. A ListBox's Padding is
         the margin of its items inside its own scroller, so the ListBox takes
         it. A bare ScrollViewer's Padding does not reach its extent at all -
         the last song of a long album stayed under the tabs with the list at
         the end of its travel - so there it is a margin on the content
         instead. Which is why the album grids inset their tiles with Padding:
         a Margin of their own would beat this one.

         Named by type rather than as any child, because the scroller's own
         template parts count as its children too: a margin on its presenter
         shrank the window by the same amount, and the list stopped the
         inset's height again short of the tabs. Every screen's content is one
         of these two; a screen that scrolls something else needs adding. -->
    <!-- The template is Fluent's with the screen's title (and a playlist's
         header) stacked above the items, inside the scroll, so they move with
         them (ScreenTitle) - a ListBox has nowhere else to put anything before
         its first item. The virtualizing panel still only realizes what shows:
         it sizes itself off the effective viewport, which a StackPanel around
         it does not change. -->
    <Style Selector="ListBox.screenScroll">
      <Setter Property="Padding" Value="{DynamicResource ScreenScrollInset}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ScrollViewer Name="PART_ScrollViewer"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                          AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}">
              <StackPanel Margin="{TemplateBinding Padding}">
                <controls:ScreenTitle />
                <!-- ...and, under it, whatever the screen put there: a
                     playlist's own header, the same one an album's tracks get
                     (TrackListScreenView, ScreenScroll.Header). Nothing at
                     all on every other screen, where the property is unset
                     and a ContentControl with no content draws and measures
                     nothing. -->
                <ContentControl Content="{TemplateBinding (controls:ScreenScroll.Header)}"
                                ContentTemplate="{StaticResource AlbumHeaderTemplate}"
                                ClipToBounds="False" />
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ScrollViewer.screenScroll > StackPanel, ScrollViewer.screenScroll > ItemsControl">
      <Setter Property="Margin" Value="{DynamicResource ScreenScrollInset}" />
    </Style>
    <!-- Border.floating and Button.pill, the floating controls over the top of
         the screens, are app-wide now: Styles/IconButtons.axaml. -->
    <Style Selector="Button.pickerRow, Button.trackRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <!-- Same story as ListBoxItem above - the grey the user sees on press is
         FluentTheme setting Background on the Button's own
         ContentPresenter#PART_ContentPresenter template part, so it has to be
         overridden there (a Background setter on the Button itself, tried
         first, doesn't touch that inner part). Covers both the picker/album
         tiles and the song rows. -->
    <Style Selector="Button.pickerRow:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.trackRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.pickerRow:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.trackRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Narrower left/right inset than the picker rows above (16): a song row
         carries art, a title, a download icon, a duration and a menu across
         one phone width, and the 8px on each side buys the title more of it
         than the margin was doing. The vertical half is untouched - it is what
         makes the row a comfortable tap. TrackListScreenView's album header
         uses this number to line its text up with the titles, so changing it
         here moves that too (see the margin on ContentControl.albumText.beside). -->
    <Style Selector="Button.trackRow">
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <!-- The currently playing song, said the one way it is said on every
         list on every platform: weight, and nothing else. Desktop marks its
         own rows the same (TrackRowControl's .playing style, and
         AlbumGridRowControl's .playingTrack for an expanded album), which it
         did not before - it drew a small "▶" in a column of its own while
         this went bold and accent-coloured, so the two heads disagreed about
         what "playing" even looks like. The accent Foreground went with the
         arrow: it was the half of this that had no counterpart over there,
         and colour is already spoken for on a row (0.5 opacity means the
         song is not here yet - see Button.trackRow.placeholder below). -->
    <Style Selector="Button.trackRow.playing TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Not-yet-downloaded track that can't currently be streamed/downloaded
         (see TrackRowViewModel.IsUnavailable/IsAvailable) - dimmed like
         the currently-playing/disabled treatment elsewhere, since there's
         genuinely nothing actionable about it right now beyond retrying
         later. An available placeholder looks like any other row - it can be
         streamed/downloaded immediately, see DownloadTrackCommand. -->
    <Style Selector="Button.trackRow.placeholder">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- The album-level counterpart, for the art-tile grids and the album
         header (see AlbumTileViewModel.IsUnavailable): an album is only
         dimmed once *nothing* in it can be played - one downloaded track
         keeps it at full strength, since tapping it still lands on
         something that plays. Same 0.5 as the track rows above, and shared
         from here so every screen hosted in this view gets the one
         definition. -->
    <Style Selector="StackPanel.dimmed">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Both of the above grey their icons and missing-cover note rather than
         leaving them the faded red dimming alone would. -->
    <Style Selector="Button.trackRow.placeholder materialIcons|MaterialIcon, StackPanel.dimmed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <Style Selector="Button.trackRow.placeholder TextBlock.placeholderGlyph, StackPanel.dimmed TextBlock.placeholderGlyph">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <Style Selector="StackPanel.searchPrompt">
      <Setter Property="Margin" Value="0,0,0,300" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Root" RowDefinitions="*,Auto,Auto">

    <!-- Content - the full height, under the mini player and tab oval too -->
    <Grid Grid.Row="0" Grid.RowSpan="3">

      <!-- Swipe-back navigation feature, final stage: the 7 IsVisible-
           toggled screen siblings Stage 1 introduced are owned by
           ScreenStackPanel instead, which keeps at most 2 real instances
           alive (current + one back) and itself owns the whole interactive
           swipe gesture - live-drag reveal on a rightward swipe (when
           there's history to reveal), easing to commit/cancel on release,
           discrete tab-paging otherwise - see that class's own doc comment.
           Each slot carries its own sliding header - the back and settings
           buttons, and the Search tab's box (see ScreenSlot) - so all of it
           moves with its screen. -->
      <controls:ScreenStackPanel x:Name="ScreenStack" />

      <!-- Empty state: shown instead of a blank screen when the current list has nothing in it.
           The host is hidden while the screen stack is moving (ScreenStackPanel.Moving/Settled,
           in the code-behind): this sits over the stack, not inside a screen, so it would
           otherwise stay put over a screen sliding away and describe the wrong one. -->
      <Panel x:Name="EmptyStateHost">
        <!-- The search prompt sits well above centre: the keyboard comes up
             under it, and the box it is about is at the top of the screen. -->
        <StackPanel Classes.searchPrompt="{Binding IsShowingSearchPrompt}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    MaxWidth="280">
          <!-- Out of the way of the recent-searches dropdown, which it would
               otherwise be drawn over - see IsSearchDropdownOpen. -->
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsContentEmpty" />
              <Binding Path="!IsSearchDropdownOpen" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <materialIcons:MaterialIcon Kind="{Binding EmptyStateIcon}" Width="40" Height="40" Opacity="0.35" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyStateTitle}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Opacity="0.6"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
          <TextBlock Text="{Binding EmptyStateMessage}"
                     IsVisible="{Binding EmptyStateMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     FontSize="14"
                     Opacity="0.5"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Panel>

    </Grid>

    <!-- Every sheet slides rather than blinking in and out - see SlidingSheet,
         which is why these take IsOpen instead of an IsVisible binding (the
         closing slide has to outlive ActiveSheet going back to None). They
         come up from the bottom, the direction each one's own ChevronDown
         dismiss or bottom-anchored card already promises; now-playing and
         settings are the exceptions, arriving from the right like a pushed
         screen and dismissing with that screen's back arrow.
         The four drawn as a card over a dimmed backdrop mark that card with
         SlidingSheet.IsCard, so the card slides while the dimming fades in
         behind it rather than sweeping up the screen with it.
         The two that arrive from the right are pushed screens with a back
         arrow, so they take DismissCommand as well and go back to a rightward
         swipe the way every screen underneath them does - see
         SlidingSheet's own "Swipe to dismiss" section. -->

    <!-- Now-playing sheet: full-screen overlay above everything else. Arrives
         from the right, like Settings below and for the same reason - it is a
         whole screen reached from a persistent bar, not something raised over
         the list you were reading. Leaves the same way, except when the
         dismissal is itself a push - tapping the album art - and it is shoved
         off to the left by the album coming in behind it. The tab oval stays
         over it (BottomChrome is declared after it, and before every other
         sheet), so the tabs are one tap away from the song too. -->
    <controls:SlidingSheet x:Name="NowPlayingSheet"
                            Grid.Row="0" Grid.RowSpan="3"
                            IsOpen="{Binding IsShowingNowPlaying}"
                            DismissCommand="{Binding CloseSheetCommand}"
                            ExitsForward="{Binding NowPlayingExitsForward}"
                            EntersBackward="{Binding NowPlayingEntersBackward}">
      <views:NowPlayingView />
    </controls:SlidingSheet>

    <!-- The mini player over the tab oval, both floating over the bottom of
         the screens rather than taking rows of their own, so a list scrolls on
         behind and around them. No Background on the stack, so the gap between
         the two passes touches through to the list. The screens' scrollers
         keep their height clear past the end - see screenScroll above.

         Declared after the Now Playing sheet and before the rest, so the tab
         oval is drawn over that sheet and under every other one. The mini
         player is not kept: it would only repeat the sheet it opens, so while
         the sheet is open it slides down under the tab oval, and comes back up
         out of it when the sheet closes - see TuckMiniPlayer. -->
    <StackPanel x:Name="BottomChrome"
                Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Bottom"
                Spacing="8"
                SizeChanged="BottomChrome_SizeChanged">

    <!-- Mini player - an oval of its own, with the same floating look and the
         same length as the tabs under it: one shape repeated, rather than two
         that are nearly the same width. Its art is round to sit in the oval's
         rounded end. The star columns centre it at 97% of the width between
         its margins, and pass touches either side through to the list, as the
         tab oval's do - and that oval takes this same margin and this same
         97%, so neither number can move here without moving there. Both ovals
         take a shadow with no offset, rather than the floating pill's downward
         one, so it rings the whole oval over the list scrolling behind it. -->
    <Grid IsVisible="{Binding CurrentlyPlaying.CurrentlyPlayingTrack, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
          x:Name="MiniPlayerHost"
          Margin="12,0"
          ColumnDefinitions="3*,194*,3*">
    <Border Grid.Column="1"
            Classes="floating"
            Height="56"
            BoxShadow="0 0 16 1.6 #4D000000"
            CornerRadius="28"
            Padding="8,0,6,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <!-- The art is part of the row rather than a button of its own, so a
             tap on it opens Now Playing like the rest of the row does - the
             same image, from the same loader, that sheet then shows large. -->
        <Button Grid.Column="0"
                Classes="pickerRow"
                Command="{Binding OpenNowPlayingCommand}"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Grid.Column="0"
                    Width="40" Height="40"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="20"
                    ClipToBounds="True">
              <Image Source="{Binding CurrentlyPlaying.AlbumArt}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentlyPlaying.CurrentlyPlayingTrack.Title}"
                         FontSize="15"
                         FontWeight="Medium"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding CurrentlyPlaying.CurrentlyPlayingTrack.Artists}"
                         FontSize="12"
                         Opacity="0.65"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1"
                Classes="pill"
                Command="{Binding ToggleMiniPlayerCommand}"
                Padding="8"
                VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="{Binding PlaylistControl.IsPlaying, Converter={StaticResource PlayOrPauseConverter}}"
                                       Width="26" Height="26" />
        </Button>
        <Button Grid.Column="2"
                Classes="pill"
                Command="{Binding NextTrackCommand}"
                Padding="8"
                VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="FastForward" Width="26" Height="26" />
        </Button>
      </Grid>
    </Border>
    </Grid>

    <!-- Tab oval - Recently Added first/leftmost, matching it being the app's
         default/home tab (see MobileMainViewModel._selectedTab). The same
         floating look as the back button and the settings button, drawn
         taller to fit a label under each icon. Its bottom margin comes from
         the safe area (MobileMainView.axaml.cs), which lifts it off the home
         indicator. The star columns centre it at 97% of the width between
         those margins; the wrapper has no Background, so the empty columns
         either side pass touches through to the list.

         The same margin and the same 97% as the mini player above, so the two
         are one oval repeated rather than two nearly-alike ones. Both numbers
         have to move together - the margin lives in the code-behind as well,
         which re-applies it for the safe area - and MobileTabBarLayoutTests
         measures that the two come out the same length. It was 85% of a wider
         margin while there were five tabs; Search made six, which did not fit
         at that width whatever the circles did - see Button.tab above. -->
    <Grid x:Name="TabBar"
          Margin="12,0"
          SizeChanged="TabBar_SizeChanged"
          ColumnDefinitions="3*,194*,3*">
    <Border Grid.Column="1"
            Classes="floating"
            Height="64"
            BoxShadow="0 0 16 1.6 #4D000000"
            CornerRadius="32"
            Padding="4,0">
    <Grid ColumnDefinitions="*,*,*,*,*,*">
      <Button Grid.Column="0" Classes="pill tab"
              Classes.current="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=RecentlyAdded}"
              Command="{Binding SelectTabCommand}" CommandParameter="RecentlyAdded">
        <StackPanel HorizontalAlignment="Center" Spacing="2">
          <materialIcons:MaterialIcon Kind="ClockPlusOutline" Width="27" Height="27" Margin="-1.5" HorizontalAlignment="Center" />
          <TextBlock Text="Recent" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="pill tab"
              Classes.current="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Songs}"
              Command="{Binding SelectTabCommand}" CommandParameter="Songs">
        <StackPanel HorizontalAlignment="Center" Spacing="2">
          <!-- SongNoteGeometry (App.axaml). Its fill comes from the Button.tab
               styles above, red when the tab is showing and grey when not. -->
          <Path Data="{StaticResource SongNoteGeometry}"
                Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" />
          <TextBlock x:Name="SongsLabel" Text="Songs" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="pill tab"
              Classes.current="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Albums}"
              Command="{Binding SelectTabCommand}" CommandParameter="Albums">
        <StackPanel HorizontalAlignment="Center" Spacing="2">
          <materialIcons:MaterialIcon Kind="Album" Width="29" Height="29" Margin="-2.5" HorizontalAlignment="Center" />
          <TextBlock Text="Albums" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="pill tab"
              Classes.current="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Artists}"
              Command="{Binding SelectTabCommand}" CommandParameter="Artists">
        <StackPanel HorizontalAlignment="Center" Spacing="2">
          <materialIcons:MaterialIcon Kind="Account" Width="36" Height="36" Margin="-6" HorizontalAlignment="Center" />
          <TextBlock Text="Artists" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Classes="pill tab"
              Classes.current="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Playlists}"
              Command="{Binding SelectTabCommand}" CommandParameter="Playlists">
        <StackPanel HorizontalAlignment="Center" Spacing="2">
          <materialIcons:MaterialIcon Kind="PlaylistPlay" Width="30" Height="30" Margin="-3" HorizontalAlignment="Center" />
          <TextBlock Text="Playlists" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <!-- Last, matching MobileTab's own declaration order, which is what
           swipe-paging clamps against (FirstTab/LastTab in
           MobileMainViewModel). Keeps SearchTab_Click: tapping the tab while
           already on Search refocuses the box, which SelectTabCommand alone
           cannot do - see the code-behind. -->
      <Button Grid.Column="5" Classes="pill tab"
              Classes.current="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Search}"
              Command="{Binding SelectTabCommand}" CommandParameter="Search"
              Click="SearchTab_Click">
        <StackPanel HorizontalAlignment="Center" Spacing="2">
          <materialIcons:MaterialIcon Kind="Magnify" Width="33" Height="33" Margin="-4.5" HorizontalAlignment="Center" />
          <TextBlock Text="Search" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
    </Border>
    </Grid>
    </StackPanel>

    <!-- Track actions (row "..." menu) and Track Info sheets -->
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingTrackActions}">
      <views:TrackActionsView />
    </controls:SlidingSheet>
    <!-- The album menu, from a long press on a cover in any album grid -->
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingAlbumActions}">
      <views:AlbumActionsView />
    </controls:SlidingSheet>
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingTrackInfo}">
      <views:TrackInfoView />
    </controls:SlidingSheet>
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingAddToPlaylist}">
      <views:AddToPlaylistView />
    </controls:SlidingSheet>
    <!-- The other sheet that arrives from the right, like a pushed screen -
         it is reached from a gear pinned above the screens rather than
         from a row's own menu, and reads as going somewhere rather than
         raising something over what is already there. Its dismiss is the back
         arrow the rest of the app pushes screens with, not the ChevronDown the
         sheets that rise from the bottom use - see SettingsView. -->
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            IsOpen="{Binding IsShowingSettings}"
                            DismissCommand="{Binding CloseSheetCommand}">
      <views:SettingsView />
    </controls:SlidingSheet>
    <!-- The smart playlist rule editor, a pushed screen for the same reason
         Settings is: it is a page of its own, reached from the Playlists tab's
         New Smart Playlist row. -->
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            IsOpen="{Binding IsShowingSmartPlaylistEditor}"
                            DismissCommand="{Binding CloseSheetCommand}">
      <views:SmartPlaylistEditorSheetView />
    </controls:SlidingSheet>
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingConfirmPairServer}">
      <views:ConfirmPairServerView />
    </controls:SlidingSheet>
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingConfirmDeleteFile}">
      <views:ConfirmDeleteFileView />
    </controls:SlidingSheet>
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingConfirmDeletePlaylist}">
      <views:ConfirmDeletePlaylistView />
    </controls:SlidingSheet>
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingConfirmUnpairServer}">
      <views:ConfirmUnpairServerView />
    </controls:SlidingSheet>
    <controls:SlidingSheet Grid.Row="0" Grid.RowSpan="3"
                            Entrance="FromBottom"
                            IsOpen="{Binding IsShowingConfirmRemoveFromLibrary}">
      <views:ConfirmRemoveFromLibraryView />
    </controls:SlidingSheet>
  </Grid>
</UserControl>
