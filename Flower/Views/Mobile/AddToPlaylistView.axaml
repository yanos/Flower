<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:svm="clr-namespace:Flower.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:conv="clr-namespace:Flower.Converters"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.AddToPlaylistView"
             x:DataType="vm:MobileMainViewModel">

  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="20,8" />
    </Style>
    <!-- The full list's rows are pushed in under their folder, as the
         Playlists tab's are; the Recent section's are not. A style rather
         than the row's own value, which would outrank it. -->
    <Style Selector="ItemsControl.tree Button.action" x:DataType="svm:SidebarItem">
      <Setter Property="Padding" Value="{Binding Depth, Converter={x:Static conv:DepthIndentConverter.Instance}, ConverterParameter='20,8,20,8'}" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="20,12,20,4" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One playlist to add to, as the Playlists tab draws it
         (PlaylistPickerScreenView), smaller: its cover - the albums most
         played in it - or, for a folder, the folder glyph on a tile the
         cover's size. -->
    <!-- Stretched, unlike the menu entries Button.action is otherwise: this
         row has something at its right edge, and a left-aligned content
         presenter would hand the grid only as much width as its text needs
         and leave the count trailing the name instead. -->
    <!-- A folder's row opens and closes it rather than taking the song
         (AddTrackToPlaylistCommand). -->
    <DataTemplate x:Key="PlaylistTargetRow" x:DataType="svm:SidebarItem">
      <Button Classes="action"
              HorizontalContentAlignment="Stretch"
              Command="{Binding $parent[UserControl].((vm:MobileMainViewModel)DataContext).AddTrackToPlaylistCommand}"
              CommandParameter="{Binding}">
        <!-- 12 past a 40px cover is where the name being typed in the New
             Playlist row above sits too - see controls:NewPlaylistEntry's
             editorSlot. The count and length on the right are the ones the
             Playlists tab's own rows show, from the same property: which of
             two playlists with similar names to add a song to is usually
             answered by how big they are. -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <controls:AlbumArtView Grid.Column="0"
                                 IsVisible="{Binding !IsFolder}"
                                 Covers="{Binding PlaylistCover.CoverArt}"
                                 Width="40" Height="40" />
          <Border Grid.Column="0"
                  IsVisible="{Binding IsFolder}"
                  Background="{DynamicResource AppSurfaceBrush}"
                  CornerRadius="{x:Static controls:AlbumArtView.CoverCornerRadius}"
                  Width="40" Height="40">
            <materialIcons:MaterialIcon Kind="FolderOutline" Width="22" Height="22" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding PlaylistSummary}"
                     IsVisible="{Binding !IsFolder}"
                     FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
          <Panel Grid.Column="2" IsVisible="{Binding IsFolder}" VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="ChevronDown" Width="20" Height="20" Opacity="0.55" IsVisible="{Binding IsExpanded}" />
            <materialIcons:MaterialIcon Kind="ChevronRight" Width="20" Height="20" Opacity="0.55" IsVisible="{Binding !IsExpanded}" />
          </Panel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- Dimmed backdrop; tapping it dismisses the sheet -->
    <Button Command="{Binding CloseSheetCommand}"
            Background="{DynamicResource AppScrimBrush}"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    <!-- Playlist picker card. Lifted clear of the keyboard, which comes up
         over the bottom of the screen where this sheet sits and covered the
         New Playlist name box the moment a tap on that row focused it. The
         lift squeezes the card rather than pushing it off the top: the height
         left above the keyboard is what it gets, and the list scrolls in it.
         See Flower.Controls.SoftKeyboard. -->
    <!-- .chromeIcons: every icon on the card, the X included, in the
         frame's colour (App.axaml). -->
    <Border VerticalAlignment="Bottom"
            Classes="chromeIcons"
            controls:SlidingSheet.IsCard="True"
            controls:SoftKeyboard.AvoidOcclusion="True"
            MaxHeight="420"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="12,12,0,0"
            Padding="0,8,0,16">
      <DockPanel Margin="{DynamicResource SheetBottomInset}">
        <!-- The same header as the song and album menus (TrackActionsView,
             AlbumActionsView): the art and name of what is being added, with
             the X that closes the sheet in the top right corner. A song when
             it came from a song's menu; otherwise the album, from the album
             menu or from the album screen's own actions. Only one of the two
             targets is ever set while this sheet is up. -->
        <Grid DockPanel.Dock="Top"
              IsVisible="{Binding ActionTarget, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
              ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,8,8,8">
          <controls:AlbumArtView Grid.Column="0"
                                  AlbumArt="{Binding ActionRow.AlbumArt}"
                                  Width="52" Height="52" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding ActionTarget.Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ActionTarget.Artists}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="pill"
                  VerticalAlignment="Top"
                  Command="{Binding CloseSheetCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Opacity="0.7" />
          </Button>
        </Grid>
        <Grid DockPanel.Dock="Top"
              IsVisible="{Binding AlbumActionTarget, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
              ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,8,8,8">
          <controls:AlbumArtView Grid.Column="0"
                                  AlbumArt="{Binding AlbumActionTarget.AlbumArt}"
                                  Width="52" Height="52" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding AlbumActionTarget.Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding AlbumActionTarget.Artist}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="pill"
                  VerticalAlignment="Top"
                  Command="{Binding CloseSheetCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Opacity="0.7" />
          </Button>
        </Grid>

        <ScrollViewer>
          <StackPanel>
            <!-- The same row, and the same naming flow, the Playlists tab
                 itself offers (controls:NewPlaylistEntry) - inset like the
                 rows under it here rather than like the ones there. -->
            <controls:NewPlaylistEntry RowPadding="20,8" />

            <!-- The playlists last changed, ahead of them all: the one a song
                 goes into is most often the one the last went into
                 (RecentPlaylistTargets). The same rows as the list below, not
                 indented by a folder's depth: here they are out of the tree. -->
            <StackPanel IsVisible="{Binding HasRecentPlaylistTargets}">
              <TextBlock Classes="sectionLabel" Text="Recent" />
              <ItemsControl ItemsSource="{Binding RecentPlaylistTargets}"
                            ItemTemplate="{StaticResource PlaylistTargetRow}" />
              <TextBlock Classes="sectionLabel" Text="All Playlists" />
            </StackPanel>

            <ItemsControl Classes="tree"
                          ItemsSource="{Binding PlaylistPickerItems}"
                          ItemTemplate="{StaticResource PlaylistTargetRow}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
