<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:vm2="clr-namespace:Flower.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:Flower.Converters"
             xmlns:controls="clr-namespace:Flower.UserControls"
             xmlns:layout="clr-namespace:Flower.Controls"
             xmlns:services="clr-namespace:Flower.Services"
             mc:Ignorable="d"
             x:Class="Flower.Views.Mobile.NowPlayingView"
             x:DataType="vm:MobileMainViewModel"
             Background="{Binding CurrentlyPlaying.AlbumArt, Converter={x:Static services:ArtSheetBrushConverter.Instance}}"
             Padding="{DynamicResource NowPlayingBottomInset}">

  <!-- The sheet is washed in the cover's own colour, darkened until white
       reads on it and a little lighter at the top than the bottom
       (ArtBackdrop.SheetBrush), in either theme - so everything on it is
       white rather than the app's red and ink: the words, the transport, and
       both sliders (their brushes are overridden just below). The two round
       buttons at the top keep their own white circles. -->

  <UserControl.Resources>
    <conv:PlayOrPauseConverter x:Key="PlayOrPauseConverter" />

    <!-- Fluent's slider brushes, on the colour for things over a cover's
         colour (PaletteOnArt, Theme.axaml, at AppOnArt*'s strengths): the
         filled part and the thumb solid, the rest of the rail faint. Nearer
         than Theme.axaml's own, so these win for both sliders in here. -->
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource PaletteOnArt}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource PaletteOnArt}" Opacity="0.8" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource PaletteOnArt}" Opacity="0.8" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource PaletteOnArt}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource PaletteOnArt}" Opacity="0.8" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource PaletteOnArt}" Opacity="0.8" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="{DynamicResource PaletteOnArt}" Opacity="0.25" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{DynamicResource PaletteOnArt}" Opacity="0.25" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{DynamicResource PaletteOnArt}" Opacity="0.25" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Every icon on the tinted part of the sheet is white. Shuffle and
         repeat say off by being half as bright, since there is no second
         colour here to say on with. -->
    <Style Selector="layout|NowPlayingBodyPanel materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.transportToggle">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtMutedBrush}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.transportToggle.active">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Button.pill.circle Border.ring">
      <Setter Property="BorderBrush" Value="{DynamicResource AppOnArtRingBrush}" />
    </Style>

    <!-- Fluent's Slider reserves 15px above and below its 20px track (the
         SliderPre/PostContentMargin rows of its template), so a bare one is
         50px tall with a 20px rail floating in the middle - which reads as a
         gap on a phone, where these two sit tight against the rows around
         them. Height="28" closed the gap by cropping the template instead of
         shrinking it: the track stayed at y=15, so the bottom third of the
         thumb was cut off on both sliders. A negative margin gives back the
         same 28px of occupied height without constraining what draws inside
         it - the whole thumb is painted, it just overhangs, and nothing in
         this sheet clips. -->
    <!-- The seek bar's two halves are separate pieces that meet at the
         thumb's square box, so rounding both ends of each (the Slider's own
         CornerRadius) left a notch either side of the round thumb. Only the
         outer ends are rounded: square where each piece meets the thumb, the
         circle covers the join. -->
    <Style Selector="Slider.seek /template/ RepeatButton#PART_DecreaseButton /template/ Border#TrackBackground">
      <Setter Property="CornerRadius" Value="3,0,0,3" />
    </Style>
    <Style Selector="Slider.seek /template/ RepeatButton#PART_IncreaseButton /template/ Border#TrackBackground">
      <Setter Property="CornerRadius" Value="0,3,3,0" />
    </Style>

    <Style Selector="Slider.tight">
      <Setter Property="Margin" Value="0,-11" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- The bottom padding is not the safe area, as on the other whole-screen
       sheets, but the tab oval MobileMainView keeps floating over this one -
       which already clears the safe area itself. -->
  <!-- No horizontal padding on the root: the top bar has to line up with the
       back and menu buttons over every screen (ScreenSlot's header band),
       inset from the window edge, so the 24px inset belongs to the rows below
       it rather than to the whole sheet. -->
  <!-- Below the status bar: the sheet itself runs up under it (MobileMainView
       pulls it up by ScreenStackBleed) so the colour reaches the top edge. -->
  <Panel Margin="{DynamicResource StatusBarInset}">
  <Grid RowDefinitions="Auto,*" Margin="0,0,0,10">

    <!-- Top bar: collapse only - no "Now Playing" label, the sheet's own
         content already makes that obvious. The back button is the round one
         every screen carries in its header band (ScreenSlot; Border.floating
         and Button.pill are styled in Styles/IconButtons.axaml), and the
         margin mirrors that band's
         (12 in from either side), with Height="52" starting at y=0 putting
         every circle on the same 26px centre line, so neither the back arrow
         nor the gear jumps when the sheet opens. The gear is this sheet's own
         copy of the screens': the sheet is drawn over them, so
         without one here settings could not be reached while a song plays. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="52" Margin="12,0,12,0">
      <Border Grid.Column="0" Classes="floating" Width="40">
        <Button Classes="pill"
                Command="{Binding CloseSheetCommand}"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
        </Button>
      </Border>

      <!-- Apple's own AirPlay/Bluetooth route button, hosted natively - and
           nothing at all on platforms that have no such control (see
           RoutePickerControl). Sized here because a NativeControlHost has no
           intrinsic size of its own to measure. -->
      <controls:RoutePickerControl Grid.Column="1"
                                   Width="30" Height="30"
                                   Margin="0,0,14,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />

      <Border Grid.Column="2" Classes="floating" Width="40">
        <Button Classes="pill"
                Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="Cog" Width="20" Height="20" />
        </Button>
      </Border>
    </Grid>

    <!-- Album art and the controls, laid out by NowPlayingBodyPanel: stacked
         upright, side by side when the phone is turned, with the cover always
         a square off the short edge. Two children in that order and nothing
         else - the panel owns every size and position here. -->
    <layout:NowPlayingBodyPanel Grid.Row="1" Margin="24,0" TextElement.Foreground="{DynamicResource AppOnArtBrush}">
      <!-- Tapping the art jumps to that track's album (closing this sheet) -
           see GoToCurrentlyPlayingAlbumCommand. -->
      <!-- The shadow is cast from outside the Button: Fluent's Button clips its
           content to its own rectangle, which cut the shadow off square at the
           cover's bottom corners. The inner Border is the one that clips, to
           round the cover itself. -->
      <!-- Stretch explicitly: the panel hands this a square to fill, and a
           track with no art yet has nothing to give the button a size of its
           own - left to its default it would collapse to nothing and the slot
           would sit empty. -->
      <Border CornerRadius="16"
              BoxShadow="{DynamicResource AppCoverShadow}">
        <Button Command="{Binding GoToCurrentlyPlayingAlbumCommand}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="16"
                Padding="0">
          <!-- The one cover control, as every cover in the app is - the note
               when there is no art included. -->
          <layout:AlbumArtView AlbumArt="{Binding CurrentlyPlaying.AlbumArt}"
                               ArtCornerRadius="16" />
        </Button>
      </Border>

      <!-- The song's name and its album go first, hard under the cover, which
           is what they are about - the star row is under them now rather than
           above, so the slack falls between the names and the seek bar and the
           transport block stays bottom-aligned as it was. -->
      <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Stretch">
        <!-- The title in the display serif, white on the cover's colour: on
             this screen the song is the subject, not one row among many. Cormorant's small
             x-height is why it is 28 where Inter would be 22. -->
        <StackPanel Grid.Row="0" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding CurrentlyPlaying.CurrentlyPlayingTrack.Title}"
                     FontFamily="{DynamicResource AppDisplayFontFamily}"
                     FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppOnArtBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding CurrentlyPlaying.Subtitle}"
                     FontSize="16"
                     Opacity="0.65"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Seek slider + times. The slider is given a height because the
             default template reserves room for a tick bar it hasn't got,
             which reads as a gap. -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
          <!-- Thicker than Fluent's rail, with round ends: this is the one
               bar on the screen, and at the default it read as a hairline
               under the words. The volume slider below keeps the default,
               being secondary. -->
          <Slider Classes="tight seek"
                  Minimum="0" Maximum="1"
                  Value="{Binding CurrentlyPlaying.SeekPosition}">
            <Slider.Resources>
              <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
            </Slider.Resources>
          </Slider>
          <Grid ColumnDefinitions="*,*">
            <TextBlock Grid.Column="0" Text="{Binding CurrentlyPlaying.ElapsedTime}" FontSize="14" Opacity="0.65" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentlyPlaying.TotalTime}" FontSize="14" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>

        <!-- Transport controls: previous, play and next gathered close in the
             middle, where one thumb reaches all three, with the shuffle and
             repeat toggles on the same line out at either edge. The two
             toggles are the same button, so the middle column is centred on
             the sheet as well as between them. -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Button Grid.Column="0"
                  Command="{Binding ToggleShuffleCommand}"
                  Background="Transparent" BorderThickness="0" Padding="6"
                  VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Shuffle" Width="24" Height="24"
                                         Classes="transportToggle"
                                         Classes.active="{Binding CurrentlyPlaying.IsShuffleEnabled}" />
          </Button>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="28"
                      HorizontalAlignment="Center">
            <Button Command="{Binding PreviousTrackCommand}"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="Rewind" Width="28" Height="28" />
            </Button>
            <Button Classes="pill circle"
                    Command="{Binding ToggleMiniPlayerCommand}"
                    Width="60" Height="60">
              <Border Classes="ring">
                <materialIcons:MaterialIcon Kind="{Binding PlaylistControl.IsPlaying, Converter={StaticResource PlayOrPauseConverter}}"
                                             Width="28" Height="28" />
              </Border>
            </Button>
            <Button Command="{Binding NextTrackCommand}"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="FastForward" Width="28" Height="28" />
            </Button>
          </StackPanel>
          <Button Grid.Column="2"
                  Command="{Binding ToggleRepeatCommand}"
                  Background="Transparent" BorderThickness="0" Padding="6"
                  VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Repeat" Width="24" Height="24"
                                         Classes="transportToggle"
                                         Classes.active="{Binding CurrentlyPlaying.IsRepeatEnabled}" />
          </Button>
        </Grid>

        <!-- Volume, below the transport where a thumb already is. Bound
             straight to the same VolumeControlViewModel the desktop status bar
             drives, so the two never disagree - but drawn as a plain Slider
             rather than reusing desktop's VolumeControl, whose 10px thumb and
             3px rail are a mouse target, not a finger one. -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0"
              DataContext="{Binding Main.Volume}"
              x:CompileBindings="True" x:DataType="vm2:VolumeControlViewModel">
          <materialIcons:MaterialIcon Grid.Column="0"
                                      Kind="VolumeLow"
                                      Width="18" Height="18"
                                      Opacity="0.5"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
          <Slider Grid.Column="1"
                  Classes="tight"
                  Minimum="0" Maximum="100"
                  Value="{Binding Volume, Mode=TwoWay}" />
          <materialIcons:MaterialIcon Grid.Column="2"
                                      Kind="VolumeHigh"
                                      Width="18" Height="18"
                                      Opacity="0.5"
                                      VerticalAlignment="Center"
                                      Margin="10,0,0,0" />
        </Grid>
      </Grid>
    </layout:NowPlayingBodyPanel>
  </Grid>
  </Panel>
</UserControl>
