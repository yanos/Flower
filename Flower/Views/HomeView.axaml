<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:mvm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <!-- Desktop's Home: three shelves under the page header MainView draws over
       every list (the name and the filter box). The album shelves are laid
       out like the Albums grid - as many columns as fit, wrapping onto rows
       below, in a virtualizing list of rows at the grid's own cell width -
       rather than one row that scrolls sideways; Recently Played is songs,
       two side by side, with a way through to History. See HomeViewModel for
       what is on them and how many. The phone's is HomeScreenView - the same
       shelves, but tapped and long-pressed rather than clicked and
       right-clicked, and inside the phone's own screen scroller. Every cover
       is the album tile the phone draws (AlbumCard); its "..." opens the
       tile's menu - MainView answers AlbumCard.MenuRequested. A song's "..."
       and a right-click on it open the song menu (Song_ContextRequested). -->
  <UserControl.Styles>
    <!-- Each shelf's heading in the display serif, leaving room above it for
         the shelf before. -->
    <Style Selector="Grid.shelfTitle">
      <Setter Property="Margin" Value="8,40,8,14" />
    </Style>
    <Style Selector="Grid.shelfTitle.first">
      <Setter Property="Margin" Value="8,0,8,14" />
    </Style>
    <!-- A song on Recently Played: a rounded row over a hairline, grey under
         the pointer, its words bold while it plays and faded while it cannot
         be played. -->
    <Style Selector="Button.homeSong">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Height" Value="60" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.homeSong:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.songTitle">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.homeSong.playing TextBlock.songTitle">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.homeSong.playing controls|TrackDownloadButton">
      <Setter Property="IsBold" Value="True" />
    </Style>
    <Style Selector="Button.homeSong.dimmed Grid#SongCells">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- "See full history": words that grey like a button when pointed at. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Button.homeTile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Grey under the pointer, as a tile in the Albums grid is. -->
    <Style Selector="Button.homeTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- One virtualizing list of rows - each shelf's heading, then its covers
         so many to a row (HomeShelfRows, fed by HomeShelfRowsHost from this
         list's width) - so only what is on screen is built, as in the Albums
         grid, and each row built once and handed shelf after shelf
         (RecyclingItemsControl), as on the phone. Its own ScrollViewer, as
         AlbumGridView has: an ItemsControl's template has none. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <controls:RecyclingItemsControl x:Name="Rows" Margin="32,0,32,40">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:HomeShelfHeaderRow">
            <Grid Classes="shelfTitle" Classes.first="{Binding IsFirst}" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="sectionTitle" FontSize="26" Text="{Binding Title}" VerticalAlignment="Bottom" />
              <Button Grid.Column="1"
                      Classes="link"
                      Content="See full history"
                      IsVisible="{Binding ShowsHistoryLink}"
                      Command="{Binding HistoryLink.ShowHistoryCommand}"
                      VerticalAlignment="Bottom" />
            </Grid>
          </DataTemplate>

          <!-- Each shelf's covers, so many to a row (TileRowPanel, which
               keeps them as the list hands the row other albums). -->
          <DataTemplate DataType="vm:HomeContinuePlayingRow">
            <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Items}" Margin="0,0,0,8">
              <controls:TileRowPanel.ItemTemplate>
                <DataTemplate x:DataType="vm:ContinuePlayingItemViewModel">
                  <Button Classes="homeTile"
                          Command="{Binding Home.ResumeCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Continue where you left off">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Continue Playing"
                                  Command="{Binding Home.ResumeCommand}"
                                  CommandParameter="{Binding}">
                          <MenuItem.Icon><materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show Album"
                                  Command="{Binding Home.OpenAlbumCommand}"
                                  CommandParameter="{Binding Tile}">
                          <MenuItem.Icon><materialIcons:MaterialIcon Kind="Album" Width="16" Height="16" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove from Continue Playing"
                                  Command="{Binding Home.ForgetCommand}"
                                  CommandParameter="{Binding}">
                          <MenuItem.Icon><materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" /></MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <controls:AlbumCard Classes="desktop"
                                        Tile="{Binding Tile}"
                                        ShowsProgress="True"
                                        Progress="{Binding Progress}"
                                        Detail="{Binding Detail}"
                                        DismissCommand="{Binding Home.ForgetCommand}"
                                        DismissParameter="{Binding}"
                                        DismissTip="Remove from Continue Playing" />
                  </Button>
                </DataTemplate>
              </controls:TileRowPanel.ItemTemplate>
            </controls:TileRowPanel>
          </DataTemplate>

          <DataTemplate DataType="vm:HomeAlbumRow">
            <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Tiles}" Margin="0,0,0,8">
              <controls:TileRowPanel.ItemTemplate>
                <DataTemplate x:DataType="mvm:AlbumTileViewModel">
                  <Button Classes="homeTile"
                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenAlbumCommand}"
                          CommandParameter="{Binding}">
                    <controls:AlbumCard Classes="desktop" Tile="{Binding}" />
                  </Button>
                </DataTemplate>
              </controls:TileRowPanel.ItemTemplate>
            </controls:TileRowPanel>
          </DataTemplate>

          <!-- Recently Played's songs, two to a row with a gutter between -
               each song's right margin, given back by the row's. A click
               plays the shelf from that song down. -->
          <DataTemplate DataType="vm:HomeSongRow">
            <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Songs}" Margin="0,0,-32,2">
              <controls:TileRowPanel.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRowViewModel">
                  <Button Classes="homeSong"
                          Classes.playing="{Binding IsCurrentlyPlaying}"
                          Classes.dimmed="{Binding IsUnavailable}"
                          Margin="0,0,32,0"
                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PlayRecentlyPlayedCommand}"
                          CommandParameter="{Binding}"
                          ContextRequested="Song_ContextRequested">
                    <Grid x:Name="SongCells" ColumnDefinitions="40,*,Auto,Auto,Auto" ColumnSpacing="12">
                      <controls:AlbumArtView Grid.Column="0"
                                             Width="40" Height="40"
                                             ArtCornerRadius="8"
                                             AlbumArt="{Binding AlbumArt}" />
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="songTitle"
                                   Text="{Binding Track.Title}"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ArtistAndAlbumText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <controls:TrackDownloadButton Grid.Column="2"
                                                    IconSize="17"
                                                    IconPadding="11"
                                                    Label="Download"
                                                    DownloadRequested="Song_DownloadRequested" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding DurationDisplay}"
                                 MinWidth="44"
                                 TextAlignment="Right"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AppTextValueBrush}" />
                      <Button Grid.Column="4"
                              Classes="pill"
                              Padding="11"
                              ToolTip.Tip="More"
                              Click="SongMenu_Click">
                        <materialIcons:MaterialIcon Kind="DotsVertical" Width="18" Height="18"
                                                    Foreground="{DynamicResource AppTextSecondaryBrush}" />
                      </Button>
                    </Grid>
                  </Button>
                </DataTemplate>
              </controls:TileRowPanel.ItemTemplate>
            </controls:TileRowPanel>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </controls:RecyclingItemsControl>
    </ScrollViewer>

    <StackPanel IsVisible="{Binding ShowsNothingYet}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="8" Opacity="0.6" MaxWidth="360">
      <materialIcons:MaterialIcon Kind="HomeOutline" Classes="chrome" Width="40" Height="40" />
      <TextBlock Text="Nothing here yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Songs you play and albums you add will show up here."
                 FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>

    <StackPanel IsVisible="{Binding ShowsNoMatches}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="8" Opacity="0.6" MaxWidth="360">
      <materialIcons:MaterialIcon Kind="Magnify" Classes="chrome" Width="40" Height="40" />
      <TextBlock Text="No matches" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Nothing on Home matches the filter."
                 FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
