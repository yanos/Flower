<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:mvm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <!-- Desktop's Home: three shelves under the page header MainView draws over
       every list (the name, the count, the filter box), each laid out like
       the Albums grid - as many columns as fit, wrapping onto rows below, in
       a virtualizing list of rows at the grid's own cell width - rather than
       one row that scrolls sideways. See HomeViewModel for what is on them and how
       many. The phone's is HomeScreenView - the same shelves, but tapped and
       long-pressed rather than clicked and right-clicked, and inside the
       phone's own screen scroller. Every cover is the album tile the phone
       draws (AlbumCard); its "..." opens the tile's menu - MainView answers
       AlbumCard.MenuRequested. -->
  <UserControl.Styles>
    <!-- The phone's shelf headings (HomeScreenView), each leaving room above
         it for the shelf before. -->
    <Style Selector="TextBlock.shelfTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="8,28,0,12" />
    </Style>
    <Style Selector="TextBlock.shelfTitle.first">
      <Setter Property="Margin" Value="8,0,0,12" />
    </Style>
    <Style Selector="Button.homeTile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.homeTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverSoftBrush}" />
    </Style>
    <Style Selector="Button.homeTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentPressedSoftBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- One virtualizing list of rows - each shelf's heading, then its covers
         so many to a row (HomeShelfRows, fed by HomeShelfRowsHost from this
         list's width) - so only what is on screen is built, as in the Albums
         grid, and each row built once and handed shelf after shelf
         (RecyclingItemsControl), as on the phone. Its own ScrollViewer, as
         AlbumGridView has: an ItemsControl's template has none. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <controls:RecyclingItemsControl x:Name="Rows" Margin="16,0,16,24">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:HomeShelfHeaderRow">
            <TextBlock Classes="shelfTitle" Classes.first="{Binding IsFirst}" Text="{Binding Title}" />
          </DataTemplate>

          <!-- Each shelf's covers, so many to a row (TileRowPanel, which
               keeps them as the list hands the row other albums). -->
          <DataTemplate DataType="vm:HomeContinuePlayingRow">
            <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Items}" Margin="0,0,0,8">
              <controls:TileRowPanel.ItemTemplate>
                <DataTemplate x:DataType="vm:ContinuePlayingItemViewModel">
                  <Button Classes="homeTile"
                          Command="{Binding Home.ResumeCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Continue where you left off">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Continue Playing"
                                  Command="{Binding Home.ResumeCommand}"
                                  CommandParameter="{Binding}">
                          <MenuItem.Icon><materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show Album"
                                  Command="{Binding Home.OpenAlbumCommand}"
                                  CommandParameter="{Binding Tile}">
                          <MenuItem.Icon><materialIcons:MaterialIcon Kind="Album" Width="16" Height="16" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove from Continue Playing"
                                  Command="{Binding Home.ForgetCommand}"
                                  CommandParameter="{Binding}">
                          <MenuItem.Icon><materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" /></MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <controls:AlbumCard Tile="{Binding Tile}"
                                        ShowsProgress="True"
                                        Progress="{Binding Progress}"
                                        Detail="{Binding Detail}" />
                  </Button>
                </DataTemplate>
              </controls:TileRowPanel.ItemTemplate>
            </controls:TileRowPanel>
          </DataTemplate>

          <DataTemplate DataType="vm:HomeAlbumRow">
            <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Tiles}" Margin="0,0,0,8">
              <controls:TileRowPanel.ItemTemplate>
                <DataTemplate x:DataType="mvm:AlbumTileViewModel">
                  <Button Classes="homeTile"
                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenAlbumCommand}"
                          CommandParameter="{Binding}">
                    <controls:AlbumCard Tile="{Binding}" />
                  </Button>
                </DataTemplate>
              </controls:TileRowPanel.ItemTemplate>
            </controls:TileRowPanel>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </controls:RecyclingItemsControl>
    </ScrollViewer>

    <StackPanel IsVisible="{Binding ShowsNothingYet}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="8" Opacity="0.6" MaxWidth="360">
      <materialIcons:MaterialIcon Kind="HomeOutline" Width="40" Height="40" />
      <TextBlock Text="Nothing here yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Albums you play and albums you add will show up here."
                 FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>

    <StackPanel IsVisible="{Binding ShowsNoMatches}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="8" Opacity="0.6" MaxWidth="360">
      <materialIcons:MaterialIcon Kind="Magnify" Width="40" Height="40" />
      <TextBlock Text="No matches" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Nothing on Home matches the filter."
                 FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
