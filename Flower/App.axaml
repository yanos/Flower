<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Flower.App"
             Name="Flower"
             RequestedThemeVariant="Default"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls">

    <!-- Defines just the native macOS app menu (the bold "Flower" title's own
         dropdown - About/Settings/Hide/Quit), replacing Avalonia's default
         "About Avalonia" item with our own. Deliberately separate from
         MainWindow's own NativeMenu.Menu (Controls/Playlist/View, the rest of
         the menu bar) - Application-level here only governs the app menu
         itself, not a whole extra top-level menu (that was the mistake in an
         earlier, reverted attempt). Plain Click handlers, not {Binding}
         Commands, so this has no DataContext-readiness dependency on when
         OnFrameworkInitializationCompleted actually runs - SettingsMenuItem_OnClick
         resolves MainViewModel from the DI container itself rather than
         relying on one being bound here. Gesture="Cmd+OemComma" makes this
         item itself the one and only owner of ⌘, - the OS resolves a native
         menu item's key equivalent before any key event reaches Avalonia's
         own input pipeline, so once this item existed at all, ⌘, stopped
         reaching MainView's own PreviewKeyDown tunnel regardless of whether
         a Gesture was set here - that manual case (see MainView.axaml.cs) is
         removed now that this is the sole handler. Avalonia auto-appends the
         standard separator + "Quit Flower" (⌘Q) after our items. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Flower" Click="AboutMenuItem_OnClick"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…" Gesture="Cmd+OemComma" Click="SettingsMenuItem_OnClick"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The design palette, light and dark (warm neutrals, and a
                     red accent for playback alone) - see Theme.axaml, the one file that holds
                     a colour value. Every control below reads its keys
                     instead of a raw hex colour, so the whole app repaints
                     from one palette. -->
                <ResourceInclude Source="avares://Flower/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The Songs note, on the phone's tab and in the desktop sidebar:
                 the placeholder art's two-stemmed note (AlbumArtPlaceholder's
                 ♫). Material's Music icon is that note with stubby stems, so
                 this is its geometry with the beam lifted 3 units - longer
                 stems, heads still round. It spans 19 by 21 units, and a Path
                 drawing it at Material's own scale is 19/24 and 21/24 of the
                 icon size it stands in for. -->
            <StreamGeometry x:Key="SongNoteGeometry">M21,0 V15.5 A3.5,3.5 0 0,1 17.5,19 A3.5,3.5 0 0,1 14,15.5 A3.5,3.5 0 0,1 17.5,12 C18.04,12 18.55,12.12 19,12.34 V3.47 L9,5.6 V17.5 A3.5,3.5 0 0,1 5.5,21 A3.5,3.5 0 0,1 2,17.5 A3.5,3.5 0 0,1 5.5,14 C6.04,14 6.55,14.12 7,14.34 V3 Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <!-- Required for AvaloniaEdit's TextEditor (see LogViewer) to render at
             all - without its own theme resources included here, the control
             has no default ControlTemplate and shows completely blank (no
             text, no caret) even though its Text property is set correctly
             underneath. -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <!-- Subtle rounded corners on every list selection highlight app-wide
             (sidebar, sub-list, Settings' library paths list, etc). The track
             list's own selection box is a hand-rolled control, not a
             ListBoxItem - see TrackRowControl.axaml for its matching radius. -->
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <!-- FluentTheme's own Window/TextBox default backgrounds aren't driven
             by the System*Color palette Theme.axaml overrides (confirmed by
             MainWindow and FilterControl's search box both still rendering
             near-black under that override alone) - applied directly here
             instead, app-wide in one place, rather than repeating a Background
             setter on every dialog Window (Settings, Track Info, About,
             Confirm, Playlist Conflict, Column Selector, Trusted Devices) and
             every TextBox (filter box, sidebar rename box, Settings' inputs). -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        </Style>
        <!-- Stated for anything that IS a TextBox rather than for TextBox
             exactly, so the app's own text box (Flower.Controls.TextInput -
             the same box with a clear button in it) is covered by this too
             rather than restating it. The outline that goes with it is not a
             style at all: Fluent draws a different one per state from inside
             its own ControlTheme, so it is set as the brushes that theme
             resolves - TextControlBorderBrush* in Theme.axaml. -->
        <Style Selector=":is(TextBox)">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- The other boxes a value is picked or typed in - a combo box, a
             number with its stepper - are the same field: its corners, its
             surface, its outline (ComboBoxBorderBrush, Theme.axaml). The
             stepper's box is a TextBox already and its arrows sit inside the
             same outline, so the corner is the one setting it needs. -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        </Style>
        <!-- A list inside a page that needs a frame of its own (Settings'
             library folders, removed songs, devices; the servers found): one
             rounded field, its rows on the surface - not Fluent's grey slab in
             a square hairline. -->
        <Style Selector="Border.listFrame">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.listFrame ListBox">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- While the platform's own field is laid over a box to be typed in
             (TextInput, NativeTextSession - the phones), the box's own words,
             caret and placeholder make way for the field's, so there is one
             copy on screen. Its background, border and clear button stay:
             the field draws on them. -->
        <Style Selector=":is(TextBox).nativeEditing /template/ TextPresenter#PART_TextPresenter, :is(TextBox).nativeEditing /template/ TextBlock#PART_Placeholder">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <!-- Compact tab headers app-wide (Settings, Track Info) - FluentTheme's
             own default TabItem is sized for a handful of wide tabs, not the
             several compact one-word ones these dialogs use. Was previously
             just TrackInfoWindow's own local Window.Styles override; moved
             here once Settings grew tabs too, so both stay in sync from one
             definition instead of two copies that could drift. -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Floating pills and round icon buttons, desktop and mobile both -
             see the file. -->
        <StyleInclude Source="avares://Flower/Styles/IconButtons.axaml"/>

        <!-- Every icon is drawn in the icon grey, rather than inheriting the
             text colour of whatever it sits in. The note Paths and the
             placeholder's ♫ glyph say the same thing themselves. An icon that
             carries a meaning of its own keeps its colour by setting it where
             it is declared: a server's standing in success or warning, the
             song playing, or a lit transport toggle in the text's ink.
             Set directly on the icon, so a disabled button's greyed foreground
             no longer reaches it; the disabled style below greys it again. -->
        <Style Selector="materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppIconBrush}"/>
        </Style>
        <!-- ...except where the icon is part of the app's frame, which is the
             frame's ink (AppChromeBrush, Theme.axaml): an icon in one of the
             ovals or rings (a round button, a pill, the ring round play), like
             the rim round it; every icon on a surface marked .chromeIcons (the
             song and album menus, Add to Playlist, the hamburger's card, the
             cover buttons in the phone's Info); and
             one marked .chrome itself (the "..." on a row, a drag handle,
             the stepper's minus and plus). An oval holding an icon and its
             words (Shuffle, New Playlist) holds them in a StackPanel, one step
             further down. Oval icons by child selectors, so a menu card a button drops - its logical
             child - answers to its own marking. The download button marks
             its own glyphs .chrome, in an oval or not. A delete's icon is
             the frame's too; its words say danger (AppDangerBrush).
             After the grey so it wins over it; before the disabled grey and
             the hover and pressed ink below, so they still win over it. -->
        <Style Selector="Border.floating > Button.pill > materialIcons|MaterialIcon, Border.floating > materialIcons|MaterialIcon, Border.floating > StackPanel > materialIcons|MaterialIcon, Border.ring > materialIcons|MaterialIcon, :is(Control).chromeIcons materialIcons|MaterialIcon, materialIcons|MaterialIcon.chrome">
            <Setter Property="Foreground" Value="{DynamicResource AppChromeBrush}"/>
        </Style>
        <Style Selector="materialIcons|MaterialIcon:disabled">
            <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
        </Style>
        <!-- The missing-cover note (AlbumArtPlaceholder): muted, on the
             placeholder's grey. A style rather than a local value, so the rows
             and tiles that dim what cannot be played can grey it along with
             their icons. -->
        <Style Selector="TextBlock.placeholderGlyph">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>
        <!-- A page's name, where it heads the page: the phone's screens
             (ScreenTitle) and the desktop's lists (MainView's page header).
             The display serif in the frame's ink, like a playlist's name; the
             serif is what a heading is in this app, Geist what everything
             under it is. Each sets its own size. -->
        <!-- A desktop page's name, at the head of the page: the display
             serif's large cut, set tight. -->
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="56"/>
            <Setter Property="LineHeight" Value="56"/>
            <Setter Property="LetterSpacing" Value="-1.1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- A heading inside a desktop page - an album card's name, a Home
             shelf's - in the display serif's text cut, which is drawn for
             these smaller sizes. -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontFamily" Value="{DynamicResource AppDisplayTextFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- A TabControl whose tabs are one segmented control over the page:
             the settings screen's. The picked tab is a raised chip of the
             surface colour with its name in bold ink, the others in the
             value colour on the tint - Track Info's tabs, for a TabControl.
             Its own templates, so Fluent's pipe under the selected tab is
             not drawn. -->
        <Style Selector="TabControl.segmented">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AppHoverBrush}"
                                CornerRadius="10"
                                Padding="3">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Border>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.segmented > TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextValueBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chip"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.segmented > TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TabControl.segmented > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabControl.segmented > TabItem:selected /template/ Border#Chip">
            <Setter Property="BoxShadow" Value="{DynamicResource AppButtonShadow}"/>
        </Style>
        <!-- The desktop's A-Z strip (the Albums grid, the Artists column):
             muted letters, the one under the pointer on the selected tint. -->
        <Style Selector="controls|ScrollIndexBar.desktop">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="ActiveBackground" Value="{DynamicResource AppSelectedBrush}"/>
            <Setter Property="BubbleBackground" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BubbleForeground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.screenTitle">
            <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppChromeBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- The equalizer's sliders: not playback, so the slider colour rather
             than the accent the seek bar and volume are filled with
             (SliderTrackValueFill, Theme.axaml). -->
        <Style Selector="Slider.control">
            <Setter Property="Foreground" Value="{DynamicResource AppControlSliderBrush}"/>
            <Style.Resources>
                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource PaletteControlSlider}"/>
                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource PaletteControlSlider}"/>
                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource PaletteControlSlider}"/>
                <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource PaletteControlSlider}"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource PaletteControlSlider}"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource PaletteControlSlider}"/>
            </Style.Resources>
        </Style>
        <!-- The thumb finds the colour its theme names through a lookup that
             misses the resources above, so it is restated on the part. -->
        <Style Selector="Slider.control /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource AppControlSliderBrush}"/>
        </Style>
        <!-- An icon on a button pointed at or pressed turns to the ink,
             whatever colour it rests in. Last in this list so it outranks
             every icon colour above it; a view that colours its own icons
             nearer than this states its own pressed colour beside them (the
             tab bar, the player's shuffle and repeat, Now Playing). -->
        <Style Selector=":is(Button):pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppIconHoverBrush}"/>
        </Style>
        <Style Selector=":is(Button):pressed materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppIconPressedBrush}"/>
        </Style>
    </Application.Styles>
</Application>
