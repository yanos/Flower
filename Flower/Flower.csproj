<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- CompositionRootTests builds the real container out of
         App.RegisterServices, which is not something any head should call. -->
    <InternalsVisibleTo Include="Flower.Tests" />
    <InternalsVisibleTo Include="Flower.Tests.UI" />
    <InternalsVisibleTo Include="Flower.Tests.Decoding" />
    <InternalsVisibleTo Include="Flower.Tests.macOS" />
    <InternalsVisibleTo Include="Flower.Tests.Windows" />
    <InternalsVisibleTo Include="Flower.Tests.iOS.Suite" />
    <!-- OutputStageHarness drives NativeAudioBridge directly, for the output
         stage's tests and the phone runners' checks of it. -->
    <InternalsVisibleTo Include="Flower.Tests.Decoding.Scenarios" />
  </ItemGroup>

  
  <ItemGroup>
    <ProjectReference Include="..\Flower.Core\Flower.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Every head renders with Skia already; this is for BackdropBlur, which
         draws with it directly. -->
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Miniaudio-CS" />
    <PackageReference Include="plist-cil" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="TagLibSharp" />
    <!-- MprisNowPlaying, Linux's media keys. Avalonia's FreeDesktop backend
         already brings this version to the desktop heads; named here because
         the shared library uses it directly. -->
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <!-- The decoder, and its native payload for the desktop building this. The
       payload is runtimes/<rid>/native/, which the SDK copies beside every
       binary downstream (and the macOS head bundles into MonoBundle), so it
       reaches the desktop heads and the tests alike. Chosen by host because
       the package set is fixed here, where no RuntimeIdentifier is known yet.
       The phone heads bring their own payloads; this one lands nowhere there. -->
  <ItemGroup>
    <PackageReference Include="FFAudio.NET" />
    <PackageReference Include="FFAudio.NET.macOS" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="FFAudio.NET.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="FFAudio.NET.Windows" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
</Project>
