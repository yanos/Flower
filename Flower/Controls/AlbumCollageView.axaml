<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             x:Class="Flower.Controls.AlbumCollageView"
             x:Name="Root">

  <!-- AlbumArtView's frame around several covers instead of one - see
       AlbumCollageSurface for how they are laid out. The note placeholder
       shows until there is at least one cover to draw, and stays for an
       artist none of whose albums has art. -->
  <Border Background="Transparent"
          BorderBrush="{DynamicResource AppBorderBrush}"
          BorderThickness="1"
          CornerRadius="4">
    <Border Background="Transparent"
            CornerRadius="3"
            ClipToBounds="True">
      <Panel>
        <controls:AlbumArtPlaceholder HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       IsVisible="{Binding !#Surface.HasArt}"/>
        <controls:AlbumCollageSurface x:Name="Surface"
                                       Covers="{Binding #Root.Covers}"/>
      </Panel>
    </Border>
  </Border>
</UserControl>
