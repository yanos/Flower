<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Controls.NewPlaylistEntry"
             x:DataType="vm:MobileMainViewModel"
             x:Name="Root">

  <!-- Making a playlist on a phone, in the two places it can be done: at the
       top of the Playlists tab, and at the top of the add-to-playlist sheet.
       One control, so the two are one flow rather than two that drift - the
       sheet only differs by the padding its own rows use (RowPadding).

       Two states in the same place. At rest, a pill holding a plus and the
       words "New Playlist". Tapped, that row is replaced in place by a playlist row
       whose name is an empty box, focused, reading "Playlist Name" until
       something is typed - so the new entry appears at the top of the list
       before it exists. Nothing is created until a name is committed, and an
       empty one creates nothing at all: see MobileMainViewModel's
       BeginCreatePlaylistCommand/CommitNewPlaylistCommand, and the
       code-behind for what commits it. -->
  <!-- Sizes live here rather than on the elements, so .large can change them
       (a local value would outrank any style). -->
  <UserControl.Styles>
    <Style Selector="StackPanel.startRow">
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="Border.plusPill">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="8,0,14,0" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.plusGlyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="TextBlock.startLabel">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="TextBox.nameBox">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Grid.editorRow">
      <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <Style Selector="Border.editorSlot">
      <Setter Property="Width" Value="22" />
    </Style>

    <!-- The Playlists tab's: the pill as tall as every other oval on the
         phone, and the box's glyph centred in a slot as wide as a cover, so a
         name being typed sits where the rows below have theirs. -->
    <Style Selector="Panel.large StackPanel.startRow">
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Panel.large Border.plusPill">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="12,0,18,0" />
    </Style>
    <Style Selector="Panel.large materialIcons|MaterialIcon.plusGlyph">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Panel.large TextBlock.startLabel">
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style Selector="Panel.large TextBox.nameBox">
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style Selector="Panel.large Grid.editorRow">
      <Setter Property="ColumnSpacing" Value="14" />
    </Style>
    <Style Selector="Panel.large Border.editorSlot">
      <Setter Property="Width" Value="64" />
    </Style>
  </UserControl.Styles>

  <Panel Classes.large="{Binding #Root.IsLarge}">
    <Button x:Name="StartButton"
            Classes="pickerRow"
            Padding="{Binding #Root.RowPadding}"
            IsVisible="{Binding !IsNamingNewPlaylist}"
            Command="{Binding BeginCreatePlaylistCommand}">
      <!-- The app's own oval - the floating one every round thing on the
           phone is (Styles/IconButtons.axaml) - around the plus and the
           words both, so the whole of what is tapped reads as one button
           rather than a circle with a caption beside it. -->
      <Border Classes="floating plusPill" HorizontalAlignment="Left">
        <StackPanel Classes="startRow" Orientation="Horizontal">
          <materialIcons:MaterialIcon Classes="plusGlyph" Kind="Plus" VerticalAlignment="Center" />
          <TextBlock Classes="startLabel" Text="New Playlist" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Button>

    <!-- Lined up with the rows under it: the same glyph in the same place, so
         the box sits exactly where the name it is about to have will. -->
    <Grid x:Name="EditorRow"
          Classes="editorRow"
          ColumnDefinitions="Auto,*"
          Margin="{Binding #Root.RowPadding}"
          IsVisible="{Binding IsNamingNewPlaylist}">
      <Border Grid.Column="0" Classes="editorSlot">
        <materialIcons:MaterialIcon Kind="PlaylistPlay" Width="22" Height="22"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <!-- PropertyChanged rather than a TextBox's own default of LostFocus:
           the box is dismissed by losing focus, and on that default it wrote
           its text back into the ViewModel on the way out - which put a
           cancelled name back after Cancel had cleared it, and a just-used one
           back after Enter had already made the playlist. Two playlists, one
           of them from an Escape. -->
      <controls:TextInput Grid.Column="1"
                          x:Name="NameBox"
                          Classes="nameBox"
                          Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="Playlist Name"
                          VerticalAlignment="Center"
                          KeyDown="NameBox_KeyDown"
                          LostFocus="NameBox_LostFocus" />
    </Grid>
  </Panel>
</UserControl>
