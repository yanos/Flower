<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:converters="clr-namespace:Flower.Converters"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Controls.AlbumTrackList"
             x:DataType="vm:AlbumTracksViewModel"
             x:CompileBindings="True"
             x:Name="Root"
             Focusable="True">

  <!-- One album's songs as a short list of their own, numbered: the Albums
       grid's expanded album (AlbumGridRowControl),
       an album card on the Artists page (MainView), and - unnumbered, each
       with its artist and album - the songs the Search page found. A click
       selects, Ctrl/Cmd and Shift extend, the arrows move, Enter or a
       double-click plays the album from that song, and a right-click - or
       the row's "..." - opens the song menu. The state is the DataContext's
       (AlbumTracksViewModel). -->
  <UserControl.Resources>
    <converters:DurationConverter x:Key="DurationConverter"/>

    <DataTemplate x:Key="TrackRowTemplate" x:DataType="vm:ExpandedTrackRowViewModel">
      <!-- The colored highlight is the tinted Border inside the Panel below -
           and CRUCIALLY its size is driven by the Panel, which measures to the
           text Grid, so to make the box bigger than the text the Grid gets an
           inner Margin (grows the Panel -> grows the highlights filling it).
           No gap between one row's box and the next: lit rows that touch
           square the corners between them (Border.highlight below), so a run
           of them reads as one shape. This outer Border stays Background="Transparent" with no padding of
           its own so the entire row - including that margin gap - still
           hit-tests for clicks (an unpainted Border doesn't register pointer
           events in Avalonia), and carries the click/hover/context handlers. -->
      <Border Classes="expandedTrack" Background="Transparent"
              PointerEntered="TrackRow_PointerEntered"
              PointerExited="TrackRow_PointerExited"
              PointerPressed="TrackRow_PointerPressed"
              DoubleTapped="TrackRow_DoubleTapped"
              ContextRequested="TrackRow_ContextRequested">
        <Panel>
          <Border Classes="highlight"
                  Classes.joinAbove="{Binding JoinsAbove}"
                  Classes.joinBelow="{Binding JoinsBelow}"
                  IsVisible="{Binding IsHovered}"
                  IsHitTestVisible="False"
                  Background="{DynamicResource AppHoverBrush}"/>
          <Border Classes="highlight"
                  Classes.joinAbove="{Binding JoinsAbove}"
                  Classes.joinBelow="{Binding JoinsBelow}"
                  IsVisible="{Binding IsSelected}"
                  IsHitTestVisible="False"
                  Background="{DynamicResource AppSelectedBrush}"/>
          <!-- The currently-playing song is bold, the way the main track
               list marks it (TrackRowControl's own .playing style). The
               download button trails the title, as there: the title's star
               column keeps every icon at the same x, and a row with nothing
               to fetch gives the title that room back. -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="8,14,4,14"
                Classes.dimmedTrack="{Binding IsUnavailable}"
                Classes.playingTrack="{Binding IsCurrentlyPlaying}">
            <TextBlock Grid.Column="0"
                       Text="{Binding Track.TrackNumber}"
                       IsVisible="{Binding #Root.ShowsNumbers}"
                       MinWidth="26"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <!-- Under the title, whose it is - the Search page's songs, which
                 are from every album rather than one. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="trackTitle" Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" FontSize="14"/>
              <TextBlock Text="{Binding ArtistAndAlbumText}"
                         IsVisible="{Binding #Root.ShowsArtist}"
                         TextTrimming="CharacterEllipsis"
                         FontSize="12"
                         Margin="0,1,0,0"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
            <controls:TrackDownloadButton Grid.Column="2" Margin="8,0,0,0"
                                          DownloadRequested="TrackRow_DownloadRequested"/>
            <TextBlock Grid.Column="3" Text="{Binding Track.Duration, Converter={StaticResource DurationConverter}}"
                       Classes="trackTime"
                       FontSize="14" Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
            <!-- The song menu, for anyone who does not know to right-click -
                 the phone's rows end in the same "..." (TrackRowTemplate). -->
            <Button Grid.Column="4" Classes="pill" Padding="4" Margin="6,-6,0,-6"
                    ToolTip.Tip="More"
                    Click="TrackRow_MenuClick">
              <materialIcons:MaterialIcon Kind="DotsVertical" Width="18" Height="18"
                                          Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </Button>
          </Grid>
        </Panel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The hover and selection backgrounds, squared where the lit row above
         or below touches this one (ExpandedTrackRowViewModel.JoinsAbove/
         JoinsBelow) - both alike, since whichever is on top is the one that
         shows. In this order, so a row joined both ways takes the last. -->
    <Style Selector="Border.highlight">
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.highlight.joinAbove">
      <Setter Property="CornerRadius" Value="0,0,10,10"/>
    </Style>
    <Style Selector="Border.highlight.joinBelow">
      <Setter Property="CornerRadius" Value="10,10,0,0"/>
    </Style>
    <Style Selector="Border.highlight.joinAbove.joinBelow">
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- A song that can't be played right now - not downloaded, and no
         reachable server to stream it from. Same 0.5 dim as the main track
         list's own unavailable rows (TrackRowControl) and mobile's
         (Button.trackRow.placeholder); applied to the text Grid rather than
         the row Border so the hover/selection highlights behind it stay at
         full strength. -->
    <Style Selector="Grid.dimmedTrack">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Grey, not the faded red dimming alone would leave them. -->
    <Style Selector="Grid.dimmedTrack materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <Style Selector="Grid.dimmedTrack TextBlock.placeholderGlyph">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <!-- Set here rather than on the elements, so the playing style below
         - a style too - can outrank them. -->
    <Style Selector="TextBlock.trackTitle">
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.trackTime">
      <Setter Property="Foreground" Value="{DynamicResource AppTextValueBrush}"/>
    </Style>
    <!-- Bold and nothing else, like every other track list: the accent is
         the app's colour for things to press, not for the song playing. -->
    <Style Selector="Grid.playingTrack TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Grid.playingTrack controls|TrackDownloadButton">
      <Setter Property="IsBold" Value="True"/>
    </Style>
  </UserControl.Styles>

  <ItemsControl ItemsSource="{Binding TrackRows}"
                ItemTemplate="{StaticResource TrackRowTemplate}"/>
</UserControl>
