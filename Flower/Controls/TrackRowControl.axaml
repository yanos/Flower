<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:controls="clr-namespace:Flower.Controls"
             x:Class="Flower.Controls.TrackRowControl"
             Background="Transparent"
             ClipToBounds="False"
             Height="34">

  <!-- Nothing in here is bound to the row: what the song decides - its
       cells, the classes below, the art - is set from the code-behind (see
       ModelWatch), since MusicListPanel hands each row song after song as the
       list scrolls. -->

  <UserControl.Styles>
    <!-- "controls|TrackRowControl", the row's own type, in every selector
         here. Not "UserControl": a bare type selector matches that exact type
         and nothing derived from it, so written that way these matched
         nothing. Nor "controls|TrackRowControl": that matches every UserControl above
         the row too, MainView among them, so with the pointer anywhere in the
         window every row took the hover grey. -->
    <!-- Hidden by these styles rather than by the elements themselves: an
         IsVisible set on the element is a local value, which outranks every
         style, so the two below that show them could never have. -->
    <Style Selector="Border#HoverBorder, Border#PlayingBorder">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Hover highlight restricted to the data columns — art column is excluded -->
    <Style Selector="controls|TrackRowControl:pointerover Border#HoverBorder">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Dimmed: a not-yet-downloaded track with nobody to stream it from
         right now (see TrackRowViewModel.IsUnavailable), and separately the
         album art beside it, which follows its whole album run rather than
         this one row (IsAlbumGroupUnavailable). Same 0.5 as mobile's own
         Button.trackRow.placeholder, so an unavailable song reads the same on
         every client. Applied to the content, not the row itself, so the
         selection/hover backgrounds behind it stay at full strength. -->
    <Style Selector="StackPanel#CellsPanel.dimmed, Panel#ArtCell.dimmed">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Grey, not the faded red dimming alone would leave them. -->
    <Style Selector="StackPanel#CellsPanel.dimmed materialIcons|MaterialIcon, Panel#ArtCell.dimmed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <Style Selector="StackPanel#CellsPanel.dimmed TextBlock.placeholderGlyph, Panel#ArtCell.dimmed TextBlock.placeholderGlyph">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <!-- The currently playing song. This was a "▶" glyph in a 14px well ahead
         of the title, which cost every row that width to mark one of them, and
         put the mark in the Title column - out of sight for anyone who scrolls
         it away. Weight is the whole row and costs no layout: the row's height
         is fixed (28 above) and the cells are ColumnManager's own widths, so
         bold text reflows nothing, it only inks the same boxes darker. Matches
         mobile, which has said "playing" this way all along (see
         MobileMainView.axaml's Button.trackRow.playing). Held down by
         TrackRowPlayingTests, which reads the rendered weight rather than the
         class: the class was set correctly the whole time this style was not
         matching anything. -->
    <Style Selector="controls|TrackRowControl.playing StackPanel#CellsPanel controls|RowText">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!-- A Queue row above the song playing (TrackRowViewModel.IsPlayed):
         faded, lighter than an unavailable song, since it plays fine. -->
    <Style Selector="controls|TrackRowControl.played StackPanel#CellsPanel, controls|TrackRowControl.played Panel#ArtCell">
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <!-- ...and sits in a grey wash of its own. -->
    <Style Selector="controls|TrackRowControl.playing Border#PlayingBorder">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </UserControl.Styles>

  <!-- The first column is the album-art well; its width is set from
       ColumnManager.ArtColumnWidth in BuildCells (0 when the art is turned
       off) rather than fixed here, and the art cell's own visibility with
       it. -->
  <Grid x:Name="RowGrid" ColumnDefinitions="80,*">
    <!-- No rule between one song and the next: each row is its own
         rounded shape when it has one - playing, pointed at or picked - and
         the page otherwise. All three from the cells on, not under the art,
         so the covers read as a column. Playing is the hover grey, so a
         picked row still stands out from it. -->
    <Border Grid.Column="1"
            x:Name="PlayingBorder"
            Background="{DynamicResource AppHoverBrush}"
            CornerRadius="8"
            IsHitTestVisible="False"/>
    <!-- Hover background (column 1 only — stops before the art) -->
    <Border Grid.Column="1"
            x:Name="HoverBorder"
            Background="{DynamicResource AppHoverBrush}"
            CornerRadius="8"
            IsHitTestVisible="False"/>
    <!-- Selection background (column 1 only), the selected tint the sidebar
         and the album grid pick with. -->
    <Border Grid.Column="1"
            x:Name="SelectionBorder"
            Background="{DynamicResource AppSelectedBrush}"
            CornerRadius="8"
            IsVisible="False"
            IsHitTestVisible="False"/>

    <!-- ── Art cell (first track of album group only) ─────────────────────── -->
    <!-- ClipToBounds="False" lets the image overflow downward into subsequent rows of the same group. -->
    <!-- VerticalAlignment="Top" on Image ensures overflow goes downward, not upward. -->
    <Panel Grid.Column="0"
           x:Name="ArtCell"
           Margin="2,2,2,0"
           ClipToBounds="False">

      <!-- Album art (or placeholder), always ArtMaxSize - spans multiple rows visually. A run too
           short to hold it is padded with phantom rows by MusicListPanel (MinAlbumGroupRows).
           Handed its art by the code-behind (Show), and only where the well shows: reading
           TrackRowViewModel.AlbumArt is what starts the load, which for a synced library is a
           network fetch, and a hidden well should not be fetching covers nobody can see. -->
      <controls:AlbumArtView x:Name="ArtImage"
              IsHitTestVisible="False"
              Width="{x:Static vm:TrackRowViewModel.ArtMaxSize}"
              Height="{x:Static vm:TrackRowViewModel.ArtMaxSize}"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"/>
    </Panel>

    <!-- ── Data cells (built in code-behind from ColumnManager) ──────────── -->
    <StackPanel x:Name="CellsPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Stretch"/>
  </Grid>

</UserControl>
