<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:controls="clr-namespace:Flower.Controls"
             x:Class="Flower.Controls.TrackRowControl"
             x:DataType="vm:TrackRowViewModel"
             x:CompileBindings="True"
             Background="Transparent"
             ClipToBounds="False"
             Classes.playing="{Binding IsCurrentlyPlaying}"
             Height="28">

  <UserControl.Styles>
    <!-- ":is(UserControl)", not "UserControl", in every selector here: a bare
         type selector matches that exact type and nothing derived from it, and
         the root of this file is a TrackRowControl. Written the plain way, both
         of the styles below silently matched nothing - the hover highlight
         never appeared, and neither did the bolding when it was added. -->
    <!-- Hover highlight restricted to the data columns — art column is excluded -->
    <Style Selector=":is(UserControl):pointerover Border#HoverBorder">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Dimmed: a not-yet-downloaded track with nobody to stream it from
         right now (see TrackRowViewModel.IsUnavailable), and separately the
         album art beside it, which follows its whole album run rather than
         this one row (IsAlbumGroupUnavailable). Same 0.5 as mobile's own
         Button.trackRow.placeholder, so an unavailable song reads the same on
         every client. Applied to the content, not the row itself, so the
         selection/hover backgrounds behind it stay at full strength. -->
    <Style Selector="StackPanel#CellsPanel.dimmed, Panel#ArtCell.dimmed">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Grey, not the faded red dimming alone would leave them. -->
    <Style Selector="StackPanel#CellsPanel.dimmed materialIcons|MaterialIcon, Panel#ArtCell.dimmed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <Style Selector="StackPanel#CellsPanel.dimmed TextBlock.placeholderGlyph, Panel#ArtCell.dimmed TextBlock.placeholderGlyph">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}"/>
    </Style>
    <!-- The currently playing song. This was a "▶" glyph in a 14px well ahead
         of the title, which cost every row that width to mark one of them, and
         put the mark in the Title column - out of sight for anyone who scrolls
         it away. Weight is the whole row and costs no layout: the row's height
         is fixed (28 above) and the cells are ColumnManager's own widths, so
         bold text reflows nothing, it only inks the same boxes darker. Matches
         mobile, which has said "playing" this way all along (see
         MobileMainView.axaml's Button.trackRow.playing). Held down by
         TrackRowPlayingTests, which reads the rendered weight rather than the
         class: the class was set correctly the whole time this style was not
         matching anything. -->
    <Style Selector=":is(UserControl).playing StackPanel#CellsPanel TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </UserControl.Styles>

  <!-- The first column is the album-art well; its width is set from
       ColumnManager.ArtColumnWidth in BuildCells (0 when the art is turned
       off) rather than fixed here, and the art cell's own visibility with
       it. -->
  <Grid x:Name="RowGrid" ColumnDefinitions="80,*">
    <!-- Hover background (column 1 only — stops before the art) -->
    <Border Grid.Column="1"
            x:Name="HoverBorder"
            Background="{DynamicResource SystemControlHighlightListLowBrush}"
            IsVisible="False"
            IsHitTestVisible="False"/>
    <!-- Selection background (column 1 only). Matches the sidebar's playlist
         drop-target highlight (see MainView.axaml's IsDropTarget Border) rather
         than the theme's own accent-tinted selection brush, which renders too
         dark for this app's unchanged-on-selection row text. -->
    <Border Grid.Column="1"
            Background="{DynamicResource AppAccentBrush}"
            Opacity="0.25"
            CornerRadius="4"
            IsVisible="{Binding IsSelected}"
            IsHitTestVisible="False"/>

    <!-- ── Art cell (first track of album group only) ─────────────────────── -->
    <!-- ClipToBounds="False" lets the image overflow downward into subsequent rows of the same group. -->
    <!-- VerticalAlignment="Top" on Image ensures overflow goes downward, not upward. -->
    <Panel Grid.Column="0"
           x:Name="ArtCell"
           Classes.dimmed="{Binding IsAlbumGroupUnavailable}"
           Margin="2,2,2,0"
           ClipToBounds="False">

      <!-- Album art (or placeholder), always ArtMaxSize - spans multiple rows visually. A run too
           short to hold it is padded with phantom rows by MusicListPanel (MinAlbumGroupRows).
           The AlbumArt binding itself is made in code-behind (ApplyArtWell), not here:
           reading that property is what starts the load, which for a synced library is a
           network fetch, and a hidden well should not be fetching covers nobody can see. -->
      <controls:AlbumArtView x:Name="ArtImage"
              IsHitTestVisible="False"
              Width="{x:Static vm:TrackRowViewModel.ArtMaxSize}"
              Height="{x:Static vm:TrackRowViewModel.ArtMaxSize}"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"/>
    </Panel>

    <!-- ── Data cells (built in code-behind from ColumnManager) ──────────── -->
    <StackPanel x:Name="CellsPanel"
                Grid.Column="1"
                Classes.dimmed="{Binding IsUnavailable}"
                Orientation="Horizontal"
                VerticalAlignment="Stretch"/>
  </Grid>

</UserControl>
