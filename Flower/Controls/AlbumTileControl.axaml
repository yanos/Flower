<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             x:Class="Flower.Controls.AlbumTileControl"
             Background="Transparent">

  <!-- What the tile decides - which album, selected, expanded - is set from
       the code-behind rather than bound (see ModelWatch): the grid hands each
       tile album after album as it scrolls. -->
  <!-- Selection/hover are plain overlay Borders, same pattern as
       TrackRowControl's HoverBorder - pointer/selection handling itself
       lives one level up, in AlbumGridPanel (mirrors MusicListPanel /
       MusicListView.axaml.cs's Panel_PointerPressed), not here. -->
  <UserControl.Styles>
    <!-- "AlbumTileControl", not ":is(UserControl)": the AlbumCard inside is a
         UserControl too, and a pointer over it would otherwise match. -->
    <!-- Hidden by a style rather than on the element, whose own IsVisible
         would be a local value outranking the one below. -->
    <Style Selector="Border#HoverBorder">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="controls|AlbumTileControl:pointerover Border#HoverBorder">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <Border x:Name="SelectionBorder"
            IsVisible="False"
            Background="{DynamicResource AppSelectedBrush}"
            CornerRadius="14"/>
    <Border x:Name="HoverBorder"
            Background="{DynamicResource AppHoverBrush}"
            CornerRadius="14"/>
    <!-- The album's tile, the phone's own (AlbumCard) with the desktop's
         captions: its "..." raises AlbumCard.MenuRequested, which MainView
         answers with the same menu a right-click on the tile opens.
         Downloading the album is in that menu. Opened, the tile takes the
         selected tint (Show), which is what points at the album card below. -->
    <controls:AlbumCard x:Name="TileContent"
                        Classes="desktop"
                        Margin="8"/>
  </Panel>
</UserControl>
