<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Flower.Controls.ScreenSlot"
             x:DataType="vm:MobileMainViewModel"
             x:Name="Root"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Wraps one materialized screen control together with that screen's own
       header (back and menu buttons, and the oval between them), so
       ScreenStackPanel's existing swipe transform - applied to this whole
       control - carries the header along with the screen content instead of
       leaving it behind in a static bar. Frame is reassigned wholesale on
       every sync (see ScreenStackPanel.SyncToCurrentFrame), the same
       StyledProperty-replaced-wholesale shape TrackListScreenView's own
       DisplayRows/DisplayHeader already use - see that class's own doc
       comment for why this works correctly even for a kept-alive
       back/forward preview.

       The band is the 52px first row, which HeaderHeight in the code-behind
       says to the code that needs it - the two cannot move apart.

       The header has no background: the screen runs up under it, so a list
       scrolls on behind the title rather than vanishing at the band's edge.
       At rest nothing sits there, because every screen's scroller starts its
       content below the band - ScreenScrollInset, in MobileMainView.axaml.
       The filter oval (and Search's box, which is the same oval) sits in the
       band too, so opening it moves nothing below. -->

  <UserControl.Styles>
    <!-- The filter oval's icons are the frame's colour like every oval's
         (App.axaml), which reaches only an oval's direct children - these
         sit a Grid further in - and the pressed accent under a finger as
         every icon is. Before the .onArt styles below, which win over
         these. -->
    <Style Selector="Border#FilterOval materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppChromeBrush}" />
    </Style>
    <Style Selector="Border#FilterOval Button.pill:pressed > materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentPressedBrush}" />
    </Style>

    <!-- Over an album, whose page is washed in its cover's colour
         (TrackListScreenView), the back and menu circles and the filter oval
         between them are ringed and drawn in white like Now Playing's (its
         TopBar styles), dimming while pressed. Their fill is the page itself:
         exactly what the page draws where each one sits, so it looks see-
         through while hiding the songs that scroll up under it (FillPills in
         the code-behind, which outranks the Transparent here once it has the
         page to draw). The icons by child selectors, as there: the menu's
         card is the menu button's logical child too, and its entries keep
         their own colours. -->
    <Style Selector="Grid#HeaderBand.onArt Border#BackPill, Grid#HeaderBand.onArt Border#MenuPill, Grid#HeaderBand.onArt Border#FilterOval">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#HeaderBand.onArt Border#BackPill > Button.pill > materialIcons|MaterialIcon, Grid#HeaderBand.onArt Border#MenuPill > Button.pill > materialIcons|MaterialIcon, Grid#HeaderBand.onArt Border#FilterOval materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
    </Style>
    <Style Selector="Grid#HeaderBand.onArt Border#BackPill > Button.pill:pressed > materialIcons|MaterialIcon, Grid#HeaderBand.onArt Border#MenuPill > Button.pill:pressed > materialIcons|MaterialIcon, Grid#HeaderBand.onArt Border#FilterOval Button.pill:pressed > materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtRingBrush}" />
    </Style>
    <!-- What is typed, white too, and the hint before it at the faint white
         Now Playing uses for what is off. On the box and on its template's
         placeholder both, since Fluent colours that part directly in some
         states. -->
    <Style Selector="Grid#HeaderBand.onArt Border#FilterOval TextBox">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AppOnArtBrush}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource AppOnArtMutedBrush}" />
    </Style>
    <Style Selector="Grid#HeaderBand.onArt Border#FilterOval TextBox /template/ TextBlock#PART_Placeholder">
      <Setter Property="Foreground" Value="{DynamicResource AppOnArtMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- The screen fills the whole slot, which on a phone runs up under the
       status bar (MobileMainView pulls the stack up behind it), so a list
       scrolls on past the header and under the clock rather than stopping at
       a strip of background. Everything drawn over it - the header band and
       the recent-searches dropdown - is pushed back down by the status bar's
       height (StatusBarInset), so none of it sits under the clock itself. -->
  <Panel>
  <ContentControl x:Name="ContentHost" />

  <!-- The header band's blur: what the screen is showing under the status
       bar and the back and menu buttons, blurred where it is (BackdropBlur)
       and faded out down the band (AppHeaderBlurMask) - so a list scrolled
       up under the header loses its detail gradually, and is soft behind the
       buttons and the clock. As tall as the status bar and the band, plus the
       fade's own length below them (HeaderBlurHeight, from MobileMainView);
       and not hit-testable, so everything it covers still takes touches. -->
  <controls:BackdropBlur VerticalAlignment="Top"
                         Height="{DynamicResource HeaderBlurHeight}"
                         IsHitTestVisible="False"
                         Radius="18"
                         Mask="{DynamicResource AppHeaderBlurMask}" />

  <Grid RowDefinitions="52,*" Margin="{DynamicResource StatusBarInset}">

    <!-- No title in the band: it is the first line of the screen's own
         scroller, under the back button, and moves with the list
         (ScreenTitle). -->

    <!-- The back and menu buttons, in this slot's own header band so they
         go wherever the screen goes: a screen sliding in brings its back
         button with it, and a swipe back takes it away and uncovers the one
         underneath with its own. Whether there is a back button is the slot's
         to say (ShowsBackButton, from ScreenStackPanel), since the screen kept
         behind for a swipe has its own answer to that, not the live one.
         No Background, so its empty middle column doesn't intercept the swipe
         gesture underneath it (Avalonia doesn't hit-test an unpainted
         Panel/Grid's empty area). Both are a 40px circle, centred on 26 by
         the 52px row itself.
         NowPlayingView's top bar draws its own chevron, a down one - Track
         Info's, which this one is turned a quarter round from - in this same
         place. -->
    <Grid x:Name="HeaderBand"
          Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto"
          Margin="12,0,12,0"
          Classes.onArt="{Binding #Root.Frame.IsAlbumTrackList, FallbackValue=False}">
      <Border x:Name="BackPill"
              Grid.Column="0"
              Classes="floating"
              Width="40"
              IsVisible="{Binding #Root.ShowsBackButton}">
        <Button Classes="pill"
                Click="BackButton_Click"
                HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="ChevronLeft" Width="22" Height="22" />
        </Button>
      </Border>

      <!-- The screen's filter, pulled down from the top of its list (see
           RubberBandScroll.PulledDownEvent and MobileMainViewModel's
           "Pull-down filter"), between the back and menu buttons and as
           tall as they are. Part of the slot rather than fixed over the
           stack, so it slides with its screen: a screen being left keeps its
           oval until the next one has slid over it, and Back brings a
           filtered screen in with its oval on. The pull itself fades it in
           (RubberBandScroll.PullingDownEvent - see ShowFilter), fully there
           at the point letting go would open it. It stays until its x is
           tapped, which is also what turns the filtering off. Visibility,
           opacity and hit-testing are the code-behind's. -->
      <Border x:Name="FilterOval"
              Grid.Column="1"
              Classes="floating"
              Height="40"
              Margin="10,0"
              CornerRadius="20"
              Padding="14,0,2,0">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <materialIcons:MaterialIcon Grid.Column="0"
                                      Kind="FilterVariant"
                                      IsVisible="{Binding #Root.IsFilterShown}"
                                      Width="18" Height="18"
                                      Opacity="0.6"
                                      VerticalAlignment="Center" />
          <materialIcons:MaterialIcon Grid.Column="0"
                                      Kind="Magnify"
                                      IsVisible="{Binding #Root.Frame.IsSearchScreen, FallbackValue=False}"
                                      Width="20" Height="20"
                                      Opacity="0.6"
                                      VerticalAlignment="Center" />
          <!-- No clear button of its own: the x at the end is the one way
               out, and a second x beside it would be two for one job. Its
               text is written from the code-behind rather than bound, so a
               screen kept alive for a swipe shows the filter it was left with
               rather than the live one. -->
          <controls:TextInput x:Name="FilterBox"
                              Grid.Column="1"
                              Classes="inOval"
                              IsVisible="{Binding #Root.IsFilterShown}"
                              ShowsClearButton="False"
                              TextChanged="FilterBox_TextChanged"
                              KeyDown="FilterBox_KeyDown"
                              LostFocus="FilterBox_LostFocus" />
          <!-- Bound to Search.Query on the shared DataContext (genuinely
               live/global state, not per-frame - see ScreenSlot.axaml.cs's own
               doc comment). PropertyChanged so the results follow each
               keystroke, and so the x emptying it reaches the query without
               waiting for the box to lose focus. -->
          <controls:TextInput x:Name="SearchTabBox"
                              Grid.Column="1"
                              Classes="inOval"
                              IsVisible="{Binding #Root.Frame.IsSearchScreen, FallbackValue=False}"
                              ShowsClearButton="False"
                              Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                              PlaceholderText="Search your library"
                              KeyDown="SearchTabBox_KeyDown"
                              GotFocus="SearchTabBox_GotFocus"
                              LostFocus="SearchTabBox_LostFocus" />
          <Button Grid.Column="2"
                  Classes="pill"
                  IsVisible="{Binding #Root.IsFilterShown}"
                  Command="{Binding CloseScreenFilterCommand}"
                  Padding="7"
                  VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" />
          </Button>
          <Button Grid.Column="2"
                  Classes="pill"
                  Focusable="False"
                  Click="ClearSearch_Click"
                  Padding="7"
                  VerticalAlignment="Center">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding ElementName="Root" Path="Frame.IsSearchScreen" FallbackValue="False" />
                <Binding ElementName="SearchTabBox" Path="Text" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
              </MultiBinding>
            </Button.IsVisible>
            <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" />
          </Button>
        </Grid>
      </Border>

      <!-- The screen's menu (ScreenMenuButton) - its entries are this
           screen's, MobileMainViewModel.BuildScreenMenu, handed over in the
           code-behind. -->
      <controls:ScreenMenuButton x:Name="ScreenMenu" Grid.Column="2" />
    </Grid>

    <!-- Suggestions for what is being typed - past searches, then artists,
         albums and songs - dropped down under the box while it has focus and
         holds something: see MobileSearchViewModel.Suggestions. The width of the
         box (the buttons' 12 + 40, and its own 10, in from each side), and after the screen's content so it is drawn over the results
         rather than under them. The rows cannot take focus: a press on one
         would otherwise take it from the box, which closes this dropdown
         under the finger before the tap has landed. Its icons, and Clear,
         are the frame's colour, as on every card dropped from the band
         (.chromeIcons, App.axaml). -->
    <Border Grid.Row="0"
            Classes="chromeIcons"
            Grid.RowSpan="2"
            Margin="62,50,62,0"
            VerticalAlignment="Top"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource AppChromeBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            BoxShadow="{DynamicResource AppDropdownShadow}"
            ClipToBounds="True">
      <!-- This slot's own box, not Search.IsDropdownOpen: the screen kept alive
           beside this one for a swipe is a ScreenSlot too, and would open its
           own copy off-screen. -->
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding ElementName="SearchTabBox" Path="IsFocused" />
          <Binding Path="Search.HasSuggestions" />
        </MultiBinding>
      </Border.IsVisible>
      <!-- Each row says what it is by its icon - a past search, an artist,
           an album, a song - and an album or a song whose it is. -->
      <ItemsControl ItemsSource="{Binding Search.Suggestions}" Margin="0,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchSuggestion">
            <Button Classes="pickerRow"
                    Focusable="False"
                    Padding="12,8"
                    Click="Suggestion_Click">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <materialIcons:MaterialIcon Kind="{Binding Icon}"
                                            Width="18" Height="18"
                                            Opacity="0.5"
                                            VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Text}"
                             FontSize="15"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}"
                             IsVisible="{Binding HasDetail}"
                             FontSize="12"
                             Opacity="0.55"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Grid>
  </Panel>
</UserControl>
