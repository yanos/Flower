<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Flower.Controls.ScreenSlot"
             x:DataType="vm:MobileMainViewModel"
             x:Name="Root"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Wraps one materialized screen control together with that screen's own
       header row (the Search tab's box; nothing at all on the rest), so
       ScreenStackPanel's existing swipe transform - applied to this whole
       control - carries the header along with the screen content instead of
       leaving it behind in a static bar. Frame is reassigned wholesale on
       every sync (see ScreenStackPanel.SyncToCurrentFrame), the same
       StyledProperty-replaced-wholesale shape TrackListScreenView's own
       DisplayRows/DisplayHeader already use - see that class's own doc
       comment for why this works correctly even for a kept-alive
       back/forward preview.

       Margin below (60,4,60,4) must stay in sync with the fixed back/settings
       overlay's own margin in MobileMainView.axaml - see that file's comment
       for the pixel math, horizontal and vertical both. The 52px row here is
       what that overlay aligns its own 52px band to, so neither the row height
       nor the 4px vertical margin can move on its own (HeaderHeight in the
       code-behind says the same 52 to the code that needs it).

       The header has no background: the screen runs up under it, so a list
       scrolls on behind the title rather than vanishing at the band's edge.
       At rest nothing sits there, because every screen's scroller starts its
       content below the band - ScreenScrollInset, in MobileMainView.axaml. -->
  <Grid RowDefinitions="52,*">
    <ContentControl Grid.Row="0" Grid.RowSpan="2" x:Name="ContentHost" />

    <Grid Grid.Row="0" Margin="60,4,60,4">
      <!-- No title here: it is the first line of the screen's own scroller,
           under the back button, and moves with the list (ScreenTitle). -->

      <!-- Search tab's own always-visible box, bound to SearchQuery on the
           shared DataContext (genuinely live/global state, not per-frame -
           see ScreenSlot.axaml.cs's own doc comment). The app's own box
           (controls:TextInput), so the x that empties it is the one every
           other field has rather than one written out here - which is also
           what retired ClearSearchQueryCommand: clearing the text is the
           whole of what it did. PropertyChanged so the results follow each
           keystroke, and so clearing reaches the query without waiting for
           the box to lose focus. -->
      <controls:TextInput x:Name="SearchTabBox"
                          Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                          IsVisible="{Binding #Root.Frame.IsSearchScreen}"
                          PlaceholderText="Search your library"
                          VerticalAlignment="Center"
                          KeyDown="SearchTabBox_KeyDown"
                          GotFocus="SearchTabBox_GotFocus"
                          LostFocus="SearchTabBox_LostFocus" />
    </Grid>

    <!-- Recent searches, dropped down under the box while it has focus - see
         MobileMainViewModel.SearchSuggestions for which ones. The width of the
         box, and after the screen's content so it is drawn over the results
         rather than under them. The rows cannot take focus: a press on one
         would otherwise take it from the box, which closes this dropdown
         under the finger before the tap has landed. -->
    <Border Grid.Row="1"
            Margin="60,2,60,0"
            VerticalAlignment="Top"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource AppPrimaryBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            BoxShadow="0 4 16 0 #33000000"
            ClipToBounds="True">
      <!-- This slot's own box, not IsSearchDropdownOpen: the screen kept alive
           beside this one for a swipe is a ScreenSlot too, and would open its
           own copy off-screen. -->
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding ElementName="SearchTabBox" Path="IsFocused" />
          <Binding Path="HasSearchSuggestions" />
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel Margin="0,0,0,4">
      <!-- Clear forgets every past search, not only the ones showing. Not
           focusable, like the rows, so the box keeps the keyboard up: what
           was being typed is still being typed. -->
      <Grid ColumnDefinitions="*,Auto" Margin="12,4,4,0">
        <TextBlock Text="Recent Searches"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Opacity="0.5"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="pickerRow"
                HorizontalAlignment="Right"
                Focusable="False"
                Padding="8,6"
                Command="{Binding ClearRecentSearchesCommand}">
          <TextBlock Text="Clear"
                     FontSize="13"
                     Foreground="{DynamicResource AppAccentBrush}" />
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding SearchSuggestions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Button Classes="pickerRow"
                    Focusable="False"
                    Padding="12,9"
                    Click="Suggestion_Click">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <materialIcons:MaterialIcon Kind="History"
                                            Width="18" Height="18"
                                            Opacity="0.5"
                                            VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           FontSize="15"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
