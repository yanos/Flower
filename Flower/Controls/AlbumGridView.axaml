<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Controls.AlbumGridView">

  <!-- Row-chunked album art grid - the same virtualizing list of rows the
       phone's Albums grids are (see AlbumGridScreenView), at a computed
       tiles-per-row (AlbumGridView.axaml.cs's RebuildRows), plus per-row
       inline expansion (AlbumGridRowControl). Wrapped in an
       explicit ScrollViewer for the same reason mobile's grids are: a plain
       ItemsControl has no ScrollViewer in its own default template.

       UniformRowPanel, as the phone's grids are, with HasTallRows: a row here
       grows when its album is expanded inline. Each row is built once and
       handed row after row (RecyclingItemsControl), and its tiles with it
       (TileRowPanel).

       Not scrolled to whatever takes the focus: a tile's "..." is a button
       and an open album's song list takes the focus on a click, and either
       pulled the page about under the pointer. The one scroll an album asks
       for is AlbumGridView.RevealExpanded's. -->
  <ScrollViewer x:Name="Scroller"
                BringIntoViewOnFocusChange="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <controls:RecyclingItemsControl x:Name="RowsList" Margin="32,0,4,16">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <controls:UniformRowPanel HasTallRows="True"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlbumGridRowViewModel">
          <controls:AlbumGridRowControl/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </controls:RecyclingItemsControl>
  </ScrollViewer>
</UserControl>
