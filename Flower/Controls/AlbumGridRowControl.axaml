<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:converters="clr-namespace:Flower.Converters"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Controls.AlbumGridRowControl"
             x:DataType="vm:AlbumGridRowViewModel"
             x:CompileBindings="True">


  <StackPanel Margin="0,0,0,16">
    <!-- The row's tiles, kept as the grid hands the row album after album
         (TileRowPanel). -->
    <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Tiles}">
      <controls:TileRowPanel.ItemTemplate>
        <DataTemplate>
          <controls:AlbumTileControl/>
        </DataTemplate>
      </controls:TileRowPanel.ItemTemplate>
    </controls:TileRowPanel>

    <!-- Expanded track list - Height animates 0<->TargetHeight (set by
         AlbumGridRowControl.axaml.cs whenever IsExpanded/ExpandedTracks
         change) via the Transition below, rather than animating to/from
         "Auto" (not natively supported - see this control's code-behind for
         why the target height is precomputed instead). ClipToBounds hides
         the two-column content while collapsed/mid-animation. -->
    <Border x:Name="ExpansionBorder"
            ClipToBounds="True"
            Height="0">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="CubicEaseOut"/>
        </Transitions>
      </Border.Transitions>

      <Border x:Name="ExpansionCard"
              Background="{DynamicResource AppAccentSoftBrush}"
              CornerRadius="8"
              Padding="12,10"
              VerticalAlignment="Top">
        <!-- The album's songs, in two columns (AlbumTrackList - the Artists
             page's album cards draw theirs with it too). -->
        <controls:AlbumTrackList TwoColumns="True"/>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
