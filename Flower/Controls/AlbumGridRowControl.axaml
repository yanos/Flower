<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Controls.AlbumGridRowControl"
             x:DataType="vm:AlbumGridRowViewModel"
             x:CompileBindings="True">


  <StackPanel Margin="0,0,0,16">
    <!-- The row's tiles, kept as the grid hands the row album after album
         (TileRowPanel). -->
    <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Tiles}">
      <controls:TileRowPanel.ItemTemplate>
        <DataTemplate>
          <controls:AlbumTileControl/>
        </DataTemplate>
      </controls:TileRowPanel.ItemTemplate>
    </controls:TileRowPanel>

    <!-- The album opened in this row: its cover, name, artist and year with
         play and shuffle under them, and its songs beside.
         Opens and closes by Reveal - the fraction of the card that shows -
         rather than by a Height worked out ahead, so it opens to the card's
         real height whatever the songs come to (RevealDecorator). -->
    <controls:RevealDecorator x:Name="Expansion">
      <controls:RevealDecorator.Transitions>
        <Transitions>
          <DoubleTransition Property="Reveal" Duration="0:0:0.22" Easing="CubicEaseOut"/>
        </Transitions>
      </controls:RevealDecorator.Transitions>

      <!-- A card a little apart from the row above, with a hairline round
           it; the open tile's selected tint is what ties the two together. -->
      <Border Background="{DynamicResource AppSidebarBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="18"
              Margin="8,4,8,0"
              Padding="32">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="40">
          <StackPanel Grid.Column="0" Spacing="16">
            <controls:AlbumArtView AlbumArt="{Binding ExpandedTile.AlbumArt}"
                                   Width="300" Height="300"
                                   ArtCornerRadius="12"/>
            <StackPanel Spacing="6">
              <TextBlock Classes="pageTitle"
                         Text="{Binding ExpandedTile.Name}"
                         FontSize="28"
                         LineHeight="32"
                         LetterSpacing="-0.3"
                         TextWrapping="Wrap"
                         MaxLines="2"/>
              <TextBlock Text="{Binding ExpandedTile.Artist}"
                         FontSize="15"
                         FontWeight="Medium"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding ExpandedYear}"
                         IsVisible="{Binding ExpandedYear, Converter={x:Static ObjectConverters.IsNotNull}}"
                         FontSize="13"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
            <!-- The download is the tile's own indicator, and is there only
                 while the album has songs to fetch (TrackDownloadButton) - the
                 phone's album header's Download All. -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="play pagePlay"
                      Click="Play_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <materialIcons:MaterialIcon Kind="Play" Width="20" Height="20"/>
                  <TextBlock Text="Play" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Border Classes="outlined" Width="44" Height="44">
                <Button Classes="pill" Padding="12" HorizontalAlignment="Center"
                        ToolTip.Tip="Shuffle"
                        Click="Shuffle_Click">
                  <materialIcons:MaterialIcon Classes="chrome" Kind="Shuffle" Width="18" Height="18"/>
                </Button>
              </Border>
              <Border Classes="outlined" Width="44" Height="44"
                      IsVisible="{Binding #ExpandedDownload.IsVisible}">
                <controls:TrackDownloadButton x:Name="ExpandedDownload"
                                              DataContext="{Binding ExpandedTile}"
                                              Label="Download album"
                                              IconSize="18"
                                              IconPadding="12"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              DownloadRequested="Download_Requested"/>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- The songs, numbered, under a band naming their columns
               (AlbumTrackList - the Artists page's album cards draw theirs
               with it too). -->
          <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <Border BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Height="36"
                    Margin="0,0,0,6"
                    Padding="8,0,36,0">
              <Grid ColumnDefinitions="Auto,20,*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="#" MinWidth="26" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="Title" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="Duration" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              </Grid>
            </Border>
            <controls:AlbumTrackList ShowsNumbers="True"/>
          </StackPanel>
        </Grid>
      </Border>
    </controls:RevealDecorator>
  </StackPanel>
</UserControl>
