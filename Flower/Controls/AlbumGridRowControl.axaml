<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Controls.AlbumGridRowControl"
             x:DataType="vm:AlbumGridRowViewModel"
             x:CompileBindings="True">

  <UserControl.Styles>
    <!-- Play's glyph stays in the words' colour on the accent, pointed at and
         pressed too - App.axaml turns every button's icon the accent then,
         which on this one would be the accent on the accent. -->
    <Style Selector="Button.primary materialIcons|MaterialIcon, Button.primary:pointerover materialIcons|MaterialIcon, Button.primary:pressed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.albumAction">
      <Setter Property="CornerRadius" Value="9999"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.albumAction:not(.primary)">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="0,0,0,16">
    <!-- The row's tiles, kept as the grid hands the row album after album
         (TileRowPanel). -->
    <controls:TileRowPanel Columns="{Binding Columns}" Items="{Binding Tiles}">
      <controls:TileRowPanel.ItemTemplate>
        <DataTemplate>
          <controls:AlbumTileControl/>
        </DataTemplate>
      </controls:TileRowPanel.ItemTemplate>
    </controls:TileRowPanel>

    <!-- The album opened in this row: its cover, name, artist and year with
         play, shuffle and the album menu under them, and its songs beside.
         Opens and closes by Reveal - the fraction of the card that shows -
         rather than by a Height worked out ahead, so it opens to the card's
         real height whatever the songs come to (RevealDecorator). -->
    <controls:RevealDecorator x:Name="Expansion">
      <controls:RevealDecorator.Transitions>
        <Transitions>
          <DoubleTransition Property="Reveal" Duration="0:0:0.22" Easing="CubicEaseOut"/>
        </Transitions>
      </controls:RevealDecorator.Transitions>

      <Border Background="{DynamicResource AppSidebarBrush}"
              CornerRadius="14"
              Padding="24">
        <Grid ColumnDefinitions="240,Auto,*">
          <StackPanel Grid.Column="0">
            <controls:AlbumArtView AlbumArt="{Binding ExpandedTile.AlbumArt}"
                                   Width="240" Height="240"
                                   ArtCornerRadius="8"/>
            <TextBlock Text="{Binding ExpandedTile.Name}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,14,0,0"/>
            <TextBlock Text="{Binding ExpandedTile.Artist}"
                       FontSize="15"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0"/>
            <TextBlock Text="{Binding ExpandedYear}"
                       IsVisible="{Binding ExpandedYear, Converter={x:Static ObjectConverters.IsNotNull}}"
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*,*,Auto" Margin="0,16,0,0">
              <Button Grid.Column="0" Classes="albumAction primary" Margin="0,0,8,0"
                      Click="Play_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18"/>
                  <TextBlock Text="Play" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="albumAction" Margin="0,0,8,0"
                      Click="Shuffle_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <materialIcons:MaterialIcon Kind="Shuffle" Width="18" Height="18"/>
                  <TextBlock Text="Shuffle" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="albumAction" Padding="8"
                      ToolTip.Tip="More"
                      Click="Menu_Click">
                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="20" Height="20"/>
              </Button>
            </Grid>
          </StackPanel>

          <Border Grid.Column="1"
                  Width="1"
                  Margin="24,0"
                  Background="{DynamicResource AppDividerBrush}"/>

          <!-- The songs, numbered, a line between each (AlbumTrackList - the
               Artists page's album cards draw theirs with it too). -->
          <controls:AlbumTrackList Grid.Column="2"
                                   ShowsNumbers="True"
                                   Classes="divided"
                                   VerticalAlignment="Top"/>
        </Grid>
      </Border>
    </controls:RevealDecorator>
  </StackPanel>
</UserControl>
