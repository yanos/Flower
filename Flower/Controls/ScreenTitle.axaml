<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:avc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels.Mobile"
             x:Class="Flower.Controls.ScreenTitle">

  <!-- A screen's name, as the first thing in its scroller rather than fixed in
       the header band: it sits on its own line under the back button, ranged
       left with the rows, and scrolls away with them. Every screen puts one at
       the top of what it scrolls - a ListBox through the screenScroll template
       in MobileMainView.axaml.

       The name is the frame's, read off the ScreenSlot hosting the screen, so
       a kept-alive back or forward screen shows its own rather than the live
       one's (see MobileNavigationFrame.Title). Blank over an album's tracks and
       on Search, where the line collapses and takes no room: the album's name
       is right there in large type, and Search has its box in the band.

       Set as every page's name is (TextBlock.screenTitle, App.axaml) - the
       desktop page header's too - and a little larger than it was (34), so
       a tab's screen reads as the top of its tab.

       On the flat Songs list, a Shuffle pill at the far end of the line -
       the same oval as the Playlists tab's New Playlist (NewPlaylistEntry) -
       which shuffles the songs on screen, as an album's own shuffle circle
       does its songs. -->
  <Grid ColumnDefinitions="*,Auto"
        Margin="16,0,16,8"
        IsVisible="{Binding $parent[controls:ScreenSlot].Frame.Title, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}">
    <!-- A tab's own screen has the tab's icon before its name, in the
         name's colour (MobileNavigationFrame.IsTabRoot). -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Panel VerticalAlignment="Center"
             IsVisible="{Binding $parent[controls:ScreenSlot].Frame.IsTabRoot, FallbackValue=False}">
        <materialIcons:MaterialIcon Kind="{Binding $parent[controls:ScreenSlot].Frame.TitleIcon, FallbackValue=MusicNote}"
                                    Width="{Binding $parent[controls:ScreenSlot].Frame.TitleIconSize, FallbackValue=30}"
                                    Height="{Binding $parent[controls:ScreenSlot].Frame.TitleIconSize, FallbackValue=30}"
                                    Margin="{Binding $parent[controls:ScreenSlot].Frame.TitleIconMargin, FallbackValue=0}"
                                    Foreground="{DynamicResource AppChromeBrush}"
                                    IsVisible="{Binding !$parent[controls:ScreenSlot].Frame.TitleUsesSongNote, FallbackValue=True}" />
        <Path Data="{StaticResource SongNoteGeometry}"
              Stretch="Uniform" Width="27" Height="27"
              Fill="{DynamicResource AppChromeBrush}"
              IsVisible="{Binding $parent[controls:ScreenSlot].Frame.TitleUsesSongNote, FallbackValue=False}" />
      </Panel>
      <TextBlock Classes="screenTitle"
                 Text="{Binding $parent[controls:ScreenSlot].Frame.Title}"
                 VerticalAlignment="Center"
                 FontSize="38" />
    </StackPanel>
    <Button Grid.Column="1"
            Classes="pill"
            Padding="0"
            VerticalAlignment="Center"
            IsVisible="{Binding $parent[controls:ScreenSlot].Frame.IsSongsList, FallbackValue=False}"
            Command="{Binding $parent[controls:ScreenSlot].((vm:MobileMainViewModel)DataContext).ShuffleAlbumCommand}">
      <Border Classes="floating" Height="40" CornerRadius="20" Padding="12,0,18,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <materialIcons:MaterialIcon Kind="Shuffle" Width="20" Height="20" VerticalAlignment="Center" />
          <TextBlock Text="Shuffle" FontSize="17" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Button>
  </Grid>
</UserControl>
