<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Flower.Controls.MusicListView"
             x:CompileBindings="False"
             Focusable="True">

  <Grid RowDefinitions="36,*">

    <!-- Column header bar: a rounded band of the surface colour over the
         rows. ClipToBounds so the header content - which is translated
         horizontally in code-behind to track Scroller's horizontal offset
         (see MusicListView.axaml.cs) - doesn't spill past this row. -->
    <Border x:Name="HeaderBorder"
            Grid.Row="0"
            ClipToBounds="True"
            Margin="0,0,8,2"
            CornerRadius="10"
            Background="{DynamicResource AppSurfaceBrush}">
      <!-- populated in code-behind -->
    </Border>

    <!-- Virtualized track list -->
    <ScrollViewer x:Name="Scroller"
                  Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <!-- MusicListPanel added in code-behind -->
    </ScrollViewer>

  </Grid>
</UserControl>
