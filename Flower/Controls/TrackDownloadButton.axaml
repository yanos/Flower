<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             x:Class="Flower.Controls.TrackDownloadButton"
             x:Name="Root"
             x:DataType="vm:DownloadIndicatorViewModel"
             x:CompileBindings="True"
             IsVisible="{Binding IsDownloadable}"
             VerticalAlignment="Center">

  <!-- The download control, wherever one appears: a track-list row's title
       cell (TrackRowControl.BuildCellContent), an expanded album's song row,
       an album tile under its name (AlbumGridRowControl/AlbumTileControl),
       mobile's own row (TrackRowTemplate.axaml) and mobile's top-bar
       "download everything on this screen" (ScreenSlot.axaml). One control
       rather than five copies of three icons, because the interesting part of
       a download icon is not the glyph but the sequence: idle -> spinning ->
       gone, with no idle frame on the way out (see
       DownloadIndicatorViewModel.FinishDownload). A copy that misses that is a
       button that flickers, which is exactly what the top bar's own copy did.

       Its own UserControl rather than code-built cell content because of the
       spinner: SpinAngle is bound onto a RotateTransform, which is not part of
       the visual tree and so has no DataContext of its own to bind against
       from code-behind - declaring it in XAML is what gives it one.

       Only shown when there is actually something to fetch (IsDownloadable -
       a placeholder the paired server can serve right now, an album with at
       least one such track, or a screenful of them), so a fully local library
       shows no icon well at all.

       Sized by IconSize plus IconPadding rather than a fixed box: the callers
       want 13px in a desktop row, 16px on a phone's row and 22px in its top
       bar, and the padding around the glyph is the tap target. Its own
       property rather than this UserControl's Padding, which a ContentControl
       template already applies once on the way in and would apply twice.

       Button.pill (Styles/IconButtons.axaml) is the look every icon button
       shares, and what makes a press light up a circle rather than a square. -->
  <Button x:Name="DownloadButton"
          Classes="pill"
          Padding="{Binding #Root.IconPadding}">
    <Panel>
      <materialIcons:MaterialIcon Kind="CloudDownloadOutline"
                                  Width="{Binding #Root.IconSize}" Height="{Binding #Root.IconSize}" Opacity="0.7"
                                  IsVisible="{Binding IsDownloadIdle}"
                                  ToolTip.Tip="{Binding #Root.Label}"/>
      <!-- Rotation driven by the indicator's own SpinAngle, not a View-side
           animation - see DownloadIndicatorViewModel.IsDownloading's doc
           comment for why (every list this appears in virtualizes and pools
           its rows).

           No RenderTransformOrigin: the default already is
           RelativePoint.Center, and the seemingly-equivalent "0.5,0.5" is
           not - RelativePoint only reads a coordinate as a fraction of the
           control when it carries a %, so that spelling means half a pixel
           from the top-left corner and the icon orbits it instead of
           spinning in place. "50%,50%" would work; saying nothing is
           shorter and is what every other spinner here does. -->
      <materialIcons:MaterialIcon Kind="Sync"
                                  Width="{Binding #Root.IconSize}" Height="{Binding #Root.IconSize}" Opacity="0.7"
                                  IsVisible="{Binding IsDownloading}">
        <materialIcons:MaterialIcon.RenderTransform>
          <RotateTransform Angle="{Binding SpinAngle}"/>
        </materialIcons:MaterialIcon.RenderTransform>
      </materialIcons:MaterialIcon>
      <materialIcons:MaterialIcon Kind="AlertCircleOutline"
                                  Width="{Binding #Root.IconSize}" Height="{Binding #Root.IconSize}"
                                  Foreground="{DynamicResource AppTextDisabledBrush}"
                                  IsVisible="{Binding IsDownloadUnavailable}"
                                  ToolTip.Tip="Download failed - try again later"/>
    </Panel>
  </Button>
</UserControl>
