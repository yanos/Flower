<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flower.ViewModels"
             xmlns:controls="using:Flower.Controls"
             xmlns:usercontrols="using:Flower.UserControls"
             mc:Ignorable="d"
             x:Class="Flower.UserControls.CurrentlyPlayingControl"
             x:DataType="vm:CurrentlyPlayingControlViewModel">

  <!-- What is playing, beside the transport: the cover, the song's title in
       the display serif - as on the phone's Now Playing, where a song's title
       is the subject of the screen - the artist and album under it, and the
       seek bar with the time either side. Shuffle and repeat are the
       transport's now (PlaylistControls). -->
  <Grid ColumnDefinitions="Auto,*">

    <controls:AlbumArtView Grid.Column="0"
                           Width="76" Height="76"
                           ArtCornerRadius="6"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           AlbumArt="{Binding AlbumArt}"/>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
      <TextBlock Text="{Binding CurrentlyPlayingTrack.Title}"
                 FontFamily="{DynamicResource AppDisplayFontFamily}"
                 FontSize="22"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"/>

      <TextBlock Text="{Binding Subtitle}"
                 FontSize="13"
                 Foreground="{DynamicResource AppTextSecondaryBrush}"
                 TextTrimming="CharacterEllipsis"/>

      <usercontrols:SeekBar Margin="0,2,0,0"/>
    </StackPanel>
  </Grid>
</UserControl>
