<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flower.ViewModels"
             xmlns:controls="using:Flower.Controls"
             mc:Ignorable="d"
             x:Class="Flower.UserControls.CurrentlyPlayingControl"
             x:DataType="vm:CurrentlyPlayingControlViewModel">

  <!-- What is playing, beside the transport: the cover, the song's title in
       the display serif - as on the phone's Now Playing, where a song's title
       is the subject of the screen - the artist and album under it, and the
       seek bar with the time either side. Shuffle and repeat are the
       transport's now (PlaylistControls). -->
  <Grid ColumnDefinitions="Auto,*">

    <controls:AlbumArtView Grid.Column="0"
                           Width="76" Height="76"
                           ArtCornerRadius="6"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           AlbumArt="{Binding AlbumArt}"/>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
      <TextBlock Text="{Binding CurrentlyPlayingTrack.Title}"
                 FontFamily="{DynamicResource AppDisplayFontFamily}"
                 FontSize="22"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"/>

      <TextBlock Text="{Binding Subtitle}"
                 FontSize="13"
                 Foreground="{DynamicResource AppTextSecondaryBrush}"
                 TextTrimming="CharacterEllipsis"/>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
        <TextBlock Grid.Column="0"
                   Text="{Binding ElapsedTime}"
                   FontSize="12"
                   MinWidth="34"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding CurrentlyPlayingTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>

        <!-- The phone's seek bar (Now Playing's Slider.tight), a little
             thicker than Fluent's rail with round ends: the one bar here. The
             negative margin crops the room Fluent's template keeps above and
             below for a tick bar it has not got. -->
        <Slider Grid.Column="1" x:Name="slider"
                Margin="10,-11"
                Padding="0"
                Minimum="0"
                Maximum="1"
                Value="{Binding SeekPosition, Mode=TwoWay}"
                VerticalAlignment="Center">
          <Slider.Resources>
            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
          </Slider.Resources>
        </Slider>

        <TextBlock Grid.Column="2"
                   Text="{Binding TotalTime}"
                   FontSize="12"
                   MinWidth="34"
                   TextAlignment="Right"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding CurrentlyPlayingTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
