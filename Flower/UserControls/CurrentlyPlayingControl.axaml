<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flower.ViewModels"
             xmlns:controls="using:Flower.Controls"
             xmlns:usercontrols="using:Flower.UserControls"
             mc:Ignorable="d"
             x:Class="Flower.UserControls.CurrentlyPlayingControl"
             x:DataType="vm:CurrentlyPlayingControlViewModel">

  <!-- What is playing, beside the transport: the cover, the song's title in
       the display serif - as on the phone's Now Playing, where a song's title
       is the subject of the screen - and the artist and album under it, level
       with the cover's top, and the seek bar level with its bottom, the times
       under the bar's ends. Shuffle and repeat are the transport's now
       (PlaylistControls). -->
  <Grid ColumnDefinitions="Auto,*">

    <controls:AlbumArtView Grid.Column="0"
                           Width="84" Height="84"
                           ArtCornerRadius="6"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           AlbumArt="{Binding AlbumArt}"/>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 Text="{Binding Title}"
                 FontFamily="{DynamicResource AppDisplayFontFamily}"
                 FontSize="22"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"/>

      <TextBlock Grid.Row="1"
                 Text="{Binding Subtitle}"
                 FontSize="13"
                 Foreground="{DynamicResource AppTextSecondaryBrush}"
                 TextTrimming="CharacterEllipsis"/>

      <usercontrols:SeekBar Grid.Row="3"/>
    </Grid>
  </Grid>
</UserControl>
