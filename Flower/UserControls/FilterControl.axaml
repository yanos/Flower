<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flower.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Flower.UserControls"
             mc:Ignorable="d"
             x:Class="Flower.UserControls.FilterControl">

  <!-- The app's own box, so the filter gets the same primary border and the
       same clear button every other field has - see Flower.Controls.TextInput. -->
  <controls:TextInput Text="{Binding $parent[local:FilterControl].FilterText}"
                      PlaceholderText="Filter..."
                      VerticalAlignment="Center"/>

</UserControl>
