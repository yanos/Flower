<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Flower.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:Flower.Converters"
             mc:Ignorable="d"
             x:Class="Flower.UserControls.PlaylistControls"
             x:DataType="vm:PlaylistControlViewModel">

  <UserControl.Resources>
    <conv:PlayOrPauseConverter x:Key="PlayOrPauseConverter"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The transport's glyphs in the text's colour, the song title's beside
         them. -->
    <Style Selector="materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <!-- Shuffle and repeat, off and on: muted when off; on, the text's ink in
         the selected grey's circle - the way a row or a sidebar entry says
         it is the one, rather than the accent, which is left to play. The
         circle is what tells on from off: muted and ink alone are too close
         to read apart at a glance. -->
    <Style Selector="materialIcons|MaterialIcon.transportToggle">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>
    <Style Selector="materialIcons|MaterialIcon.transportToggle.active">
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.pill.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
    </Style>
    <!-- Pointed at and pressed, any of them, the hover and pressed ink -
         restated here because the ones above are nearer than App.axaml's. -->
    <Style Selector=":is(Button):pointerover materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppIconHoverBrush}"/>
    </Style>
    <Style Selector=":is(Button):pressed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppIconPressedBrush}"/>
    </Style>
    <!-- ...except on play, which is white on its red throughout. -->
    <Style Selector="Button.play materialIcons|MaterialIcon, Button.play:pointerover materialIcons|MaterialIcon, Button.play:pressed materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- The transport, in a row: shuffle and repeat at either end, previous
       and next either side of play, and play the one filled red circle in the
       bar (Button.play, Styles/IconButtons.axaml). The seek bar is under it
       (MainView). -->
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">

    <Button Classes="pill" Padding="13" Click="Shuffle" ToolTip.Tip="Shuffle"
            Classes.active="{Binding IsShuffleEnabled}">
      <materialIcons:MaterialIcon Kind="Shuffle" Width="18" Height="18"
                                  Classes="transportToggle"
                                  Classes.active="{Binding IsShuffleEnabled}"/>
    </Button>

    <Button Classes="pill" Padding="11" Click="Previous" ToolTip.Tip="Previous">
      <materialIcons:MaterialIcon Kind="SkipPrevious" Width="22" Height="22"/>
    </Button>

    <Button Classes="play"
            Width="48" Height="48"
            CornerRadius="24"
            Padding="0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="PlayOrPause">
      <materialIcons:MaterialIcon Kind="{Binding IsPlaying, Converter={StaticResource PlayOrPauseConverter}}"
                                  Width="24" Height="24"/>
    </Button>

    <Button Classes="pill" Padding="11" Click="Next" ToolTip.Tip="Next">
      <materialIcons:MaterialIcon Kind="SkipNext" Width="22" Height="22"/>
    </Button>

    <Button Classes="pill" Padding="13" Click="Repeat" ToolTip.Tip="Repeat"
            Classes.active="{Binding IsRepeatEnabled}">
      <materialIcons:MaterialIcon Kind="Repeat" Width="18" Height="18"
                                  Classes="transportToggle"
                                  Classes.active="{Binding IsRepeatEnabled}"/>
    </Button>

  </StackPanel>

</UserControl>
