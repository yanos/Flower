<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:Flower.ViewModels"
             xmlns:conv="clr-namespace:Flower.Converters"
             x:Class="Flower.UserControls.VolumeControl"
             x:DataType="vm:VolumeControlViewModel">

  <UserControl.Resources>
    <conv:MaterialIconGeometryConverter x:Key="MaterialIconGeometryConverter"/>
  </UserControl.Resources>

  <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">

    <!-- One speaker, at the quiet end, that says how loud it is - an X at
         nothing, more waves the louder it is (VolumeControlViewModel.Icon).
         Drawn on the icons' own 24x24 canvas rather than as a MaterialIcon,
         which scales each glyph to fit its outline: the waves make each
         level's outline a different width, so the speaker moved and resized
         as the volume crossed from one to the next. -->
    <Viewbox Grid.Column="0"
             Width="26" Height="26"
             VerticalAlignment="Center"
             Margin="0,0,6,0">
      <Canvas Width="24" Height="24">
        <Path Data="{Binding Icon, Converter={StaticResource MaterialIconGeometryConverter}}"
              Fill="{DynamicResource AppTextPrimaryBrush}"/>
      </Canvas>
    </Viewbox>

    <!-- The seek bar's slider (SeekBar): the same size, thumb and rail, and
         the same text-coloured fill up to the thumb. The negative margin
         crops the room Fluent's template keeps above and below for a tick
         bar it has not got, as the seek bar's does - 2 more at the top than
         the bottom, which otherwise left the rail that much below the middle
         of the speaker beside it (measured off a screenshot). -->
    <Slider x:Name="slider"
            Grid.Column="1"
            Padding="0"
            Margin="0,-13,0,-9"
            Maximum="100"
            Value="{Binding Volume, Mode=TwoWay}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
      <Slider.Resources>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource PaletteTextPrimary}"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource PaletteTextPrimary}" Opacity="0.8"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource PaletteTextPrimary}" Opacity="0.8"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource PaletteTextPrimary}"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource PaletteTextPrimary}" Opacity="0.8"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource PaletteTextPrimary}" Opacity="0.8"/>
      </Slider.Resources>
    </Slider>

  </Grid>

</UserControl>
