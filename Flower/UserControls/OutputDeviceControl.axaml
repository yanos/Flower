<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:Flower.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Flower.UserControls.OutputDeviceControl"
             x:DataType="vm:OutputDeviceControlViewModel"
             IsVisible="{Binding IsAvailable}">

  <!-- Speaker button that opens the device list - a context menu built on
       each click (see the code-behind), so on macOS it is a native menu
       like every other one (PlatformContextMenu), and elsewhere Avalonia's,
       opening upward from the status bar it sits in. -->
  <Button x:Name="PickerButton"
          Background="Transparent"
          BorderThickness="0"
          Padding="4,2"
          VerticalAlignment="Center"
          ToolTip.Tip="Audio output"
          Click="PickerButton_Click">
    <materialIcons:MaterialIcon Kind="SpeakerMultiple"
                                Width="14" Height="14"
                                Opacity="0.65"/>
  </Button>

</UserControl>
