<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flower.ViewModels"
             mc:Ignorable="d"
             x:Class="Flower.UserControls.SeekBar"
             x:DataType="vm:CurrentlyPlayingControlViewModel">

  <!-- The seek bar with the time either side. Its own control because it has
       two homes: under the title in CurrentlyPlayingControl, and in the status
       bar when the playback controls are at the bottom (see
       AppSettings.PlaybackControlsPlacement). -->
  <Grid ColumnDefinitions="Auto,*,Auto">
    <TextBlock Grid.Column="0"
               Text="{Binding ElapsedTime}"
               FontSize="12"
               MinWidth="34"
               Foreground="{DynamicResource AppTextSecondaryBrush}"
               VerticalAlignment="Center"
               IsVisible="{Binding CurrentlyPlayingTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    <!-- The phone's seek bar (Now Playing's Slider.tight), a little
         thicker than Fluent's rail with round ends: the one bar here. The
         negative margin crops the room Fluent's template keeps above and
         below for a tick bar it has not got. -->
    <Slider Grid.Column="1"
            Margin="10,-11"
            Padding="0"
            Minimum="0"
            Maximum="1"
            Value="{Binding SeekPosition, Mode=TwoWay}"
            VerticalAlignment="Center">
      <Slider.Resources>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
      </Slider.Resources>
    </Slider>

    <TextBlock Grid.Column="2"
               Text="{Binding TotalTime}"
               FontSize="12"
               MinWidth="34"
               TextAlignment="Right"
               Foreground="{DynamicResource AppTextSecondaryBrush}"
               VerticalAlignment="Center"
               IsVisible="{Binding CurrentlyPlayingTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </Grid>
</UserControl>
