<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flower.ViewModels"
             mc:Ignorable="d"
             x:Class="Flower.UserControls.SeekBar"
             x:DataType="vm:CurrentlyPlayingControlViewModel">

  <!-- The seek bar, under the transport in the middle of the player bar,
       with the elapsed and total times either side of it. -->
  <Grid ColumnDefinitions="36,*,36" ColumnSpacing="10">
    <!-- The phone's seek bar (Now Playing's Slider.tight), a little
         thicker than Fluent's rail with round ends: the one bar here. Filled
         and thumbed in the slider ink, like every other slider - not the
         accent, which is left to play itself. The negative margin crops
         the room Fluent's template keeps above and below for a tick bar it
         has not got. -->
    <Slider x:Name="Bar"
            Grid.Column="1"
            Padding="0"
            Margin="0,-11"
            Minimum="0"
            Maximum="1"
            Value="{Binding SeekPosition, Mode=TwoWay}"
            VerticalAlignment="Center">
      <Slider.Resources>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource PaletteControlSlider}"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource PaletteControlSlider}" Opacity="0.85"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource PaletteControlSlider}" Opacity="0.85"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource PaletteControlSlider}"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource PaletteControlSlider}" Opacity="0.85"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource PaletteControlSlider}" Opacity="0.85"/>
      </Slider.Resources>
    </Slider>
    <TextBlock Grid.Column="0"
               Text="{Binding ElapsedTime}"
               FontSize="12"
               TextAlignment="Right"
               VerticalAlignment="Center"
               Foreground="{DynamicResource AppTextSecondaryBrush}"
               IsVisible="{Binding CurrentlyPlayingTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <TextBlock Grid.Column="2"
               Text="{Binding TotalTime}"
               FontSize="12"
               VerticalAlignment="Center"
               Foreground="{DynamicResource AppTextSecondaryBrush}"
               IsVisible="{Binding CurrentlyPlayingTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </Grid>
</UserControl>
