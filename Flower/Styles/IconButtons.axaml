<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <!-- Icon-only buttons, app-wide: the floating back and menu buttons over
       the mobile screens, the tabs in the oval below them, the back buttons of
       the Now Playing and Settings sheets, an album's action group, and every
       download button (TrackDownloadButton puts the class on its own inner
       Button). Kept here rather than in MobileMainView so they all press the
       same way wherever they are hosted - the download button used to light up
       a square around its glyph while everything beside it lit up a circle. -->

  <!-- A pill round at both ends, and a circle when it is 40 wide. Every oval on
       the phone is one - the back button, search and the menu, an album's
       actions, the mini player and the tab bar - and each is ringed by a
       single pixel of the outline colour (AppChromeBorderBrush, Theme.axaml).
       The icon in each is the frame's ink (App.axaml). -->
  <Style Selector="Border.floating">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- Just enough to lift the circle off the page: a darker or wider one
         read as a halo round every button. -->
    <Setter Property="BoxShadow" Value="{DynamicResource AppButtonShadow}" />
  </Style>

  <!-- A text box inside an oval - the phone's filter and Search boxes
       (ScreenSlot), the desktop's filter (FilterControl): the oval is its
       border, so the box itself draws none, in any state - Fluent paints a
       different background and outline for hover and focus from inside its
       template. -->
  <Style Selector="TextBox.inOval">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBox.inOval /template/ Border#PART_BorderElement, TextBox.inOval:pointerover /template/ Border#PART_BorderElement, TextBox.inOval:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- CornerRadius is what rounds the pressed and hover highlight: Fluent paints
       those on the template's ContentPresenter, which takes the Button's radius.
       Larger than any icon button is tall, so the highlight is always a circle
       around a square button, whatever its size. Padding is the tap target
       around the glyph; TrackDownloadButton sets its own from IconPadding. -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pill.selected materialIcons|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <!-- Pointed at, an icon button sits in the hover grey, a circle round its
       glyph; the presenter, since that is where Fluent paints its states. -->
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>

  <!-- Play, wherever it is the point of a group (Now Playing's transport, an
       album's actions): a thin ring around the glyph, no fill. The ring is a
       Border.ring the markup puts inside the Button, rather than the Button's
       own border, so it sits a few pixels inside the round press highlight -
       pressing greys the whole button and leaves that gap showing. The Button's
       Padding is the gap; the ring's Padding is its room around the glyph.
       Contents stretch so a Button given a fixed size draws its ring that size. -->
  <Style Selector="Button.pill.circle">
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.pill.circle Border.ring">
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="Padding" Value="3.5" />
  </Style>

  <!-- Every button, pressed or pointed at: its icon takes the ink
       (App.axaml) and nothing else changes - no fill or rim behind it, and
       the words keep their colour rather than Fluent's pressed one. The
       presenter keeps the button's own resting look, on the template's
       presenter where Fluent paints its states. An icon button (Button.pill,
       above) and a filled one (Button.primary, Button.play, below) still
       change: the grey round the glyph, and the fill, are the button. -->
  <Style Selector="Button:not(.pill):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- The one action a dialog or sheet is asking for (OK, Save, Pair): a
     fill of the ink, a shade lighter under the pointer and the finger, and
     the page's own colour for its words. Not the red - that is playback's
     (Button.play, below). On the template's presenter, which is where Fluent
     paints its own hover and pressed backgrounds - a Background set on the
     Button itself was replaced by Fluent's grey the moment it was pointed at
     or pressed. -->
  <Style Selector="Button.primary">
    <Setter Property="Foreground" Value="{DynamicResource AppOnInkBrush}" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppInkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnInkBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppInkHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnInkBrush}" />
  </Style>

  <!-- Play, filled: the accent at rest, its deeper red under the pointer and
     the finger, white on it throughout - the one fill in the app that is red,
     because it starts the music. -->
  <Style Selector="Button.play">
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.play /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.play materialIcons|MaterialIcon, Button.play:pointerover materialIcons|MaterialIcon, Button.play:pressed materialIcons|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
  </Style>
  <!-- The desktop page header's round buttons, its Sort and its filter: the
     surface inside a hairline of the control outline, flat on the page -
     the phone's floating ovals' shape without the lift. The Button.pill
     inside fills it exactly, so its hover grey is the whole circle. -->
  <Style Selector="Border.outlined">
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- The same for a button with words in it (Clear Queue), which greys
     like an icon button when pointed at. -->
  <Style Selector="Button.outlined">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.outlined:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <!-- A page header's Play: the red pill with its word beside the glyph. -->
  <Style Selector="Button.pagePlay">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="18,0,22,0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- These presenter styles outrank Fluent's own disabled one, which would
       otherwise grey them: disabled, each is the same button at half
       strength. -->
  <Style Selector="Button.primary:disabled, Button.play:disabled, Button.outlined:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- An icon turning in place while something is under way: the connection
       icon's sync arrows, and the cover being written in Track Info. Once,
       here, rather than once per host file, which is where it was first
       declared - in MainView, ServerPickerView and mobile SettingsView in
       turn - before it lived in ConnectionStatusIcon. A pooled row's spinner
       is driven from its view model instead (DownloadIndicatorViewModel.
       SpinAngle), since an animation does not survive the row being reused. -->
  <Style Selector="materialIcons|MaterialIcon.spinning">
    <Setter Property="RenderTransform" Value="rotate(0deg)"/>
  </Style>
  <Style Selector="materialIcons|MaterialIcon.spinning">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
