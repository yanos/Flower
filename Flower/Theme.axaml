<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The app's colours, in three layers, and the only file in the app that
       holds a colour value:

       1. The palette (Palette*), per theme variant: the design's own named
          colours - Background, Accent and Accent Deep, the two text colours,
          Surface and Divider, the two icon neutrals - plus the few roles it
          does not name (what reads on the accent, what reads on a sheet tinted
          with a cover's colour, the status colours, the scrim behind a card).
          Change one here and everything drawn in that role follows.

       2. FluentTheme's own System*Color keys, per variant, each an alias of a
          palette colour, so what Fluent draws for itself (buttons, menus,
          scrollbars) is drawn in the same colours.

       3. Every brush anything names - the app's own App* roles and the Fluent
          brushes the views use directly - defined once for both variants, each
          on a palette colour through a DynamicResource: switch the variant, or
          replace a palette colour at runtime, and every brush on it repaints.
          A lighter or fainter version of a colour is that colour at an
          Opacity, never a second value.

       Shadows (BoxShadows) are here too, for the same reason: no view states a
       colour, a shadow's included. -->

  <!-- The display face: a song's title where it is the subject of the screen
       (Now Playing), set in a serif against Inter everywhere else. Bundled
       rather than named, since no platform ships it; subset to Latin,
       Latin Extended and Vietnamese (1MB down to 180KB) because a title in
       any other script falls back to the system either way. OFL - the licence
       sits beside the font. -->
  <FontFamily x:Key="AppDisplayFontFamily">avares://Flower/Assets/Fonts#Cormorant Garamond</FontFamily>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- The design palette ("Flower Home - Color Palette"). -->
      <Color x:Key="PaletteBackground">#FEFBF8</Color>
      <Color x:Key="PaletteAccent">#EF2D46</Color>
      <Color x:Key="PaletteAccentDeep">#D21F36</Color>
      <Color x:Key="PaletteTextPrimary">#1A1314</Color>
      <Color x:Key="PaletteTextSecondary">#6E6566</Color>
      <Color x:Key="PaletteSurface">#F5EEEB</Color>
      <Color x:Key="PaletteDivider">#E6DDD8</Color>
      <Color x:Key="PaletteIconInactive">#8C7F7F</Color>
      <Color x:Key="PaletteIconDisabled">#C9BEBE</Color>

      <!-- Roles the palette does not name. -->
      <Color x:Key="PaletteOnAccent">#FFFFFF</Color>
      <Color x:Key="PaletteOnArt">#FFFFFF</Color>
      <Color x:Key="PaletteScrim">#000000</Color>
      <Color x:Key="PaletteSuccess">#4CAF7B</Color>
      <Color x:Key="PaletteWarning">#E0A12E</Color>
      <Color x:Key="PaletteError">#D64545</Color>

      <!-- FluentTheme's base palette, on the design's. -->
      <StaticResource x:Key="SystemAccentColor" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="PaletteAccentDeep" />
      <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="PaletteAccentDeep" />
      <StaticResource x:Key="SystemAccentColorDark3" ResourceKey="PaletteAccentDeep" />
      <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAltHighColor" ResourceKey="PaletteBackground" />
      <StaticResource x:Key="SystemAltMediumHighColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemAltMediumColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemAltMediumLowColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemAltLowColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemBaseHighColor" ResourceKey="PaletteTextPrimary" />
      <StaticResource x:Key="SystemBaseMediumHighColor" ResourceKey="PaletteTextSecondary" />
      <StaticResource x:Key="SystemBaseMediumColor" ResourceKey="PaletteIconInactive" />
      <StaticResource x:Key="SystemBaseMediumLowColor" ResourceKey="PaletteIconDisabled" />
      <StaticResource x:Key="SystemBaseLowColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemChromeHighColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemChromeMediumColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemChromeMediumLowColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemChromeLowColor" ResourceKey="PaletteBackground" />
      <StaticResource x:Key="SystemChromeAltLowColor" ResourceKey="PaletteTextSecondary" />
      <StaticResource x:Key="SystemChromeDisabledHighColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemChromeDisabledLowColor" ResourceKey="PaletteIconDisabled" />
      <StaticResource x:Key="SystemChromeGrayColor" ResourceKey="PaletteIconInactive" />
      <StaticResource x:Key="SystemListLowColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemListMediumColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemRegionColor" ResourceKey="PaletteBackground" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- The design palette ("Flower Home - Dark Theme Color Palette"). -->
      <Color x:Key="PaletteBackground">#151112</Color>
      <Color x:Key="PaletteAccent">#F13A4F</Color>
      <Color x:Key="PaletteAccentDeep">#D6283E</Color>
      <Color x:Key="PaletteTextPrimary">#F6EFEC</Color>
      <Color x:Key="PaletteTextSecondary">#B7A8A8</Color>
      <Color x:Key="PaletteSurface">#21191B</Color>
      <Color x:Key="PaletteDivider">#3B2F31</Color>
      <Color x:Key="PaletteIconInactive">#8E7D7F</Color>
      <Color x:Key="PaletteIconDisabled">#5F5053</Color>

      <!-- Roles the palette does not name. -->
      <Color x:Key="PaletteOnAccent">#FFFFFF</Color>
      <Color x:Key="PaletteOnArt">#FFFFFF</Color>
      <Color x:Key="PaletteScrim">#000000</Color>
      <Color x:Key="PaletteSuccess">#3DAA6B</Color>
      <Color x:Key="PaletteWarning">#E0A82E</Color>
      <Color x:Key="PaletteError">#E0524D</Color>

      <!-- FluentTheme's base palette, on the design's. -->
      <StaticResource x:Key="SystemAccentColor" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="PaletteAccentDeep" />
      <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="PaletteAccentDeep" />
      <StaticResource x:Key="SystemAccentColorDark3" ResourceKey="PaletteAccentDeep" />
      <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="PaletteAccent" />
      <StaticResource x:Key="SystemAltHighColor" ResourceKey="PaletteBackground" />
      <StaticResource x:Key="SystemAltMediumHighColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemAltMediumColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemAltMediumLowColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemAltLowColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemBaseHighColor" ResourceKey="PaletteTextPrimary" />
      <StaticResource x:Key="SystemBaseMediumHighColor" ResourceKey="PaletteTextSecondary" />
      <StaticResource x:Key="SystemBaseMediumColor" ResourceKey="PaletteIconInactive" />
      <StaticResource x:Key="SystemBaseMediumLowColor" ResourceKey="PaletteIconDisabled" />
      <StaticResource x:Key="SystemBaseLowColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemChromeHighColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemChromeMediumColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemChromeMediumLowColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemChromeLowColor" ResourceKey="PaletteBackground" />
      <StaticResource x:Key="SystemChromeAltLowColor" ResourceKey="PaletteTextSecondary" />
      <StaticResource x:Key="SystemChromeDisabledHighColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemChromeDisabledLowColor" ResourceKey="PaletteIconDisabled" />
      <StaticResource x:Key="SystemChromeGrayColor" ResourceKey="PaletteIconInactive" />
      <StaticResource x:Key="SystemListLowColor" ResourceKey="PaletteSurface" />
      <StaticResource x:Key="SystemListMediumColor" ResourceKey="PaletteDivider" />
      <StaticResource x:Key="SystemRegionColor" ResourceKey="PaletteBackground" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ── The app's own roles ─────────────────────────────────────────── -->

  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource PaletteBackground}" />
  <!-- Cards, the mini player and tab bar, sheets, text boxes. -->
  <SolidColorBrush x:Key="AppSurfaceBrush" Color="{DynamicResource PaletteSurface}" />
  <SolidColorBrush x:Key="AppElevatedSurfaceBrush" Color="{DynamicResource PaletteSurface}" />
  <!-- The square standing in for a missing cover: a step off the surface it
       sits on, so it still reads as a square there. -->
  <SolidColorBrush x:Key="AppPlaceholderBrush" Color="{DynamicResource PaletteDivider}" />
  <SolidColorBrush x:Key="AppBorderBrush" Color="{DynamicResource PaletteDivider}" />
  <SolidColorBrush x:Key="AppDividerBrush" Color="{DynamicResource PaletteDivider}" />
  <!-- The unfilled part of the desktop volume bar. -->
  <SolidColorBrush x:Key="AppTrackBrush" Color="{DynamicResource PaletteDivider}" />

  <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{DynamicResource PaletteTextPrimary}" />
  <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{DynamicResource PaletteTextSecondary}" />
  <!-- An icon or label at rest (a tab not showing, a toggle off). -->
  <SolidColorBrush x:Key="AppTextMutedBrush" Color="{DynamicResource PaletteIconInactive}" />
  <SolidColorBrush x:Key="AppTextDisabledBrush" Color="{DynamicResource PaletteIconDisabled}" />

  <!-- The accent: an icon, the playing row, a lit toggle, a primary button's
       fill. Primary and Accent are the same colour; both names stay because
       the views use both, the one for a fill and the other for a highlight. -->
  <SolidColorBrush x:Key="AppPrimaryBrush" Color="{DynamicResource PaletteAccent}" />
  <SolidColorBrush x:Key="AppAccentBrush" Color="{DynamicResource PaletteAccent}" />
  <SolidColorBrush x:Key="AppAccentDeepBrush" Color="{DynamicResource PaletteAccentDeep}" />
  <!-- The accent at half strength, for the rim of every oval: at full
       strength a one-pixel ring outshouted the icon inside it. -->
  <SolidColorBrush x:Key="AppPrimaryBorderBrush" Color="{DynamicResource PaletteAccent}" Opacity="0.5" />
  <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{DynamicResource PaletteAccent}" Opacity="0.2" />
  <SolidColorBrush x:Key="AppAccentMutedBrush" Color="{DynamicResource PaletteAccent}" Opacity="0.2" />
  <SolidColorBrush x:Key="AppOnPrimaryBrush" Color="{DynamicResource PaletteOnAccent}" />

  <!-- A hairline around every icon (App.axaml): the text colour, faint, so
       it defines a glyph against either variant's background. -->
  <SolidColorBrush x:Key="AppIconOutlineBrush" Color="{DynamicResource PaletteTextPrimary}" Opacity="0.35" />

  <SolidColorBrush x:Key="AppSuccessBrush" Color="{DynamicResource PaletteSuccess}" />
  <SolidColorBrush x:Key="AppWarningBrush" Color="{DynamicResource PaletteWarning}" />
  <SolidColorBrush x:Key="AppErrorBrush" Color="{DynamicResource PaletteError}" />

  <!-- Dimmed behind a card raised over the screen (the action sheets). -->
  <SolidColorBrush x:Key="AppScrimBrush" Color="{DynamicResource PaletteScrim}" Opacity="0.4" />

  <!-- On a sheet washed in a cover's colour (Now Playing - see
       ArtBackdrop.SheetBrush), which is dark whatever the theme: the words
       and the filled controls, the same faint for what is off or unfilled,
       and a ring between the two. -->
  <SolidColorBrush x:Key="AppOnArtBrush" Color="{DynamicResource PaletteOnArt}" />
  <SolidColorBrush x:Key="AppOnArtPressedBrush" Color="{DynamicResource PaletteOnArt}" Opacity="0.8" />
  <SolidColorBrush x:Key="AppOnArtMutedBrush" Color="{DynamicResource PaletteOnArt}" Opacity="0.5" />
  <SolidColorBrush x:Key="AppOnArtRingBrush" Color="{DynamicResource PaletteOnArt}" Opacity="0.6" />
  <SolidColorBrush x:Key="AppOnArtRailBrush" Color="{DynamicResource PaletteOnArt}" Opacity="0.25" />

  <!-- ── Shadows ─────────────────────────────────────────────────────── -->

  <!-- Under a round button: just enough to lift it off the page. -->
  <BoxShadows x:Key="AppButtonShadow">0 1 4 0 #1A000000</BoxShadows>
  <!-- Under the mini player and the tab bar, over a list scrolling past. -->
  <BoxShadows x:Key="AppOvalShadow">0 4 20 0 #2E000000</BoxShadows>
  <!-- Under a cover that is the page's subject (an album's, Now Playing's). -->
  <BoxShadows x:Key="AppCoverShadow">0 6 20 0 #38000000</BoxShadows>
  <!-- Under something dropped down over the page (recent searches). -->
  <BoxShadows x:Key="AppDropdownShadow">0 4 16 0 #33000000</BoxShadows>

  <!-- ── Masks ───────────────────────────────────────────────────────── -->

  <!-- Fades the album page's blurred backdrop out down the header: only its
       opacity counts, so it is the same in either theme. -->
  <LinearGradientBrush x:Key="AppBackdropFadeMask" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#FF000000" Offset="0" />
    <GradientStop Color="#C0000000" Offset="0.5" />
    <GradientStop Color="#00000000" Offset="1" />
  </LinearGradientBrush>

  <!-- ── Fluent brushes the app sets ─────────────────────────────────── -->
  <!-- Fluent resolves these from its own colours when it loads, so the
       aliases above never reach them; the views name several directly. -->

  <!-- Selected list rows: the accent, faint, a step stronger under the
       pointer and another when pressed. -->
  <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{DynamicResource PaletteAccent}" Opacity="0.14" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{DynamicResource PaletteAccent}" Opacity="0.2" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{DynamicResource PaletteAccent}" Opacity="0.26" />

  <!-- Sheets and the floating chrome. -->
  <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="{DynamicResource PaletteSurface}" />
  <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{DynamicResource PaletteBackground}" />
  <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="{DynamicResource PaletteDivider}" />
  <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="{DynamicResource PaletteSurface}" />
  <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush" Color="{DynamicResource PaletteDivider}" />
  <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{DynamicResource PaletteSurface}" />
  <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="{DynamicResource PaletteIconDisabled}" />
  <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="{DynamicResource PaletteDivider}" />

  <!-- Every text box's outline, in the accent: half strength at rest, full
       under the pointer and while the caret is in it. Named outright because
       Fluent resolves its own text-box brushes inside its own dictionary,
       where the aliases above never reach, so a focused box came out the
       platform's blue. -->
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource PaletteAccent}" Opacity="0.5" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource PaletteAccent}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource PaletteAccent}" />

  <!-- Fluent's Slider - the seek bars and the phone's volume: filled and
       thumbed in the accent, deepening under the pointer and the press, and
       disabled-grey when disabled. Named outright for the same reason as the
       text boxes'. -->
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource PaletteAccent}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource PaletteAccentDeep}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource PaletteAccentDeep}" />
  <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{DynamicResource PaletteIconDisabled}" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource PaletteAccent}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource PaletteAccentDeep}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource PaletteAccentDeep}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{DynamicResource PaletteIconDisabled}" />
</ResourceDictionary>
